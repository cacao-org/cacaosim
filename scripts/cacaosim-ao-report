ts_wf_p = os.path.join(out_dir, "ts_wf_plot.npy")
ts_sr_p = os.path.join(out_dir, "ts_strehl_plot.npy")
has_wf_ts = os.path.exists(ts_wf_p)
has_sr_ts = os.path.exists(ts_sr_p)
if _want_plot(11) and has_wf_ts and has_sr_ts:
    wf_arr = np.load(ts_wf_p)
    sr_arr = np.load(ts_sr_p)
    ts_m = data.get("timeseries_metrics", {})
    wf_stat = ts_m.get("wf_rms_nm", {})
    sr_stat = ts_m.get("strehl", {})
    sa_m = data.get("star_and_atmosphere", {})
    seeing_v = sa_m.get("seeing_arcsec_500nm", 0.6)
    phys_t = sa_m.get("physical_time_s", 10.0)
    nfr_wf = wf_stat.get("final", {}).get("n_frames", wf_arr.shape[0])
    nexp_sr = sr_stat.get("vis", {}).get("final", {}).get("n_exposures", sr_arr.shape[0])

    def _boxcar_1d(y, win):
        y = np.asarray(y, dtype=float)
        if y.size <= 3 or win <= 1:
            return y
        w = min(int(win) | 1, y.size if y.size % 2 == 1 else max(1, y.size - 1))
        if w <= 1:
            return y
        pad = w // 2
        yp = np.pad(y, pad, mode="edge")
        return np.convolve(yp, np.ones(w) / float(w), mode="valid")

    figt, axest = plt.subplots(
        4, 1, figsize=(14.5, 12.2), sharex=True, constrained_layout=True
    )
    figt.suptitle(
        f"Subaru {tel_d:.2f} m AO3k + SCExAO — Pupil RMS Wavefront Error & "
        "Strehl Ratio vs Time\n"
        f"(Seeing = {seeing_v:.2f}\", {phys_t:.1f} s physical, {nfr_wf:,d} WF frames, "
        f"{nexp_sr:,d} PSF exposures)",
        fontsize=12.8,
        fontweight="bold",
    )

    t_wf = wf_arr[:, 1]
    t_sr = sr_arr[:, 0]
    samp_list = [
        sm for sm in (wf_info or {}).get("samples", []) if sm.get("t_phys_s") is not None
    ]
    vid_info = data.get("short_timescale_video")
    vid_span = None
    if vid_info and vid_info.get("t_start_s") is not None and vid_info.get("t_end_s") is not None:
        vid_span = (float(vid_info["t_start_s"]), float(vid_info["t_end_s"]))

    for ax in axest:
        if vid_span is not None:
            ax.axvspan(
                vid_span[0],
                vid_span[1],
                color="#10b981",
                alpha=0.22,
                zorder=2,
            )
            ax.axvline(vid_span[0], color="#059669", lw=1.1, alpha=0.80, zorder=3)
            ax.axvline(vid_span[1], color="#059669", lw=1.1, alpha=0.80, zorder=3)
        for sm in samp_list:
            ax.axvline(
                float(sm["t_phys_s"]),
                color="#7c3aed",
                ls="--",
                lw=1.35,
                alpha=0.72,
                zorder=3,
            )

    wf_specs = [
        (2, "raw", "Before Stage 1 (Entrance Pupil)", "#d62728"),
        (3, "stg1", "Between Stages 1 & 2 (Post-AO3k)", "#ff7f0e"),
        (4, "final", "After Stage 2 (Post-SCExAO)", "#1f77b4"),
    ]
    ax0 = axest[0]
    for col_i, skey, slab, col_c in wf_specs:
        y = wf_arr[:, col_i]
        m = wf_stat.get(skey, {})
        lbl = (
            f"{slab}: mean={m.get('mean_nm', 0):.1f}, med={m.get('median_nm', 0):.1f}, "
            f"P05-95={m.get('p05_nm', 0):.0f}..{m.get('p95_nm', 0):.0f} nm"
        )
        if t_wf.size > 20:
            ax0.plot(t_wf, y, color=col_c, lw=0.5, alpha=0.25)
            ys = _boxcar_1d(y, 21)
            ax0.plot(t_wf, ys, color=col_c, lw=1.85, label=lbl)
        else:
            ax0.plot(t_wf, y, "o-", color=col_c, lw=1.8, ms=4.5, label=lbl)
        if samp_list:
            sx, sy = [], []
            for sm in samp_list:
                ts_v = float(sm["t_phys_s"])
                yv = sm.get(skey, {}).get("rms_nm")
                if yv is None and t_wf.size > 0:
                    yv = float(y[int(np.argmin(np.abs(t_wf - ts_v)))])
                if yv is not None and np.isfinite(yv):
                    sx.append(ts_v)
                    sy.append(float(yv))
            if sx:
                ax0.scatter(
                    sx,
                    sy,
                    s=46,
                    facecolor=col_c,
                    edgecolor="#111827",
                    linewidths=1.15,
                    zorder=6,
                )
    if samp_list:
        sec_s = ax0.secondary_xaxis("top", functions=(lambda x: x, lambda x: x))
        s_ticks = [float(sm["t_phys_s"]) for sm in samp_list]
        if phys_t >= 1.0:
            s_labs = [f"S{i + 1} ({tv:.2f} s)" for i, tv in enumerate(s_ticks)]
        else:
            s_labs = [f"S{i + 1} ({tv * 1e3:.0f} ms)" for i, tv in enumerate(s_ticks)]
        sec_s.set_xticks(s_ticks)
        sec_s.set_xticklabels(s_labs, fontsize=9.0, fontweight="bold", color="#5b21b6")
        sec_s.tick_params(axis="x", colors="#5b21b6", length=5, width=1.4, pad=2)
    ax0.set_title(
        "Pupil Piston-Removed RMS Wavefront Error vs Time (All Optical Planes, 10 ms Smooth)",
        fontsize=11,
        fontweight="bold",
    )
    ax0.set_ylabel("Pupil RMS WFE [nm]")
    ymax0 = float(np.nanmax(wf_arr[:, 2])) if np.any(np.isfinite(wf_arr[:, 2])) else 100.0
    ax0.set_ylim(0.0, max(100.0, ymax0 * 1.25))
    ax0.grid(True, alpha=0.28)
    h0, l0 = ax0.get_legend_handles_labels()
    if samp_list:
        h0.append(
            Line2D(
                [0],
                [0],
                color="#7c3aed",
                ls="--",
                lw=1.35,
                marker="o",
                mfc="white",
                mec="#111827",
                mew=1.15,
                ms=5.8,
            )
        )
        l0.append(f"Sampled Snapshots S1-S{len(samp_list)} (PSF/WF/DM/WFS)")
    if vid_span is not None:
        h0.append(
            Patch(
                facecolor="#10b981",
                edgecolor="#059669",
                alpha=0.45,
                lw=1.1,
            )
        )
        l0.append(
            f"Video Clip [{vid_span[0]:.2f}..{vid_span[1]:.2f} s] "
            f"({(vid_span[1]-vid_span[0])*1e3:.0f} ms)"
        )
    ax0.legend(h0, l0, loc="upper right", fontsize=8.0, framealpha=0.92)

    ax1 = axest[1]
    for col_i, skey, slab, col_c in wf_specs[1:]:
        y = wf_arr[:, col_i]
        m = wf_stat.get(skey, {})
        lbl = (
            f"{slab}: mean={m.get('mean_nm', 0):.1f}, med={m.get('median_nm', 0):.1f}, "
            f"P05-95={m.get('p05_nm', 0):.0f}..{m.get('p95_nm', 0):.0f} nm"
        )
        if t_wf.size > 20:
            ax1.plot(t_wf, y, color=col_c, lw=0.5, alpha=0.26)
            ys = _boxcar_1d(y, 21)
            ax1.plot(t_wf, ys, color=col_c, lw=1.9, label=lbl)
        else:
            ax1.plot(t_wf, y, "o-", color=col_c, lw=1.8, ms=4.5, label=lbl)
        if samp_list:
            sx, sy = [], []
            for sm in samp_list:
                ts_v = float(sm["t_phys_s"])
                yv = sm.get(skey, {}).get("rms_nm")
                if yv is None and t_wf.size > 0:
                    yv = float(y[int(np.argmin(np.abs(t_wf - ts_v)))])
                if yv is not None and np.isfinite(yv):
                    sx.append(ts_v)
                    sy.append(float(yv))
            if sx:
                ax1.scatter(
                    sx,
                    sy,
                    s=46,
                    facecolor=col_c,
                    edgecolor="#111827",
                    linewidths=1.15,
                    zorder=6,
                )
    ax1.axhline(
        119.37,
        color="#6b7280",
        ls="--",
        lw=1.0,
        alpha=0.70,
        label="1 rad RMS @ 0.75 um (119 nm)",
    )
    ax1.axhline(
        262.61,
        color="#4b5563",
        ls="-.",
        lw=1.0,
        alpha=0.55,
        label="1 rad RMS @ 1.65 um (263 nm)",
    )
    ax1.set_title(
        "Closed-Loop Residual RMS Wavefront Error vs Time (Post-AO3k & Post-SCExAO Zoom)",
        fontsize=11,
        fontweight="bold",
    )
    ax1.set_ylabel("Residual RMS WFE [nm]")
    cl_vals = np.concatenate([wf_arr[:, 3], wf_arr[:, 4]])
    cl_vals = cl_vals[np.isfinite(cl_vals)]
    p99_cl = float(np.percentile(cl_vals, 99.0)) if cl_vals.size else 200.0
    ax1.set_ylim(0.0, max(150.0, p99_cl * 1.25))
    ax1.grid(True, alpha=0.28)
    ax1.legend(loc="upper right", fontsize=8.0, ncol=2, framealpha=0.92)

    sr_band_panels = [
        (
            axest[2],
            "vis",
            "Visible I-Band (0.75 um)",
            [(1, 2, "raw"), (3, 4, "stg1"), (5, 6, "final")],
        ),
        (
            axest[3],
            "nir",
            "Near-IR H-Band (1.65 um)",
            [(7, 8, "raw"), (9, 10, "stg1"), (11, 12, "final")],
        ),
    ]
    sr_stage_meta = {
        "raw": ("Uncorrected (Open-Loop)", "#d62728"),
        "stg1": ("Stage 1 Only (AO3k)", "#ff7f0e"),
        "final": ("Stage 1 + 2 (AO3k + SCExAO)", "#1f77b4"),
    }
    for ax_s, bkey, blab, cols in sr_band_panels:
        max_sr = 10.0
        has_highrate_sr = False
        for ci, cl, skey in cols:
            slab, col_c = sr_stage_meta[skey]
            yi = sr_arr[:, ci] * 100.0
            yl = sr_arr[:, cl] * 100.0
            ms = sr_stat.get(bkey, {}).get(skey, {})
            m_i = np.isfinite(yi)
            if np.any(m_i):
                t_i = t_sr[m_i]
                y_i = yi[m_i]
                max_sr = max(max_sr, float(np.max(y_i)))
                lbl_i = (
                    f"{slab}: short mean={ms.get('inst_mean', 0)*100:.1f}% "
                    f"(long={ms.get('long_final', 0)*100:.1f}%)"
                )
                if y_i.size > 2000:
                    has_highrate_sr = True
                    ax_s.plot(t_i, y_i, color=col_c, lw=0.45, alpha=0.22)
                    ax_s.plot(
                        t_i,
                        _boxcar_1d(y_i, 21),
                        color=col_c,
                        lw=1.55,
                        alpha=0.88,
                        label=lbl_i,
                    )
                else:
                    ax_s.plot(t_i, y_i, color=col_c, lw=1.15, alpha=0.68, label=lbl_i)
                if samp_list:
                    sx, sy = [], []
                    for sm in samp_list:
                        ts_v = float(sm["t_phys_s"])
                        sr_pk = (
                            sm.get("inst_psf", {})
                            .get(bkey, {})
                            .get(skey, {})
                            .get("strehl_peak")
                        )
                        if sr_pk is not None and np.isfinite(sr_pk):
                            yv = float(sr_pk) * 100.0
                        elif t_i.size > 0:
                            cand = np.where(t_i <= ts_v + 1e-6)[0]
                            idx_s = (
                                int(cand[-1])
                                if cand.size > 0
                                else int(np.argmin(np.abs(t_i - ts_v)))
                            )
                            yv = float(y_i[idx_s])
                        else:
                            yv = float("nan")
                        if np.isfinite(yv):
                            sx.append(ts_v)
                            sy.append(yv)
                    if sx:
                        ax_s.scatter(
                            sx,
                            sy,
                            s=46,
                            facecolor=col_c,
                            edgecolor="#111827",
                            linewidths=1.15,
                            zorder=6,
                        )
            m_l = np.isfinite(yl)
            if np.any(m_l):
                max_sr = max(max_sr, float(np.max(yl[m_l])))
                ax_s.plot(t_sr[m_l], yl[m_l], color=col_c, ls="--", lw=2.2, alpha=0.95)
        exp_desc = (
            "Solid: 0.5 ms Speckle + 10 ms Smooth"
            if has_highrate_sr
            else "Solid: 10 ms Short-Exp"
        )
        ax_s.set_title(
            f"{blab} Strehl Ratios vs Time ({exp_desc} | Dashed: Cumulative Long-Exp)",
            fontsize=11,
            fontweight="bold",
        )
        ax_s.set_ylabel(f"{bkey.upper()} Strehl [%]")
        top_sr = min(118.0, max_sr * 1.26)
        ax_s.set_ylim(0.0, top_sr)
        if top_sr > 100.0:
            ax_s.set_yticks([0, 20, 40, 60, 80, 100])
        ax_s.grid(True, alpha=0.28)
        ax_s.legend(loc="upper right", fontsize=8.2, framealpha=0.92)

    xmax = max(
        float(np.nanmax(t_wf)) if t_wf.size else phys_t,
        float(np.nanmax(t_sr)) if t_sr.size else phys_t,
    )
    axest[3].set_xlim(0.0, max(xmax, 0.1))
    axest[3].set_xlabel("Physical Simulation Time t [s]", fontsize=10.5)
    figt.savefig(os.path.join(out_dir, "wf_strehl_timeseries_4x1.png"), dpi=180)
    plt.close(figt)

chrom = data.get("chromaticity")
if _want_plot(12) and chrom and chrom.get("beams") and chrom.get("sensors"):
    lam_b = np.asarray(chrom["lambda_bins_um"], dtype=float)
    bmap = chrom["beams"]
    figc, axesc = plt.subplots(
        2, 1, figsize=(13.8, 8.2), sharex=True, constrained_layout=True
    )
    figc.suptitle(
        f"Subaru {tel_d:.2f} m AO3k + SCExAO — Polychromatic Photon Budget & "
        "Sub-Band Optical Sampling\n"
        "(32-Bin Dichroic Beam Spectra [0.40..2.40 µm] & Bolometric Sub-Band "
        "Centroids λ_c with Focal λ₀/λ_c Scaling)",
        fontsize=12.4,
        fontweight="bold",
    )

    ax_sp = axesc[0]
    beam_plot = [
        ("b_pup", "Entrance Pupil (b_pup)", "#111827", "--", 2.0),
        ("b_nir_wfs", "Stage-1 AO3k J-Band PyWFS Arm (b_nir_wfs)", "#d97706", "-", 2.3),
        ("b_vis_wfs", "Stage-2 SCExAO Vis PyWFS Arm (b_vis_wfs)", "#2563eb", "-", 2.3),
        ("b_vis_sci", "Stage-2 Vis Science Arm (b_vis_sci, 10%)", "#0891b2", "-.", 1.9),
        ("b_nir_sci", "Unocculted H-Band Science (b_nir_sci)", "#dc2626", "-", 2.2),
        ("b_coro_sci", "Post-Lyot Coronagraph Arm (b_coro_sci)", "#7c3aed", ":", 2.1),
        ("b_lowfs_defoc", "Reflective-Lyot LLOWFS Arm (b_lowfs_defoc)", "#059669", "-.", 1.9),
    ]
    for bk, blab, col_b, ls_b, lw_b in beam_plot:
        if bk not in bmap:
            continue
        yv = np.maximum(np.asarray(bmap[bk]["ph_s_per_um"], dtype=float), 2.0e4)
        tot_s = bmap[bk]["total_ph_s"]
        ax_sp.semilogy(
            lam_b,
            yv,
            color=col_b,
            ls=ls_b,
            lw=lw_b,
            label=f"{blab} ({tot_s:.2e} ph/s)",
        )
    ax_sp.set_ylim(2.0e4, 8.0e11)
    ax_sp.set_ylabel("Spectral Photon Rate [ph / s / µm]")
    ax_sp.set_title(
        f"Propagated 32-Bin Stellar & Dichroic Beam Spectra "
        f"(mV = 6.0, Teff = 9600 K, D = {tel_d:.2f} m, Tput = {tput_pct:.0f}%)",
        fontsize=11,
        fontweight="bold",
    )
    ax_sp.grid(True, which="both", alpha=0.28)
    ax_sp.legend(loc="upper right", fontsize=8.0, ncol=2, framealpha=0.92)

    ax_sb = axesc[1]
    pick_ids = ["wfs_vis", "vis_final", "wfs_nir", "nir_final", "nir_coro", "wfs_lowfs"]
    s_by_id = {sn["id"]: sn for sn in chrom["sensors"]}
    disp_sens = [s_by_id[k] for k in pick_ids if k in s_by_id]
    if not disp_sens:
        disp_sens = chrom["sensors"][:6]
    s_colors = {
        "wfs_vis": "#2563eb",
        "vis_final": "#0891b2",
        "wfs_nir": "#d97706",
        "nir_final": "#dc2626",
        "nir_coro": "#7c3aed",
        "wfs_lowfs": "#059669",
    }
    ylabels = []
    for idx_y, sn in enumerate(disp_sens):
        col_s = s_colors.get(sn["id"], "#3b82f6")
        lmin = float(sn["lambda_min_um"])
        lmax = float(sn["lambda_max_um"])
        nlam = int(sn["eff_nlam"])
        sub_dl = (lmax - lmin) / max(nlam, 1)
        ax_sb.barh(
            idx_y,
            lmax - lmin,
            left=lmin,
            height=0.46,
            color=col_s,
            alpha=0.22,
            edgecolor=col_s,
            lw=1.5,
        )
        for k_edge in range(1, nlam):
            xe = lmin + k_edge * sub_dl
            ax_sb.plot(
                [xe, xe],
                [idx_y - 0.23, idx_y + 0.23],
                color=col_s,
                ls=":",
                lw=1.2,
            )
        clams = sn["chan_lam_um"]
        cws = sn["chan_weight"]
        fscs = sn["focal_scale_lam0_over_lam"]
        ax_sb.scatter(
            clams,
            [idx_y] * len(clams),
            s=[160.0 * max(w, 0.15) for w in cws],
            color=col_s,
            edgecolors="#111827",
            linewidths=1.1,
            zorder=5,
        )
        tag_pts = ", ".join(
            f"{lc:.3f}µm ({w*100:.0f}%, {sc:.2f}×)"
            for lc, w, sc in zip(clams, cws, fscs)
        )
        place_left = lmin > 1.35
        ax_sb.text(
            (lmin - 0.025) if place_left else (lmax + 0.025),
            idx_y,
            f"N={nlam}ch | {sn['flux_ph_per_frame']:.2e} ph/fr | {tag_pts}",
            va="center",
            ha="right" if place_left else "left",
            fontsize=8.1,
            family="monospace",
            color="#111827",
        )
        ylabels.append(
            f"{sn['id']} ({sn['kind'].upper()})\n"
            f"λ₀={sn['lambda0_um']:.2f}µm, Δλ/λ₀={sn['bw_frac']*100:.0f}%"
        )
    ax_sb.set_yticks(range(len(disp_sens)))
    ax_sb.set_yticklabels(ylabels, fontsize=8.8, fontweight="bold")
    ax_sb.set_ylim(-0.6, max(len(disp_sens) - 0.4, 0.6))
    ax_sb.set_xlim(0.38, 2.42)
    ax_sb.set_xlabel("Wavelength λ [µm]", fontsize=10.5)
    ax_sb.set_title(
        "Sensor Passbands [λ_min..λ_max], Contiguous Sub-Bands & "
        "Flux-Weighted Propagation Slices λ_c (w_c, λ₀/λ_c)",
        fontsize=10.8,
        fontweight="bold",
    )
    ax_sb.grid(True, axis="x", alpha=0.28)
    figc.savefig(os.path.join(out_dir, "chromatic_passbands_2x1.png"), dpi=180)
    plt.close(figc)

coro_m = data.get("coronagraph_metrics")
if (
    _want_plot(13)
    and coro_m
    and os.path.exists(os.path.join(out_dir, "psf_nir_coro_dl.npy"))
    and os.path.exists(os.path.join(out_dir, "psf_nir_coro.npy"))
