    s_colors = {
        "wfs_vis": "#2563eb",
        "vis_final": "#0891b2",
        "wfs_nir": "#d97706",
        "nir_final": "#dc2626",
    }
    ylabels = []
    for idx_y, sn in enumerate(disp_sens):
        col_s = s_colors.get(sn["id"], "#3b82f6")
        lmin = float(sn["lambda_min_um"])
        lmax = float(sn["lambda_max_um"])
        nlam = int(sn["eff_nlam"])
        sub_dl = (lmax - lmin) / max(nlam, 1)
        ax_sb.barh(
            idx_y,
            lmax - lmin,
            left=lmin,
            height=0.46,
            color=col_s,
            alpha=0.22,
            edgecolor=col_s,
            lw=1.5,
        )
        for k_edge in range(1, nlam):
            xe = lmin + k_edge * sub_dl
            ax_sb.plot(
                [xe, xe],
                [idx_y - 0.23, idx_y + 0.23],
                color=col_s,
                ls=":",
                lw=1.2,
            )
        clams = sn["chan_lam_um"]
        cws = sn["chan_weight"]
        fscs = sn["focal_scale_lam0_over_lam"]
        ax_sb.scatter(
            clams,
            [idx_y] * len(clams),
            s=[160.0 * max(w, 0.15) for w in cws],
            color=col_s,
            edgecolors="#111827",
            linewidths=1.1,
            zorder=5,
        )
        tag_pts = ", ".join(
            f"{lc:.3f}µm ({w*100:.0f}%, {sc:.2f}×)"
            for lc, w, sc in zip(clams, cws, fscs)
        )
        place_left = lmin > 1.35
        ax_sb.text(
            (lmin - 0.025) if place_left else (lmax + 0.025),
            idx_y,
            f"N={nlam}ch | {sn['flux_ph_per_frame']:.2e} ph/fr | {tag_pts}",
            va="center",
            ha="right" if place_left else "left",
            fontsize=8.3,
            family="monospace",
            color="#111827",
        )
        ylabels.append(
            f"{sn['id']} ({sn['kind'].upper()})\n"
            f"λ₀={sn['lambda0_um']:.2f}µm, Δλ/λ₀={sn['bw_frac']*100:.0f}%"
        )
    ax_sb.set_yticks(range(len(disp_sens)))
    ax_sb.set_yticklabels(ylabels, fontsize=9.0, fontweight="bold")
    ax_sb.set_ylim(-0.6, max(len(disp_sens) - 0.4, 0.6))
    ax_sb.set_xlim(0.38, 2.42)
    ax_sb.set_xlabel("Wavelength λ [µm]", fontsize=10.5)
    ax_sb.set_title(
        "Sensor Passbands [λ_min..λ_max], Contiguous Sub-Bands & "
        "Flux-Weighted Propagation Slices λ_c (w_c, λ₀/λ_c)",
        fontsize=10.8,
        fontweight="bold",
    )
    ax_sb.grid(True, axis="x", alpha=0.28)
    figc.savefig(os.path.join(out_dir, "chromatic_passbands_2x1.png"), dpi=180)
    plt.close(figc)
