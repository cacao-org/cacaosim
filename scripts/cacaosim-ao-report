            ]
        )
        for r in repos:
            rname = r["name"]
            rurl = r["url"]
            rbr = r["branch"]
            rsha = r.get("commit", "")
            rshort = r.get("short_commit", "")
            sha_cell = (
                f"[`{rshort}`]({rurl}/commit/{rsha})" if rsha and rshort else "`HEAD`"
            )
            lines.append(
                f"| [{rname}]({rurl}) | `{rbr}` | {sha_cell} | {r['role']} |"
            )

        def _checkout_line(rname, clone_dir=None):
            r = by_name.get(rname, {})
            d = clone_dir or rname
            url = r.get("url", f"https://github.com/milk-org/{rname}") + ".git"
            br = r.get("branch", "main")
            sha = r.get("commit", "")
            cmd = f"git clone -b {br} {url} {d}"
            if sha:
                cmd += f" && git -C {d} checkout -q {sha}"
            return cmd

        isio_sha = by_name.get("ImageStreamIO", {}).get("commit", "")
        isio_step = "git -C milk submodule update --init src/engine/ImageStreamIO"
        if isio_sha:
            isio_step += f" && git -C milk/src/engine/ImageStreamIO checkout -q {isio_sha}"

        bfile = repro.get("bench_file", "ao3k_scexao.bench")
        mfile = repro.get("metrics_file", "ao3k_scexao_metrics.json")
        rcmd = repro.get("run_command", "./scripts/run-ao3k-scexao.sh")

        lines.extend(
            [
                "",
                "### End-to-End Reproduction Recipe (CLI & AI Agent Ready)",
                "",
                "- **System Prerequisites**: Linux `x86_64` with `/dev/shm` (`tmpfs`), "
                "GCC/G++ with OpenMP, CMake >= 3.20, `pkg-config`, CFITSIO, FFTW3 (`fftw3` & "
                "`fftw3f`), OpenBLAS + LAPACKE, `ncurses`, NVIDIA CUDA Toolkit (`nvcc`, `cufft`, "
                "`cublas`; CPU fallback also supported), and Python >= 3.10 with `numpy`, "
                "`astropy`, `matplotlib`, `pillow`, `imageio-ffmpeg`, and `pytest`.",
                f"- **Machine-Readable Config & Metrics**: [{bfile}]({bfile}) and "
                f"[{mfile}]({mfile}) (includes this `reproducibility` manifest).",
                "",
                "```bash",
                "# 1. Clone all stack repositories at the exact commits recorded above",
                "mkdir -p ~/src && cd ~/src",
                _checkout_line("milk"),
                isio_step,
                _checkout_line("cacao"),
                _checkout_line("milk-mltools"),
                _checkout_line("OpticsMaterials"),
                _checkout_line("WFpropagate"),
                _checkout_line("AtmosphericTurbulenceSimul"),
                _checkout_line("cacaosim"),
                _checkout_line("cacao-work"),
                "",
                "# 2. Configure, build, install into milk/_install, and run isolated sanity tests",
                "cd ~/src/cacao-work",
                "source env.sh",
                "./scripts/build-all.sh",
                "pytest -v tests/test_00_stack_sanity.py tests/test_05_ao_web_report.py",
                "",
                "# 3. Run the 10 s Subaru AO3k + SCExAO simulation, telemetry, video & reports",
                rcmd,
                "",
                "# 4. Stage static HTML site locally under _work/_web_site/public/",
                "./scripts/publish-ao-report.sh --build-only _work/ao3k_scexao",
                "```",
            ]
        )

    with open(os.path.join(out_dir, "REPORT.md"), "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines) + "\n")


def load_and_summarize_timeseries(out_dir, wf_metrics, tmp_npys):
    ts_summary = {}

    wf_arr = None
    has_full_wf = False
    wf_csv_p = os.path.join(out_dir, "wf_timeseries.csv")
    if os.path.isfile(wf_csv_p):
        try:
            loaded = np.loadtxt(wf_csv_p, delimiter=",", skiprows=1, ndmin=2)
            if loaded.ndim == 2 and loaded.shape[0] > 0 and loaded.shape[1] >= 5:
                wf_arr = loaded[:, :5].astype(np.float64)
                has_full_wf = True
        except Exception:
            wf_arr = None

    if wf_arr is None and wf_metrics and wf_metrics.get("samples"):
        rows = []
        for sm in wf_metrics["samples"]:
            rows.append(
                [
                    float(sm.get("frame", 0)),
                    float(sm.get("t_phys_s", 0.0)),
                    float(sm.get("raw", {}).get("rms_nm", float("nan"))),
                    float(sm.get("stg1", {}).get("rms_nm", float("nan"))),
                    float(sm.get("final", {}).get("rms_nm", float("nan"))),
                ]
            )
        if rows:
            wf_arr = np.asarray(rows, dtype=np.float64)

    if wf_arr is not None and wf_arr.shape[0] > 0:
        wf_npy = os.path.join(out_dir, "ts_wf_plot.npy")
        np.save(wf_npy, wf_arr.astype(np.float32))
        tmp_npys.append(wf_npy)
        wf_rms_summary = {}
        for col_i, k in ((2, "raw"), (3, "stg1"), (4, "final")):
            vals = wf_arr[:, col_i]
            vals = vals[np.isfinite(vals)]
            if vals.size > 0:
                wf_rms_summary[k] = {
                    "n_frames": int(vals.size),
                    "mean_nm": float(np.mean(vals)),
                    "std_nm": float(np.std(vals)),
                    "min_nm": float(np.min(vals)),
                    "p05_nm": float(np.percentile(vals, 5.0)),
                    "median_nm": float(np.median(vals)),
                    "p95_nm": float(np.percentile(vals, 95.0)),
                    "max_nm": float(np.max(vals)),
                    "has_full_csv": has_full_wf,
                }
        if wf_rms_summary:
            ts_summary["wf_rms_nm"] = wf_rms_summary

    sr_cols = [
        ("vis", "raw"),
        ("vis", "stg1"),
        ("vis", "final"),
        ("nir", "raw"),
        ("nir", "stg1"),
        ("nir", "final"),
    ]
    sr_arr = None
    has_full_sr = False
    sr_csv_p = os.path.join(out_dir, "strehl_timeseries.csv")
    if os.path.isfile(sr_csv_p):
        try:
            with open(sr_csv_p, "r", encoding="utf-8") as fh:
                hdr_line = fh.readline().strip()
            col_names = [c.strip() for c in hdr_line.split(",")]
            col_map = {name: idx for idx, name in enumerate(col_names)}
            if "t_phys_s" in col_map and "vis_raw_inst" in col_map:
                raw_mat = np.loadtxt(
                    sr_csv_p, delimiter=",", skiprows=1, ndmin=2, dtype=np.float64
                )
                if raw_mat.ndim == 2 and raw_mat.shape[0] > 0:
                    nrows = raw_mat.shape[0]
                    cols_data = [raw_mat[:, col_map["t_phys_s"]]]
                    for bkey, skey in sr_cols:
                        ik = f"{bkey}_{skey}_inst"
                        lk = f"{bkey}_{skey}_long"
                        cols_data.append(
                            raw_mat[:, col_map[ik]]
                            if ik in col_map and col_map[ik] < raw_mat.shape[1]
                            else np.full(nrows, np.nan)
                        )
                        cols_data.append(
                            raw_mat[:, col_map[lk]]
                            if lk in col_map and col_map[lk] < raw_mat.shape[1]
                            else np.full(nrows, np.nan)
                        )
                    sr_arr = np.column_stack(cols_data)
                    has_full_sr = True
        except Exception:
            sr_arr = None

    if sr_arr is None and wf_metrics and wf_metrics.get("samples"):
        samps = wf_metrics["samples"]
        if any(sm.get("inst_psf", {}).get("vis") for sm in samps):
            t_vec = np.asarray([float(sm.get("t_phys_s", 0.0)) for sm in samps], dtype=np.float64)
            cols_data = [t_vec]
            for bkey, skey in sr_cols:
                vals = np.asarray(
                    [
                        float(
                            sm.get("inst_psf", {})
                            .get(bkey, {})
                            .get(skey, {})
                            .get("strehl_peak", float("nan"))
                        )
                        for sm in samps
                    ],
                    dtype=np.float64,
                )
                lvals = np.full(vals.shape, np.nan, dtype=np.float64)
                fin = np.isfinite(vals)
                if np.any(fin):
                    cnt = np.cumsum(fin.astype(np.float64))
                    csum = np.cumsum(np.where(fin, vals, 0.0))
                    lvals[fin] = csum[fin] / cnt[fin]
                cols_data.extend([vals, lvals])
            sr_arr = np.column_stack(cols_data)

    if sr_arr is not None and sr_arr.shape[0] > 0:
        sr_npy = os.path.join(out_dir, "ts_strehl_plot.npy")
        np.save(sr_npy, sr_arr.astype(np.float32))
        tmp_npys.append(sr_npy)
        sr_summary = {"vis": {}, "nir": {}}
        for idx, (bkey, skey) in enumerate(sr_cols):
            iv = sr_arr[:, 1 + 2 * idx]
            lv = sr_arr[:, 2 + 2 * idx]
            iv_f = iv[np.isfinite(iv)]
            lv_f = lv[np.isfinite(lv)]
            if iv_f.size > 0:
                sr_summary[bkey][skey] = {
                    "n_exposures": int(iv_f.size),
                    "inst_mean": float(np.mean(iv_f)),
                    "inst_std": float(np.std(iv_f)),
                    "inst_min": float(np.min(iv_f)),
                    "inst_p05": float(np.percentile(iv_f, 5.0)),
                    "inst_median": float(np.median(iv_f)),
                    "inst_p95": float(np.percentile(iv_f, 95.0)),
                    "inst_max": float(np.max(iv_f)),
                    "long_final": float(lv_f[-1]) if lv_f.size > 0 else float("nan"),
                    "has_full_csv": has_full_sr,
                }
        if sr_summary["vis"] or sr_summary["nir"]:
            ts_summary["strehl"] = sr_summary

    return ts_summary if ts_summary else None


def main():
    if any(a in ("-h1", "--help-oneline") for a in sys.argv[1:]):
        print("compile AO optical/control PSF, wavefront, mlat, and selfRM metrics + REPORT.md")
        return
    if any(a in ("-h2", "--help-description") for a in sys.argv[1:]):
        print(
            "Analyze FITS PSFs, coronagraph dark holes, wavefront stats, mlat latency, and\n"
            "selfRM cubes from Subaru AO3k + SCExAO + LLOWFS simulation runs to generate\n"
            "REPORT.md, ao3k_scexao_metrics.json, and 13 publication figures."
        )
        return
    if len(sys.argv) >= 3 and sys.argv[1] == "--replot-calib2wfs":
        out_dir = os.path.abspath(sys.argv[2])
        summary_path = os.path.join(out_dir, "ao3k_scexao_metrics.json")
        if not os.path.isfile(summary_path):
            raise FileNotFoundError(f"Missing {summary_path}")
        tmp_npys = []
        try:
            c2d = load_calib_2wfs1dm_metrics(out_dir, out_dir, tmp_npys)
            if c2d is None:
                raise FileNotFoundError(f"Missing calib_2wfs1dm/sysid_summary.json in {out_dir}")
            with open(summary_path, "r", encoding="utf-8") as fh:
                summary = json.load(fh)
            if not isinstance(summary.get("calib_2wfs1dm"), dict):
                summary["calib_2wfs1dm"] = c2d
                with open(summary_path, "w", encoding="utf-8") as fh:
                    json.dump(summary, fh, indent=2)
                    fh.write("\n")
            prev_slot = os.environ.get("CACAOSIM_PLOT_SLOT")
            os.environ["CACAOSIM_PLOT_SLOT"] = "17"
            try:
                render_plots_via_sys_python(out_dir, summary_path)
            finally:
                if prev_slot is None:
                    os.environ.pop("CACAOSIM_PLOT_SLOT", None)
                else:
                    os.environ["CACAOSIM_PLOT_SLOT"] = prev_slot
        finally:
            for npy_p in tmp_npys:
                if os.path.exists(npy_p):
                    os.remove(npy_p)
        return
    if len(sys.argv) < 11 or any(a in ("-h", "--help", "-hm", "--help-mono") for a in sys.argv[1:]):
        print(
            "Usage: cacaosim-ao-report <work_dir> <out_dir> <seeing> <phys_time> <master_ticks>\n"
            "                          <wall_elapsed> <gain1> <gain2> <mult1> <mult2>\n"
            "                          [mgain_alpha] [mgain_floor] [mgain_tt]"
        )
        return

    (
        work_dir,
        out_dir,
        seeing,
        phys_time,
        master_ticks,
        wall_elapsed,
        gain1,
        gain2,
        mult1,
        mult2,
    ) = sys.argv[1:11]
    mgain_alpha = float(sys.argv[11]) if len(sys.argv) > 11 else 0.8
    mgain_floor = float(sys.argv[12]) if len(sys.argv) > 12 else 0.10
    mgain_tt = float(sys.argv[13]) if len(sys.argv) > 13 else 1.0
    gain3 = float(os.environ.get("CACAOSIM_GAIN3", "0.20"))
    mult3 = float(os.environ.get("CACAOSIM_MULT3", "0.995"))
    svdlim3_env = float(os.environ.get("CACAOSIM_SVDLIM3", "0.02"))
    enable_lowfs = os.environ.get("CACAOSIM_ENABLE_LOWFS", "1").lower() not in (
        "0",
        "off",
        "false",
    )

    bench_filename = ensure_gui_screenshots(work_dir, out_dir)
    chrom_info = (
        analyze_bench_chromaticity(os.path.join(out_dir, bench_filename))
        if bench_filename
        else None
    )
    bcfg_parsed = (chrom_info or {}).get("bench", {})
    tel_diam_m = float(bcfg_parsed.get("tel_diam_m", TEL_DIAM_M))

    tmp_npys = []
    psf_metrics = {}
    dl_imgs = {}
    for bkey, bcfg in BANDS.items():
        psf_metrics[bkey] = {}
        dl_img = np.asarray(
            fits.getdata(os.path.join(out_dir, f"psf_{bkey}_dl.fits")), dtype=np.float64
        )
        dl_imgs[bkey] = dl_img
        dl_sum = float(np.sum(dl_img))
        for skey, _ in STAGES:
            fpath = os.path.join(out_dir, f"psf_{bkey}_{skey}.fits")
            img = np.asarray(fits.getdata(fpath), dtype=np.float64)
            npy_p = os.path.join(out_dir, f"psf_{bkey}_{skey}.npy")
            np.save(npy_p, img.astype(np.float32))
            tmp_npys.append(npy_p)
            psf_metrics[bkey][skey] = analyze_band_stage(
                img, dl_sum, bcfg, tel_diam_m=tel_diam_m
            )

    wf_metrics = None
    wf_json_p = os.path.join(out_dir, "wf_stats.json")
    if os.path.isfile(wf_json_p):
        with open(wf_json_p, "r", encoding="utf-8") as fh:
            wf_metrics = json.load(fh)
        wf_stems = [
            "wf_pupil_mask",
            "wfs_raw_stg1_samples",
            "wfs_sig_stg1_samples",
            "wfs_raw_stg2_samples",
            "wfs_sig_stg2_samples",
            "dm_cmd_stg1_samples",
            "dm_opd_stg1_samples",
            "dm_cmd_stg2_samples",
            "dm_opd_stg2_samples",
        ]
        for k in ("raw", "stg1", "final"):
            wf_stems.extend([f"wf_samples_{k}", f"wf_mean_{k}", f"wf_std_{k}"])
        for stem in wf_stems:
            fp = os.path.join(out_dir, f"{stem}.fits")
            if os.path.isfile(fp):
                npy_p = os.path.join(out_dir, f"{stem}.npy")
                np.save(npy_p, np.asarray(fits.getdata(fp), dtype=np.float32))
                tmp_npys.append(npy_p)

        samples_list = wf_metrics.get("samples", [])
        for sm in samples_list:
            sm["inst_psf"] = {"vis": {}, "nir": {}}

        for bkey, bcfg in BANDS.items():
            dl_img = dl_imgs[bkey]
            ny, nx = dl_img.shape
            c0 = nx // 2
            yy, xx = np.indices((ny, nx), dtype=np.float64)
            core_m = np.hypot(xx - c0, yy - c0) <= 20.0
            dl_core_sum = max(float(np.sum(dl_img[core_m])), 1e-6)
            dl_tot_sum = max(float(np.sum(dl_img)), 1e-6)
            ld_mas = (bcfg["lam_um"] * 1e-6 / tel_diam_m) * RAD2MAS
            pix_mas = ld_mas / bcfg["pixscale_ld"]
            rr_mas = np.hypot(xx - c0, yy - c0) * pix_mas
            rgrid_mas = np.linspace(0.5 * pix_mas, 1500.0, 200)

            for skey in ("raw", "stg1", "final"):
                sp = os.path.join(out_dir, f"psf_inst_{bkey}_{skey}_samples.fits")
                dlp = os.path.join(out_dir, f"det_{bkey}_{skey}_dl.fits")
                if not os.path.isfile(sp):
                    continue
                scube = np.asarray(fits.getdata(sp), dtype=np.float64)
                if os.path.isfile(dlp):
                    det_dl = np.asarray(fits.getdata(dlp), dtype=np.float64)
                    det_sub = np.maximum(det_dl - 100.0, 0.0)
                    adu_per_sr = max(float(np.sum(det_sub[core_m])) / dl_core_sum, 1.0)
                else:
                    adu_per_sr = max(float(np.max(scube - 100.0)), 1.0)

                sr_cube = np.maximum(scube - 100.0, 0.0) / adu_per_sr
                npy_sr = os.path.join(out_dir, f"psf_inst_{bkey}_{skey}_sr.npy")
                np.save(npy_sr, sr_cube.astype(np.float32))
                tmp_npys.append(npy_sr)

                for idx in range(min(len(samples_list), sr_cube.shape[0])):
                    frm = sr_cube[idx]
                    pidx = int(np.argmax(frm))
                    py, px = divmod(pidx, nx)
                    sr_pk = float(frm[py, px])
                    fw_px = estimate_fwhm_pix(frm, (px, py))
                    ee_c = np.array(
                        [float(np.sum(frm[rr_mas <= r]) / dl_tot_sum) for r in rgrid_mas]
                    )
                    i50 = int(np.searchsorted(ee_c, 0.50))
                    r50 = (
                        float(rgrid_mas[i50])
                        if i50 < len(rgrid_mas)
                        else float(rgrid_mas[-1])
                    )
                    samples_list[idx]["inst_psf"][bkey][skey] = {
                        "strehl_peak": sr_pk,
                        "fwhm_mas": fw_px * pix_mas,
                        "fwhm_ld": (fw_px * pix_mas) / ld_mas,
                        "ee50_radius_mas": r50,
                        "peak_adu": float(np.max(scube[idx] - 100.0)),
                        "adu_per_sr": adu_per_sr,
                    }

    stage1_info = load_loop_calib(work_dir, "ao3k", 1, out_dir, tmp_npys)
    stage2_info = load_loop_calib(work_dir, "scexao", 2, out_dir, tmp_npys)
    stage3_raw = load_loop_calib(
        work_dir, "llowfs", 3, out_dir, tmp_npys, phys_hz_override=500.0
    )
    has_stg3 = any(
        k in stage3_raw for k in ("n_cm_modes", "dm_rms_um", "mlat", "selfrm")
    )
    stage3_info = (
        {
            **stage3_raw,
            "enabled": enable_lowfs,
            "dm_grid": "50x50 (dm02disp04 ZPO)",
            "dm_pupil_diam_act": 46,
            "wfs_detector": "64x64",
            "wfs_band": (
                "H-band 1.65 um Lyot-Refl Defocused LLOWFS "
                "(18% BW, N=3ch, +200 nm Z4)"
            ),
            "phys_rate_hz": 500.0,
            "gain": gain3 if enable_lowfs else 0.0,
            "mult": mult3,
            "svdlim": stage3_raw.get("svdlim", svdlim3_env),
        }
        if has_stg3
        else None
    )

    ts_metrics = load_and_summarize_timeseries(out_dir, wf_metrics, tmp_npys)
    pred_info = load_predictive_control_metrics(out_dir, tmp_npys)
    calib_2wfs_info = load_calib_2wfs1dm_metrics(out_dir, work_dir, tmp_npys)
    coro_metrics = analyze_coronagraph_and_lowfs(
        out_dir,
        chrom_info,
        psf_metrics,
        stage2_info,
        stage3_info,
        tel_diam_m,
        tmp_npys,
    )

    nwf_tel = int(bcfg_parsed.get("nwf", 256))
    pup_dpix = float(bcfg_parsed.get("pup_diam_pix", 240.0))
    lowfs_mode_lbl = "LLOWFS Loop Closed" if enable_lowfs else "LLOWFS Loop Open"
    if pred_info is None:
        pred_mode_lbl = ""
    elif pred_info.get("pf_mode") == "eof":
        pred_mode_lbl = (
            f" + PSOL Block-EOF(B={pred_info.get('pf_blocksize', 128)}, "
            f"P={pred_info['pf_order']}) Predictive Control"
        )
    else:
        pred_mode_lbl = f" + PSOL AR({pred_info['pf_order']}) Predictive Control"
    c2d_mode_lbl = (
        " + 2-WFS/1-DM Telemetry Calib"
        if calib_2wfs_info is not None
        else ""
    )
    cfg_label = (
        f"Subaru {tel_diam_m:.2f}m AO3k + SCExAO + Lyot Coronagraph "
        f"({lowfs_mode_lbl}{pred_mode_lbl}{c2d_mode_lbl})"
        if coro_metrics is not None
        else f"Subaru {tel_diam_m:g}m AO3k + SCExAO "
        f"(Two-Stage Pyramid WFS{pred_mode_lbl}{c2d_mode_lbl})"
    )

    loops_dict = {
        "stage1_ao3k": {
            **stage1_info,
            "dm_grid": "64x64",
            "dm_pupil_diam_act": 60,
            "wfs_detector": "160x160",
            "wfs_band": "J-band 1.22 um PyWFS (20% BW, N=2ch, 160x160, mod 3.0 l0/D)",
            "phys_rate_hz": 1000.0,
            "gain": float(gain1),
            "mult": float(mult1),
            "mgain_alpha": mgain_alpha,
            "mgain_floor": mgain_floor,
            "mgain_tt_factor": mgain_tt,
        },
        "stage2_scexao": {
            **stage2_info,
            "dm_grid": "50x50",
            "dm_pupil_diam_act": 46,
            "wfs_detector": "120x120",
            "wfs_band": "Visible 0.75 um PyWFS (20% BW, N=2ch, 120x120, mod 3.0 l0/D)",
            "phys_rate_hz": 2000.0,
            "gain": float(gain2),
            "mult": float(mult2),
            "mgain_alpha": mgain_alpha,
            "mgain_floor": mgain_floor,
            "mgain_tt_factor": mgain_tt,
        },
    }
    if stage3_info is not None:
        loops_dict["stage3_llowfs"] = stage3_info

    summary = {
        "configuration": cfg_label,
        "telescope": {
            "pupil_geom": bcfg_parsed.get("pupil_geom", "subaru"),
            "diameter_m": tel_diam_m,
            "cobs": float(bcfg_parsed.get("cobs", 0.307)),
            "nspider": int(bcfg_parsed.get("nspider", 4)),
            "spider_w": float(bcfg_parsed.get("spider_w", 0.02314)),
            "spider_deg": float(bcfg_parsed.get("spider_deg", 51.75)),
            "spider_offset": float(bcfg_parsed.get("spider_offset", 0.08289)),
            "tput_tel": float(bcfg_parsed.get("tput_tel", 0.20)),
            "nwf": nwf_tel,
            "pup_diam_pix": pup_dpix,
            "pupil_scale_m_pix": tel_diam_m / max(pup_dpix, 1.0),
        },
        "star_and_atmosphere": {
            "star_mV": float(bcfg_parsed.get("star_mag", 6.0)),
            "star_mH": float(bcfg_parsed.get("star_mag", 6.0)),
            "star_teff_K": float(bcfg_parsed.get("star_teff", 9600.0)),
            "seeing_arcsec_500nm": float(seeing),
            "profile": "7-layer Maunakea (4.2..23.7 km, wind 6.5..22.0 m/s)",
            "physical_time_s": float(phys_time),
            "master_rate_phys_hz": 2000.0,
            "stage1_rate_phys_hz": 1000.0,
            "stage2_rate_phys_hz": 2000.0,
            "stage3_rate_phys_hz": 500.0 if stage3_info is not None else 0.0,
            "master_ticks_integrated": int(master_ticks),
            "wall_elapsed_s": float(wall_elapsed),
            "calibration_turbulence_gain": 0.0,
        },
        "loops": loops_dict,
        "psf_metrics": psf_metrics,
    }
    if coro_metrics is not None:
        summary["coronagraph_metrics"] = coro_metrics
    if wf_metrics is not None:
        summary["wavefront_metrics"] = wf_metrics
    if ts_metrics is not None:
        summary["timeseries_metrics"] = ts_metrics
    if pred_info is not None:
        summary["predictive_control"] = pred_info
    if calib_2wfs_info is not None:
        summary["calib_2wfs1dm"] = calib_2wfs_info

    if chrom_info is not None:
        summary["chromaticity"] = chrom_info
        t_b = chrom_info.get("timing", {})
        if t_b:
            summary["timing"] = t_b
            sa_blk = summary["star_and_atmosphere"]
            sa_blk["oversample"] = int(t_b["oversample"])
            sa_blk["internal_bench_hz"] = float(t_b["internal_bench_hz"])
            sa_blk["internal_dt_ms"] = float(t_b["internal_dt_ms"])
            sa_blk["internal_dt_us"] = float(t_b["internal_dt_us"])
            sa_blk["internal_subticks_integrated"] = (
                int(master_ticks) * int(t_b["oversample"])
            )

    vid_meta = ensure_telemetry_video(out_dir)
    if vid_meta is not None:
        summary["short_timescale_video"] = vid_meta

    summary["reproducibility"] = collect_reproducibility_info(
        out_dir, summary, bench_filename=bench_filename
    )

    summary_path = os.path.join(out_dir, "ao3k_scexao_metrics.json")
    with open(summary_path, "w", encoding="utf-8") as fh:
        json.dump(summary, fh, indent=2)
        fh.write("\n")

    render_plots_via_sys_python(out_dir, summary_path)
    write_ao_report_md(out_dir, summary, bench_filename=bench_filename)
    for npy_p in tmp_npys:
        if os.path.exists(npy_p):
            os.remove(npy_p)

    print(
        f"\n=== Subaru {tel_diam_m:.2f}m AO3k + SCExAO "
        f"{float(phys_time):.1f}s Performance Summary ==="
    )
    t_prt = summary.get("timing", {})
    if t_prt:
        print(
            f"  Internal Clock : {t_prt['internal_bench_hz']/1000:.1f} kHz "
            f"(dt = {t_prt['internal_dt_ms']:.3f} ms = {t_prt['internal_dt_us']:.0f} us), "
            f"{t_prt['oversample']} sub-samples per {t_prt['outer_dt_ms']:.2f} ms "
            f"({t_prt['outer_master_hz']/1000:.1f} kHz) outer tick"
        )
    for bkey, bcfg in BANDS.items():
        print(f"\n[{bcfg['label']}]")
        for skey, slabel in STAGES:
            m = psf_metrics[bkey][skey]
            print(
                f"  {slabel:<28s}: Strehl={m['strehl_peak']*100:6.2f}% "
                f"(axis={m['strehl_axis']*100:6.2f}%), "
                f"FWHM={m['fwhm_mas']:6.2f} mas ({m['fwhm_ld']:4.2f} l/D), "
                f"EE(1.22 l/D)={m['ee_1p22ld']*100:5.1f}%, "
                f"r50={m['ee50_radius_mas']:5.1f} mas"
            )

    if coro_metrics is not None:
        ly_p = coro_metrics["lyot_stop"]
        lo_p = coro_metrics["llowfs"]
        cl_p = coro_metrics["closed_loop"]
        print(
            f"\n[H-Band Lyot Coronagraph (R={coro_metrics['spot_radius_ld']:.1f} l/D) & "
            f"Reflective-Lyot LLOWFS]"
        )
        print(
            f"  Lyot Stop      : outer={ly_p['outer']:.2f}, obs={ly_p['obs']:.2f}, "
            f"T_Lyot={ly_p['intensity_throughput']*100:.1f}%, "
            f"eta_planet={ly_p['planet_peak_throughput']*100:.1f}%"
        )
        print(
            f"  LLOWFS (aol3)  : {'CLOSED' if lo_p['enabled_closed_loop'] else 'OPEN'} "
            f"({lo_p['n_zernike_modes']} Zernikes @ {lo_p['rate_hz']:.0f} Hz, "
            f"+{lo_p['defocus_nm']:.0f} nm Z4), "
            f"dmC_RMS={lo_p['dm3_stroke_rms_nm']:.1f} nm, "
            f"ZPO_WFS={lo_p['stg2_zpo_wfs_rms']*1e4:.2f}e-4"
        )
        lb_p = coro_metrics.get("lowfs_light_budget") or {}
        bdl_p = lb_p.get("diffraction_limited") or {}
        bcl_p = lb_p.get("closed_loop") or {}
        if bdl_p and bcl_p:
            print(
                f"  Pre-Lyot Light : DL={bdl_p['frac_coro_in_incident_on_lyot']*100:.2f}% coro-in "
                f"(FPM abs {bdl_p['frac_coro_in_fpm_absorbed']*100:.2f}%), "
                f"CL={bcl_p['frac_coro_in_incident_on_lyot']*100:.2f}% coro-in "
                f"(FPM abs {bcl_p['frac_coro_in_fpm_absorbed']*100:.2f}%)"
            )
            print(
                f"  LOWFS Cam Light: CL={bcl_p['frac_coro_in_reaching_lowfs_cam_fov']*100:.2f}% "
                f"coro-in ({bcl_p['frac_entrance_pup_h_reaching_lowfs_cam_fov']*100:.2f}% H-pup, "
                f"{bcl_p['frac_sky_h_reaching_lowfs_cam_fov']*100:.2f}% Sky-H, "
                f"{bcl_p['frac_entrance_broadband_reaching_lowfs_cam_fov']*100:.2f}% 0.4-2.4um) | "
                f"DL={bdl_p['frac_coro_in_reaching_lowfs_cam_fov']*100:.2f}% coro-in"
            )
            print(
                f"  LOWFS Cam Flux : {bcl_p['lowfs_cam_incident_ph_per_frame']:.2e} ph/fr "
                f"({bcl_p['lowfs_cam_detected_phe_per_frame']:.2e} e-/fr @ "
                f"QE={lb_p['lowfs_qe']*100:.0f}%, {lo_p['rate_hz']:.0f} Hz)"
            )
        for row in coro_metrics["contrast_table"]:
            print(
                f"  r = {row['sep_ld']:4.0f} l/D ({row['sep_mas']:4.0f} mas): "
                f"CL_Raw={row['cl_raw_contrast']:.2e}, "
                f"CL_Planet={row['cl_planet_contrast']:.2e}, "
                f"5sig_Planet={row['cl_5sigma_planet_contrast']:.2e}, "
                f"Supp={row['coro_suppression_factor']:5.1f}x"
            )

    if wf_metrics is not None:
        print(
            f"\n[Wavefront OPD Telemetry ({wf_metrics['n_frames']} frames, "
            f"{wf_metrics['phys_time_recorded_s']:.2f} s)]"
        )
        for k in ("raw", "stg1", "final"):
            lm = wf_metrics["locations"][k]
            print(
                f"  {lm['label']:<36s}: "
                f"TotRMS={lm['quad_total_rms_nm']:6.1f} nm "
                f"(MeanMapRMS={lm['mean_map_rms_nm']:5.1f} nm, "
                f"StdMapRMS={lm['std_map_rms_nm']:6.1f} nm)"
            )

    loop_print_list = [
        ("Stage 1 (AO3k)", stage1_info),
        ("Stage 2 (SCExAO)", stage2_info),
    ]
    if stage3_info is not None:
        loop_print_list.append(("Stage 3 (LLOWFS)", stage3_info))

    if any(sinf.get("mlat") for _, sinf in loop_print_list):
        print("\n[Hardware Latency (mlat) & RM Timing]")
        for tag, sinf in loop_print_list:
            ml = sinf.get("mlat")
            if ml:
                fit = ml["fit"]
                print(
                    f"  {tag:<18s}: mlat={ml['latency_fr']:.3f} fr "
                    f"({ml['latency_phys_ms']:.2f} ms phys), "
                    f"GaussFit={fit['tau_fit_fr']:.3f}+/-{fit['tau_err_fr']:.3f} fr "
                    f"(FWHM={fit['fwhm_fit_fr']:.2f} fr, R2={fit['r2']:.2f}), "
                    f"RMdelayfr={ml['rm_delay_fr']} (+{ml['rm_subframe_wait_fr']:.2f} fr)"
                )

    if any(sinf.get("selfrm") for _, sinf in loop_print_list):
        print("\n[Modal Self-Response Matrix (selfRM) — Calibration vs On-Sky]")
        for tag, sinf in loop_print_list:
            sr = sinf.get("selfrm")
            if sr:
                print(
                    f"  {tag:<18s}: N={sr['n_modes_probed']:3d} | "
                    f"Calib Diag={sr['cal_diag_mean']:.3f}+/-{sr['cal_diag_std']:.3f} "
                    f"(OffRMS={sr['cal_offdiag_rms']:.4f}) | "
                    f"OnSky Diag={sr['sky_og_mean']:.3f}, "
                    f"g_opt(OnSky/Cal)={sr['sky_og_ratio_mean']:.3f} "
                    f"[TT={sr['sky_ratio_tt']:.3f}, Low={sr['sky_ratio_low']:.3f}, "
                    f"High={sr['sky_ratio_high']:.3f}] "
                    f"(OffRMS={sr['sky_offdiag_rms']:.4f})"
                )


if __name__ == "__main__":
    main()
