        f"(Spot R = {spot_ld:.1f} λ/D = {coro_m['spot_iwa_mas']:.0f} mas, "
        f"Lyot Outer/Obs = {ly['outer']:.2f}/{ly['obs']:.2f}, "
        f"LLOWFS Defocus = {lo['defocus_nm']:.0f} nm RMS Z4 @ {lo['rate_hz']:.0f} Hz)",
