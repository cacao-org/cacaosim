with open(summary_path, "r", encoding="utf-8") as fh:
    data = json.load(fh)

stages = [
    ("raw", "Uncorrected (0.6\" Seeing)"),
    ("stg1", "After Stage 1 (AO3k NIR PyWFS)"),
    ("final", "Final Stage 1+2 (AO3k + SCExAO)"),
]
bands = [
    ("vis", "Visible I-Band (0.75 µm, 15% BW, 3ch)", 0.72),
    ("nir", "Near-IR H-Band (1.65 µm, 18% BW, 3ch)", 1.50),
]

fig, axes = plt.subplots(2, 3, figsize=(14.5, 9.2), constrained_layout=True)
