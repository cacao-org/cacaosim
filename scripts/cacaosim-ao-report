    for col_i, skey, slab, col_c in wf_specs:
        y = wf_arr[:, col_i]
        m = wf_stat.get(skey, {})
        lbl = (
            f"{slab}: mean={m.get('mean_nm', 0):.1f}, med={m.get('median_nm', 0):.1f}, "
