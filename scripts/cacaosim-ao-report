                f"`{stp.get('wfsfact', 1.0):.3f}` | "
                f"`{stp.get('n_updates', 0)}` (`{stp.get('n_samples', 0)}`) | "
                f"`{stp.get('rms_ol', 0):.4f}` / `{stp.get('rms_zoh', 0):.4f}` / "
