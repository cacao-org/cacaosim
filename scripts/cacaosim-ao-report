def ensure_gui_screenshots(work_dir, out_dir):
    bench_cands = []
    if os.path.isdir(out_dir):
        local_benches = sorted(
            f for f in os.listdir(out_dir) if f.endswith(".bench")
        )
        for fb in local_benches:
            if fb != "csim_active.bench":
                bench_cands.append(os.path.join(out_dir, fb))
        for fb in local_benches:
            if fb == "csim_active.bench":
                bench_cands.append(os.path.join(out_dir, fb))

    env_bench = os.environ.get("CACAOSIM_BENCH_FILE", "")
    if env_bench:
        bench_cands.append(env_bench)
    shm_dir = os.environ.get("MILK_SHM_DIR", "")
    if shm_dir and shm_dir != "/milk/shm":
        bench_cands.append(os.path.join(shm_dir, "csim_active.bench"))
    if work_dir:
        bench_cands.append(os.path.join(work_dir, "csim", "csim_active.bench"))

    cacao_root = os.environ.get("CACAO_WORK_ROOT", "")
    if cacao_root:
        bench_cands.append(
            os.path.join(cacao_root, "benches", "ao3k_scexao", "ao3k_scexao.bench")
        )
    cur = os.path.abspath(out_dir)
    for _ in range(4):
        cand = os.path.join(cur, "benches", "ao3k_scexao", "ao3k_scexao.bench")
        bench_cands.append(cand)
        parent = os.path.dirname(cur)
        if parent == cur:
            break
        cur = parent

    src_bench = next((p for p in bench_cands if p and os.path.isfile(p)), None)
    if src_bench is None:
        return None

    base_name = os.path.basename(src_bench)
    if base_name == "csim_active.bench":
        base_name = "ao3k_scexao.bench"
    staged_bench = os.path.join(out_dir, base_name)
    if os.path.abspath(src_bench) != os.path.abspath(staged_bench):
        if not os.path.isfile(staged_bench):
            shutil.copy2(src_bench, staged_bench)

    script_dir = os.path.dirname(os.path.abspath(__file__))
    shot_cands = [
        shutil.which("cacaosim-gui-screenshot") or "",
        os.path.join(script_dir, "cacaosim-gui-screenshot"),
        os.path.join(
            os.environ.get("MILK_INSTALL_ROOT", ""), "bin", "cacaosim-gui-screenshot"
        ),
        os.path.join(os.environ.get("MILK_ROOT", ""), "bin", "cacaosim-gui-screenshot"),
    ]
    shot_bin = next(
        (p for p in shot_cands if p and os.path.isfile(p) and os.access(p, os.X_OK)),
        None,
    )
    if shot_bin is not None:
        try:
            subprocess.run(
                [
                    sys.executable,
                    shot_bin,
                    "--outdir",
                    out_dir,
                    "--keep-existing",
                    staged_bench,
                ],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
        except OSError:
            pass
    return os.path.basename(staged_bench)


def ensure_telemetry_video(out_dir):
    tlm_cands = [
        os.environ.get("CACAOSIM_TELEMETRY_DIR", ""),
        os.path.join(out_dir, "telemetry"),
    ]
    tlm_dir = next(
        (
            d
            for d in tlm_cands
            if d
            and os.path.isdir(d)
            and glob.glob(os.path.join(d, "csim_wfs_vis_*.fits*"))
            and glob.glob(os.path.join(d, "psf_vis_final_*.fits*"))
        ),
        None,
    )
    mp4_path = os.path.join(out_dir, "wfs_psf_short_evolution.mp4")
    meta_cache = os.path.join(out_dir, "wfs_psf_short_evolution_meta.json")

    if tlm_dir is not None:
        script_dir = os.path.dirname(os.path.abspath(__file__))
        vid_cands = [
            shutil.which("cacaosim-telemetry-video") or "",
            os.path.join(script_dir, "cacaosim-telemetry-video"),
            os.path.join(
                os.environ.get("MILK_INSTALL_ROOT", ""), "bin", "cacaosim-telemetry-video"
            ),
            os.path.join(
                os.environ.get("MILK_ROOT", ""), "bin", "cacaosim-telemetry-video"
            ),
        ]
        vid_bin = next(
            (p for p in vid_cands if p and os.path.isfile(p)),
            None,
        )
        if vid_bin is not None:
            try:
                subprocess.run(
                    [
                        sys.executable,
                        vid_bin,
                        "--telemetry-dir",
                        tlm_dir,
                        "--report-dir",
                        out_dir,
                        "--out",
                        mp4_path,
                        "--meta-out",
                        meta_cache,
                    ],
                    check=True,
                )
            except (OSError, subprocess.CalledProcessError) as exc:
                print(
                    f"[cacaosim-ao-report] Warning: telemetry video render failed: {exc}",
                    file=sys.stderr,
                )

    if os.path.isfile(mp4_path) and os.path.isfile(meta_cache):
        try:
            with open(meta_cache, "r", encoding="utf-8") as fh:
                return json.load(fh)
        except (OSError, json.JSONDecodeError):
            pass
    if os.path.isfile(mp4_path):
        return {
            "video_file": "wfs_psf_short_evolution.mp4",
            "size_bytes": int(os.path.getsize(mp4_path)),
        }
    return None


def write_ao_report_md(out_dir, s, bench_filename=None):
    tel = s.get("telescope", {})
    sa = s.get("star_and_atmosphere", {})
    lps = s.get("loops", {})
    l1 = lps.get("stage1_ao3k", {})
    l2 = lps.get("stage2_scexao", {})
    pm = s.get("psf_metrics", {})
    wm = s.get("wavefront_metrics")

    chrom = s.get("chromaticity", {})
    tinfo = s.get("timing") or chrom.get("timing", {})
    outer_hz = float(tinfo.get("outer_master_hz", sa.get("master_rate_phys_hz", 2000.0)))
    outer_khz = outer_hz / 1000.0
    outer_dt_ms = float(tinfo.get("outer_dt_ms", 1000.0 / max(outer_hz, 1.0)))
    ov_k = max(1, int(tinfo.get("oversample", sa.get("oversample", 4))))
    int_hz = float(tinfo.get("internal_bench_hz", outer_hz * ov_k))
    int_khz = int_hz / 1000.0
    int_dt_ms = float(tinfo.get("internal_dt_ms", 1000.0 / max(int_hz, 1.0)))
    int_dt_us = float(tinfo.get("internal_dt_us", 1.0e6 / max(int_hz, 1.0)))
    n_outer_ticks = int(sa.get("master_ticks_integrated", 0))
    n_sub_ticks = n_outer_ticks * ov_k

    lines = [
        f"# AO Optical & Control Report: {s.get('configuration', 'AO3k + SCExAO')}",
        "",
        f"- **Seeing**: `{sa.get('seeing_arcsec_500nm', 0):.2f}\"` at 0.50 um | "
        f"**Star**: mV={sa.get('star_mV', 6):.1f}, mH={sa.get('star_mH', 6):.1f}",
        f"- **Internal Optical-Bench Clock**: **`{int_khz:.1f} kHz` "
        f"(`dt = {int_dt_ms:.3f} ms = {int_dt_us:.0f} us`), i.e., "
        f"`{ov_k}` sub-samples per `{outer_dt_ms:.2f} ms` (`{outer_khz:.1f} kHz`) outer tick**",
        f"- **Integration**: `{sa.get('physical_time_s', 0):.2f} s` physical "
        f"(`{n_outer_ticks}` outer ticks @ `{outer_khz:.1f} kHz` = "
        f"`{n_sub_ticks}` internal sub-ticks @ `{int_khz:.1f} kHz`, "
        f"`{sa.get('wall_elapsed_s', 0):.2f} s` wall-clock)",
        f"- **Stage 1 (AO3k)**: `{l1.get('dm_grid', '64x64')}` DM (D="
        f"{l1.get('dm_pupil_diam_act', 60)}), `{l1.get('wfs_detector', '160x160')}` "
        f"polychromatic J-band PyWFS (`1.22 um, 20% BW, N=2ch, /{2*ov_k} sub-ticks`), "
        f"`{l1.get('n_cm_modes', 0)}` CM modes",
        f"- **Stage 2 (SCExAO)**: `{l2.get('dm_grid', '50x50')}` DM (D="
        f"{l2.get('dm_pupil_diam_act', 46)}), `{l2.get('wfs_detector', '120x120')}` "
        f"polychromatic Vis PyWFS (`0.75 um, 20% BW, N=2ch, /{ov_k} sub-ticks`), "
        f"`{l2.get('n_cm_modes', 0)}` CM modes",
        "- **Science Cameras**: Polychromatic Soummer-MFT PSFs in Visible I-band "
        "(`0.75 um, 15% BW, N=3ch`) & Near-IR H-band (`1.65 um, 18% BW, N=3ch`) with "
        "focal `lambda/D` scaling",
        "",
        "> Companion systems & optimization report: [COMPUTE_REPORT.md](COMPUTE_REPORT.md)",
    ]

    schem_png = os.path.join(out_dir, "cacaosim_gui_schematic.png")
    has_extra_gui = any(
        os.path.isfile(os.path.join(out_dir, fn))
        for fn in (
            "cacaosim_gui_builder.png",
            "cacaosim_gui_tables.png",
            "cacaosim_gui_status.png",
        )
    )
    if os.path.isfile(schem_png) or bench_filename:
        lines.extend(["", "## Optical Bench & Hardware Configuration (`cacaosim-CTRL`)", ""])
        if bench_filename and os.path.isfile(os.path.join(out_dir, bench_filename)):
            nwf_v = tel.get("nwf", 256)
            diam_v = tel.get("diameter_m", 8.2)
            cobs_pct = tel.get("cobs", 0.30) * 100.0
            pscale_v = tel.get("pupil_scale_m_pix", 8.2 / 240.0)
            lines.append(
                f"- **Declarative Bench**: [{bench_filename}]({bench_filename}) "
                f"(`{nwf_v}x{nwf_v}` grid, `D = {diam_v:.2f} m`, "
                f"`cobs = {cobs_pct:.0f}%`, `{pscale_v:.4f} m/pix`, "
                f"`{outer_khz:.1f} kHz` outer `x{ov_k}` = "
                f"`{int_khz:.1f} kHz` / `{int_dt_us:.0f} us` internal)"
            )
        lines.append(
            f"- **Optical Relay**: Entrance pupil (`b_pup`) -> Stage-1 AO3k "
            f"`{l1.get('dm_grid', '64x64')}` DM (`dm01disp`) -> `1.22 um` J-band dichroic "
            f"(`R` -> `{l1.get('wfs_detector', '160x160')}` NIR PyWFS @ `1 kHz`; `T` -> Stage-2) "
            f"-> Stage-2 SCExAO `{l2.get('dm_grid', '50x50')}` DM (`dm02disp`) -> `1.00 um` LP "
            f"dichroic (`T` -> `1.65 um` H-band camera; `R` -> `90/10` Vis splitter -> "
            f"`{l2.get('wfs_detector', '120x120')}` Vis PyWFS @ `2 kHz` + `0.75 um` Vis camera)"
        )
        if has_extra_gui:
            lines.append(
                "- **Interactive Simulator Views**: Builder inspector, hardware audit tables, "
                "and live SHM telemetry in "
                "[Hardware Simulator GUI (`cacaosim-CTRL`)](#hardware-simulator-gui-cacaosim-ctrl)"
            )
        if os.path.isfile(schem_png):
            lines.extend(
                [
                    "",
                    "![cacaosim-CTRL 2D Optical Bench Schematic, Entrance Pupil & "
                    "32-Bin Polychromatic Spectra (F3:SCHEMATIC)](cacaosim_gui_schematic.png)",
                ]
            )

    dms_t = tinfo.get("dms", [])
    dm1_t = next((d for d in dms_t if d["id"] == "ao3k"), dms_t[0] if dms_t else None)
    dm2_t = next((d for d in dms_t if d["id"] == "scexao"), dms_t[1] if len(dms_t) > 1 else None)
    dm1_note = (
        f"delay `{dm1_t['delay_us']:.0f} us` (`{dm1_t['delay_subticks']:.0f}` sub-ticks), "
        f"RC `tau = {dm1_t['tau_us']:.0f} us`"
        if dm1_t
        else f"stepped every `{int_dt_us:.0f} us` sub-tick"
    )
    dm2_note = (
        f"delay `{dm2_t['delay_us']:.0f} us` (`{dm2_t['delay_subticks']:.0f}` sub-ticks), "
        f"RC `tau = {dm2_t['tau_us']:.0f} us`"
        if dm2_t
        else f"stepped every `{int_dt_us:.0f} us` sub-tick"
    )
    wf_nfr = (
        int(wm["n_frames"])
        if wm and "n_frames" in wm
        else int(sa.get("physical_time_s", 10) * outer_hz)
    )
    lines.extend(
        [
            "",
            f"### Internal Multi-Rate Timing & Sub-Stepping "
            f"(`{int_khz:.1f} kHz` / `{int_dt_us:.0f} us`)",
            "",
            f"> **Internal Timing Architecture**: The fused GPU optical bench (`csim_htsim`) "
            f"ran at **`{int_khz:.1f} kHz` (`dt = {int_dt_ms:.3f} ms = {int_dt_us:.0f} us`)**, "
            f"i.e., **`{ov_k}` sub-samples per `{outer_dt_ms:.2f} ms` "
            f"(`{outer_khz:.1f} kHz`) outer tick** (`master_hz = {outer_hz:.0f}`, "
            f"`oversample = {ov_k}`).",
            "",
            "| Component | Physical Rate | Sub-Tick Cadence | Sub-Step Integration & Physics |",
            "| :--- | :--- | :---: | :--- |",
            f"| **Internal Bench Clock (`htsim`)** | `{int_khz:.1f} kHz` (`{int_dt_ms:.3f} ms`) | "
            f"`1` (`{int_dt_us:.0f} us`) | `{ov_k}` sub-samples per `{outer_dt_ms:.2f} ms` "
            f"(`{outer_khz:.1f} kHz`) outer tick |",
            f"| **Turbulence (`atmturb` + `htsim`)** | "
            f"`{outer_khz:.1f} kHz` (`{outer_dt_ms:.2f} ms`) | `{1}:{ov_k}` lockstep | "
            f"New screen every `{outer_dt_ms:.2f} ms`, GPU-interpolated across "
            f"`{ov_k}` sub-ticks |",
            f"| **Stage-1 DM (`dm.ao3k`)** | `{int_khz:.1f} kHz` (`{int_dt_us:.0f} us`) | "
            f"every sub-tick | Servo & FIFO stepped at `{int_khz:.1f} kHz`: {dm1_note} |",
            f"| **Stage-2 DM (`dm.scexao`)** | `{int_khz:.1f} kHz` (`{int_dt_us:.0f} us`) | "
            f"every sub-tick | Servo & FIFO stepped at `{int_khz:.1f} kHz`: {dm2_note} |",
            f"| **Stage-2 Vis PyWFS (`wfs_vis`)** | `2.0 kHz` (`0.50 ms`) | "
            f"`2000 (/{ov_k})` | Propagated every sub-tick (`stride = 1`): `{ov_k}` sub-samples "
            "`x 2ch x 16` pts |",
            f"| **Stage-1 NIR PyWFS (`wfs_nir`)** | `1.0 kHz` (`1.00 ms`) | "
            f"`1000 (/{2*ov_k})` | Propagated every sub-tick (`stride = 1`): "
            f"`{2*ov_k}` sub-samples `x 2ch x 16` pts |",
            f"| **Science Cameras (`fpcam.*`, 6x)** | `100 Hz` (`10.0 ms`) | "
            f"`100 (/{20*ov_k})` | `stride = {ov_k}` (staggered `0..{ov_k-1}`): `20` evals "
            f"(`{outer_khz:.1f} kHz`) `x 3ch` / frame |",
            f"| **Wavefront OPD Stats (`wfstat`)** | "
            f"`{outer_khz:.1f} kHz` (`{outer_dt_ms:.2f} ms`) | every `{ov_k}` sub-ticks | "
            f"Sampled once per `{outer_dt_ms:.2f} ms` outer tick "
            f"(`{wf_nfr}` frames in `{sa.get('physical_time_s', 10):.1f} s`) |",
        ]
    )

    if chrom and chrom.get("sensors"):
        lines.extend(
            [
                "",
                "## Polychromatic Passbands, Sub-Band Sampling & Flux Scaling",
                "",
                "| Sensor (`out_cam`) | Beam | Bandpass [um] (`dL/L0`) | Slices `N` | "
                "Sub-Band `lambda_c` [um] (`w_c`) | Focal `L0/Lc` Scale | "
                "Rate [Hz] (/Sub) | Flux [ph/fr] |",
                "| :--- | :--- | :---: | ---: | :--- | :---: | :---: | ---: |",
            ]
        )
        for sn in chrom["sensors"]:
            ch_desc = ", ".join(
                f"{lc:.3f} ({w * 100:.0f}%)"
                for lc, w in zip(sn["chan_lam_um"], sn["chan_weight"])
            )
            fsc = sn["focal_scale_lam0_over_lam"]
            sc_desc = (
                f"{fsc[0]:.3f}x"
                if len(fsc) == 1
                else f"{min(fsc):.3f}..{max(fsc):.3f}x"
            )
            nsub_s = int(sn.get("navg_subticks", max(1, round(int_hz / max(sn["rate_hz"], 0.1)))))
            rate_desc = f"{sn['rate_hz']:.0f} (/{nsub_s})"
            lines.append(
                f"| `{sn['id']}` (`{sn['out_cam']}`) | `{sn['in_beam']}` | "
                f"{sn['lambda_min_um']:.3f}-{sn['lambda_max_um']:.3f} "
                f"(`{sn['bw_frac']*100:.0f}%`) | {sn['eff_nlam']} | {ch_desc} | "
                f"{sc_desc} | {rate_desc} | {sn['flux_ph_per_frame']:.2e} |"
            )
        chrom_png = os.path.join(out_dir, "chromatic_passbands_2x1.png")
        if os.path.isfile(chrom_png):
            lines.extend(
                [
                    "",
                    "![Optical Bench 32-Bin Spectra & Polychromatic Sensor Sub-Band "
                    "Sampling (2x1)](chromatic_passbands_2x1.png)",
                ]
            )

    lines.extend(
        [
            "",
            "## Long-Exposure PSF Summary",
            "",
            "| Band | Stage | Strehl Peak | FWHM [mas] | FWHM [l/D] | EE(1.22 l/D) | r50 [mas] |",
            "| :--- | :--- | ---: | ---: | ---: | ---: | ---: |",
        ]
    )
    for bkey, bcfg in BANDS.items():
        bm = pm.get(bkey, {})
        for skey, slabel in STAGES:
            m = bm.get(skey)
            if not m:
                continue
            lines.append(
                f"| {bcfg['label']} | {slabel} | {m['strehl_peak']*100:.2f}% | "
                f"{m['fwhm_mas']:.2f} | {m['fwhm_ld']:.2f} | {m['ee_1p22ld']*100:.1f}% | "
                f"{m['ee50_radius_mas']:.1f} |"
            )

    if wm and wm.get("locations"):
        lines.extend(
            [
                "",
                f"## Wavefront OPD Statistics ({wm.get('n_frames', 0)} frames, "
                f"{wm.get('phys_time_recorded_s', 0):.2f} s)",
                "",
                "| Optical Plane | Total RMS [nm] | Mean Map RMS [nm] | Temporal Std RMS [nm] | "
                "Marechal SR (750 nm / 1.65 um) |",
                "| :--- | ---: | ---: | ---: | :---: |",
            ]
        )
        for k in ("raw", "stg1", "final"):
            loc = wm["locations"].get(k)
            if loc:
                lines.append(
                    f"| {loc['label']} | {loc['quad_total_rms_nm']:.1f} | "
                    f"{loc['mean_map_rms_nm']:.1f} | {loc['std_map_rms_nm']:.1f} | "
                    f"{loc['marechal_sr_vis_750nm']*100:.1f}% / "
                    f"{loc['marechal_sr_nir_1650nm']*100:.1f}% |"
                )

    tsm = s.get("timeseries_metrics")
    samples = wm.get("samples", []) if wm else []
    if tsm or samples:
        wf_ts = tsm.get("wf_rms_nm", {}) if tsm else {}
        sr_ts = tsm.get("strehl", {}) if tsm else {}
        if wf_ts or sr_ts or samples:
            lines.extend(["", "## Temporal Evolution Summary"])
        if wf_ts:
            lines.extend(
                [
                    "",
                    "### Pupil RMS Wavefront Error vs Time",
                    "",
                    "| Optical Plane | Frames | Mean [nm] | Median [nm] | Std [nm] | "
                    "P05-P95 [nm] | Min-Max [nm] |",
                    "| :--- | ---: | ---: | ---: | ---: | :---: | :---: |",
                ]
            )
            loc_labels = {
                "raw": "Before Stage 1 (Entrance Pupil)",
                "stg1": "Between Stages 1 & 2 (Post-AO3k)",
                "final": "After Stage 2 (Post-SCExAO)",
            }
            for k in ("raw", "stg1", "final"):
                m = wf_ts.get(k)
                if m:
                    lines.append(
                        f"| {loc_labels[k]} | {m['n_frames']} | {m['mean_nm']:.1f} | "
                        f"{m['median_nm']:.1f} | {m['std_nm']:.1f} | "
                        f"{m['p05_nm']:.1f}-{m['p95_nm']:.1f} | "
                        f"{m['min_nm']:.1f}-{m['max_nm']:.1f} |"
                    )
        if sr_ts:
            lines.extend(
                [
                    "",
                    "### Optical Strehl Ratio vs Time",
                    "",
                    "| Band | Stage | Exposures | Mean Short SR | Median Short SR | "
                    "P05-P95 Short SR | Final Long SR |",
                    "| :--- | :--- | ---: | ---: | ---: | :---: | ---: |",
                ]
            )
            for bkey, bcfg in BANDS.items():
                bsr = sr_ts.get(bkey, {})
                for skey, slabel in STAGES[1:]:
                    m = bsr.get(skey)
                    if m:
                        lines.append(
                            f"| {bcfg['label']} | {slabel} | {m['n_exposures']} | "
                            f"{m['inst_mean']*100:.2f}% | {m['inst_median']*100:.2f}% | "
                            f"{m['inst_p05']*100:.2f}%-{m['inst_p95']*100:.2f}% | "
                            f"{m['long_final']*100:.2f}% |"
                        )
        if samples:
            lines.extend(
                [
                    "",
                    f"### Sampled Snapshot Instants (S1-S{len(samples)})",
                    "",
                    "| Sample | Time [s] | Frame | Raw WFE [nm] | Stg1 WFE [nm] | "
                    "Final WFE [nm] | DM1 / DM2 OPD [nm] | "
                    "Vis Short SR (Stg1 / Final) | NIR Short SR (Stg1 / Final) |",
                    "| :---: | ---: | ---: | ---: | ---: | ---: | "
                    ":---: | :---: | :---: |",
                ]
            )
            for idx_s, sm in enumerate(samples):
                ex = sm.get("extra", {})
                dm1_opd = ex.get("dm_opd_stg1", {}).get("rms_nm")
                dm2_opd = ex.get("dm_opd_stg2", {}).get("rms_nm")
                if dm1_opd is not None and dm2_opd is not None:
                    dm_str = f"{dm1_opd:.1f} / {dm2_opd:.1f}"
                else:
                    dm_str = "-"
                ip = sm.get("inst_psf", {})
                v1 = ip.get("vis", {}).get("stg1", {}).get("strehl_peak")
                vf = ip.get("vis", {}).get("final", {}).get("strehl_peak")
                vs_str = (
                    f"{v1 * 100:.1f}% / {vf * 100:.1f}%"
                    if v1 is not None and vf is not None
                    else "-"
                )
                n1 = ip.get("nir", {}).get("stg1", {}).get("strehl_peak")
                nf = ip.get("nir", {}).get("final", {}).get("strehl_peak")
                ns_str = (
                    f"{n1 * 100:.1f}% / {nf * 100:.1f}%"
                    if n1 is not None and nf is not None
                    else "-"
                )
                raw_w = sm.get("raw", {}).get("rms_nm", 0.0)
                s1_w = sm.get("stg1", {}).get("rms_nm", 0.0)
                fn_w = sm.get("final", {}).get("rms_nm", 0.0)
                lines.append(
                    f"| S{idx_s + 1} | {sm.get('t_phys_s', 0.0):.2f} | "
                    f"{sm.get('frame', 0)} | {raw_w:.1f} | {s1_w:.1f} | "
                    f"{fn_w:.1f} | {dm_str} | {vs_str} | {ns_str} |"
                )
        csv_links = []
        for cname in ("wf_timeseries.csv", "strehl_timeseries.csv"):
            if os.path.isfile(os.path.join(out_dir, cname)):
                csv_links.append(f"[{cname}]({cname})")
        if csv_links:
            lines.extend(["", f"- Time-series CSVs: {', '.join(csv_links)}"])

    vid_meta = s.get("short_timescale_video")
    vid_fname = (
        vid_meta.get("video_file", "wfs_psf_short_evolution.mp4")
        if isinstance(vid_meta, dict)
        else "wfs_psf_short_evolution.mp4"
    )
    if os.path.isfile(os.path.join(out_dir, vid_fname)):
        lines.extend(["", "### Short-Timescale WFS & PSF Evolution (Video)", ""])
        if isinstance(vid_meta, dict) and "t_start_s" in vid_meta and "n_frames" in vid_meta:
            vt0 = float(vid_meta["t_start_s"])
            vt1 = float(vid_meta["t_end_s"])
            vdur = float(vid_meta["duration_ms"])
            vnfr = int(vid_meta["n_frames"])
            vdt = float(vid_meta["dt_step_ms"])
            vfps = int(vid_meta["fps"])
            vslow = float(vid_meta["slowdown_factor"])
            vp_s1 = float(vid_meta.get("psf_stg1_rate_hz", 2000.0))
            vp_fn = float(vid_meta.get("psf_final_rate_hz", 2000.0))
            vsub = vnfr * ov_k
            psf_cad_str = (
                f"`{vp_fn/1e3:.1f} kHz` (`{1e3/max(vp_fn, 1.0):.2f} ms` speckle)"
                if vp_fn >= 500.0
                else f"`{vp_fn:.0f} Hz` (`{1e3/max(vp_fn, 1.0):.1f} ms` short-exposure)"
            )
            stg1_note = (
                ""
                if abs(vp_s1 - vp_fn) < 1.0
                else f" (Post-AO3k at `{vp_s1:.0f} Hz`)"
            )
            lines.extend(
                [
                    f"- **Physical Window**: `t = {vt0:.4f} .. {vt1:.4f} s` "
                    f"(`{vdur:.1f} ms` span, `{vnfr}` frames @ `{vdt:.2f} ms` / "
                    f"`{outer_khz:.1f} kHz` outer tick = `{vsub}` internal sub-ticks @ "
                    f"`{int_khz:.1f} kHz` / `{int_dt_us:.0f} us`), "
                    "shaded in green on the time-series figure below",
                    f"- **Synchronized Streams**: Stage-1 AO3k J-band PyWFS "
                    f"(`1.0 kHz`, raw + `imWFS2`) + Stage-2 SCExAO Vis PyWFS "
                    f"(`2.0 kHz`, raw + `imWFS2`) + Post-AO3k & Final Vis (`0.75 um`) / "
                    f"H-band (`1.65 um`) PSFs at {psf_cad_str}{stg1_note}",
                    f"- **Playback**: `{vfps} fps` "
                    f"(`{vid_meta.get('playback_duration_s', 0):.1f} s` loop, "
                    f"**`{vslow:.1f}x` slow-motion**) | Mean clip Strehl: "
                    f"Vis Final `{vid_meta.get('vis_final_sr_mean_pct', 0):.1f}%` "
                    f"(`{vid_meta.get('vis_final_sr_min_pct', 0):.1f}%.."
                    f"{vid_meta.get('vis_final_sr_max_pct', 0):.1f}%`), "
                    f"H Final `{vid_meta.get('nir_final_sr_mean_pct', 0):.1f}%` "
                    f"(`{vid_meta.get('nir_final_sr_min_pct', 0):.1f}%.."
                    f"{vid_meta.get('nir_final_sr_max_pct', 0):.1f}%`)",
                    "",
                    f"![Short-Timescale PyWFS & Speckle PSF Evolution "
                    f"(t = {vt0:.2f}..{vt1:.2f} s, {vdur:.0f} ms @ {outer_khz:.1f} kHz / "
                    f"{int_khz:.1f} kHz Sub-Tick, {vslow:.1f}x Slow-Motion)]({vid_fname})",
                ]
            )
        else:
            lines.append(
                f"![Short-Timescale PyWFS & Speckle PSF Evolution]({vid_fname})"
            )

    snap_title = (
        f"Time-Series & Sampled Instant Snapshots (S1-S{len(samples)})"
        if samples
        else "Time-Series Telemetry"
    )
    fig_sections = [
        (
            "Hardware Simulator GUI (cacaosim-CTRL)",
            [
                (
                    "cacaosim-CTRL 3-Pane Hardware Configurator & "
                    "DM Parameter Inspector (F2:BUILDER)",
                    "cacaosim_gui_builder.png",
                ),
                (
                    "cacaosim-CTRL Active Mirrors, Wavefront/Science Sensors & "
                    "Beamsplitters Summary (F4:TABLES)",
                    "cacaosim_gui_tables.png",
                ),
                (
                    "cacaosim-CTRL Live Shared-Memory Streams & "
                    "Active MILK FPS Units (F5:STATUS)",
                    "cacaosim_gui_status.png",
                ),
            ],
        ),
        (
            "Long-Exposure PSF & Wavefront Summary",
            [
                ("Long-Exposure PSF Comparison (2x3)", "psf_comparison_2x3.png"),
                ("PSF Radial Profiles & Encircled Energy", "psf_radial_profiles.png"),
                ("Wavefront Mean & Temporal Std Dev Maps (2x3)", "wf_stats_2x3.png"),
            ],
        ),
        (
            snap_title,
            [
                (
                    "RMS Wavefront Error & Strehl Ratio Time Series "
                    "with Sampled Instants (4x1)",
                    "wf_strehl_timeseries_4x1.png",
                ),
                (
                    "Instantaneous Visible 0.75 um PSFs at Sampled Instants (5x3)",
                    "psf_inst_vis_5x3.png",
                ),
                (
                    "Instantaneous Near-IR H-Band 1.65 um PSFs at Sampled Instants (5x3)",
                    "psf_inst_nir_5x3.png",
                ),
                (
                    "Instantaneous Pupil Wavefront OPD Samples at Sampled Instants (5x3)",
                    "wf_samples_5x3.png",
                ),
                (
                    "Instantaneous DM Actuator Commands & Pupil OPD Shapes "
                    "at Sampled Instants (5x4)",
                    "dm_samples_5x4.png",
                ),
                (
                    "Instantaneous Pyramid WFS Frames & Ref-Subtracted Signals "
                    "at Sampled Instants (5x4)",
                    "wfs_samples_5x4.png",
                ),
            ],
        ),
        (
            "Loop Calibration, Latency & Modal Control",
            [
                ("Applied Per-Mode Integrator Gains (1x2)", "modal_gains_1x2.png"),
                ("Hardware Latency Measurement (mlat, 1x2)", "mlat_latency_1x2.png"),
                (
                    "Modal Self-Response Matrix Summary (selfRM, 2x4)",
                    "selfrm_summary_2x4.png",
                ),
            ],
        ),
    ]
    fig_lines = []
    for sec_title, items in fig_sections:
        present = [
            f"- ![{alt}]({fname})"
            for alt, fname in items
            if os.path.isfile(os.path.join(out_dir, fname))
        ]
        if present:
            fig_lines.extend(["", f"### {sec_title}", "", *present])
    if fig_lines:
        lines.extend(["", "## Figures", *fig_lines])
    with open(os.path.join(out_dir, "REPORT.md"), "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines) + "\n")


def load_and_summarize_timeseries(out_dir, wf_metrics, tmp_npys):
    ts_summary = {}

    wf_arr = None
    has_full_wf = False
    wf_csv_p = os.path.join(out_dir, "wf_timeseries.csv")
    if os.path.isfile(wf_csv_p):
        try:
            loaded = np.loadtxt(wf_csv_p, delimiter=",", skiprows=1, ndmin=2)
            if loaded.ndim == 2 and loaded.shape[0] > 0 and loaded.shape[1] >= 5:
                wf_arr = loaded[:, :5].astype(np.float64)
                has_full_wf = True
        except Exception:
            wf_arr = None

    if wf_arr is None and wf_metrics and wf_metrics.get("samples"):
        rows = []
        for sm in wf_metrics["samples"]:
            rows.append(
                [
                    float(sm.get("frame", 0)),
                    float(sm.get("t_phys_s", 0.0)),
                    float(sm.get("raw", {}).get("rms_nm", float("nan"))),
                    float(sm.get("stg1", {}).get("rms_nm", float("nan"))),
                    float(sm.get("final", {}).get("rms_nm", float("nan"))),
                ]
            )
        if rows:
            wf_arr = np.asarray(rows, dtype=np.float64)

    if wf_arr is not None and wf_arr.shape[0] > 0:
        wf_npy = os.path.join(out_dir, "ts_wf_plot.npy")
        np.save(wf_npy, wf_arr.astype(np.float32))
        tmp_npys.append(wf_npy)
        wf_rms_summary = {}
        for col_i, k in ((2, "raw"), (3, "stg1"), (4, "final")):
            vals = wf_arr[:, col_i]
            vals = vals[np.isfinite(vals)]
            if vals.size > 0:
                wf_rms_summary[k] = {
                    "n_frames": int(vals.size),
                    "mean_nm": float(np.mean(vals)),
                    "std_nm": float(np.std(vals)),
                    "min_nm": float(np.min(vals)),
                    "p05_nm": float(np.percentile(vals, 5.0)),
                    "median_nm": float(np.median(vals)),
                    "p95_nm": float(np.percentile(vals, 95.0)),
                    "max_nm": float(np.max(vals)),
                    "has_full_csv": has_full_wf,
                }
        if wf_rms_summary:
            ts_summary["wf_rms_nm"] = wf_rms_summary

    sr_cols = [
        ("vis", "raw"),
        ("vis", "stg1"),
        ("vis", "final"),
        ("nir", "raw"),
        ("nir", "stg1"),
        ("nir", "final"),
    ]
    sr_arr = None
    has_full_sr = False
    sr_csv_p = os.path.join(out_dir, "strehl_timeseries.csv")
    if os.path.isfile(sr_csv_p):
        try:
            tbl = np.genfromtxt(sr_csv_p, delimiter=",", names=True, dtype=np.float64)
            tbl = np.atleast_1d(tbl)
            names = set(tbl.dtype.names or ())
            if tbl.size > 0 and "t_phys_s" in names and "vis_raw_inst" in names:
                cols_data = [np.asarray(tbl["t_phys_s"], dtype=np.float64)]
                for bkey, skey in sr_cols:
                    ik = f"{bkey}_{skey}_inst"
                    lk = f"{bkey}_{skey}_long"
                    cols_data.append(
                        np.asarray(tbl[ik], dtype=np.float64)
                        if ik in names
                        else np.full(tbl.size, np.nan)
                    )
                    cols_data.append(
                        np.asarray(tbl[lk], dtype=np.float64)
                        if lk in names
                        else np.full(tbl.size, np.nan)
                    )
                sr_arr = np.column_stack(cols_data)
                has_full_sr = True
        except Exception:
            sr_arr = None

    if sr_arr is None and wf_metrics and wf_metrics.get("samples"):
        samps = wf_metrics["samples"]
        if any(sm.get("inst_psf", {}).get("vis") for sm in samps):
            t_vec = np.asarray([float(sm.get("t_phys_s", 0.0)) for sm in samps], dtype=np.float64)
            cols_data = [t_vec]
            for bkey, skey in sr_cols:
                vals = np.asarray(
                    [
                        float(
                            sm.get("inst_psf", {})
                            .get(bkey, {})
                            .get(skey, {})
                            .get("strehl_peak", float("nan"))
                        )
                        for sm in samps
                    ],
                    dtype=np.float64,
                )
                lvals = np.full(vals.shape, np.nan, dtype=np.float64)
                fin = np.isfinite(vals)
                if np.any(fin):
                    cnt = np.cumsum(fin.astype(np.float64))
                    csum = np.cumsum(np.where(fin, vals, 0.0))
                    lvals[fin] = csum[fin] / cnt[fin]
                cols_data.extend([vals, lvals])
            sr_arr = np.column_stack(cols_data)

    if sr_arr is not None and sr_arr.shape[0] > 0:
        sr_npy = os.path.join(out_dir, "ts_strehl_plot.npy")
        np.save(sr_npy, sr_arr.astype(np.float32))
        tmp_npys.append(sr_npy)
        sr_summary = {"vis": {}, "nir": {}}
        for idx, (bkey, skey) in enumerate(sr_cols):
            iv = sr_arr[:, 1 + 2 * idx]
            lv = sr_arr[:, 2 + 2 * idx]
            iv_f = iv[np.isfinite(iv)]
            lv_f = lv[np.isfinite(lv)]
            if iv_f.size > 0:
                sr_summary[bkey][skey] = {
                    "n_exposures": int(iv_f.size),
                    "inst_mean": float(np.mean(iv_f)),
                    "inst_std": float(np.std(iv_f)),
                    "inst_min": float(np.min(iv_f)),
                    "inst_p05": float(np.percentile(iv_f, 5.0)),
                    "inst_median": float(np.median(iv_f)),
                    "inst_p95": float(np.percentile(iv_f, 95.0)),
                    "inst_max": float(np.max(iv_f)),
                    "long_final": float(lv_f[-1]) if lv_f.size > 0 else float("nan"),
                    "has_full_csv": has_full_sr,
                }
        if sr_summary["vis"] or sr_summary["nir"]:
            ts_summary["strehl"] = sr_summary

    return ts_summary if ts_summary else None


def main():
    if any(a in ("-h1", "--help-oneline") for a in sys.argv[1:]):
        print("compile AO optical/control PSF, wavefront, mlat, and selfRM metrics + REPORT.md")
        return
    if any(a in ("-h2", "--help-description") for a in sys.argv[1:]):
        print(
            "Analyze FITS PSFs, wavefront stats, mlat hardware latency, and selfRM cubes\n"
            "from two-stage AO3k + SCExAO simulation runs to generate REPORT.md,\n"
            "ao3k_scexao_metrics.json, and 12 publication figures."
        )
        return
    if len(sys.argv) < 11 or any(a in ("-h", "--help", "-hm", "--help-mono") for a in sys.argv[1:]):
        print(
            "Usage: cacaosim-ao-report <work_dir> <out_dir> <seeing> <phys_time> <master_ticks>\n"
            "                          <wall_elapsed> <gain1> <gain2> <mult1> <mult2>\n"
            "                          [mgain_alpha] [mgain_floor] [mgain_tt]"
        )
        return

    (
        work_dir,
        out_dir,
        seeing,
        phys_time,
        master_ticks,
        wall_elapsed,
        gain1,
        gain2,
        mult1,
        mult2,
    ) = sys.argv[1:11]
    mgain_alpha = float(sys.argv[11]) if len(sys.argv) > 11 else 0.8
    mgain_floor = float(sys.argv[12]) if len(sys.argv) > 12 else 0.10
    mgain_tt = float(sys.argv[13]) if len(sys.argv) > 13 else 1.0

    tmp_npys = []
    psf_metrics = {}
    dl_imgs = {}
    for bkey, bcfg in BANDS.items():
        psf_metrics[bkey] = {}
        dl_img = np.asarray(
            fits.getdata(os.path.join(out_dir, f"psf_{bkey}_dl.fits")), dtype=np.float64
        )
        dl_imgs[bkey] = dl_img
        dl_sum = float(np.sum(dl_img))
        for skey, _ in STAGES:
            fpath = os.path.join(out_dir, f"psf_{bkey}_{skey}.fits")
            img = np.asarray(fits.getdata(fpath), dtype=np.float64)
            npy_p = os.path.join(out_dir, f"psf_{bkey}_{skey}.npy")
            np.save(npy_p, img.astype(np.float32))
            tmp_npys.append(npy_p)
            psf_metrics[bkey][skey] = analyze_band_stage(img, dl_sum, bcfg)

    wf_metrics = None
    wf_json_p = os.path.join(out_dir, "wf_stats.json")
    if os.path.isfile(wf_json_p):
        with open(wf_json_p, "r", encoding="utf-8") as fh:
            wf_metrics = json.load(fh)
        wf_stems = [
            "wf_pupil_mask",
            "wfs_raw_stg1_samples",
            "wfs_sig_stg1_samples",
            "wfs_raw_stg2_samples",
            "wfs_sig_stg2_samples",
            "dm_cmd_stg1_samples",
            "dm_opd_stg1_samples",
            "dm_cmd_stg2_samples",
            "dm_opd_stg2_samples",
        ]
        for k in ("raw", "stg1", "final"):
            wf_stems.extend([f"wf_samples_{k}", f"wf_mean_{k}", f"wf_std_{k}"])
        for stem in wf_stems:
            fp = os.path.join(out_dir, f"{stem}.fits")
            if os.path.isfile(fp):
                npy_p = os.path.join(out_dir, f"{stem}.npy")
                np.save(npy_p, np.asarray(fits.getdata(fp), dtype=np.float32))
                tmp_npys.append(npy_p)

        samples_list = wf_metrics.get("samples", [])
        for sm in samples_list:
            sm["inst_psf"] = {"vis": {}, "nir": {}}

        for bkey, bcfg in BANDS.items():
            dl_img = dl_imgs[bkey]
            ny, nx = dl_img.shape
            c0 = nx // 2
            yy, xx = np.indices((ny, nx), dtype=np.float64)
            core_m = np.hypot(xx - c0, yy - c0) <= 20.0
            dl_core_sum = max(float(np.sum(dl_img[core_m])), 1e-6)
            dl_tot_sum = max(float(np.sum(dl_img)), 1e-6)
            ld_mas = (bcfg["lam_um"] * 1e-6 / TEL_DIAM_M) * RAD2MAS
            pix_mas = ld_mas / bcfg["pixscale_ld"]
            rr_mas = np.hypot(xx - c0, yy - c0) * pix_mas
            rgrid_mas = np.linspace(0.5 * pix_mas, 1500.0, 200)

            for skey in ("raw", "stg1", "final"):
                sp = os.path.join(out_dir, f"psf_inst_{bkey}_{skey}_samples.fits")
                dlp = os.path.join(out_dir, f"det_{bkey}_{skey}_dl.fits")
                if not os.path.isfile(sp):
                    continue
                scube = np.asarray(fits.getdata(sp), dtype=np.float64)
                if os.path.isfile(dlp):
                    det_dl = np.asarray(fits.getdata(dlp), dtype=np.float64)
                    det_sub = np.maximum(det_dl - 100.0, 0.0)
                    adu_per_sr = max(float(np.sum(det_sub[core_m])) / dl_core_sum, 1.0)
                else:
                    adu_per_sr = max(float(np.max(scube - 100.0)), 1.0)

                sr_cube = np.maximum(scube - 100.0, 0.0) / adu_per_sr
                npy_sr = os.path.join(out_dir, f"psf_inst_{bkey}_{skey}_sr.npy")
                np.save(npy_sr, sr_cube.astype(np.float32))
                tmp_npys.append(npy_sr)

                for idx in range(min(len(samples_list), sr_cube.shape[0])):
                    frm = sr_cube[idx]
                    pidx = int(np.argmax(frm))
                    py, px = divmod(pidx, nx)
                    sr_pk = float(frm[py, px])
                    fw_px = estimate_fwhm_pix(frm, (px, py))
                    ee_c = np.array(
                        [float(np.sum(frm[rr_mas <= r]) / dl_tot_sum) for r in rgrid_mas]
                    )
                    i50 = int(np.searchsorted(ee_c, 0.50))
                    r50 = (
                        float(rgrid_mas[i50])
                        if i50 < len(rgrid_mas)
                        else float(rgrid_mas[-1])
                    )
                    samples_list[idx]["inst_psf"][bkey][skey] = {
                        "strehl_peak": sr_pk,
                        "fwhm_mas": fw_px * pix_mas,
                        "fwhm_ld": (fw_px * pix_mas) / ld_mas,
                        "ee50_radius_mas": r50,
                        "peak_adu": float(np.max(scube[idx] - 100.0)),
                        "adu_per_sr": adu_per_sr,
                    }

    stage1_info = load_loop_calib(work_dir, "ao3k", 1, out_dir, tmp_npys)
    stage2_info = load_loop_calib(work_dir, "scexao", 2, out_dir, tmp_npys)
    ts_metrics = load_and_summarize_timeseries(out_dir, wf_metrics, tmp_npys)

    summary = {
        "configuration": "Subaru 8.2m AO3k + SCExAO (Two-Stage Pyramid WFS)",
        "telescope": {
            "diameter_m": 8.2,
            "cobs": 0.30,
            "nspider": 4,
            "nwf": 256,
            "pup_diam_pix": 240.0,
            "pupil_scale_m_pix": 8.2 / 240.0,
        },
        "star_and_atmosphere": {
            "star_mV": 6.0,
            "star_mH": 6.0,
            "star_teff_K": 9600.0,
            "seeing_arcsec_500nm": float(seeing),
            "profile": "7-layer Maunakea (4.2..23.7 km, wind 6.5..22.0 m/s)",
            "physical_time_s": float(phys_time),
            "master_rate_phys_hz": 2000.0,
            "stage1_rate_phys_hz": 1000.0,
            "stage2_rate_phys_hz": 2000.0,
            "master_ticks_integrated": int(master_ticks),
            "wall_elapsed_s": float(wall_elapsed),
            "calibration_turbulence_gain": 0.0,
        },
        "loops": {
            "stage1_ao3k": {
                **stage1_info,
                "dm_grid": "64x64",
                "dm_pupil_diam_act": 60,
                "wfs_detector": "160x160",
                "wfs_band": "J-band 1.22 um PyWFS (20% BW, N=2ch, 160x160, mod 3.0 l0/D)",
                "phys_rate_hz": 1000.0,
                "gain": float(gain1),
                "mult": float(mult1),
                "mgain_alpha": mgain_alpha,
                "mgain_floor": mgain_floor,
                "mgain_tt_factor": mgain_tt,
            },
            "stage2_scexao": {
                **stage2_info,
                "dm_grid": "50x50",
                "dm_pupil_diam_act": 46,
                "wfs_detector": "120x120",
                "wfs_band": "Visible 0.75 um PyWFS (20% BW, N=2ch, 120x120, mod 3.0 l0/D)",
                "phys_rate_hz": 2000.0,
                "gain": float(gain2),
                "mult": float(mult2),
                "mgain_alpha": mgain_alpha,
                "mgain_floor": mgain_floor,
                "mgain_tt_factor": mgain_tt,
            },
        },
        "psf_metrics": psf_metrics,
    }
    if wf_metrics is not None:
        summary["wavefront_metrics"] = wf_metrics
    if ts_metrics is not None:
        summary["timeseries_metrics"] = ts_metrics

    bench_filename = ensure_gui_screenshots(work_dir, out_dir)
    if bench_filename:
        chrom_info = analyze_bench_chromaticity(os.path.join(out_dir, bench_filename))
        if chrom_info is not None:
            summary["chromaticity"] = chrom_info
            t_b = chrom_info.get("timing", {})
            if t_b:
                summary["timing"] = t_b
                sa_blk = summary["star_and_atmosphere"]
                sa_blk["oversample"] = int(t_b["oversample"])
                sa_blk["internal_bench_hz"] = float(t_b["internal_bench_hz"])
                sa_blk["internal_dt_ms"] = float(t_b["internal_dt_ms"])
                sa_blk["internal_dt_us"] = float(t_b["internal_dt_us"])
                sa_blk["internal_subticks_integrated"] = (
                    int(master_ticks) * int(t_b["oversample"])
                )

    vid_meta = ensure_telemetry_video(out_dir)
    if vid_meta is not None:
        summary["short_timescale_video"] = vid_meta

    summary_path = os.path.join(out_dir, "ao3k_scexao_metrics.json")
    with open(summary_path, "w", encoding="utf-8") as fh:
        json.dump(summary, fh, indent=2)
        fh.write("\n")

    render_plots_via_sys_python(out_dir, summary_path)
    write_ao_report_md(out_dir, summary, bench_filename=bench_filename)
    for npy_p in tmp_npys:
        if os.path.exists(npy_p):
            os.remove(npy_p)

    print("\n=== Subaru AO3k + SCExAO 10.0s Performance Summary ===")
    t_prt = summary.get("timing", {})
    if t_prt:
        print(
            f"  Internal Clock : {t_prt['internal_bench_hz']/1000:.1f} kHz "
            f"(dt = {t_prt['internal_dt_ms']:.3f} ms = {t_prt['internal_dt_us']:.0f} us), "
            f"{t_prt['oversample']} sub-samples per {t_prt['outer_dt_ms']:.2f} ms "
            f"({t_prt['outer_master_hz']/1000:.1f} kHz) outer tick"
        )
    for bkey, bcfg in BANDS.items():
        print(f"\n[{bcfg['label']}]")
        for skey, slabel in STAGES:
            m = psf_metrics[bkey][skey]
            print(
                f"  {slabel:<28s}: Strehl={m['strehl_peak']*100:6.2f}% "
                f"(axis={m['strehl_axis']*100:6.2f}%), "
                f"FWHM={m['fwhm_mas']:6.2f} mas ({m['fwhm_ld']:4.2f} l/D), "
                f"EE(1.22 l/D)={m['ee_1p22ld']*100:5.1f}%, "
                f"r50={m['ee50_radius_mas']:5.1f} mas"
            )

    if wf_metrics is not None:
        print(
            f"\n[Wavefront OPD Telemetry ({wf_metrics['n_frames']} frames, "
            f"{wf_metrics['phys_time_recorded_s']:.2f} s)]"
        )
        for k in ("raw", "stg1", "final"):
            lm = wf_metrics["locations"][k]
            print(
                f"  {lm['label']:<36s}: "
                f"TotRMS={lm['quad_total_rms_nm']:6.1f} nm "
                f"(MeanMapRMS={lm['mean_map_rms_nm']:5.1f} nm, "
                f"StdMapRMS={lm['std_map_rms_nm']:6.1f} nm)"
            )

    if stage1_info.get("mlat") or stage2_info.get("mlat"):
        print("\n[Hardware Latency (mlat) & RM Timing]")
        for tag, sinf in [("Stage 1 (AO3k)", stage1_info), ("Stage 2 (SCExAO)", stage2_info)]:
            ml = sinf.get("mlat")
            if ml:
                fit = ml["fit"]
                print(
                    f"  {tag:<18s}: mlat={ml['latency_fr']:.3f} fr "
                    f"({ml['latency_phys_ms']:.2f} ms phys), "
                    f"GaussFit={fit['tau_fit_fr']:.3f}+/-{fit['tau_err_fr']:.3f} fr "
                    f"(FWHM={fit['fwhm_fit_fr']:.2f} fr, R2={fit['r2']:.2f}), "
                    f"RMdelayfr={ml['rm_delay_fr']} (+{ml['rm_subframe_wait_fr']:.2f} fr)"
                )

    if stage1_info.get("selfrm") or stage2_info.get("selfrm"):
        print("\n[Modal Self-Response Matrix (selfRM) — Calibration vs On-Sky]")
        for tag, sinf in [("Stage 1 (AO3k)", stage1_info), ("Stage 2 (SCExAO)", stage2_info)]:
            sr = sinf.get("selfrm")
            if sr:
                print(
                    f"  {tag:<18s}: N={sr['n_modes_probed']:3d} | "
                    f"Calib Diag={sr['cal_diag_mean']:.3f}+/-{sr['cal_diag_std']:.3f} "
                    f"(OffRMS={sr['cal_offdiag_rms']:.4f}) | "
                    f"OnSky Diag={sr['sky_og_mean']:.3f}, "
                    f"g_opt(OnSky/Cal)={sr['sky_og_ratio_mean']:.3f} "
                    f"[TT={sr['sky_ratio_tt']:.3f}, Low={sr['sky_ratio_low']:.3f}, "
                    f"High={sr['sky_ratio_high']:.3f}] "
                    f"(OffRMS={sr['sky_offdiag_rms']:.4f})"
                )


if __name__ == "__main__":
    main()
