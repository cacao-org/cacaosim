            interpolation="nearest",
        )
        ld_arcsec = m["ld_mas"] / 1000.0
        c1 = Circle(
            (0.0, 0.0),
            30.0 * ld_arcsec,
            fill=False,
            ls="--",
            lw=0.9,
            ec="cyan",
            alpha=0.75,
            label="AO3k 30 λ/D",
        )
        c2 = Circle(
            (0.0, 0.0),
            23.0 * ld_arcsec,
            fill=False,
            ls=":",
            lw=1.0,
            ec="lime",
            alpha=0.85,
            label="SCExAO 23 λ/D",
        )
        ax.add_patch(c1)
        ax.add_patch(c2)
        if r == 0 and c == 2:
            ax.legend(
                loc="upper right",
                fontsize=8,
                facecolor="#10141c",
                edgecolor="#556070",
                labelcolor="white",
                framealpha=0.85,
            )

        if r == 0:
            ax.set_title(slabel, fontsize=11.5, fontweight="bold")
        if c == 0:
            ax.set_ylabel(f"{blabel}\nΔDec [arcsec]", fontsize=10.5)
        else:
            ax.set_ylabel("ΔDec [arcsec]", fontsize=9.5)
        ax.set_xlabel("ΔRA [arcsec]", fontsize=9.5)

        txt = (
            f"Strehl = {m['strehl_peak']*100:.1f}%\n"
            f"FWHM = {m['fwhm_mas']:.1f} mas ({m['fwhm_ld']:.2f} λ/D)\n"
            f"EE(1.22 λ/D) = {m['ee_1p22ld']*100:.1f}%"
        )
        ax.text(
            0.03,
            0.04,
            txt,
            transform=ax.transAxes,
            fontsize=8.8,
            color="white",
             family="monospace",
            bbox=dict(boxstyle="round,pad=0.3", fc="black", ec="none", alpha=0.68),
        )
    cbar = fig.colorbar(im_handle, ax=axes[r, :], shrink=0.88, pad=0.015)
    cbar.set_label("Strehl-Normalized Intensity", fontsize=10)

fig.savefig(os.path.join(out_dir, "psf_comparison_2x3.png"), dpi=180)
plt.close(fig)

fig2, axes2 = plt.subplots(2, 2, figsize=(13.5, 8.8), constrained_layout=True)
fig2.suptitle(
    "AO3k + SCExAO Azimuthal Radial PSF Profiles & Encircled Energy (10.0 s Integration)",
    fontsize=13,
    fontweight="bold",
)
