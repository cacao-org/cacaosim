def _ensure_sci_python() -> None:
    help_flags = (
        "-h",
        "--help",
        "-h1",
        "--help-oneline",
        "-h2",
        "--help-description",
        "-hm",
        "--help-mono",
    )
    if any(a in help_flags for a in sys.argv[1:]):
        return
    try:
        import astropy  # noqa: F401
        import matplotlib  # noqa: F401
        import numpy  # noqa: F401
        return
    except ImportError:
        pass
    cands = [
        os.environ.get("PYTHON_BIN", ""),
        os.path.expanduser("~/miniforge3/bin/python3"),
        os.path.expanduser("~/.local/envs/cacao/bin/python3"),
    ]
    for p in cands:
        if p and os.path.isfile(p) and os.path.realpath(p) != os.path.realpath(sys.executable):
            os.execv(p, [p] + sys.argv)


_ensure_sci_python()

RAD2MAS = 206264.806247 * 1000.0
TEL_DIAM_M = 8.2

BAND_META = {
    "vis": {
        "label": "Vis I-Band (0.75 µm)",
        "lam_um": 0.75,
        "pixscale_ld": 2.20,
        "fov_arcsec": 0.65,
    },
    "nir": {
        "label": "Near-IR H-Band (1.65 µm)",
        "lam_um": 1.65,
        "pixscale_ld": 2.50,
        "fov_arcsec": 1.35,
    },
}


def find_ffmpeg_bin() -> str | None:
    """Locate a working ffmpeg executable via env, PATH, ~/.local/bin, or imageio_ffmpeg."""
    cands = [
        os.environ.get("FFMPEG_BIN", ""),
        shutil.which("ffmpeg") or "",
        os.path.expanduser("~/.local/bin/ffmpeg"),
    ]
    for c in cands:
        if c and os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    try:
        import imageio_ffmpeg  # type: ignore[import-not-found]

        exe = imageio_ffmpeg.get_ffmpeg_exe()
        if exe and os.path.isfile(exe):
            return exe
    except Exception:
        pass
    return None


def parse_bench_config(bench_path: str | None) -> dict[str, object]:
    """Extract timing, pupil, star, and DM physics parameters from an optical .bench file."""
    cfg: dict[str, object] = {
        "master_hz": 2000.0,
        "oversample": 4.0,
        "tel_diam_m": TEL_DIAM_M,
        "nwf": 256,
        "pup_diam": 0.9375,
        "cobs": 0.307,
        "star_mag": 6.0,
        "wf_unit": 1,
        "ref_lambda": 0.50,
        "dms": [],
    }
    if not bench_path or not os.path.isfile(bench_path):
        return cfg

    sec = ""
    explicit_diam = False
    dm_map: dict[str, dict[str, object]] = {}
    dm_order: list[str] = []

    def _to_float(val: str, default: float) -> float:
        try:
            return float(val)
        except ValueError:
            return default

    def _to_int(val: str, default: int) -> int:
        try:
            return int(round(float(val)))
        except ValueError:
            return default

    with open(bench_path, "r", encoding="utf-8", errors="replace") as fh:
        for raw in fh:
            line = raw.split("#", 1)[0].strip()
            if not line:
                continue
            if line.startswith("[") and line.endswith("]"):
                sec = line
                if sec.startswith("[dm."):
                    dmid = sec[4:-1].strip()
                    if dmid not in dm_map:
                        dm_map[dmid] = {
                            "id": dmid,
                            "in_cmd": "",
                            "out_opd": "",
                            "nact_x": 64,
                            "nact_y": 64,
                            "dm_diam": 0.9375,
                            "if_coupling": 0.15,
                            "dyn_mode": "1",
                            "plate_drive": "disp",
                            "rim_bc": "clamped",
                            "f0_hz": 1000.0,
                            "act_pitch_mm": 1.5,
                            "wave_c": 14.0,
                            "bend_beta": 0.0085,
                            "delay_us": 0.0,
                            "refl_scale": 2.0,
                        }
                        dm_order.append(dmid)
                continue
            if "=" not in line:
                continue
            k, v = [x.strip() for x in line.split("=", 1)]
            v = v.strip('"').strip("'")
            if sec == "[bench]":
                if k == "master_hz":
                    cfg["master_hz"] = _to_float(v, 2000.0)
                elif k == "oversample":
                    cfg["oversample"] = max(1.0, _to_float(v, 4.0))
                elif k == "tel_diam_m":
                    cfg["tel_diam_m"] = _to_float(v, TEL_DIAM_M)
                    explicit_diam = True
                elif k == "pupil_geom" and v.lower() == "subaru" and not explicit_diam:
                    cfg["tel_diam_m"] = 7.95
                elif k == "nwf":
                    cfg["nwf"] = max(16, _to_int(v, 256))
                elif k == "pup_diam":
                    cfg["pup_diam"] = _to_float(v, 0.9375)
                elif k == "cobs":
                    cfg["cobs"] = _to_float(v, 0.307)
                elif k == "star_mag":
                    cfg["star_mag"] = _to_float(v, 6.0)
                elif k == "wf_unit":
                    cfg["wf_unit"] = _to_int(v, 1)
                elif k == "ref_lambda":
                    cfg["ref_lambda"] = _to_float(v, 0.50)
            elif sec.startswith("[dm."):
                dmid = sec[4:-1].strip()
                dm = dm_map[dmid]
                if k in ("in_cmd", "out_opd", "dyn_mode", "plate_drive", "rim_bc"):
                    dm[k] = v.lower() if k in ("dyn_mode", "plate_drive", "rim_bc") else v
                elif k in ("nact_x", "nact_y"):
                    dm[k] = max(1, _to_int(v, int(dm[k])))
                elif k in (
                    "dm_diam",
                    "if_coupling",
                    "f0_hz",
                    "act_pitch_mm",
                    "wave_c",
                    "bend_beta",
                    "delay_us",
                    "refl_scale",
                ):
                    dm[k] = _to_float(v, float(dm[k]))

    cfg["dms"] = [dm_map[d] for d in dm_order]
    return cfg


def parse_bench_timing(bench_path: str | None) -> dict[str, float]:
    """Extract master_hz, oversample, and tel_diam_m from an optical .bench file."""
    cfg = parse_bench_config(bench_path)
    return {
        "master_hz": float(cfg["master_hz"]),
        "oversample": float(cfg["oversample"]),
        "tel_diam_m": float(cfg["tel_diam_m"]),
    }


def discover_stream_cubes(telem_dir: str, stream_name: str) -> list[tuple[str, str | None]]:
    """Return sorted [(fits_path, txt_path_or_None), ...] for stream_name in telem_dir."""
    pats = [
        os.path.join(telem_dir, f"{stream_name}_[0-9][0-9]:[0-9][0-9]:[0-9][0-9]*.fits"),
        os.path.join(telem_dir, f"{stream_name}_[0-9][0-9]:[0-9][0-9]:[0-9][0-9]*.fits.fz"),
    ]
    fits_files: list[str] = []
    for pat in pats:
        fits_files.extend(glob.glob(pat))
    fits_files = sorted(set(fits_files))
    pairs: list[tuple[str, str | None]] = []
    for fp in fits_files:
        if fp.endswith(".fits.fz"):
            stem = fp[: -len(".fits.fz")]
        else:
            stem = fp[: -len(".fits")]
        # Check exact prefix match so e.g. psf_vis_final does not match psf_vis_final_long
        base = os.path.basename(stem)
        m = re.match(r"^(.+)_\d{2}:\d{2}:\d{2}(?:\.\d+)?$", base)
        if not m or m.group(1) != stream_name:
            continue
        tp = stem + ".txt"
        pairs.append((fp, tp if os.path.isfile(tp) else None))

    def _pair_sort_key(item: tuple[str, str | None]) -> tuple[int, float, str]:
        fp, tp = item
        if tp is not None:
            c0, _ = read_tlm_txt(tp)
            if c0.size > 0:
                return (0, float(c0[0]), fp)
        return (1, os.path.getmtime(fp), fp)

    pairs.sort(key=_pair_sort_key)
    return pairs


def read_tlm_txt(txt_path: str):
    """Parse logshmim 7-column or 4-column timing .txt -> (cnt0_arr, tacq_arr)."""
    import numpy as np

    cnt0_list: list[int] = []
    tacq_list: list[float] = []
    with open(txt_path, "r", encoding="utf-8", errors="replace") as fh:
        for raw in fh:
            s = raw.strip()
            if not s or s.startswith("#"):
                continue
            toks = s.split()
            if len(toks) >= 7:
                try:
                    tacq_list.append(float(toks[4]))
                    cnt0_list.append(int(toks[5]))
                except ValueError:
                    continue
            elif len(toks) == 4:
                try:
                    cnt0_list.append(int(toks[1]))
                    tacq_list.append(0.0)
                except ValueError:
                    continue
    return np.asarray(cnt0_list, dtype=np.int64), np.asarray(tacq_list, dtype=np.float64)


class TelemetryStreamIndex:
    """Lightweight memory-mapped index over one or more streamFITSlog cubes."""

    def __init__(
        self,
        stream_name: str,
        pairs: list[tuple[str, str | None]],
        phys_time_s: float,
        nominal_rate_hz: float | None = None,
    ) -> None:
        import numpy as np
        from astropy.io import fits

        self.stream_name = stream_name
        self.segments: list[tuple[str, int, int, tuple[int, ...]]] = []
        cnt0_parts = []
        total_frames = 0
        frame_shape: tuple[int, ...] = ()

        for fp, tp in pairs:
            with fits.open(fp, memmap=True) as hdul:
                hdu = hdul[0] if hdul[0].data is not None else hdul[1]
                shp = hdu.data.shape
                if len(shp) == 3:
                    nz = int(shp[0])
                    fshp = (int(shp[1]), int(shp[2]))
                elif len(shp) == 2:
                    nz = 1
                    fshp = (int(shp[0]), int(shp[1]))
                else:
                    continue
            if tp is not None:
                c0, _ = read_tlm_txt(tp)
                n_use = min(nz, int(c0.size)) if c0.size > 0 else nz
                if c0.size >= n_use and n_use > 0:
                    cnt0_parts.append(c0[:n_use])
                else:
                    cnt0_parts.append(np.arange(total_frames, total_frames + n_use, dtype=np.int64))
            else:
                n_use = nz
                cnt0_parts.append(np.arange(total_frames, total_frames + n_use, dtype=np.int64))
            if n_use <= 0:
                continue
            frame_shape = fshp
            self.segments.append((fp, total_frames, n_use, fshp))
            total_frames += n_use

        self.n_frames = total_frames
        self.frame_shape = frame_shape
        if total_frames == 0:
            self.cnt0 = np.zeros(0, dtype=np.int64)
            self.rate_hz = float(nominal_rate_hz or 2000.0)
            self.t_phys_s = np.zeros(0, dtype=np.float64)
            return

        self.cnt0 = np.concatenate(cnt0_parts)
        span_cnt = int(self.cnt0[-1] - self.cnt0[0] + 1)
        if span_cnt <= 0 or span_cnt > total_frames * 50:
            rel_idx = np.arange(total_frames, dtype=np.float64)
            span_cnt = total_frames
        else:
            rel_idx = (self.cnt0 - self.cnt0[0]).astype(np.float64)

        est_rate = float(span_cnt) / max(phys_time_s, 1e-6)
        if nominal_rate_hz and abs(est_rate - nominal_rate_hz) / nominal_rate_hz < 0.08:
            self.rate_hz = float(nominal_rate_hz)
        else:
            # Snap to standard harmonic bench rates when within 6%
            std_rates = (8000.0, 4000.0, 2000.0, 1000.0, 500.0, 400.0, 250.0, 200.0, 100.0, 50.0)
            snapped = next(
                (sr for sr in std_rates if abs(est_rate - sr) / sr < 0.06),
                round(est_rate, 3),
            )
            self.rate_hz = max(float(snapped), 1.0)

        self.t_phys_s = (rel_idx + 1.0) / self.rate_hz

    def load_slice(self, idx_start: int, idx_stop: int):
        """Memory-map and extract frames [idx_start:idx_stop] into a float32 array."""
        import numpy as np
        from astropy.io import fits

        idx_start = max(0, int(idx_start))
        idx_stop = min(self.n_frames, int(idx_stop))
        n_out = max(0, idx_stop - idx_start)
        out = np.zeros((n_out, *self.frame_shape), dtype=np.float32)
        if n_out == 0:
            return out

        for fp, seg0, seg_len, _ in self.segments:
            seg1 = seg0 + seg_len
            ov0 = max(idx_start, seg0)
            ov1 = min(idx_stop, seg1)
            if ov0 >= ov1:
                continue
            with fits.open(fp, memmap=True) as hdul:
                hdu = hdul[0] if hdul[0].data is not None else hdul[1]
                if hdu.data.ndim == 3:
                    chunk = np.asarray(hdu.data[ov0 - seg0 : ov1 - seg0], dtype=np.float32)
                else:
                    chunk = np.asarray(hdu.data, dtype=np.float32)[None, :, :]
            out[ov0 - idx_start : ov1 - idx_start] = chunk
        return out

    def load_indices(self, indices):
        """Memory-map and extract specific frame indices (sparse-friendly) -> float32 cube."""
        import numpy as np
        from astropy.io import fits

        idx_arr = np.clip(np.asarray(indices, dtype=np.int64), 0, max(self.n_frames - 1, 0))
        n_out = int(idx_arr.size)
        out = np.zeros((n_out, *self.frame_shape), dtype=np.float32)
        if n_out == 0 or self.n_frames == 0:
            return out

        uniq, inv = np.unique(idx_arr, return_inverse=True)
        s0, s1 = int(uniq[0]), int(uniq[-1]) + 1
        if (s1 - s0) <= max(64, 2 * int(uniq.size)):
            return self.load_slice(s0, s1)[idx_arr - s0]

        u_buf = np.zeros((int(uniq.size), *self.frame_shape), dtype=np.float32)
        for fp, seg0, seg_len, _ in self.segments:
            seg1 = seg0 + seg_len
            m = (uniq >= seg0) & (uniq < seg1)
            if not np.any(m):
                continue
            loc = uniq[m] - seg0
            dst_pos = np.flatnonzero(m)
            with fits.open(fp, memmap=True) as hdul:
                hdu = hdul[0] if hdul[0].data is not None else hdul[1]
                if hdu.data.ndim == 3:
                    for di, li in zip(dst_pos, loc):
                        u_buf[int(di)] = np.asarray(hdu.data[int(li)], dtype=np.float32)
                else:
                    u_buf[dst_pos] = np.asarray(hdu.data, dtype=np.float32)[None, :, :]
        return u_buf[inv]


def compute_wfs_refsub(raw_cube, calib_dir: str, norm_floor: float = 1.0):
    """Compute exact CACAO acquireWFSim reference-subtracted signal imWFS2 from raw WFS frames."""
    import numpy as np
    from astropy.io import fits

    wref_p = os.path.join(calib_dir, "wfsref.fits")
    wmsk_p = os.path.join(calib_dir, "wfsmask.fits")
    nfr, ny, nx = raw_cube.shape
    npix = float(nx * ny)
    raw64 = raw_cube.astype(np.float64)

    if os.path.isfile(wmsk_p):
        wmsk = np.asarray(fits.getdata(wmsk_p), dtype=np.float64)
        if wmsk.shape != (ny, nx):
            wmsk = np.ones((ny, nx), dtype=np.float64)
    else:
        wmsk = np.ones((ny, nx), dtype=np.float64)

    flux = np.sum(raw64 * wmsk[None, :, :], axis=(1, 2), keepdims=True)
    inv = 1.0 / np.maximum(flux + norm_floor * npix, 1.0e-12)
    im1 = raw64 * inv * wmsk[None, :, :]

    if os.path.isfile(wref_p):
        wref = np.asarray(fits.getdata(wref_p), dtype=np.float64)
        if wref.shape == (ny, nx):
            return (im1 - wref[None, :, :]).astype(np.float32)

    mean_ref = np.mean(im1, axis=0, keepdims=True)
    return (im1 - mean_ref).astype(np.float32)


def _scale_wfs_refsub(sig_cube, pct: float = 99.0):
    """Auto-scale ref-sub WFS cube to a clean power-of-10 symmetric range for visualization."""
    import numpy as np

    abs_c = np.abs(sig_cube)
    nz = abs_c[abs_c > 0.0]
    raw_lim = float(np.percentile(nz, pct)) if nz.size > 0 else float(np.percentile(abs_c, pct))
    if not math.isfinite(raw_lim) or raw_lim <= 1.0e-12:
        raw_lim = 1.0e-6
    exp10 = int(math.floor(math.log10(raw_lim)))
    scale = 10.0 ** (-exp10)
    disp = (sig_cube * scale).astype(np.float32)
    lim = max(0.1, raw_lim * scale)
    sup = str.maketrans("-0123456789", "⁻⁰¹²³⁴⁵⁶⁷⁸⁹")
    exp_lbl = f"×10{str(exp10).translate(sup)}"
    return disp, lim, exp_lbl


def _fmt_sci(val: float) -> str:
    """Compact 2-decimal scientific string (e.g. 1.41e-6)."""
    return f"{val:.2e}".replace("e-0", "e-").replace("e+0", "e+")


def _fmt_rate_hz(rate_hz: float) -> str:
    """Compact frequency label (e.g. '2.0 kHz' or '100 Hz')."""
    return f"{rate_hz / 1e3:.1f} kHz" if rate_hz >= 500.0 else f"{rate_hz:.0f} Hz"


def load_pupil_mask(telem_dir: str, report_dir: str, bcfg: dict[str, object]):
    """Load pupil amplitude mask and return (pup, pmask, weights, ext_m)."""
    import numpy as np
    from astropy.io import fits

    pup = None
    for cand in (
        os.path.join(telem_dir, "csim_pup.fits"),
        os.path.join(report_dir, "csim_pup.fits"),
        os.path.join(report_dir, "wf_pupil_mask.fits"),
    ):
        if os.path.isfile(cand):
            arr = np.asarray(fits.getdata(cand), dtype=np.float64)
            if arr.ndim == 2 and arr.shape[0] == arr.shape[1]:
                pup = arr
                break

    if pup is None:
        nwf = int(bcfg.get("nwf", 256))
        pdiam = float(bcfg.get("pup_diam", 0.9375))
        cobs = float(bcfg.get("cobs", 0.307))
        yy, xx = np.indices((nwf, nwf), dtype=np.float64)
        ctr = 0.5 * (nwf - 1.0)
        rr = np.hypot(xx - ctr, yy - ctr)
        r_out = 0.5 * pdiam * nwf
        r_in = cobs * r_out
        pup = ((rr <= r_out) & (rr >= r_in)).astype(np.float64)

    pmask = pup > 0.5
    if not np.any(pmask):
        pmask = np.ones_like(pup, dtype=bool)
        pup = np.ones_like(pup, dtype=np.float64)
    w = np.where(pmask, pup * pup, 0.0)
    w_sum = float(np.sum(w))
    weights = w / max(w_sum, 1.0e-12)

    nwf = int(pup.shape[0])
    tel_diam_m = float(bcfg.get("tel_diam_m", TEL_DIAM_M))
    pup_pix = max(1.0, float(bcfg.get("pup_diam", 0.9375)) * nwf)
    half_m = 0.5 * nwf * (tel_diam_m / pup_pix)
    ext_m = [-half_m, half_m, -half_m, half_m]
    return pup, pmask, weights, ext_m


def _build_dm_stencil(
    nwf: int,
    nact_x: int,
    nact_y: int,
    dm_diam: float,
    if_coupling: float,
    refl_scale: float = 2.0,
):
    """Build exact 16-tap 4x4 Gaussian DM gather stencil matching cacaosim_dm_engine.c."""
    import numpy as np

    diam = dm_diam if (0.05 < dm_diam <= 1.2) else 0.9375
    span = diam * float(nwf)
    ctr = 0.5 * float(nwf - 1)
    px = span / float(nact_x - 1) if nact_x > 1 else span
    py = span / float(nact_y - 1) if nact_y > 1 else span
    x0 = ctr - 0.5 * float(nact_x - 1) * px
    y0 = ctr - 0.5 * float(nact_y - 1) * py
    coupl = min(max(float(if_coupling), 0.005), 0.45)
    alpha = -math.log(coupl)

    yy, xx = np.indices((nwf, nwf), dtype=np.float64)
    fx = (xx - x0) / px
    fy = (yy - y0) / py
    ax0 = np.floor(fx).astype(np.int32) - 1
    ay0 = np.floor(fy).astype(np.int32) - 1

    lat_sum = np.zeros((nwf, nwf), dtype=np.float64)
    for dy in range(4):
        ry = fy - (ay0 + dy)
        for dx in range(4):
            rx = fx - (ax0 + dx)
            lat_sum += np.exp(-alpha * (rx * rx + ry * ry))
    w_scale = np.where(lat_sum > 1.0e-8, refl_scale / lat_sum, refl_scale)

    idxs = []
    ws = []
    for dy in range(4):
        ay = ay0 + dy
        for dx in range(4):
            ax = ax0 + dx
            valid = (ax >= 0) & (ax < nact_x) & (ay >= 0) & (ay < nact_y)
            rx = fx - ax
            ry = fy - ay
            w = np.where(valid, w_scale * np.exp(-alpha * (rx * rx + ry * ry)), 0.0)
            idx = np.where(valid, ay * nact_x + ax, 0)
            idxs.append(idx.ravel().astype(np.int32))
            ws.append(w.ravel().astype(np.float32))
    idxs_arr = np.stack(idxs, axis=0)
    ws_arr = np.stack(ws, axis=0)
    try:
        from scipy import sparse  # type: ignore[import-not-found]

        npix = nwf * nwf
        rows = np.repeat(np.arange(npix, dtype=np.int32), 16)
        cols = idxs_arr.T.ravel()
        vals = ws_arr.T.ravel()
        nz = vals != 0.0
        smat = sparse.csr_matrix(
            (vals[nz], (rows[nz], cols[nz])),
            shape=(npix, nact_x * nact_y),
            dtype=np.float32,
        )
        return smat, None
    except Exception:
        return idxs_arr, ws_arr


def _apply_dm_stencil(cmd_cube, stencil_a, stencil_b, nwf: int):
    """Apply precomputed 16-tap DM gather stencil to (N, ny, nx) cube -> (N, nwf, nwf)."""
    import numpy as np

    nfr = int(cmd_cube.shape[0])
    flat = np.asarray(cmd_cube, dtype=np.float32).reshape(nfr, -1)
    if stencil_b is None:
        return np.asarray((stencil_a @ flat.T).T, dtype=np.float32).reshape(nfr, nwf, nwf)
    out = np.zeros((nfr, nwf * nwf), dtype=np.float32)
    for t in range(16):
        out += flat[:, stencil_a[t]] * stencil_b[t][None, :]
    return out.reshape(nfr, nwf, nwf)


def _build_plate_solver(dm_cfg: dict[str, object]):
    """Build exact static circular-rim coupled-plate solver matching cacaosim_dm_engine.c."""
    import numpy as np

    dyn = str(dm_cfg.get("dyn_mode", "1")).strip().lower()
    drive = str(dm_cfg.get("plate_drive", "disp")).strip().lower()
    if dyn not in ("plate", "3") or drive not in ("force", "1"):
        return None

    nx = int(dm_cfg.get("nact_x", 64))
    ny = int(dm_cfg.get("nact_y", 64))
    if nx < 4 or ny < 4:
        return None

    cx = 0.5 * float(nx - 1)
    cy = 0.5 * float(ny - 1)
    r_rim = 0.5 * float(min(nx, ny)) + 0.5
    yy, xx = np.indices((ny, nx), dtype=np.float64)
    pm = ((xx - cx) ** 2 + (yy - cy) ** 2) <= (r_rim * r_rim)
    act_idx = np.flatnonzero(pm.ravel())
    n_act = int(act_idx.size)
    idx_map = np.full(nx * ny, -1, dtype=np.int32)
    idx_map[act_idx] = np.arange(n_act, dtype=np.int32)

    rim_free = str(dm_cfg.get("rim_bc", "clamped")).strip().lower() in ("free", "1")
    lap = np.zeros((n_act, n_act), dtype=np.float64)
    for k, flat_i in enumerate(act_idx):
        ay, ax = divmod(int(flat_i), nx)
        diag = 0.0
        for dy, dx in ((0, -1), (0, 1), (-1, 0), (1, 0)):
            ny_, nx_ = ay + dy, ax + dx
            if 0 <= nx_ < nx and 0 <= ny_ < ny and pm[ny_, nx_]:
                lap[k, idx_map[ny_ * nx + nx_]] += 1.0
                diag -= 1.0
            elif not rim_free:
                diag -= 1.0
        lap[k, k] = diag

    pitch_m = max(float(dm_cfg.get("act_pitch_mm", 1.5)), 1.0e-4) * 1.0e-3
    f0_hz = max(float(dm_cfg.get("f0_hz", 1000.0)), 1.0)
    wave_c = float(dm_cfg.get("wave_c", 14.0))
    beta = float(dm_cfg.get("bend_beta", 0.0085))
    w0 = 2.0 * math.pi * f0_hz
    cm_p = wave_c / pitch_m
    beta_p = beta / (pitch_m * pitch_m)
    stiff = (w0 * w0) * np.eye(n_act) - (cm_p * cm_p) * lap + (beta_p * beta_p) * (lap @ lap)

    try:
        from scipy.linalg import cho_factor, cho_solve  # type: ignore[import-not-found]

        cf = cho_factor(stiff, lower=True)

        def _solve(cmd_cube):
            nfr = int(cmd_cube.shape[0])
            rhs = (w0 * w0) * np.asarray(cmd_cube, dtype=np.float64).reshape(nfr, -1)[:, act_idx].T
            sol = cho_solve(cf, rhs)
            out = np.zeros((nfr, ny * nx), dtype=np.float32)
            out[:, act_idx] = sol.T.astype(np.float32)
            return out.reshape(nfr, ny, nx)

        return _solve
    except Exception:
        chol = np.linalg.cholesky(stiff)

        def _solve_np(cmd_cube):
            nfr = int(cmd_cube.shape[0])
            rhs = (w0 * w0) * np.asarray(cmd_cube, dtype=np.float64).reshape(nfr, -1)[:, act_idx].T
            y = np.linalg.solve(chol, rhs)
            sol = np.linalg.solve(chol.T, y)
            out = np.zeros((nfr, ny * nx), dtype=np.float32)
            out[:, act_idx] = sol.T.astype(np.float32)
            return out.reshape(nfr, ny, nx)

        return _solve_np


def _finalize_opd_cube(cube_nm, pmask, weights):
    """Piston-remove OPD cube [nm], mask outside pupil to NaN, and return (disp, rms, ptv)."""
    import numpy as np

    c64 = np.asarray(cube_nm, dtype=np.float64)
    nfr = int(c64.shape[0])
    w_flat = weights.ravel()
    m_flat = pmask.ravel()
    c_flat = c64.reshape(nfr, -1)
    pist = c_flat @ w_flat
    sub = c_flat - pist[:, None]
    w_act = w_flat[m_flat]
    sub_act = sub[:, m_flat]
    rms = np.sqrt(np.maximum((sub_act * sub_act) @ w_act, 0.0))
    ptv = np.max(sub_act, axis=1) - np.min(sub_act, axis=1)
    disp = sub.reshape(c64.shape).astype(np.float32)
    disp[:, ~pmask] = np.nan
    return disp, rms, ptv


def _nice_opd_vlim(disp_cube, pmask, min_lim: float = 10.0) -> float:
    """Compute a clean symmetric ±vlim [nm] across a pupil OPD clip (prevents flicker)."""
    import numpy as np

    vals = np.abs(disp_cube[:, pmask])
    vals = vals[np.isfinite(vals)]
    lim = float(np.percentile(vals, 99.3)) if vals.size > 0 else min_lim
    if not math.isfinite(lim) or lim < min_lim:
        lim = min_lim
    step = 100.0 if lim > 800.0 else (25.0 if lim > 200.0 else 10.0)
    return float(max(min_lim, step, math.ceil(lim / step) * step))


def _find_wfstat_meta(telem_dir: str, report_dir: str, prefix: str):
    """Locate <prefix>_meta.json + <prefix>_raw.fits in telem_dir or report_dir."""
    for d in (telem_dir, report_dir):
        mp = os.path.join(d, f"{prefix}_meta.json")
        rp = os.path.join(d, f"{prefix}_raw.fits")
        if os.path.isfile(mp) and os.path.isfile(rp):
            return d, mp
    return None, None


def _load_wfstat_clip(
    telem_dir: str,
    report_dir: str,
    t_grid,
    wfs2_cnt0_clip,
    realtime: bool = False,
):
    """Load exact ground-truth wf_clip_* or wf_full_* cubes if they cover t_grid."""
    import numpy as np
    from astropy.io import fits

    order = (
        (("wf_full", "dm_full"), ("wf_clip", "dm_clip"))
        if realtime
        else (("wf_clip", "dm_clip"),)
    )
    for wf_pfx, dm_pfx in order:
        clip_dir, meta_p = _find_wfstat_meta(telem_dir, report_dir, wf_pfx)
        if clip_dir is None or meta_p is None:
            continue

        try:
            with open(meta_p, "r", encoding="utf-8") as fh:
                meta = json.load(fh)
        except (OSError, json.JSONDecodeError):
            continue

        n_clip_src = int(meta.get("n_frames", 0))
        if n_clip_src < 2:
            continue

        dt_s = float(meta.get("dt_phys_s", 0.0005))
        rate_hz = 1.0 / max(dt_s, 1.0e-6)
        c0_arr = np.asarray(meta.get("wfs2_cnt0", []), dtype=np.int64)
        fr_arr = np.asarray(meta.get("frames", []), dtype=np.int64)
        step_tol = (
            max(4, int(math.ceil(float(meta.get("full_step_frames", 67.0)))))
            if wf_pfx == "wf_full"
            else 4
        )

        pos = None
        if (
            c0_arr.size == n_clip_src
            and wfs2_cnt0_clip.size > 0
            and np.all(c0_arr > 0)
            and int(c0_arr[0]) <= int(wfs2_cnt0_clip[0]) + step_tol
            and int(c0_arr[-1]) >= int(wfs2_cnt0_clip[-1]) - step_tol
        ):
            pos = np.searchsorted(c0_arr, wfs2_cnt0_clip, side="left")
            pos = np.clip(pos, 0, n_clip_src - 1)
            prev = np.clip(pos - 1, 0, n_clip_src - 1)
            use_prev = np.abs(c0_arr[prev] - wfs2_cnt0_clip) < np.abs(
                c0_arr[pos] - wfs2_cnt0_clip
            )
            pos = np.where(use_prev, prev, pos)
            if int(np.max(np.abs(c0_arr[pos] - wfs2_cnt0_clip))) > step_tol:
                pos = None
        elif fr_arr.size == n_clip_src:
            t_clip = fr_arr.astype(np.float64) * dt_s
            t_tol = max(0.005, float(step_tol) * dt_s)
            if t_clip[0] <= float(t_grid[0]) + t_tol and t_clip[-1] >= float(t_grid[-1]) - t_tol:
                pos = np.searchsorted(t_clip, t_grid, side="left")
                pos = np.clip(pos, 0, n_clip_src - 1)
                prev = np.clip(pos - 1, 0, n_clip_src - 1)
                use_prev = np.abs(t_clip[prev] - t_grid) < np.abs(t_clip[pos] - t_grid)
                pos = np.where(use_prev, prev, pos)

        if pos is None:
            continue

        uniq, inv = np.unique(pos, return_inverse=True)
        s0, s1 = int(uniq[0]), int(uniq[-1]) + 1
        use_dense = (s1 - s0) <= max(64, 2 * int(uniq.size))
        out: dict[str, object] = {
            "map_idx": (pos - s0) if use_dense else inv,
            "rate_hz": rate_hz,
            "wf_src": wf_pfx,
            "dm_src": dm_pfx,
        }
        for key, fname in (
            ("wf_raw", f"{wf_pfx}_raw.fits"),
            ("wf_final", f"{wf_pfx}_final.fits"),
            ("dm1_opd", f"{dm_pfx}_opd_stg1.fits"),
            ("dm2_opd", f"{dm_pfx}_opd_stg2.fits"),
        ):
            fp = os.path.join(clip_dir, fname)
            if os.path.isfile(fp):
                with fits.open(fp, memmap=True) as hdul:
                    hdu = hdul[0] if hdul[0].data is not None else hdul[1]
                    if hdu.data.ndim == 3 and int(hdu.data.shape[0]) >= s1:
                        if use_dense:
                            out[key] = np.asarray(hdu.data[s0:s1], dtype=np.float32)
                        else:
                            buf = np.empty(
                                (int(uniq.size), int(hdu.data.shape[1]), int(hdu.data.shape[2])),
                                dtype=np.float32,
                            )
                            for di, li in enumerate(uniq):
                                buf[di] = np.asarray(hdu.data[int(li)], dtype=np.float32)
                            out[key] = buf
        if "wf_raw" in out:
            return out
    return None


def _slice_stream_at_times(
    telem_dir: str,
    stream_name: str,
    phys_time_s: float,
    nominal_rate_hz: float,
    t_query,
):
    """Discover and slice stream_name at query times t_query -> (cube, map_idx, rate_hz) or None."""
    import numpy as np

    pairs = discover_stream_cubes(telem_dir, stream_name)
    if not pairs:
        return None
    idx = TelemetryStreamIndex(stream_name, pairs, phys_time_s, nominal_rate_hz=nominal_rate_hz)
    if idx.n_frames == 0:
        return None
    pos = np.searchsorted(idx.t_phys_s, t_query + 1.0e-7, side="right") - 1
    pos = np.clip(pos, 0, idx.n_frames - 1)
    uniq, inv = np.unique(pos, return_inverse=True)
    s0 = int(uniq[0])
    s1 = int(uniq[-1]) + 1
    if (s1 - s0) <= max(64, 2 * int(uniq.size)):
        return idx.load_slice(s0, s1), (pos - s0), float(idx.rate_hz)
    return idx.load_indices(uniq), inv, float(idx.rate_hz)


def _load_wf_and_dm_panels(
    telem_dir: str,
    report_dir: str,
    bcfg: dict[str, object],
    phys_time_s: float,
    fs_stg1: float,
    fs_stg2: float,
    t_grid,
    wfs2_cnt0_clip,
    realtime: bool = False,
):
    """Load/reconstruct synchronized Incoming WF, DM1/DM2 shapes, and optional Residual WF."""
    import numpy as np
    from astropy.io import fits

    _, pmask, weights, ext_m = load_pupil_mask(telem_dir, report_dir, bcfg)
    nwf = int(pmask.shape[0])
    dms = list(bcfg.get("dms", []))
    dm1_cfg = (
        dms[0]
        if len(dms) >= 1
        else {
            "in_cmd": "dm01disp",
            "nact_x": 64,
            "nact_y": 64,
            "dm_diam": 0.984375,
            "if_coupling": 0.08,
            "dyn_mode": "plate",
            "plate_drive": "force",
            "rim_bc": "free",
            "f0_hz": 1000.0,
            "act_pitch_mm": 1.5,
            "wave_c": 14.0,
            "bend_beta": 0.0085,
            "delay_us": 1000.0,
            "refl_scale": 2.0,
        }
    )
    dm2_cfg = (
        dms[1]
        if len(dms) >= 2
        else {
            "in_cmd": "dm02disp",
            "nact_x": 50,
            "nact_y": 50,
            "dm_diam": 0.9986413,
            "if_coupling": 0.15,
            "dyn_mode": "1",
            "plate_drive": "disp",
            "delay_us": 500.0,
            "refl_scale": 2.0,
        }
    )

    clip_exact = _load_wfstat_clip(
        telem_dir, report_dir, t_grid, wfs2_cnt0_clip, realtime=realtime
    )

    # Lazy physics builders for DM1/DM2 fallback reconstruction
    stencil_cache: dict[int, tuple[object, object]] = {}
    plate_cache: dict[int, object] = {}

    def _get_dm_ops(stage: int, dcfg: dict[str, object], shape_yx: tuple[int, int]):
        if stage not in stencil_cache:
            ny_a, nx_a = shape_yx
            stencil_cache[stage] = _build_dm_stencil(
                nwf,
                nx_a,
                ny_a,
                float(dcfg.get("dm_diam", 0.9375)),
                float(dcfg.get("if_coupling", 0.15)),
                float(dcfg.get("refl_scale", 2.0)),
            )
            dcfg_eff = dict(dcfg)
            dcfg_eff["nact_x"] = nx_a
            dcfg_eff["nact_y"] = ny_a
            plate_cache[stage] = _build_plate_solver(dcfg_eff)
        return stencil_cache[stage], plate_cache[stage]

    # 1. Stage-1 DM1 Shape [nm]
    dm1_disp = None
    dm1_rms = None
    dm1_ptv = None
    dm1_midx = None
    dm1_src = "none"
    dm1_title = ""
    dm1_nx = int(dm1_cfg.get("nact_x", 64))
    dm1_ny = int(dm1_cfg.get("nact_y", 64))

    if clip_exact is not None and "dm1_opd" in clip_exact:
        dm1_disp, dm1_rms, dm1_ptv = _finalize_opd_cube(clip_exact["dm1_opd"], pmask, weights)
        dm1_midx = clip_exact["map_idx"]
        dm1_src = str(clip_exact.get("dm_src", "dm_clip"))
        dm1_title = (
            f"Stg 1 AO3k DM1 Shape ({dm1_nx}×{dm1_ny})\n"
            f"(csim_dm01_opd, {_fmt_rate_hz(float(clip_exact['rate_hz']))})"
        )
    else:
        res_opd1 = _slice_stream_at_times(telem_dir, "csim_dm01_opd", phys_time_s, fs_stg2, t_grid)
        if res_opd1 is not None:
            cube1, dm1_midx, r1 = res_opd1
            dm1_disp, dm1_rms, dm1_ptv = _finalize_opd_cube(cube1 * 1000.0, pmask, weights)
            dm1_src = "csim_dm01_opd"
            dm1_title = (
                f"Stg 1 AO3k DM1 Shape ({dm1_nx}×{dm1_ny})\n"
                f"(csim_dm01_opd, {_fmt_rate_hz(r1)})"
            )
        else:
            delay1_s = float(dm1_cfg.get("delay_us", 1000.0)) * 1.0e-6
            t_dm1_q = np.maximum(t_grid - delay1_s, 0.0)
            in_cmd1 = str(dm1_cfg.get("in_cmd", "dm01disp"))
            cands1 = (
                [("dm01shaped", fs_stg2), ("dm01disp", fs_stg1), ("aol1_dmC", fs_stg1)]
                if in_cmd1 == "dm01shaped"
                else [("dm01disp", fs_stg1), ("dm01shaped", fs_stg2), ("aol1_dmC", fs_stg1)]
            )
            for sname1, nom1 in cands1:
                res1 = _slice_stream_at_times(telem_dir, sname1, phys_time_s, nom1, t_dm1_q)
                if res1 is not None:
                    cmd1, dm1_midx, r1 = res1
                    dm1_ny, dm1_nx = int(cmd1.shape[1]), int(cmd1.shape[2])
                    (idxs1, ws1), psolve1 = _get_dm_ops(1, dm1_cfg, (dm1_ny, dm1_nx))
                    surf1 = psolve1(cmd1) if psolve1 is not None else cmd1
                    opd1_nm = _apply_dm_stencil(surf1, idxs1, ws1, nwf) * 1000.0
                    dm1_disp, dm1_rms, dm1_ptv = _finalize_opd_cube(opd1_nm, pmask, weights)
                    dm1_src = f"{sname1}_{'plate' if psolve1 is not None else 'stencil'}"
                    dm1_title = (
                        f"Stg 1 AO3k DM1 Shape ({dm1_nx}×{dm1_ny})\n"
                        f"({sname1} → Pupil OPD, {_fmt_rate_hz(r1)})"
                    )
                    break

    # 2. Stage-2 DM2 Shape [nm]
    dm2_disp = None
    dm2_rms = None
    dm2_ptv = None
    dm2_midx = None
    dm2_src = "open"
    dm2_is_open = False
    dm2_nx = int(dm2_cfg.get("nact_x", 50))
    dm2_ny = int(dm2_cfg.get("nact_y", 50))
    dm2_title = f"Stg 2 SCExAO DM2 Shape ({dm2_nx}×{dm2_ny})\n(Stage-2 Loop Open)"

    if clip_exact is not None and "dm2_opd" in clip_exact:
        dm2_disp, dm2_rms, dm2_ptv = _finalize_opd_cube(clip_exact["dm2_opd"], pmask, weights)
        dm2_midx = clip_exact["map_idx"]
        dm2_src = str(clip_exact.get("dm_src", "dm_clip"))
        dm2_is_open = float(np.max(dm2_rms)) < 1.0e-3
        dm2_title = (
            f"Stg 2 SCExAO DM2 Shape ({dm2_nx}×{dm2_ny})\n"
            + (
                "(csim_dm02_opd, Loop Open)"
                if dm2_is_open
                else f"(csim_dm02_opd, {_fmt_rate_hz(float(clip_exact['rate_hz']))})"
            )
        )
    else:
        res_opd2 = _slice_stream_at_times(telem_dir, "csim_dm02_opd", phys_time_s, fs_stg2, t_grid)
        if res_opd2 is not None:
            cube2, dm2_midx, r2 = res_opd2
            dm2_disp, dm2_rms, dm2_ptv = _finalize_opd_cube(cube2 * 1000.0, pmask, weights)
            dm2_src = "csim_dm02_opd"
            dm2_is_open = float(np.max(dm2_rms)) < 1.0e-3
            dm2_title = (
                f"Stg 2 SCExAO DM2 Shape ({dm2_nx}×{dm2_ny})\n"
                f"(csim_dm02_opd, {_fmt_rate_hz(r2)})"
            )
        else:
            delay2_s = float(dm2_cfg.get("delay_us", 500.0)) * 1.0e-6
            t_dm2_q = np.maximum(t_grid - delay2_s, 0.0)
            for sname2, nom2 in (("dm02disp", fs_stg2), ("aol2_dmC", fs_stg2)):
                res2 = _slice_stream_at_times(telem_dir, sname2, phys_time_s, nom2, t_dm2_q)
                if res2 is not None:
                    cmd2, dm2_midx, r2 = res2
                    dm2_ny, dm2_nx = int(cmd2.shape[1]), int(cmd2.shape[2])
                    (idxs2, ws2), psolve2 = _get_dm_ops(2, dm2_cfg, (dm2_ny, dm2_nx))
                    surf2 = psolve2(cmd2) if psolve2 is not None else cmd2
                    opd2_nm = _apply_dm_stencil(surf2, idxs2, ws2, nwf) * 1000.0
                    dm2_disp, dm2_rms, dm2_ptv = _finalize_opd_cube(opd2_nm, pmask, weights)
                    dm2_src = f"{sname2}_stencil"
                    dm2_is_open = float(np.max(dm2_rms)) < 1.0e-3
                    dm2_title = (
                        f"Stg 2 SCExAO DM2 Shape ({dm2_nx}×{dm2_ny})\n"
                        f"({sname2} → Pupil OPD, {_fmt_rate_hz(r2)})"
                    )
                    break

    if dm2_disp is None:
        z_map = np.zeros((1, nwf, nwf), dtype=np.float32)
        z_map[:, ~pmask] = np.nan
        dm2_disp = z_map
        dm2_rms = np.zeros(1, dtype=np.float64)
        dm2_ptv = np.zeros(1, dtype=np.float64)
        dm2_midx = np.zeros(int(t_grid.size), dtype=np.int64)
        dm2_is_open = True

    # 3. True Incoming Pupil WF [nm] (b_pup / wf_clip_raw / outarraypha)
    wf_in_disp = None
    wf_in_rms = None
    wf_in_ptv = None
    wf_in_midx = None
    wf_in_src = "none"
    wf_in_title = ""
    wf_in_rate_hz = fs_stg2

    if clip_exact is not None and "wf_raw" in clip_exact:
        wf_in_disp, wf_in_rms, wf_in_ptv = _finalize_opd_cube(clip_exact["wf_raw"], pmask, weights)
        wf_in_midx = clip_exact["map_idx"]
        wf_in_src = str(clip_exact.get("wf_src", "wf_clip"))
        wf_in_rate_hz = float(clip_exact["rate_hz"])
        wf_in_title = (
            f"Incoming Pupil WF\n(b_pup, {_fmt_rate_hz(wf_in_rate_hz)}, {nwf}×{nwf})"
        )
    else:
        res_bpup = _slice_stream_at_times(telem_dir, "b_pup", phys_time_s, fs_stg2, t_grid)
        if res_bpup is not None:
            bp_c, wf_in_midx, r_bp = res_bpup
            wf_in_disp, wf_in_rms, wf_in_ptv = _finalize_opd_cube(bp_c * 1000.0, pmask, weights)
            wf_in_src = "b_pup"
            wf_in_rate_hz = r_bp
            wf_in_title = f"Incoming Pupil WF\n(b_pup, {_fmt_rate_hz(r_bp)}, {nwf}×{nwf})"
        else:
            res_pha = _slice_stream_at_times(telem_dir, "outarraypha", phys_time_s, fs_stg2, t_grid)
            if res_pha is not None:
                pha_c, wf_in_midx, r_ph = res_pha
                wf_unit = int(bcfg.get("wf_unit", 1))
                ref_lam = float(bcfg.get("ref_lambda", 0.50))
                scale_nm = (ref_lam * 1000.0 / (2.0 * math.pi)) if wf_unit == 1 else 1000.0
                wf_in_disp, wf_in_rms, wf_in_ptv = _finalize_opd_cube(
                    pha_c * scale_nm, pmask, weights
                )
                wf_in_src = "outarraypha"
                wf_in_rate_hz = r_ph
                wf_in_title = f"Incoming Atm WF\n(outarraypha, {_fmt_rate_hz(r_ph)}, {nwf}×{nwf})"

    # 4. PSOL Reconstructed Pupil WF [nm] (aol1_modevalOL + Stage-1 CMmodesDM -> DM1 pupil OPD,
    #    plus Stage-1 passive petal-unwrap dm01disp06 offset when aol1_petal_cmd is active)
    psol_disp = None
    psol_rms = None
    psol_ptv = None
    psol_midx = None
    psol_src = "none"
    psol_title = ""

    cm1_p = os.path.join(telem_dir, "calib_stg1", "CMmodesDM.fits")
    res_ol = _slice_stream_at_times(telem_dir, "aol1_modevalOL", phys_time_s, fs_stg1, t_grid)
    if res_ol is not None and os.path.isfile(cm1_p):
        ol_c, psol_midx, r_ol = res_ol
        cm1 = np.asarray(fits.getdata(cm1_p), dtype=np.float32)
        if cm1.ndim == 3:
            ol_2d = ol_c.reshape(ol_c.shape[0], -1)
            nmode = min(int(ol_2d.shape[1]), int(cm1.shape[0]))
            psol_cmd = -np.tensordot(ol_2d[:, :nmode], cm1[:nmode], axes=(1, 0))
            ny_c, nx_c = int(cm1.shape[1]), int(cm1.shape[2])
            (idxs1, ws1), psolve1 = _get_dm_ops(1, dm1_cfg, (ny_c, nx_c))
            psol_surf = psolve1(psol_cmd) if psolve1 is not None else psol_cmd
            psol_opd = _apply_dm_stencil(psol_surf, idxs1, ws1, nwf) * 1000.0
            psol_src = "aol1_modevalOL"
            psol_title = f"PSOL Recon. WF\n(aol1_modevalOL, {_fmt_rate_hz(r_ol)})"

            # Include atomic integer-wave petal-unwrapper offset (dm01disp06) when active:
            # mfilt-1 computes aol1_modevalOL from dm01disp04 only, so total Stage-1 PSOL
            # reconstruction of the incoming wavefront adds dm01disp06 = w_enws @ petalDM.
            pdm_cands = [
                os.path.join(report_dir, "petal_ctrl", "petal_dm_modes.fits"),
                os.path.join(os.path.dirname(telem_dir), "petal_ctrl", "petal_dm_modes.fits"),
                os.path.join(telem_dir, "calib_stg1", "petal_dm_modes.fits"),
            ]
            pdm_p = next((p for p in pdm_cands if os.path.isfile(p)), None)
            if pdm_p is not None:
                delay1_s = float(dm1_cfg.get("delay_us", 1000.0)) * 1.0e-6
                t_pet_q = np.maximum(t_grid - delay1_s, 0.0)
                res_pet = _slice_stream_at_times(
                    telem_dir, "aol1_petal_cmd", phys_time_s, fs_stg1, t_pet_q
                )
                if res_pet is not None:
                    pet_c, pet_midx, _ = res_pet
                    pet_2d = pet_c.reshape(pet_c.shape[0], -1)
                    if pet_2d.shape[1] >= 4 and bool(np.any(np.abs(pet_2d[:, :4]) > 1.0e-9)):
                        pdm = np.asarray(fits.getdata(pdm_p), dtype=np.float32)
                        if pdm.ndim == 3 and pdm.shape == (4, ny_c, nx_c):
                            step_scale = 1.0
                            for ps_p in (
                                os.path.join(report_dir, "petal_stats.json"),
                                os.path.join(os.path.dirname(telem_dir), "petal_stats.json"),
                            ):
                                if os.path.isfile(ps_p):
                                    try:
                                        with open(ps_p, "r", encoding="utf-8") as fh:
                                            step_scale = float(json.load(fh).get("step_scale", 1.0))
                                    except (OSError, ValueError, TypeError):
                                        step_scale = 1.0
                                    break
                            pdm_surf = psolve1(pdm) if psolve1 is not None else pdm
                            pdm_opd = (
                                _apply_dm_stencil(pdm_surf, idxs1, ws1, nwf)
                                * (1000.0 * step_scale)
                            )
                            pairs = np.stack([psol_midx, pet_midx], axis=1)
                            uniq_pairs, inv_pairs = np.unique(pairs, axis=0, return_inverse=True)
                            pet_opd_u = np.tensordot(
                                pet_2d[uniq_pairs[:, 1], :4], pdm_opd, axes=(1, 0)
                            )
                            psol_opd = psol_opd[uniq_pairs[:, 0]] + pet_opd_u
                            psol_midx = inv_pairs
                            psol_src = "aol1_modevalOL+petal"
                            psol_title = (
                                f"PSOL Recon. WF\n(modevalOL + petal, {_fmt_rate_hz(r_ol)})"
                            )

            psol_disp, psol_rms, psol_ptv = _finalize_opd_cube(psol_opd, pmask, weights)

    # 5. Optional Exact Final Residual Pupil WF [nm] (b_post_stg2 / wf_clip_final)
    wf_res_disp = None
    wf_res_rms = None
    wf_res_ptv = None
    wf_res_midx = None
    wf_res_src = "none"
    wf_res_title = ""

    if clip_exact is not None and "wf_final" in clip_exact:
        wf_res_disp, wf_res_rms, wf_res_ptv = _finalize_opd_cube(
            clip_exact["wf_final"], pmask, weights
        )
        wf_res_midx = clip_exact["map_idx"]
        wf_res_src = str(clip_exact.get("wf_src", "wf_clip"))
        wf_res_title = (
            f"Final Residual Pupil WF\n"
            f"(b_post_stg2, {_fmt_rate_hz(float(clip_exact['rate_hz']))}, {nwf}×{nwf})"
        )
    else:
        res_bfin = _slice_stream_at_times(telem_dir, "b_post_stg2", phys_time_s, fs_stg2, t_grid)
        if res_bfin is not None:
            bf_c, wf_res_midx, r_bf = res_bfin
            wf_res_disp, wf_res_rms, wf_res_ptv = _finalize_opd_cube(bf_c * 1000.0, pmask, weights)
            wf_res_src = "b_post_stg2"
            wf_res_title = (
                f"Final Residual Pupil WF\n(b_post_stg2, {_fmt_rate_hz(r_bf)}, {nwf}×{nwf})"
            )

    panels: list[dict[str, object]] = []
    if wf_in_disp is not None and psol_disp is not None and dm1_disp is not None:
        # Both true Incoming WF and PSOL reconstruction available:
        # 5-panel Row 0: Incoming WF | PSOL Recon. WF | Diff (Incoming - PSOL) | DM1 | DM2
        in_at_t = np.nan_to_num(wf_in_disp[wf_in_midx], nan=0.0)
        ps_at_t = np.nan_to_num(psol_disp[psol_midx], nan=0.0)
        diff_disp, diff_rms, diff_ptv = _finalize_opd_cube(in_at_t - ps_at_t, pmask, weights)
        diff_midx = np.arange(int(t_grid.size), dtype=np.int64)
        diff_src_lbl = "b_pup" if wf_in_src in ("wf_clip", "wf_full", "b_pup") else wf_in_src
        diff_title = (
            f"Diff: Incoming − PSOL\n({diff_src_lbl} − PSOL, {_fmt_rate_hz(wf_in_rate_hz)})"
        )

        vlim_in = _nice_opd_vlim(wf_in_disp, pmask, min_lim=25.0)
        vlim_psol = _nice_opd_vlim(psol_disp, pmask, min_lim=25.0)
        vlim_dm1 = _nice_opd_vlim(dm1_disp, pmask, min_lim=25.0)
        vlim_shared = max(vlim_in, vlim_psol, vlim_dm1)
        vlim_diff = _nice_opd_vlim(diff_disp, pmask, min_lim=25.0)

        dm1_t5 = dm1_title.replace("DM1 Shape ", "DM1 ")
        dm2_t5 = dm2_title.replace("DM2 Shape ", "DM2 ")
        panels.extend(
            [
                {
                    "key": "wf_in",
                    "title": wf_in_title,
                    "cube": wf_in_disp,
                    "rms": wf_in_rms,
                    "ptv": wf_in_ptv,
                    "map_idx": wf_in_midx,
                    "vlim": vlim_shared,
                    "source": wf_in_src,
                    "is_open": False,
                },
                {
                    "key": "wf_psol",
                    "title": psol_title,
                    "cube": psol_disp,
                    "rms": psol_rms,
                    "ptv": psol_ptv,
                    "map_idx": psol_midx,
                    "vlim": vlim_shared,
                    "source": psol_src,
                    "is_open": False,
                },
                {
                    "key": "wf_diff",
                    "title": diff_title,
                    "cube": diff_disp,
                    "rms": diff_rms,
                    "ptv": diff_ptv,
                    "map_idx": diff_midx,
                    "vlim": vlim_diff,
                    "source": f"{wf_in_src}-psol",
                    "is_open": False,
                },
                {
                    "key": "dm1",
                    "title": dm1_t5,
                    "cube": dm1_disp,
                    "rms": dm1_rms,
                    "ptv": dm1_ptv,
                    "map_idx": dm1_midx,
                    "vlim": vlim_shared,
                    "source": dm1_src,
                    "is_open": False,
                },
                {
                    "key": "dm2",
                    "title": dm2_t5,
                    "cube": dm2_disp,
                    "rms": dm2_rms,
                    "ptv": dm2_ptv,
                    "map_idx": dm2_midx,
                    "vlim": _nice_opd_vlim(dm2_disp, pmask, min_lim=10.0),
                    "source": dm2_src,
                    "is_open": dm2_is_open,
                },
            ]
        )
    elif wf_in_disp is not None and dm1_disp is not None:
        # True Incoming WF without PSOL stream: 3 or 4 panels (with optional Final Residual WF)
        vlim_in = _nice_opd_vlim(wf_in_disp, pmask, min_lim=25.0)
        vlim_dm1 = _nice_opd_vlim(dm1_disp, pmask, min_lim=25.0)
        vlim_shared = max(vlim_in, vlim_dm1)
        panels.extend(
            [
                {
                    "key": "wf_in",
                    "title": wf_in_title,
                    "cube": wf_in_disp,
                    "rms": wf_in_rms,
                    "ptv": wf_in_ptv,
                    "map_idx": wf_in_midx,
                    "vlim": vlim_shared,
                    "source": wf_in_src,
                    "is_open": False,
                },
                {
                    "key": "dm1",
                    "title": dm1_title,
                    "cube": dm1_disp,
                    "rms": dm1_rms,
                    "ptv": dm1_ptv,
                    "map_idx": dm1_midx,
                    "vlim": vlim_shared,
                    "source": dm1_src,
                    "is_open": False,
                },
                {
                    "key": "dm2",
                    "title": dm2_title,
                    "cube": dm2_disp,
                    "rms": dm2_rms,
                    "ptv": dm2_ptv,
                    "map_idx": dm2_midx,
                    "vlim": _nice_opd_vlim(dm2_disp, pmask, min_lim=10.0),
                    "source": dm2_src,
                    "is_open": dm2_is_open,
                },
            ]
        )
        if wf_res_disp is not None:
            panels.append(
                {
                    "key": "wf_res",
                    "title": wf_res_title,
                    "cube": wf_res_disp,
                    "rms": wf_res_rms,
                    "ptv": wf_res_ptv,
                    "map_idx": wf_res_midx,
                    "vlim": _nice_opd_vlim(wf_res_disp, pmask, min_lim=25.0),
                    "source": wf_res_src,
                    "is_open": False,
                }
            )
    elif psol_disp is not None and dm1_disp is not None:
        # Legacy telemetry without true incoming WF cube: 3 centered panels clearly labeled PSOL
        wf_in_src = "psol"
        vlim_psol = _nice_opd_vlim(psol_disp, pmask, min_lim=25.0)
        vlim_dm1 = _nice_opd_vlim(dm1_disp, pmask, min_lim=25.0)
        vlim_shared = max(vlim_psol, vlim_dm1)
        panels.extend(
            [
                {
                    "key": "wf_psol",
                    "title": psol_title,
                    "cube": psol_disp,
                    "rms": psol_rms,
                    "ptv": psol_ptv,
                    "map_idx": psol_midx,
                    "vlim": vlim_shared,
                    "source": psol_src,
                    "is_open": False,
                },
                {
                    "key": "dm1",
                    "title": dm1_title,
                    "cube": dm1_disp,
                    "rms": dm1_rms,
                    "ptv": dm1_ptv,
                    "map_idx": dm1_midx,
                    "vlim": vlim_shared,
                    "source": dm1_src,
                    "is_open": False,
                },
                {
                    "key": "dm2",
                    "title": dm2_title,
                    "cube": dm2_disp,
                    "rms": dm2_rms,
                    "ptv": dm2_ptv,
                    "map_idx": dm2_midx,
                    "vlim": _nice_opd_vlim(dm2_disp, pmask, min_lim=10.0),
                    "source": dm2_src,
                    "is_open": dm2_is_open,
                },
            ]
        )

    return {
        "panels": panels,
        "ext_m": ext_m,
        "wf_in_source": wf_in_src,
        "psol_source": psol_src,
        "dm1_source": dm1_src,
        "dm2_source": dm2_src,
        "wf_res_source": wf_res_src,
    }


def normalize_psf_to_strehl(
    raw_cube,
    report_dir: str,
    bkey: str,
    skey: str,
    bias_adu: float = 100.0,
):
    """Convert raw fpcam ADU frames into Strehl-normalized intensity units."""
    import numpy as np
    from astropy.io import fits

    dl_p = os.path.join(report_dir, f"psf_{bkey}_dl.fits")
    det_dl_p = os.path.join(report_dir, f"det_{bkey}_{skey}_dl.fits")
    sub = np.maximum(raw_cube.astype(np.float64) - bias_adu, 0.0)
    _, ny, nx = sub.shape
    c0 = nx // 2
    yy, xx = np.indices((ny, nx), dtype=np.float64)
    core_m = np.hypot(xx - c0, yy - c0) <= 20.0
    fov_m = np.hypot(xx - c0, yy - c0) <= (0.45 * nx)

    adu_per_sr = None
    if os.path.isfile(dl_p) and os.path.isfile(det_dl_p):
        dl_img = np.asarray(fits.getdata(dl_p), dtype=np.float64)
        det_dl = np.asarray(fits.getdata(det_dl_p), dtype=np.float64)
        if dl_img.shape == (ny, nx) and det_dl.shape == (ny, nx):
            dl_core = max(float(np.sum(dl_img[core_m])), 1.0e-9)
            det_sub = np.maximum(det_dl - bias_adu, 0.0)
            base_adu_sr = max(float(np.sum(det_sub[core_m])) / dl_core, 1.0e-6)
            # Guard against exposure-rate change between Step-2 det_dl and telemetry cube
            det_tot = float(np.sum(det_sub[fov_m]))
            cube_tot = float(np.median(np.sum(sub[:, fov_m], axis=1)))
            if det_tot > 1.0 and cube_tot > 1.0:
                ratio = cube_tot / det_tot
                if ratio < 0.45 or ratio > 2.2:
                    base_adu_sr *= ratio
            adu_per_sr = base_adu_sr

    if adu_per_sr is None and os.path.isfile(dl_p):
        dl_img = np.asarray(fits.getdata(dl_p), dtype=np.float64)
        if dl_img.shape == (ny, nx):
            dl_tot = max(float(np.sum(dl_img[fov_m])), 1.0e-9)
            cube_tot = max(float(np.median(np.sum(sub[:, fov_m], axis=1))), 1.0)
            adu_per_sr = cube_tot / dl_tot

    if adu_per_sr is None or adu_per_sr <= 0.0:
        adu_per_sr = max(float(np.percentile(sub, 99.99)), 1.0)

    return (sub / adu_per_sr).astype(np.float32)


def render_telemetry_video(
    telem_dir: str,
    report_dir: str,
    out_mp4: str,
    poster_png: str | None = None,
    meta_json: str | None = None,
    t_start_req: float = 5.0,
    duration_ms: float = 200.0,
    fps: int = 30,
    realtime: bool = False,
) -> dict[str, object]:
    """Slice telemetry cubes around [t_start, t_start + duration] and encode H.264 MP4 + poster."""
    import matplotlib

    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    from matplotlib.colors import Normalize
    from matplotlib.gridspec import GridSpec
    from matplotlib.patches import Circle
    from matplotlib.ticker import MaxNLocator
    import numpy as np

    t_wall0 = time.monotonic()
    ffmpeg_bin = find_ffmpeg_bin()
    if not ffmpeg_bin:
        raise RuntimeError("ffmpeg binary not found (install imageio-ffmpeg or set FFMPEG_BIN)")

    manifest: dict[str, object] = {}
    man_json_p = os.path.join(telem_dir, "telemetry_manifest.json")
    if os.path.isfile(man_json_p):
        with open(man_json_p, "r", encoding="utf-8") as fh:
            manifest = json.load(fh)

    phys_time_s = float(manifest.get("phys_time_s", 10.0))
    seeing_arcsec = float(manifest.get("seeing_arcsec", 0.60))
    fs_stg1 = float(manifest.get("fs_stg1_hz", 1000.0))
    fs_stg2 = float(manifest.get("fs_stg2_hz", 2000.0))
    psf_navg = max(1, int(manifest.get("psf_navg", 20)))
    nom_psf_hz = fs_stg2 / float(psf_navg)

    bench_cands = [
        os.path.join(report_dir, "ao3k_scexao.bench"),
        os.path.join(os.path.dirname(report_dir), "ao3k_scexao.bench"),
    ]
    bench_p = next((p for p in bench_cands if os.path.isfile(p)), None)
    bcfg = parse_bench_config(bench_p)
    tel_diam_m = float(manifest.get("tel_diam_m", bcfg.get("tel_diam_m", TEL_DIAM_M)))
    bcfg["tel_diam_m"] = tel_diam_m
    star_mag = float(bcfg.get("star_mag", 6.0))
    outer_hz = float(bcfg.get("master_hz", fs_stg2))
    oversample = int(round(float(bcfg.get("oversample", 4.0))))
    internal_hz = outer_hz * oversample
    internal_dt_us = 1.0e6 / max(internal_hz, 1.0)

    req_streams = {
        "wfs1": ("csim_wfs_nir", fs_stg1),
        "wfs2": ("csim_wfs_vis", fs_stg2),
        "psf_vis_stg1": ("psf_vis_stg1", nom_psf_hz),
        "psf_vis_final": ("psf_vis_final", nom_psf_hz),
        "psf_nir_stg1": ("psf_nir_stg1", nom_psf_hz),
        "psf_nir_final": ("psf_nir_final", nom_psf_hz),
    }
    indices: dict[str, TelemetryStreamIndex] = {}
    for key, (sname, nom_hz) in req_streams.items():
        pairs = discover_stream_cubes(telem_dir, sname)
        if not pairs:
            raise FileNotFoundError(f"Missing telemetry cube for stream '{sname}' in {telem_dir}")
        idx = TelemetryStreamIndex(sname, pairs, phys_time_s, nominal_rate_hz=nom_hz)
        if idx.n_frames == 0:
            raise RuntimeError(f"Empty telemetry cube for stream '{sname}' in {telem_dir}")
        indices[key] = idx

    t_max_avail = min(float(idx.t_phys_s[-1]) for idx in indices.values())
    t_min_avail = max(float(idx.t_phys_s[0]) for idx in indices.values())
    wfs2_t = indices["wfs2"].t_phys_s
    wfs2_c0 = indices["wfs2"].cnt0

    if realtime:
        phys_span_s = max(t_max_avail - t_min_avail, 1.0 / max(indices["wfs2"].rate_hz, 1.0))
        n_vid = max(2, int(round(phys_span_s * float(max(fps, 1)))))
        i2_sel = None
        _, full_mp = _find_wfstat_meta(telem_dir, report_dir, "wf_full")
        if full_mp is not None:
            try:
                with open(full_mp, "r", encoding="utf-8") as fh:
                    fmeta = json.load(fh)
                fc0 = np.asarray(fmeta.get("wfs2_cnt0", []), dtype=np.int64)
                if (
                    fc0.size >= 2
                    and np.all(fc0 > 0)
                    and abs(int(fc0.size) - n_vid) <= max(3, int(round(0.10 * n_vid)))
                ):
                    p = np.clip(np.searchsorted(wfs2_c0, fc0, side="left"), 0, wfs2_c0.size - 1)
                    prev = np.clip(p - 1, 0, wfs2_c0.size - 1)
                    p = np.where(np.abs(wfs2_c0[prev] - fc0) < np.abs(wfs2_c0[p] - fc0), prev, p)
                    # Keep samples strictly within [t_min_avail, t_max_avail]
                    valid_t = (wfs2_t[p] >= t_min_avail - 1.0e-5) & (
                        wfs2_t[p] <= t_max_avail + 1.0e-5
                    )
                    if int(np.sum(valid_t)) >= 2:
                        i2_sel = p[valid_t]
            except (OSError, json.JSONDecodeError):
                i2_sel = None
        if i2_sel is None:
            t_targets = np.linspace(t_min_avail, t_max_avail, n_vid)
            p = np.clip(np.searchsorted(wfs2_t, t_targets, side="left"), 0, wfs2_t.size - 1)
            prev = np.clip(p - 1, 0, wfs2_t.size - 1)
            i2_sel = np.where(
                np.abs(wfs2_t[prev] - t_targets) < np.abs(wfs2_t[p] - t_targets), prev, p
            )
        t_grid = wfs2_t[i2_sel]
        wfs2_cnt0_clip = wfs2_c0[i2_sel]
        n_clip = int(t_grid.size)
        t0_actual = float(t_grid[0])
        t1_actual = float(t_grid[-1])
        actual_dur_ms = max(
            (t1_actual - t0_actual) * 1000.0,
            1000.0 / max(indices["wfs2"].rate_hz, 1.0),
        )
        dt_step_ms = actual_dur_ms / float(max(n_clip - 1, 1))
        slowdown = (n_clip / float(max(fps, 1))) / max(actual_dur_ms * 1.0e-3, 1.0e-6)
    else:
        dur_s = min(max(duration_ms * 1.0e-3, 0.010), max(t_max_avail - t_min_avail, 0.010))
        t_start = float(t_start_req)
        if t_start + dur_s > t_max_avail - 1.0e-6:
            t_start = max(t_min_avail, 0.5 * (t_min_avail + t_max_avail - dur_s))
        t_start = max(t_start, t_min_avail)
        t_end = min(t_max_avail, t_start + dur_s)

        # Step on Stage-2 WFS outer grid (0.50 ms @ 2.0 kHz)
        i2_0 = int(np.searchsorted(wfs2_t, t_start - 1.0e-7, side="left"))
        i2_1 = int(np.searchsorted(wfs2_t, t_end + 1.0e-7, side="right"))
        i2_1 = max(i2_0 + 2, min(i2_1, indices["wfs2"].n_frames))
        t_grid = wfs2_t[i2_0:i2_1]
        wfs2_cnt0_clip = wfs2_c0[i2_0:i2_1]
        n_clip = int(t_grid.size)
        t0_actual = float(t_grid[0])
        t1_actual = float(t_grid[-1])
        dt_step_ms = 1000.0 / max(indices["wfs2"].rate_hz, 1.0)
        actual_dur_ms = max((t1_actual - t0_actual) * 1000.0, dt_step_ms)
        slowdown = (1000.0 / dt_step_ms) / float(max(fps, 1))

    # Extract only the needed frames from each stream via memmap (sparse-safe for 10s realtime)
    sliced_cubes: dict[str, np.ndarray] = {}
    map_idx: dict[str, np.ndarray] = {}
    abs_idx: dict[str, np.ndarray] = {}
    for key, idx in indices.items():
        pos = np.searchsorted(idx.t_phys_s, t_grid + 1.0e-7, side="right") - 1
        pos = np.clip(pos, 0, idx.n_frames - 1)
        uniq, inv = np.unique(pos, return_inverse=True)
        s0 = int(uniq[0])
        s1 = int(uniq[-1]) + 1
        if (s1 - s0) <= max(64, 2 * int(uniq.size)):
            sliced_cubes[key] = idx.load_slice(s0, s1)
            map_idx[key] = pos - s0
        else:
            sliced_cubes[key] = idx.load_indices(uniq)
            map_idx[key] = inv
        abs_idx[key] = pos + 1  # 1-based exposure index

    # Load synchronized Incoming Pupil WF, Stage-1/Stage-2 DM shapes, and optional Residual WF
    wf_dm_info = _load_wf_and_dm_panels(
        telem_dir=telem_dir,
        report_dir=report_dir,
        bcfg=bcfg,
        phys_time_s=phys_time_s,
        fs_stg1=fs_stg1,
        fs_stg2=fs_stg2,
        t_grid=t_grid,
        wfs2_cnt0_clip=wfs2_cnt0_clip,
        realtime=realtime,
    )
    wf_dm_panels = list(wf_dm_info["panels"])
    has_wf_dm_row = len(wf_dm_panels) > 0
    ext_m = wf_dm_info["ext_m"]

    # Reference-subtracted WFS signals (exact acquireWFSim formula using calib_stg{1,2})
    wfs1_raw = sliced_cubes["wfs1"]
    wfs2_raw = sliced_cubes["wfs2"]
    wfs1_sig = compute_wfs_refsub(wfs1_raw, os.path.join(telem_dir, "calib_stg1"))
    wfs2_sig = compute_wfs_refsub(wfs2_raw, os.path.join(telem_dir, "calib_stg2"))

    # Strehl-normalized PSF slices & ROI crops
    psf_sr: dict[tuple[str, str], np.ndarray] = {}
    psf_ext: dict[str, list[float]] = {}
    psf_ld_arcsec: dict[str, float] = {}
    psf_peak_sr: dict[tuple[str, str], np.ndarray] = {}

    for bkey, bm in BAND_META.items():
        ld_mas = (bm["lam_um"] * 1.0e-6 / tel_diam_m) * RAD2MAS
        pix_arcsec = (ld_mas / bm["pixscale_ld"]) / 1000.0
        psf_ld_arcsec[bkey] = ld_mas / 1000.0
        for skey in ("stg1", "final"):
            raw_s = sliced_cubes[f"psf_{bkey}_{skey}"]
            sr_full = normalize_psf_to_strehl(raw_s, report_dir, bkey, skey)
            _, ny, nx = sr_full.shape
            c0 = nx // 2
            hw = min(c0, int(round(bm["fov_arcsec"] / pix_arcsec)))
            psf_ext[bkey] = [
                -hw * pix_arcsec,
                hw * pix_arcsec,
                -hw * pix_arcsec,
                hw * pix_arcsec,
            ]
            crop = sr_full[:, c0 - hw : c0 + hw, c0 - hw : c0 + hw]
            # Peak Strehl within central core (r <= 12 pix around center)
            yy, xx = np.indices((ny, nx), dtype=np.float64)
            cmask = np.hypot(xx - c0, yy - c0) <= 16.0
            pk = np.max(sr_full[:, cmask], axis=1) * 100.0
            psf_peak_sr[(bkey, skey)] = pk[map_idx[f"psf_{bkey}_{skey}"]]
            # Pre-compute log10 intensity in [-4, 0] for fast linear Normalize rendering
            psf_sr[(bkey, skey)] = np.log10(np.clip(crop, 1.0e-4, 1.0)).astype(np.float32)

    # Load synchronized WFE time-series slice from wf_timeseries.csv (or modal fallback)
    t_rel_ms = (t_grid - t0_actual) * 1000.0
    wfe_stg1_nm = None
    wfe_final_nm = None
    wf_csv_p = os.path.join(report_dir, "wf_timeseries.csv")
    if os.path.isfile(wf_csv_p):
        try:
            wf_tbl = np.loadtxt(wf_csv_p, delimiter=",", skiprows=1, ndmin=2)
            if wf_tbl.ndim == 2 and wf_tbl.shape[1] >= 5 and wf_tbl.shape[0] > 2:
                tw = wf_tbl[:, 1]
                wfe_stg1_nm = np.interp(t_grid, tw, wf_tbl[:, 3])
                wfe_final_nm = np.interp(t_grid, tw, wf_tbl[:, 4])
        except Exception:
            wfe_stg1_nm = None

    wfe_label_mode = "pupil"
    if wfe_stg1_nm is None or wfe_final_nm is None:
        # Fallback to modal WFS residual RMS if wf_timeseries.csv is absent
        wfe_label_mode = "modal"
        modal_specs = [
            ("stg1", "aol1_modevalWFS", fs_stg1),
            ("final", "aol2_modevalWFS", fs_stg2),
        ]
        for tag, sname, fs_m in modal_specs:
            mpairs = discover_stream_cubes(telem_dir, sname)
            if mpairs:
                midx = TelemetryStreamIndex(sname, mpairs, phys_time_s, nominal_rate_hz=fs_m)
                mpos = np.clip(
                    np.searchsorted(midx.t_phys_s, t_grid + 1.0e-7, side="right") - 1,
                    0,
                    midx.n_frames - 1,
                )
                m_uniq, m_inv = np.unique(mpos, return_inverse=True)
                mcube = midx.load_indices(m_uniq).reshape(int(m_uniq.size), -1)
                mrms = np.sqrt(np.sum(mcube.astype(np.float64) ** 2, axis=1)) * 1000.0
                if tag == "stg1":
                    wfe_stg1_nm = mrms[m_inv]
                else:
                    wfe_final_nm = mrms[m_inv]
        if wfe_stg1_nm is None:
            wfe_stg1_nm = np.zeros_like(t_rel_ms)
        if wfe_final_nm is None:
            wfe_final_nm = np.zeros_like(t_rel_ms)

    # Fixed color-scale limits across entire clip (prevents flicker)
    w1_vmin, w1_vmax = 95.0, max(150.0, float(np.percentile(wfs1_raw, 99.7)))
    w2_vmin, w2_vmax = 95.0, max(150.0, float(np.percentile(wfs2_raw, 99.7)))
    s1_disp, s1_lim, s1_exp_lbl = _scale_wfs_refsub(wfs1_sig, pct=99.0)
    s2_disp, s2_lim, s2_exp_lbl = _scale_wfs_refsub(wfs2_sig, pct=99.0)

    w1_sum_kadu = np.sum(wfs1_raw.astype(np.float64), axis=(1, 2)) * 1.0e-3
    w1_max_adu = np.max(wfs1_raw, axis=(1, 2))
    w2_sum_kadu = np.sum(wfs2_raw.astype(np.float64), axis=(1, 2)) * 1.0e-3
    w2_max_adu = np.max(wfs2_raw, axis=(1, 2))
    s1_rms = np.sqrt(np.mean(wfs1_sig.astype(np.float64) ** 2, axis=(1, 2)))
    s2_rms = np.sqrt(np.mean(wfs2_sig.astype(np.float64) ** 2, axis=(1, 2)))

    # Build Matplotlib figure once (even dimensions for H.264 yuv420p)
    n_wfdm = len(wf_dm_panels)
    if has_wf_dm_row:
        if n_wfdm == 5:
            fig = plt.figure(figsize=(17.6, 12.4), dpi=100, facecolor="#ffffff")
            gs = GridSpec(
                4,
                4,
                figure=fig,
                height_ratios=[1.00, 1.02, 1.06, 0.72],
                left=0.095,
                right=0.905,
                bottom=0.046,
                top=0.892,
                hspace=0.36,
                wspace=0.28,
            )
        else:
            fig = plt.figure(figsize=(14.8, 12.8), dpi=100, facecolor="#ffffff")
            gs = GridSpec(
                4,
                4,
                figure=fig,
                height_ratios=[1.02, 1.02, 1.06, 0.72],
                left=0.052,
                right=0.946,
                bottom=0.046,
                top=0.892,
                hspace=0.36,
                wspace=0.28,
            )
        title_y = 0.986
        hud_rect = [0.04, 0.926, 0.92, 0.036]
        row_wfs = 1
        row_psf = 2
        row_ts = 3
        title_tag = "Full-Duration Real-Time" if realtime else "Short-Timescale"
        fig_title = (
            f"Subaru {tel_diam_m:.2f} m AO3k + SCExAO — "
            f"{title_tag} WF, DM, WFS & PSF Evolution "
            f"(Seeing = {seeing_arcsec:.2f}\", mV = mH = {star_mag:.1f})"
        )
    else:
        fig = plt.figure(figsize=(14.8, 10.0), dpi=100, facecolor="#ffffff")
        gs = GridSpec(
            3,
            4,
            figure=fig,
            height_ratios=[1.02, 1.06, 0.72],
            left=0.052,
            right=0.946,
            bottom=0.058,
            top=0.858,
            hspace=0.37,
            wspace=0.28,
        )
        title_y = 0.978
        hud_rect = [0.04, 0.902, 0.92, 0.044]
        row_wfs = 0
        row_psf = 1
        row_ts = 2
        title_tag = "Full-Duration Real-Time" if realtime else "Short-Timescale"
        fig_title = (
            f"Subaru {tel_diam_m:.2f} m AO3k + SCExAO — {title_tag} WFS & PSF Evolution "
            f"(Seeing = {seeing_arcsec:.2f}\", mV = mH = {star_mag:.1f})"
        )

    fig.text(
        0.5,
        title_y,
        fig_title,
        ha="center",
        va="top",
        fontsize=13.2,
        fontweight="bold",
        color="#0f172a",
    )
    # Dedicated thin top axis for clean HUD blitting without touching subplot titles
    ax_hud = fig.add_axes(hud_rect)
    ax_hud.set_axis_off()
    hud_text = ax_hud.text(
        0.5,
        0.5,
        "",
        transform=ax_hud.transAxes,
        ha="center",
        va="center",
        fontsize=9.4,
        family="monospace",
        fontweight="bold",
        color="#1e293b",
        bbox=dict(boxstyle="round,pad=0.30", fc="#f1f5f9", ec="#cbd5e1", lw=1.0),
    )

    # Row 0 (optional): Incoming Pupil WF, PSOL, Diff, DM1/DM2 Shapes & optional Residual WF
    wf_dm_ims = []
    wf_dm_badges = []
    if has_wf_dm_row:
        cmap_opd = matplotlib.colormaps["RdBu_r"].copy()
        cmap_opd.set_bad("#141820")
        if n_wfdm == 5:
            r0_box = gs[0, 0].get_position(fig)
            gs_r0 = GridSpec(
                1,
                5,
                figure=fig,
                left=0.042,
                right=0.956,
                bottom=float(r0_box.y0),
                top=float(r0_box.y1),
                wspace=0.34,
            )
            r0_slots = [gs_r0[0, c] for c in range(5)]
        elif n_wfdm == 3:
            r0_box = gs[0, 0].get_position(fig)
            gs_r0 = GridSpec(
                1,
                3,
                figure=fig,
                left=0.165,
                right=0.835,
                bottom=float(r0_box.y0),
                top=float(r0_box.y1),
                wspace=0.28,
            )
            r0_slots = [gs_r0[0, c] for c in range(3)]
        else:
            r0_slots = [gs[0, c] for c in range(n_wfdm)]

        r0_title_fs = 9.2 if n_wfdm == 5 else 9.8
        for col_i, pinfo in enumerate(wf_dm_panels):
            ax = fig.add_subplot(r0_slots[col_i])
            cube = pinfo["cube"]
            midx_arr = pinfo["map_idx"]
            vlim = float(pinfo["vlim"])
            im = ax.imshow(
                cube[midx_arr[0]],
                origin="lower",
                extent=ext_m,
                cmap=cmap_opd,
                vmin=-vlim,
                vmax=vlim,
                interpolation="nearest",
            )
            ax.set_title(str(pinfo["title"]), fontsize=r0_title_fs, fontweight="bold", pad=5)
            ax.set_xlabel("x [m]", fontsize=8.3, labelpad=2)
            ax.set_ylabel("y [m]" if col_i == 0 else "", fontsize=8.5, labelpad=2)
            ax.xaxis.set_major_locator(MaxNLocator(5))
            ax.yaxis.set_major_locator(MaxNLocator(5))
            ax.tick_params(labelsize=7.8)
            cb = fig.colorbar(im, ax=ax, fraction=0.046, pad=0.03)
            cb.ax.tick_params(labelsize=7.4)
            cb.ax.yaxis.set_major_locator(MaxNLocator(4))
            cb.set_label("OPD [nm]", fontsize=7.6)
            bd = ax.text(
                0.03,
                0.04,
                "",
                transform=ax.transAxes,
                fontsize=7.7 if n_wfdm == 5 else 7.9,
                family="monospace",
                color="white",
                bbox=dict(boxstyle="round,pad=0.22", fc="black", ec="none", alpha=0.72),
            )
            wf_dm_ims.append(
                (ax, im, cube, midx_arr, pinfo["rms"], pinfo["ptv"], bool(pinfo["is_open"]))
            )
            wf_dm_badges.append((ax, bd))

    # Row 1 (or 0): 4 Pyramid WFS panels
    wfs_specs = [
        (
            0,
            f"Stg 1 AO3k Raw PyWFS\n(1.22 µm, {indices['wfs1'].rate_hz/1e3:.1f} kHz, 160×160)",
            wfs1_raw,
            map_idx["wfs1"],
            "magma",
            w1_vmin,
            w1_vmax,
            "Detector [ADU]",
            "raw",
        ),
        (
            1,
            "Stg 1 AO3k Ref-Sub Signal\n(aol1_imWFS2, 160×160)",
            s1_disp,
            map_idx["wfs1"],
            "RdBu_r",
            -s1_lim,
            s1_lim,
            f"Signal [{s1_exp_lbl} norm]",
            "sig",
        ),
        (
            2,
            f"Stg 2 SCExAO Raw PyWFS\n(0.75 µm, {indices['wfs2'].rate_hz/1e3:.1f} kHz, 120×120)",
            wfs2_raw,
            map_idx["wfs2"],
            "magma",
            w2_vmin,
            w2_vmax,
            "Detector [ADU]",
            "raw",
        ),
        (
            3,
            "Stg 2 SCExAO Ref-Sub Signal\n(aol2_imWFS2, 120×120)",
            s2_disp,
            map_idx["wfs2"],
            "RdBu_r",
            -s2_lim,
            s2_lim,
            f"Signal [{s2_exp_lbl} norm]",
            "sig",
        ),
    ]
    wfs_ims = []
    wfs_badges = []
    for col, title, cube, midx_arr, cmap_n, vmin, vmax, cblab, kind in wfs_specs:
        ax = fig.add_subplot(gs[row_wfs, col])
        im = ax.imshow(
            cube[midx_arr[0]],
            origin="lower",
            cmap=cmap_n,
            vmin=vmin,
            vmax=vmax,
            interpolation="nearest",
        )
        ax.set_title(title, fontsize=9.8, fontweight="bold", pad=5)
        ax.set_xlabel("x [pix]", fontsize=8.3, labelpad=2)
        ax.set_ylabel("y [pix]" if col == 0 else "", fontsize=8.5, labelpad=2)
        ax.tick_params(labelsize=7.8)
        cb = fig.colorbar(im, ax=ax, fraction=0.046, pad=0.03)
        cb.ax.tick_params(labelsize=7.5)
        cb.ax.yaxis.set_major_locator(MaxNLocator(4))
        cb.set_label(cblab, fontsize=7.8)
        bd = ax.text(
            0.03,
            0.04,
            "",
            transform=ax.transAxes,
            fontsize=7.9,
            family="monospace",
            color="white" if kind == "raw" else "#0f172a",
            bbox=dict(
                boxstyle="round,pad=0.22",
                fc="black" if kind == "raw" else "white",
                ec="none",
                alpha=0.72 if kind == "raw" else 0.82,
            ),
        )
        wfs_ims.append((ax, im, cube, midx_arr))
        wfs_badges.append((ax, bd))

    # Row 1: 4 Short-Exposure Science PSF panels
    psf_rate_lbl = {}
    for pk in ("psf_vis_stg1", "psf_vis_final", "psf_nir_stg1", "psf_nir_final"):
        rhz = indices[pk].rate_hz
        psf_rate_lbl[pk] = f"{rhz/1e3:.1f} kHz" if rhz >= 500.0 else f"{rhz:.0f} Hz"

    psf_specs = [
        (
            0,
            "vis",
            "stg1",
            f"Vis 0.75 µm — Post-AO3k (Stg 1)\n({psf_rate_lbl['psf_vis_stg1']} Short-Exp Speckle)",
        ),
        (
            1,
            "vis",
            "final",
            f"Vis 0.75 µm — Final AO3k + SCExAO\n"
            f"({psf_rate_lbl['psf_vis_final']} Short-Exp Speckle)",
        ),
        (
            2,
            "nir",
            "stg1",
            f"H-Band 1.65 µm — Post-AO3k (Stg 1)\n"
            f"({psf_rate_lbl['psf_nir_stg1']} Short-Exp Speckle)",
        ),
        (
            3,
            "nir",
            "final",
            f"H-Band 1.65 µm — Final AO3k + SCExAO\n"
            f"({psf_rate_lbl['psf_nir_final']} Short-Exp Speckle)",
        ),
    ]
    psf_ims = []
    psf_badges = []
    log_norm = Normalize(vmin=-4.0, vmax=0.0)
    for col, bkey, skey, title in psf_specs:
        ax = fig.add_subplot(gs[row_psf, col])
        pk = f"psf_{bkey}_{skey}"
        cube_log = psf_sr[(bkey, skey)]
        midx_arr = map_idx[pk]
        im = ax.imshow(
            cube_log[midx_arr[0]],
            origin="lower",
            extent=psf_ext[bkey],
            cmap="inferno",
            norm=log_norm,
            interpolation="nearest",
        )
        ld_a = psf_ld_arcsec[bkey]
        c30 = Circle(
            (0.0, 0.0),
            30.0 * ld_a,
            fill=False,
            ls="--",
            lw=0.85,
            ec="cyan",
            alpha=0.75,
            label="30 λ/D",
        )
        c23 = Circle(
            (0.0, 0.0),
            23.0 * ld_a,
            fill=False,
            ls=":",
            lw=0.95,
            ec="lime",
            alpha=0.85,
            label="23 λ/D",
        )
        ax.add_patch(c30)
        ax.add_patch(c23)
        leg_p = None
        if col in (1, 3):
            leg_p = ax.legend(
                loc="upper right",
                fontsize=7.2,
                facecolor="#10141c",
                edgecolor="#556070",
                labelcolor="white",
                framealpha=0.82,
            )
        ax.set_title(title, fontsize=9.8, fontweight="bold", pad=5)
        ax.set_xlabel('ΔRA ["]', fontsize=8.3, labelpad=2)
        ax.set_ylabel('ΔDec ["]' if col == 0 else "", fontsize=8.5, labelpad=2)
        ax.tick_params(labelsize=7.8)
        cb = fig.colorbar(im, ax=ax, fraction=0.046, pad=0.03, ticks=[-4, -3, -2, -1, 0])
        cb.ax.set_yticklabels(["10⁻⁴", "10⁻³", "10⁻²", "10⁻¹", "1"], fontsize=7.4)
        cb.set_label("Strehl Intensity", fontsize=7.8)
        bd = ax.text(
            0.03,
            0.04,
            "",
            transform=ax.transAxes,
            fontsize=8.0,
            family="monospace",
            color="white",
            bbox=dict(boxstyle="round,pad=0.22", fc="black", ec="none", alpha=0.72),
        )
        psf_ims.append((ax, im, c30, c23, leg_p, cube_log, midx_arr, bkey, skey, pk))
        psf_badges.append((ax, bd))

    # Row 3 Left: Residual WFE strip chart
    x_is_sec = bool(realtime or actual_dur_ms > 1000.0)
    x_ts = t_grid if x_is_sec else t_rel_ms
    x_lim0 = float(x_ts[0]) if x_is_sec else 0.0
    x_lim1 = max(float(x_ts[-1]), x_lim0 + (0.01 if x_is_sec else 1.0))
    x_lbl = (
        "Physical Simulation Time t [s]"
        if x_is_sec
        else f"Window Time Offset Δt [ms]  (t₀ = {t0_actual:.3f} s)"
    )
    ax_wfe = fig.add_subplot(gs[row_ts, 0:2])
    ax_wfe.plot(x_ts, wfe_stg1_nm, color="#ff7f0e", lw=1.6, label="Post-AO3k (Stg 1)")
    ax_wfe.plot(
        x_ts, wfe_final_nm, color="#1f77b4", lw=1.8, label="Post-SCExAO (Final Stg 1+2)"
    )
    if wfe_label_mode == "pupil":
        ax_wfe.axhline(
            119.37,
            color="#64748b",
            ls="--",
            lw=0.95,
            alpha=0.75,
            label="1 rad @ 0.75 µm (119 nm)",
        )
        ax_wfe.set_ylabel("Residual WFE [nm]", fontsize=9.0)
        ax_wfe.set_title(
            f"Closed-Loop Residual Pupil RMS WFE ({t0_actual:.3f} .. {t1_actual:.3f} s)",
            fontsize=10.0,
            fontweight="bold",
        )
    else:
        ax_wfe.set_ylabel("Modal Residual [nm]", fontsize=9.0)
        ax_wfe.set_title(
            f"Sensed Modal Residual Norm ({t0_actual:.3f} .. {t1_actual:.3f} s)",
            fontsize=10.0,
            fontweight="bold",
        )
    wfe_top = max(145.0, float(np.max(np.concatenate([wfe_stg1_nm, wfe_final_nm]))) * 1.25)
    ax_wfe.set_xlim(x_lim0, x_lim1)
    ax_wfe.set_ylim(0.0, wfe_top)
    ax_wfe.set_xlabel(x_lbl, fontsize=8.8)
    ax_wfe.tick_params(labelsize=8.2)
    ax_wfe.grid(True, alpha=0.28)
    leg_wfe = ax_wfe.legend(loc="upper right", fontsize=7.8, ncol=3, framealpha=0.90)
    cur_wfe = ax_wfe.axvline(x_lim0, color="#7c3aed", lw=1.9, zorder=5, animated=True)
    (dot_w1,) = ax_wfe.plot(
        [x_lim0],
        [wfe_stg1_nm[0]],
        "o",
        color="#ff7f0e",
        mec="#0f172a",
        ms=6.0,
        zorder=6,
        animated=True,
    )
    (dot_w2,) = ax_wfe.plot(
        [x_lim0],
        [wfe_final_nm[0]],
        "o",
        color="#1f77b4",
        mec="#0f172a",
        ms=6.0,
        zorder=6,
        animated=True,
    )

    # Row 3 Right: Short-Exposure Strehl strip chart
    ax_sr = fig.add_subplot(gs[row_ts, 2:4])
    sr_v1 = psf_peak_sr[("vis", "stg1")]
    sr_vf = psf_peak_sr[("vis", "final")]
    sr_n1 = psf_peak_sr[("nir", "stg1")]
    sr_nf = psf_peak_sr[("nir", "final")]
    ax_sr.plot(x_ts, sr_v1, color="#0284c7", ls="--", lw=1.35, alpha=0.85, label="Vis Stg 1")
    ax_sr.plot(x_ts, sr_vf, color="#1d4ed8", lw=1.8, label="Vis Final")
    ax_sr.plot(x_ts, sr_n1, color="#f59e0b", ls="--", lw=1.35, alpha=0.85, label="H Stg 1")
    ax_sr.plot(x_ts, sr_nf, color="#dc2626", lw=1.8, label="H Final")
    sr_max = max(50.0, float(np.max(np.concatenate([sr_v1, sr_vf, sr_n1, sr_nf]))) * 1.18)
    ax_sr.set_xlim(x_lim0, x_lim1)
    ax_sr.set_ylim(0.0, min(112.0, sr_max))
    if sr_max > 95.0:
        ax_sr.set_yticks([0, 20, 40, 60, 80, 100])
    ax_sr.set_ylabel("Short-Exp Strehl [%]", fontsize=9.0)
    ax_sr.set_xlabel(x_lbl, fontsize=8.8)
    ax_sr.set_title(
        "Instantaneous Peak Strehl Ratio (Vis 0.75 µm & H-Band 1.65 µm)",
        fontsize=10.0,
        fontweight="bold",
    )
    ax_sr.tick_params(labelsize=8.2)
    ax_sr.grid(True, alpha=0.28)
    sr_all = np.concatenate([sr_v1, sr_vf, sr_n1, sr_nf])
    sr_leg_loc = "lower right" if float(np.min(sr_all)) > 35.0 else "upper right"
    leg_sr = ax_sr.legend(loc=sr_leg_loc, fontsize=7.8, ncol=4, framealpha=0.90)
    cur_sr = ax_sr.axvline(x_lim0, color="#7c3aed", lw=1.9, zorder=5, animated=True)
    (dot_sv,) = ax_sr.plot(
        [x_lim0], [sr_vf[0]], "o", color="#1d4ed8", mec="#0f172a", ms=6.0, zorder=6, animated=True
    )
    (dot_sn,) = ax_sr.plot(
        [x_lim0], [sr_nf[0]], "o", color="#dc2626", mec="#0f172a", ms=6.0, zorder=6, animated=True
    )

    hud_text.set_animated(True)
    for _, im, _, _, _, _, _ in wf_dm_ims:
        im.set_animated(True)
    for _, bd in wf_dm_badges:
        bd.set_animated(True)
    for _, im, _, _ in wfs_ims:
        im.set_animated(True)
    for _, bd in wfs_badges:
        bd.set_animated(True)
    for _, im, c30, c23, leg_p, _, _, _, _, _ in psf_ims:
        im.set_animated(True)
        c30.set_animated(True)
        c23.set_animated(True)
        if leg_p is not None:
            leg_p.set_animated(True)
    for _, bd in psf_badges:
        bd.set_animated(True)
    leg_wfe.set_animated(True)
    leg_sr.set_animated(True)

    fig.canvas.draw()
    bg_cache = fig.canvas.copy_from_bbox(fig.bbox)
    width_px, height_px = fig.canvas.get_width_height()
    os.makedirs(os.path.dirname(os.path.abspath(out_mp4)), exist_ok=True)
    if poster_png is None:
        stem, _ = os.path.splitext(out_mp4)
        poster_png = f"{stem}_poster.png"
    tmp_mp4 = f"{out_mp4}.tmp.mp4"

    ff_cmd = [
        ffmpeg_bin,
        "-y",
        "-loglevel",
        "error",
        "-f",
        "rawvideo",
        "-vcodec",
        "rawvideo",
        "-pix_fmt",
        "rgba",
        "-s",
        f"{width_px}x{height_px}",
        "-r",
        str(int(fps)),
        "-i",
        "-",
        "-an",
        "-c:v",
        "libx264",
        "-preset",
        "veryfast",
        "-threads",
        "8",
        "-crf",
        "24",
        "-pix_fmt",
        "yuv420p",
        "-profile:v",
        "high",
        "-movflags",
        "+faststart",
        tmp_mp4,
    ]

    poster_k = n_clip // 2
    from PIL import Image

    def _draw_frame(k: int):
        fig.canvas.restore_region(bg_cache)
        t_cur = float(t_grid[k])
        x_cur = float(x_ts[k])
        dt_ms = float(t_rel_ms[k])
        outer_tick = int(round(t_cur * outer_hz))
        sub_tick = outer_tick * oversample
        if realtime:
            hud_text.set_text(
                f"t = {t_cur:6.3f} / {t1_actual:6.3f} s  |  "
                f"Outer {outer_hz/1e3:.1f} kHz Tick: {outer_tick:6,d}  |  "
                f"Internal {internal_hz/1e3:.1f} kHz Sub-Tick "
                f"({internal_dt_us:.0f} µs): {sub_tick:7,d}  |  "
                f"1.0× Real-Time ({fps} fps)"
            )
        else:
            hud_text.set_text(
                f"t = {t_cur:7.4f} s (+{dt_ms:5.1f} / {actual_dur_ms:5.1f} ms)  |  "
                f"Outer {outer_hz/1e3:.1f} kHz Tick: {outer_tick:6,d}  |  "
                f"Internal {internal_hz/1e3:.1f} kHz Sub-Tick "
                f"({internal_dt_us:.0f} µs): {sub_tick:7,d}  |  "
                f"{slowdown:.1f}× Slow-Motion ({fps} fps)"
            )
        ax_hud.draw_artist(hud_text)

        for d_i, (ax_d, im, cube, midx_arr, rms_a, ptv_a, is_open) in enumerate(wf_dm_ims):
            j_d = int(midx_arr[k])
            im.set_data(cube[j_d])
            if is_open:
                wf_dm_badges[d_i][1].set_text("RMS =   0.0 nm\nPTV =   0 nm (Open)")
            else:
                wf_dm_badges[d_i][1].set_text(
                    f"RMS = {float(rms_a[j_d]):6.1f} nm\nPTV = {float(ptv_a[j_d]):6.0f} nm"
                )
            ax_d.draw_artist(im)
            for sp in ax_d.spines.values():
                ax_d.draw_artist(sp)
            ax_d.draw_artist(wf_dm_badges[d_i][1])

        i1 = int(map_idx["wfs1"][k])
        i2 = int(map_idx["wfs2"][k])
        wfs_badges[0][1].set_text(
            f"Max = {w1_max_adu[i1]:5.0f} ADU\n"
            f"Sum = {w1_sum_kadu[i1]:4.0f} kADU (#{int(abs_idx['wfs1'][k])})"
        )
        wfs_badges[1][1].set_text(f"RMS = {_fmt_sci(float(s1_rms[i1]))}")
        wfs_badges[2][1].set_text(
            f"Max = {w2_max_adu[i2]:5.0f} ADU\n"
            f"Sum = {w2_sum_kadu[i2]:4.0f} kADU (#{int(abs_idx['wfs2'][k])})"
        )
        wfs_badges[3][1].set_text(f"RMS = {_fmt_sci(float(s2_rms[i2]))}")

        for w_i, (ax_w, im, cube, midx_arr) in enumerate(wfs_ims):
            im.set_data(cube[midx_arr[k]])
            ax_w.draw_artist(im)
            for sp in ax_w.spines.values():
                ax_w.draw_artist(sp)
            ax_w.draw_artist(wfs_badges[w_i][1])

        for p_i, p_item in enumerate(psf_ims):
            ax_p, im, c30, c23, leg_p, cube_log, midx_arr, bkey, skey, pk = p_item
            im.set_data(cube_log[midx_arr[k]])
            sr_v = float(psf_peak_sr[(bkey, skey)][k])
            psf_badges[p_i][1].set_text(
                f"Inst SR = {sr_v:5.1f}%\nExp #{int(abs_idx[pk][k])}"
            )
            ax_p.draw_artist(im)
            ax_p.draw_artist(c30)
            ax_p.draw_artist(c23)
            for sp in ax_p.spines.values():
                ax_p.draw_artist(sp)
            if leg_p is not None:
                ax_p.draw_artist(leg_p)
            ax_p.draw_artist(psf_badges[p_i][1])

        cur_wfe.set_xdata([x_cur, x_cur])
        dot_w1.set_data([x_cur], [float(wfe_stg1_nm[k])])
        dot_w2.set_data([x_cur], [float(wfe_final_nm[k])])
        ax_wfe.draw_artist(cur_wfe)
        ax_wfe.draw_artist(dot_w1)
        ax_wfe.draw_artist(dot_w2)
        ax_wfe.draw_artist(leg_wfe)

        cur_sr.set_xdata([x_cur, x_cur])
        dot_sv.set_data([x_cur], [float(sr_vf[k])])
        dot_sn.set_data([x_cur], [float(sr_nf[k])])
        ax_sr.draw_artist(cur_sr)
        ax_sr.draw_artist(dot_sv)
        ax_sr.draw_artist(dot_sn)
        ax_sr.draw_artist(leg_sr)

        buf = fig.canvas.buffer_rgba()
        if k == poster_k and poster_png:
            poster_tmp = f"{poster_png}.tmp.png"
            img_rgba = Image.frombuffer(
                "RGBA", (width_px, height_px), bytes(buf), "raw", "RGBA", 0, 1
            )
            img_rgba.convert("RGB").save(poster_tmp, compress_level=1)
            os.replace(poster_tmp, poster_png)
        return buf

    n_workers = (
        min(10, os.cpu_count() or 1, max(1, (n_clip + 24) // 25))
        if hasattr(os, "fork") and n_clip >= 40
        else 1
    )
    chunks: list[tuple[int, int]] = []
    for w in range(n_workers):
        k0 = (w * n_clip) // n_workers
        k1 = ((w + 1) * n_clip) // n_workers
        if k1 > k0:
            chunks.append((k0, k1))
    n_workers = len(chunks)

    shm_tmp_dir = None
    if os.path.isdir("/dev/shm") and os.access("/dev/shm", os.W_OK):
        try:
            need_b = int(n_clip) * int(width_px) * int(height_px) * 4 + (512 << 20)
            if shutil.disk_usage("/dev/shm").free >= need_b:
                shm_tmp_dir = "/dev/shm"
        except OSError:
            shm_tmp_dir = None

    worker_tfs = []
    child_pids: list[int] = []
    proc = None
    err_bytes = b""
    try:
        for _ in range(1, n_workers):
            worker_tfs.append(tempfile.TemporaryFile(dir=shm_tmp_dir))

        for idx_w in range(1, n_workers):
            k0, k1 = chunks[idx_w]
            pid = os.fork()
            if pid == 0:
                try:
                    my_tf = worker_tfs[idx_w - 1]
                    for j, tf in enumerate(worker_tfs):
                        if j != idx_w - 1:
                            tf.close()
                    for k in range(k0, k1):
                        my_tf.write(memoryview(_draw_frame(k)))
                    my_tf.flush()
                    os._exit(0)
                except BaseException:
                    traceback.print_exc()
                    os._exit(1)
            child_pids.append(pid)

        proc = subprocess.Popen(ff_cmd, stdin=subprocess.PIPE, stderr=subprocess.PIPE)
        assert proc.stdin is not None

        k0_0, k1_0 = chunks[0]
        for k in range(k0_0, k1_0):
            proc.stdin.write(memoryview(_draw_frame(k)))

        for idx_w, pid in enumerate(child_pids):
            _, st = os.waitpid(pid, 0)
            child_pids[idx_w] = 0
            if st != 0:
                raise RuntimeError(f"telemetry-video worker {idx_w + 1} exited with status {st}")
            tf = worker_tfs[idx_w]
            tf.seek(0)
            while True:
                blk = tf.read(4 * 1024 * 1024)
                if not blk:
                    break
                proc.stdin.write(blk)
            tf.close()
            worker_tfs[idx_w] = None

        proc.stdin.close()
        proc.stdin = None
        _, err_bytes = proc.communicate()
    finally:
        plt.close(fig)
        for pid in child_pids:
            if pid > 0:
                try:
                    os.kill(pid, signal.SIGTERM)
                except OSError:
                    pass
                try:
                    os.waitpid(pid, 0)
                except OSError:
                    pass
        for tf in worker_tfs:
            if tf is not None:
                try:
                    tf.close()
                except OSError:
                    pass
        if proc is not None and proc.stdin is not None:
            proc.stdin.close()

    if proc.returncode != 0:
        if os.path.exists(tmp_mp4):
            os.remove(tmp_mp4)
        err_msg = err_bytes.decode(errors="replace")
        raise RuntimeError(f"ffmpeg exited with code {proc.returncode}: {err_msg}")

    os.replace(tmp_mp4, out_mp4)
    wall_render_s = time.monotonic() - t_wall0
    poster_base = (
        os.path.basename(poster_png) if poster_png and os.path.isfile(poster_png) else None
    )
    meta = {
        "video_file": os.path.basename(out_mp4),
        "poster_file": poster_base,
        "playback_mode": "realtime" if realtime else "short_slowmo",
        "telemetry_mode": str(manifest.get("mode", "custom")),
        "t_start_s": round(t0_actual, 6),
        "t_end_s": round(t1_actual, 6),
        "duration_ms": round(actual_dur_ms, 3),
        "n_frames": n_clip,
        "dt_step_ms": round(dt_step_ms, 4),
        "fps": int(fps),
        "playback_duration_s": round(n_clip / float(max(fps, 1)), 2),
        "slowdown_factor": round(slowdown, 2),
        "width_px": int(width_px),
        "height_px": int(height_px),
        "size_bytes": int(os.path.getsize(out_mp4)),
        "wfs_stg1_rate_hz": float(indices["wfs1"].rate_hz),
        "wfs_stg2_rate_hz": float(indices["wfs2"].rate_hz),
        "psf_stg1_rate_hz": float(indices["psf_vis_stg1"].rate_hz),
        "psf_final_rate_hz": float(indices["psf_vis_final"].rate_hz),
        "internal_bench_hz": float(internal_hz),
        "internal_dt_us": float(internal_dt_us),
        "oversample": int(oversample),
        "vis_final_sr_mean_pct": round(float(np.mean(sr_vf)), 2),
        "vis_final_sr_min_pct": round(float(np.min(sr_vf)), 2),
        "vis_final_sr_max_pct": round(float(np.max(sr_vf)), 2),
        "nir_final_sr_mean_pct": round(float(np.mean(sr_nf)), 2),
        "nir_final_sr_min_pct": round(float(np.min(sr_nf)), 2),
        "nir_final_sr_max_pct": round(float(np.max(sr_nf)), 2),
        "wfe_final_mean_nm": round(float(np.mean(wfe_final_nm)), 2),
        "wf_in_source": str(wf_dm_info["wf_in_source"]),
        "psol_source": str(wf_dm_info["psol_source"]),
        "dm1_source": str(wf_dm_info["dm1_source"]),
        "dm2_source": str(wf_dm_info["dm2_source"]),
        "wf_res_source": str(wf_dm_info["wf_res_source"]),
        "has_wf_dm_row": bool(has_wf_dm_row),
        "wf_dm_panel_count": int(n_wfdm),
        "has_psol_wf": any(str(p["key"]) == "wf_psol" for p in wf_dm_panels),
        "has_wf_psol_diff": any(str(p["key"]) == "wf_diff" for p in wf_dm_panels),
        "has_residual_wf": any(str(p["key"]) == "wf_res" for p in wf_dm_panels),
        "render_wall_s": round(wall_render_s, 2),
    }
    for pinfo in wf_dm_panels:
        pk = str(pinfo["key"])
        r_vals = pinfo["rms"][pinfo["map_idx"]]
        if pk == "wf_in":
            meta["wf_in_rms_mean_nm"] = round(float(np.mean(r_vals)), 1)
        elif pk == "wf_psol":
            meta["psol_rms_mean_nm"] = round(float(np.mean(r_vals)), 1)
        elif pk == "wf_diff":
            meta["wf_psol_diff_rms_mean_nm"] = round(float(np.mean(r_vals)), 1)
        elif pk == "dm1":
            meta["dm1_opd_rms_mean_nm"] = round(float(np.mean(r_vals)), 1)
        elif pk == "dm2":
            meta["dm2_opd_rms_mean_nm"] = round(float(np.mean(r_vals)), 1)
    if meta_json:
        with open(meta_json, "w", encoding="utf-8") as fh:
            json.dump(meta, fh, indent=2)
            fh.write("\n")
    return meta


def main(argv: list[str] | None = None) -> int:
    args_raw = sys.argv[1:] if argv is None else argv
    if any(a in ("-h1", "--help-oneline") for a in args_raw):
        print("render short-timescale WF, DM, WFS & PSF evolution MP4 video from AO telemetry")
        return 0
    if any(a in ("-h2", "--help-description") for a in args_raw):
        print(
            "Memory-map streamFITSlog AO telemetry cubes (b_pup/wf_clip, dm01/dm02, csim_wfs_*,\n"
            "psf_*) and render a synchronized slow-motion H.264 MP4 movie + poster frame."
        )
        return 0

    parser = argparse.ArgumentParser(
        description="Render short-timescale WFS & PSF evolution video from on-disk AO telemetry."
    )
    parser.add_argument(
        "--telemetry-dir",
        required=True,
        help="Path to telemetry directory produced by --save-telemetry",
    )
    parser.add_argument(
        "--report-dir",
        default=None,
        help=(
            "AO report directory with DL PSF references & wf_timeseries.csv "
            "(default: parent of telemetry-dir)"
        ),
    )
    parser.add_argument(
        "--out",
        default=None,
        help="Output .mp4 path (default: <report-dir>/wfs_psf_short_evolution.mp4)",
    )
    parser.add_argument(
        "--poster",
        default=None,
        help="Output poster .png path (default: <out_stem>_poster.png)",
    )
    parser.add_argument(
        "--meta-out",
        default=None,
        help="Optional output JSON file recording video clip statistics",
    )
    parser.add_argument(
        "--t-start",
        type=float,
        default=5.0,
        help="Physical start time [s] of the short-timescale clip (default: 5.0)",
    )
    parser.add_argument(
        "--duration-ms",
        type=float,
        default=200.0,
        help="Physical duration [ms] of the clip (default: 200.0)",
    )
    parser.add_argument(
        "--fps",
        type=int,
        default=30,
        help="Video playback frame rate [fps] (default: 30)",
    )
    parser.add_argument(
        "--realtime",
        action="store_true",
        help="Render full simulation duration at 1.0x physical time (e.g. 10 s -> 10 s video)",
    )
    args = parser.parse_args(args_raw)

    telem_dir = os.path.abspath(args.telemetry_dir)
    report_dir = os.path.abspath(args.report_dir) if args.report_dir else os.path.dirname(telem_dir)
    def_mp4_name = "wfs_psf_full_evolution.mp4" if args.realtime else "wfs_psf_short_evolution.mp4"
    out_mp4 = (
        os.path.abspath(args.out)
        if args.out
        else os.path.join(report_dir, def_mp4_name)
    )
    meta = render_telemetry_video(
        telem_dir=telem_dir,
        report_dir=report_dir,
        out_mp4=out_mp4,
        poster_png=args.poster,
        meta_json=args.meta_out,
        t_start_req=args.t_start,
        duration_ms=args.duration_ms,
        fps=args.fps,
        realtime=bool(args.realtime),
    )
    sz_mb = float(meta["size_bytes"]) / (1024.0 * 1024.0)
    rate_desc = (
        f"1.0x real-time @ {meta['fps']} fps"
        if args.realtime
        else f"{meta['slowdown_factor']}x slow-motion @ {meta['fps']} fps"
    )
    print(
        f"[telemetry-video] Rendered {meta['n_frames']} frames "
        f"(t = {meta['t_start_s']:.3f}..{meta['t_end_s']:.3f} s, "
        f"{rate_desc}) -> {out_mp4} ({sz_mb:.2f} MiB in {meta['render_wall_s']:.1f} s)"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
