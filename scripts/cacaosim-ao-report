def _ensure_sci_python():
    try:
        import astropy  # noqa: F401
        import matplotlib  # noqa: F401
        import numpy  # noqa: F401
        return
    except ImportError:
        pass
    cands = [
        os.environ.get("PYTHON_BIN", ""),
        os.path.expanduser("~/miniforge3/bin/python3"),
        os.path.expanduser("~/.local/envs/cacao/bin/python3"),
    ]
    for p in cands:
        if p and os.path.isfile(p) and os.path.realpath(p) != os.path.realpath(sys.executable):
            os.execv(p, [p] + sys.argv)


_ensure_sci_python()
import numpy as np  # noqa: E402
from astropy.io import fits  # noqa: E402

RAD2MAS = 206264.806247 * 1000.0
TEL_DIAM_M = 8.2

BANDS = {
    "vis": {
        "label": "Visible (0.75 um)",
        "lam_um": 0.75,
        "pixscale_ld": 2.20,
        "stg1_ctrl_ld": 30.0,
        "stg2_ctrl_ld": 23.0,
    },
    "nir": {
        "label": "Near-IR H (1.65 um)",
        "lam_um": 1.65,
        "pixscale_ld": 2.50,
        "stg1_ctrl_ld": 30.0,
        "stg2_ctrl_ld": 23.0,
    },
}

STAGES = [
    ("dl", "Diffraction-Limited"),
    ("raw", "Uncorrected (Open-Loop)"),
    ("stg1", "Stage 1 Only (AO3k)"),
    ("final", "Stage 1 + 2 (AO3k + SCExAO)"),
]

SPEC_NSPEC = 32
SPEC_MIN_UM = 0.40
SPEC_MAX_UM = 2.40
SPEC_DL_UM = (SPEC_MAX_UM - SPEC_MIN_UM) / SPEC_NSPEC


def _spec_bin_lambda(b):
    return SPEC_MIN_UM + (b + 0.5) * SPEC_DL_UM


def _smooth_step_lo(lam, cut, roll):
    w = roll if roll > 1e-4 else 0.02
    z = 4.0 * (lam - cut) / w
    if z > 40.0:
        return 0.0
    if z < -40.0:
        return 1.0
    return 1.0 / (1.0 + math.exp(z))


def _spec_integrate_interval(spec, l_lo, l_hi):
    if l_hi <= l_lo:
        return 0.0, 0.5 * (l_lo + l_hi)
    if spec is None:
        dl = l_hi - l_lo
        return dl, 0.5 * dl * (l_lo + l_hi)
    knots = [SPEC_MIN_UM + k * SPEC_DL_UM for k in range(SPEC_NSPEC + 1)]
    inv_dl = 1.0 / SPEC_DL_UM
    d = [p * inv_dl for p in spec]
    f_knots = [0.0] * (SPEC_NSPEC + 1)
    f_knots[0] = max(0.0, 1.5 * d[0] - 0.5 * d[1])
    for k in range(1, SPEC_NSPEC):
        f_knots[k] = 0.5 * (d[k - 1] + d[k])
    f_knots[SPEC_NSPEC] = max(0.0, 1.5 * d[SPEC_NSPEC - 1] - 0.5 * d[SPEC_NSPEC - 2])
    tot_ph = 0.0
    tot_mom = 0.0
    if l_lo < knots[0]:
        b = min(l_hi, knots[0])
        seg = b - l_lo
        ph = f_knots[0] * seg
        tot_ph += ph
        tot_mom += ph * 0.5 * (l_lo + b)
    for k in range(SPEC_NSPEC):
        a = max(l_lo, knots[k])
        b = min(l_hi, knots[k + 1])
        if b <= a:
            continue
        inv_seg = 1.0 / (knots[k + 1] - knots[k])
        fa = f_knots[k] + (f_knots[k + 1] - f_knots[k]) * ((a - knots[k]) * inv_seg)
        fb = f_knots[k] + (f_knots[k + 1] - f_knots[k]) * ((b - knots[k]) * inv_seg)
        seg = b - a
        ph = 0.5 * (fa + fb) * seg
        tot_ph += ph
        tot_mom += seg * (a * (2.0 * fa + fb) + b * (fa + 2.0 * fb)) / 6.0
    if l_hi > knots[SPEC_NSPEC]:
        a = max(l_lo, knots[SPEC_NSPEC])
        seg = l_hi - a
        ph = f_knots[SPEC_NSPEC] * seg
        tot_ph += ph
        tot_mom += ph * 0.5 * (a + l_hi)
    return tot_ph, tot_mom


def _sample_band_exact(spec, lam0, bw_frac, nlam, dt_s, qe):
    n = max(1, min(32, int(nlam)))
    bw = max(0.0, min(1.5, float(bw_frac)))
    scale = max(0.0, float(dt_s)) * max(0.0, min(1.0, float(qe)))
    if bw <= 1e-7:
        return 0.0, [lam0] * n, [1.0 / n] * n, lam0
    dlam = lam0 * bw
    l_min = max(0.05, lam0 - 0.5 * dlam)
    l_max = lam0 + 0.5 * dlam
    if l_max <= l_min + 1e-8:
        return 0.0, [lam0] * n, [1.0 / n] * n, lam0
    sub_dl = (l_max - l_min) / n
    raw_ph = []
    lam_c = []
    tot_ph = 0.0
    tot_mom = 0.0
    for c in range(n):
        a = l_min + c * sub_dl
        b = l_max if c == n - 1 else (a + sub_dl)
        ph_c, mom_c = _spec_integrate_interval(spec, a, b)
        raw_ph.append(ph_c)
        lam_c.append((mom_c / ph_c) if ph_c > 1e-30 else 0.5 * (a + b))
        tot_ph += ph_c
        tot_mom += mom_c
    if tot_ph > 1e-30:
        weights = [p / tot_ph for p in raw_ph]
        eff_lam = tot_mom / tot_ph
    else:
        weights = [1.0 / n] * n
        eff_lam = lam0
    return tot_ph * scale, lam_c, weights, eff_lam


def analyze_bench_chromaticity(bench_path):
    if not bench_path or not os.path.isfile(bench_path):
        return None
    bench = {
        "nwf": 256,
        "pup_diam": 0.9375,
        "pupil_geom": "",
        "tel_diam_m": 8.2,
        "cobs": 0.30,
        "nspider": 4,
        "spider_w": 0.012,
        "spider_deg": 45.0,
        "spider_offset": 0.0,
        "star_mag": 6.0,
        "star_teff": 9600.0,
        "tput_tel": 0.75,
        "master_hz": 2000.0,
        "out_beam": "b_pup",
    }
    raw_bench_keys = set()
    nodes = []
    cur = None
    with open(bench_path, "r", encoding="utf-8") as fh:
        for raw in fh:
            line = raw.split("#", 1)[0].strip()
            if not line:
                continue
            if line.startswith("[") and line.endswith("]"):
                sec = line[1:-1].strip()
                if sec.lower() == "bench":
                    cur = ("bench", bench)
                elif "." in sec:
                    kind, nid = [t.strip() for t in sec.split(".", 1)]
                    nd = {"kind": kind.lower(), "id": nid}
                    nodes.append(nd)
                    cur = ("node", nd)
                else:
                    cur = None
                continue
            if cur is None or "=" not in line:
                continue
            k, v = [t.strip() for t in line.split("=", 1)]
            if len(v) >= 2 and v[0] == v[-1] and v[0] in ('"', "'"):
                v = v[1:-1]
            cur[1][k] = v
            if cur[0] == "bench":
                raw_bench_keys.add(k)

    pgeom = str(bench.get("pupil_geom", "")).strip().lower()
    if pgeom == "subaru":
        subaru_defs = {
            "tel_diam_m": 7.95,
            "cobs": 0.307,
            "nspider": 4,
            "spider_w": 0.02314,
            "spider_deg": 51.75,
            "spider_offset": 0.08289,
        }
        for dk, dv in subaru_defs.items():
            if dk not in raw_bench_keys:
                bench[dk] = dv

    nwf_b = max(16, int(float(bench.get("nwf", 256))))
    pup_diam_b = float(bench.get("pup_diam", 0.9375))
    diam = float(bench.get("tel_diam_m", 8.2))
    obs = float(bench.get("cobs", bench.get("obs_frac", 0.30)))
    nspider = int(float(bench.get("nspider", 4)))
    spider_w = float(bench.get("spider_w", 0.012))
    spider_deg = float(bench.get("spider_deg", 45.0))
    spider_offset = float(bench.get("spider_offset", 0.0))
    mag = float(bench.get("star_mag", 6.0))
    teff = max(500.0, float(bench.get("star_teff", 9600.0)))
    tput = float(bench.get("tput_tel", bench.get("tel_tput", 0.75)))
    master_hz = max(1.0, float(bench.get("master_hz", bench.get("frame_rate", 2000.0))))
    oversample = max(1, int(float(bench.get("oversample", 1))))
    eff_master_hz = master_hz * oversample
    dt_outer_ms = 1000.0 / master_hz
    dt_sub_ms = 1000.0 / eff_master_hz
    dt_sub_us = 1.0e6 / eff_master_hz
    atm_interp = str(bench.get("atm_interp", "1")).lower() not in ("0", "off", "false")
    area = 0.25 * math.pi * diam * diam * (1.0 - obs * obs)
    f0_v = 1.0e11 * (10.0 ** (-0.4 * mag))
    base_flx = f0_v * area * tput * SPEC_DL_UM
    hc_k = 14387.77
    n_v = 1.0 / ((0.55**4) * math.expm1(hc_k / (0.55 * teff)))

    root_spec = []
    lam_bins = [_spec_bin_lambda(b) for b in range(SPEC_NSPEC)]
    for lam in lam_bins:
        x = hc_k / (lam * teff)
        rel = 0.0 if x > 80.0 else (1.0 / ((lam**4) * math.expm1(x))) / n_v
        root_spec.append(base_flx * rel)

    beams = {bench.get("out_beam", "b_pup"): root_spec}
    beam_nlam = {bench.get("out_beam", "b_pup"): 1}
    sensors = []
    dms = []
    coros = []
    wfes = []

    for nd in nodes:
        kind = nd["kind"]
        in_b = nd.get("in", nd.get("in_beam", ""))
        sp_in = beams.get(in_b, root_spec)
        in_nl = beam_nlam.get(in_b, 1)
        if kind in ("dm", "ttm", "wfe", "static_wfe"):
            tp = float(nd.get("tput", 0.98))
            out_b = nd.get("out", nd.get("out_beam", ""))
            if out_b:
                beams[out_b] = [p * tp for p in sp_in]
                beam_nlam[out_b] = in_nl
            if kind in ("dm", "ttm"):
                del_us = float(nd.get("delay_us", 0.0))
                tau_us = float(nd.get("tau_us", 0.0))
                dms.append(
                    {
                        "id": nd["id"],
                        "kind": kind,
                        "nact_x": int(nd.get("nact_x", 1)),
                        "nact_y": int(nd.get("nact_y", 1)),
                        "delay_us": del_us,
                        "delay_subticks": del_us / dt_sub_us if dt_sub_us > 0 else 0.0,
                        "tau_us": tau_us,
                        "dyn_mode": int(nd.get("dyn_mode", 0)),
                    }
                )
            else:
                defoc_nm = float(
                    nd.get("defocus_nm", float(nd.get("defocus_m", 0.0)) * 1.0e9)
                )
                wfes.append(
                    {
                        "id": nd["id"],
                        "in_beam": in_b,
                        "out_beam": out_b,
                        "rms_nm": float(nd.get("rms_nm", 0.0)),
                        "defocus_nm": defoc_nm,
                        "tput": tp,
                    }
                )
        elif kind == "splitter":
            mode = nd.get("mode", "dichroic_lp").lower()
            cut = float(nd.get("lambda_cut", 0.95))
            bw_sp = float(nd.get("band_width", 0.25))
            roll = float(nd.get("roll_um", 0.03))
            er = float(nd.get("eff_refl", 0.95))
            et = float(nd.get("eff_trans", 0.95))
            rg = float(nd.get("r_gray", 0.50))
            tg = float(nd.get("t_gray", 0.50))
            sp_r, sp_t = [], []
            for b, lam in enumerate(lam_bins):
                if mode in ("gray", "0"):
                    r, t = max(0.0, rg), max(0.0, tg)
                elif mode in ("dichroic_lp", "lp", "1"):
                    s = _smooth_step_lo(lam, cut, roll)
                    r, t = er * s, et * (1.0 - s)
                elif mode in ("dichroic_sp", "sp", "2"):
                    s = _smooth_step_lo(lam, cut, roll)
                    r, t = er * (1.0 - s), et * s
                else:
                    hw = 0.5 * max(0.01, bw_sp)
                    bp = (1.0 - _smooth_step_lo(lam, cut - hw, roll)) * _smooth_step_lo(
                        lam, cut + hw, roll
                    )
                    r, t = er * bp, et * (1.0 - bp)
                if r + t > 1.0:
                    r, t = r / (r + t), t / (r + t)
                sp_r.append(r * sp_in[b])
                sp_t.append(t * sp_in[b])
            if nd.get("out_refl"):
                beams[nd["out_refl"]] = sp_r
                beam_nlam[nd["out_refl"]] = in_nl
            if nd.get("out_trans"):
                beams[nd["out_trans"]] = sp_t
                beam_nlam[nd["out_trans"]] = in_nl
        elif kind == "coro":
            tp = float(nd.get("tput", 0.92))
            bw_c = float(nd.get("bw_frac", 0.0))
            nl_c = int(nd.get("nlambda", 0))
            eff_c = nl_c if nl_c >= 1 else (in_nl if in_nl > 1 else (2 if bw_c > 1e-6 else 1))
            out_b = nd.get("out", nd.get("out_beam", ""))
            if out_b:
                beams[out_b] = [p * tp for p in sp_in]
                beam_nlam[out_b] = eff_c
            lo_b = nd.get("out_lowfs", "")
            refl = float(nd.get("lowfs_refl", 0.95))
            if lo_b:
                beams[lo_b] = [p * tp for p in sp_in]
                beam_nlam[lo_b] = eff_c
            coros.append(
                {
                    "id": nd["id"],
                    "type": nd.get("mode", nd.get("type", "lyot_spot")),
                    "in_beam": in_b,
                    "out_beam": out_b,
                    "out_lowfs": lo_b,
                    "out_pre_lyot": nd.get("out_pre_lyot", ""),
                    "out_pre_lyot_long": nd.get("out_pre_lyot_long", ""),
                    "lambda_um": float(nd.get("lambda_um", 1.65)),
                    "bw_frac": bw_c,
                    "nlambda": eff_c,
                    "spot_radius_ld": float(
                        nd.get("fpm_rad_ld", nd.get("spot_radius_ld", 3.0))
                    ),
                    "spot_trans": float(nd.get("fpm_amp", nd.get("spot_trans", 0.0))),
                    "lyot_outer": float(nd.get("lyot_outer", 0.85)),
                    "lyot_obs": float(nd.get("lyot_obs", 0.36)),
                    "lyot_nspider": int(float(nd.get("lyot_nspider", nspider))),
                    "lyot_spider_w": float(nd.get("lyot_spider_w", 0.025)),
                    "lyot_spider_deg": float(nd.get("lyot_spider_deg", spider_deg)),
                    "lyot_spider_offset": float(
                        nd.get("lyot_spider_offset", spider_offset)
                    ),
                    "lowfs_mode": nd.get("lowfs_mode", "none"),
                    "lowfs_refl": refl,
                    "tput": tp,
                }
            )
        elif kind in ("pyrwfs", "shwfs", "zwfs", "fpcam", "fpwfs"):
            is_fpcam_like = kind in ("fpcam", "fpwfs")
            is_wfs = (kind != "fpcam") or (
                str(nd.get("is_wfs", "0")).lower() not in ("0", "off", "false")
            )
            def_lam = 1.65 if is_fpcam_like else 0.75
            def_bw = 0.18 if is_fpcam_like else 0.20
            def_qe = 0.85 if is_fpcam_like else 0.80
            lam0 = float(nd.get("lambda_um", def_lam))
            if "dlambda_um" in nd:
                bw_f = max(0.0, float(nd["dlambda_um"])) / max(0.05, lam0)
            else:
                bw_f = float(nd.get("bw_frac", def_bw))
            cfg_nl = int(nd.get("nlambda", 0))
            eff_nl = (
                max(1, min(32, cfg_nl))
                if cfg_nl >= 1
                else (2 if bw_f > 1e-6 else 1)
            )
            qe = float(nd.get("qe", def_qe))
            rate_hz = float(nd.get("rate_hz", 0.0))
            navg = max(1, int(nd.get("navg", 1)))
            eff_hz = rate_hz if rate_hz > 0.1 else (master_hz / navg)
            navg_sub = (
                max(1, int(round(eff_master_hz / eff_hz)))
                if rate_hz > 0.1
                else (navg * oversample)
            )
            sim_hz_cfg = float(nd.get("sim_hz", 0.0))
            sub_stride_cfg = int(nd.get("subframe_stride", 0))
            if sim_hz_cfg > 0.1:
                stride_sub = max(1, int(round(eff_master_hz / sim_hz_cfg)))
            elif sub_stride_cfg >= 1:
                stride_sub = sub_stride_cfg
            elif is_fpcam_like and (not is_wfs) and oversample > 1:
                stride_sub = oversample
            else:
                stride_sub = 1
            stride_sub = min(stride_sub, navg_sub)
            if sub_stride_cfg == 0 and sim_hz_cfg <= 0.1:
                while stride_sub > 1 and (navg_sub % stride_sub) != 0:
                    stride_sub -= 1
            evals_per_fr = max(1, navg_sub // stride_sub)
            dt_exp = 1.0 / eff_hz
            use_bf = str(nd.get("use_beam_flux", "1")).lower() not in ("0", "off", "false")
            flx, c_lam, c_w, eff_lam = _sample_band_exact(
                sp_in if use_bf else None, lam0, bw_f, eff_nl, dt_exp, qe
            )
            if not use_bf:
                flx = float(nd.get("flux_ph", 1.0e5))
            dlam = lam0 * bw_f
            ncam = (
                int(nd.get("n_sub", 16)) * int(nd.get("pix_per_sub", 8))
                if kind == "shwfs"
                else int(nd.get("ncam", 128 if is_fpcam_like else 64))
            )
            sensors.append(
                {
                    "id": nd["id"],
                    "kind": "fpwfs" if (is_fpcam_like and is_wfs) else kind,
                    "is_wfs": is_wfs,
                    "in_beam": in_b,
                    "out_cam": nd.get("out_cam", ""),
                    "ncam": ncam,
                    "pixscale_ld": float(nd.get("pixscale_ld", 2.5)),
                    "lambda0_um": lam0,
                    "bw_frac": bw_f,
                    "dlambda_um": dlam,
                    "lambda_min_um": max(0.05, lam0 - 0.5 * dlam),
                    "lambda_max_um": lam0 + 0.5 * dlam,
                    "eff_nlam": eff_nl,
                    "eff_lambda_um": eff_lam,
                    "chan_lam_um": c_lam,
                    "chan_weight": c_w,
                    "focal_scale_lam0_over_lam": [lam0 / lc for lc in c_lam],
                    "rate_hz": eff_hz,
                    "navg_subticks": navg_sub,
                    "stride_subticks": stride_sub,
                    "evals_per_frame": evals_per_fr,
                    "qe": qe,
                    "flux_ph_per_frame": flx,
                }
            )

    beam_out = {}
    for bname, sp in beams.items():
        tot = float(sum(sp))
        mean_l = (
            float(sum(p * lam_bins[i] for i, p in enumerate(sp)) / tot) if tot > 0.0 else 0.0
        )
        beam_out[bname] = {
            "total_ph_s": tot,
            "mean_lambda_um": mean_l,
            "ph_s_per_um": [p / SPEC_DL_UM for p in sp],
        }

    pup_diam_pix = pup_diam_b * nwf_b
    return {
        "bench": {
            "name": str(bench.get("name", "")),
            "pupil_geom": pgeom or "circular",
            "nwf": nwf_b,
            "pup_diam": pup_diam_b,
            "pup_diam_pix": pup_diam_pix,
            "tel_diam_m": diam,
            "cobs": obs,
            "nspider": nspider,
            "spider_w": spider_w,
            "spider_deg": spider_deg,
            "spider_offset": spider_offset,
            "tput_tel": tput,
            "star_mag": mag,
            "star_teff": teff,
            "pupil_scale_m_pix": diam / max(pup_diam_pix, 1.0),
        },
        "coros": coros,
        "wfes": wfes,
        "lambda_bins_um": lam_bins,
        "spec_dl_um": SPEC_DL_UM,
        "timing": {
            "outer_master_hz": master_hz,
            "outer_dt_ms": dt_outer_ms,
            "oversample": oversample,
            "internal_bench_hz": eff_master_hz,
            "internal_dt_ms": dt_sub_ms,
            "internal_dt_us": dt_sub_us,
            "atm_interp": atm_interp,
            "dms": dms,
        },
        "beams": beam_out,
        "sensors": sensors,
    }


def radial_profile(img, cx, cy, dr=0.5, return_std=False):
    ny, nx = img.shape
    yy, xx = np.indices((ny, nx), dtype=np.float64)
    rr = np.hypot(xx - cx, yy - cy)
    rmax = min(cx, cy, nx - 2.0 - cx, ny - 2.0 - cy)
    nbins = max(int(rmax / dr), 2)
    centers = np.linspace(0.0, nbins * dr, nbins + 1)
    thetas = np.linspace(0.0, 2.0 * math.pi, 144, endpoint=False)
    xs = cx + centers[:, None] * np.cos(thetas)[None, :]
    ys = cy + centers[:, None] * np.sin(thetas)[None, :]
    x0 = np.floor(xs).astype(int)
    y0 = np.floor(ys).astype(int)
    wx = xs - x0
    wy = ys - y0
    vals = (
        (1.0 - wx) * (1.0 - wy) * img[y0, x0]
        + wx * (1.0 - wy) * img[y0, x0 + 1]
        + (1.0 - wx) * wy * img[y0 + 1, x0]
        + wx * wy * img[y0 + 1, x0 + 1]
    )
    prof = np.mean(vals, axis=1)
    if return_std:
        pstd = np.std(vals, axis=1, ddof=1)
        return centers, prof, pstd, rr
    return centers, prof, rr


def build_aperture_mask_2d(
    nwf,
    pup_diam,
    outer_frac,
    obs_frac,
    nspider,
    spider_w,
    spider_deg,
    spider_offset,
):
    dpix = float(pup_diam) * float(nwf)
    p0 = 0.5 * float(nwf - 1)
    sub = (np.arange(4, dtype=np.float64) + 0.5) / 4.0 - 0.5
    coords = (np.arange(nwf, dtype=np.float64)[:, None] + sub[None, :]).ravel() - p0
    xx = coords[None, :] / dpix
    yy = coords[:, None] / dpix
    rr = np.hypot(xx, yy)
    inside = rr <= (0.5 * float(outer_frac))
    if obs_frac > 0.0:
        inside &= rr >= (0.5 * float(obs_frac))
    hw = 0.5 * float(spider_w)
    if nspider > 0 and hw > 0.0:
        if nspider == 4 and abs(spider_offset) > 1.0e-6:
            off = float(spider_offset)
            ang = math.radians(float(spider_deg))
            ca, sa = math.cos(ang), math.sin(ang)
            for sx, ca_s in ((+off, +ca), (-off, -ca)):
                dx = xx - sx
                for sa_s in (+sa, -sa):
                    t_par = dx * ca_s + yy * sa_s
                    d_perp = np.abs(-dx * sa_s + yy * ca_s)
                    inside &= ~((t_par >= -hw) & (d_perp <= hw))
        else:
            ang0 = math.radians(float(spider_deg))
            for k in range(nspider):
                ang = ang0 + k * math.pi / float(nspider)
                d_perp = np.abs(-xx * math.sin(ang) + yy * math.cos(ang))
                inside &= d_perp > hw
    return inside.reshape(nwf, 4, nwf, 4).mean(axis=(1, 3))


def estimate_fwhm_pix(img, peak_xy=None):
    ny, nx = img.shape
    if peak_xy is None:
        idx = int(np.argmax(img))
        py, px = divmod(idx, nx)
    else:
        px, py = peak_xy
    cx, cy = float(px), float(py)
    peak_val = float(img[py, px])
    if peak_val <= 0.0:
        return 0.0
    rmax = min(cx, cy, nx - 2.0 - cx, ny - 2.0 - cy)
    if rmax <= 0.5:
        return 1.0
    r_grid = np.linspace(0.0, rmax, int(rmax * 20) + 1)
    thetas = np.linspace(0.0, 2.0 * math.pi, 72, endpoint=False)
    xx = cx + r_grid[:, None] * np.cos(thetas)[None, :]
    yy = cy + r_grid[:, None] * np.sin(thetas)[None, :]
    x0 = np.floor(xx).astype(int)
    y0 = np.floor(yy).astype(int)
    wx = xx - x0
    wy = yy - y0
    vals = (
        (1.0 - wx) * (1.0 - wy) * img[y0, x0]
        + wx * (1.0 - wy) * img[y0, x0 + 1]
        + (1.0 - wx) * wy * img[y0 + 1, x0]
        + wx * wy * img[y0 + 1, x0 + 1]
    )
    prof = np.mean(vals, axis=1)
    half = 0.5 * prof[0]
    above = np.where(prof >= half)[0]
    k = int(above[-1]) if len(above) else 0
    if k < len(prof) - 1 and prof[k] > prof[k + 1]:
        frac = (half - prof[k]) / (prof[k + 1] - prof[k])
        r_half = r_grid[k] + frac * (r_grid[k + 1] - r_grid[k])
    else:
        r_half = r_grid[k]
    return float(2.0 * r_half)


def analyze_band_stage(img, dl_sum, cfg, tel_diam_m=TEL_DIAM_M):
    ny, nx = img.shape
    c0 = nx // 2
    ld_mas = (cfg["lam_um"] * 1e-6 / tel_diam_m) * RAD2MAS
    pix_mas = ld_mas / cfg["pixscale_ld"]

    peak_idx = int(np.argmax(img))
    py, px = divmod(peak_idx, nx)
    strehl_peak = float(img[py, px])
    strehl_axis = float(img[c0, c0])

    fwhm_pix = estimate_fwhm_pix(img, (px, py))
    fwhm_mas = fwhm_pix * pix_mas
    fwhm_ld = fwhm_mas / ld_mas

    centers_pix, prof, rr_pix = radial_profile(img, float(c0), float(c0), dr=0.5)
    rr_ld = rr_pix / cfg["pixscale_ld"]
    rr_mas = rr_pix * pix_mas

    norm_denom = dl_sum if dl_sum > 0.0 else float(np.sum(img))
    ee_core = float(np.sum(img[rr_ld <= 1.22]) / norm_denom)
    ee_50mas = float(np.sum(img[rr_mas <= 50.0]) / norm_denom)
    ee_100mas = float(np.sum(img[rr_mas <= 100.0]) / norm_denom)

    radii_mas_grid = np.linspace(0.5 * pix_mas, 1500.0, 400)
    ee_curve = np.array(
        [float(np.sum(img[rr_mas <= r]) / norm_denom) for r in radii_mas_grid]
    )
    idx50 = int(np.searchsorted(ee_curve, 0.50))
    ee50_rad_mas = (
        float(radii_mas_grid[idx50]) if idx50 < len(radii_mas_grid) else float("nan")
    )

    zone1 = (rr_ld >= 2.0) & (rr_ld <= cfg["stg1_ctrl_ld"])
    zone2 = (rr_ld >= 2.0) & (rr_ld <= cfg["stg2_ctrl_ld"])
    contrast_2_30ld = float(np.mean(img[zone1])) if np.any(zone1) else 0.0
    contrast_2_23ld = float(np.mean(img[zone2])) if np.any(zone2) else 0.0

    return {
        "strehl_peak": strehl_peak,
        "strehl_axis": strehl_axis,
        "fwhm_pix": fwhm_pix,
        "fwhm_mas": fwhm_mas,
        "fwhm_ld": fwhm_ld,
        "ee_1p22ld": ee_core,
        "ee_50mas": ee_50mas,
        "ee_100mas": ee_100mas,
        "ee50_radius_mas": ee50_rad_mas,
        "contrast_2_23ld": contrast_2_23ld,
        "contrast_2_30ld": contrast_2_30ld,
        "pixscale_mas": pix_mas,
        "ld_mas": ld_mas,
        "rad_mas": (centers_pix * pix_mas).tolist(),
        "rad_ld": (centers_pix / cfg["pixscale_ld"]).tolist(),
        "rad_prof": prof.tolist(),
        "ee_grid_mas": radii_mas_grid[::4].tolist(),
        "ee_grid_val": ee_curve[::4].tolist(),
    }


def analyze_coronagraph_and_lowfs(
    out_dir,
    chrom_info,
    psf_metrics,
    stage2_info,
    stage3_info,
    tel_diam_m,
    tmp_npys,
):
    coro_dl_p = os.path.join(out_dir, "psf_nir_coro_dl.fits")
    coro_cl_p = os.path.join(out_dir, "psf_nir_coro.fits")
    if not (os.path.isfile(coro_dl_p) and os.path.isfile(coro_cl_p)):
        return None

    bcfg = (chrom_info or {}).get("bench", {})
    coros = (chrom_info or {}).get("coros", [])
    wfes = (chrom_info or {}).get("wfes", [])
    sensors = (chrom_info or {}).get("sensors", [])
    cnode = coros[0] if coros else {}
    s_coro = next((s for s in sensors if s["id"] == "nir_coro"), {})
    s_lowfs = next((s for s in sensors if s["id"] == "wfs_lowfs"), {})
    w_defoc = next((w for w in wfes if abs(w.get("defocus_nm", 0.0)) > 0.0), {})

    nwf = int(bcfg.get("nwf", 256))
    pup_diam = float(bcfg.get("pup_diam", 0.9375))
    cobs = float(bcfg.get("cobs", 0.307))
    nspider = int(bcfg.get("nspider", 4))
    spider_w = float(bcfg.get("spider_w", 0.02314))
    spider_deg = float(bcfg.get("spider_deg", 51.75))
    spider_offset = float(bcfg.get("spider_offset", 0.08289))

    pup_p = next(
        (
            p
            for p in (
                os.path.join(out_dir, "csim_pup.fits"),
                os.path.join(out_dir, "wf_pupil_mask.fits"),
            )
            if os.path.isfile(p)
        ),
        None,
    )
    if pup_p is not None:
        pup_amp = np.asarray(fits.getdata(pup_p), dtype=np.float64)
        nwf = int(pup_amp.shape[0])
    else:
        pup_amp = build_aperture_mask_2d(
            nwf, pup_diam, 1.0, cobs, nspider, spider_w, spider_deg, spider_offset
        )

    lyot_outer = float(cnode.get("lyot_outer", 0.85))
    lyot_obs = float(cnode.get("lyot_obs", 0.38))
    lyot_nsp = int(cnode.get("lyot_nspider", nspider))
    lyot_sw = float(cnode.get("lyot_spider_w", 0.040))
    lyot_sdeg = float(cnode.get("lyot_spider_deg", spider_deg))
    lyot_soff = float(cnode.get("lyot_spider_offset", spider_offset))
    lyot_amp = build_aperture_mask_2d(
        nwf, pup_diam, lyot_outer, lyot_obs, lyot_nsp, lyot_sw, lyot_sdeg, lyot_soff
    )

    eff_lyot = pup_amp * lyot_amp
    pup_power = max(float(np.sum(pup_amp**2)), 1.0e-12)
    pup_sum_amp = max(float(np.sum(pup_amp)), 1.0e-12)
    t_lyot_int = float(np.sum(eff_lyot**2)) / pup_power
    eta_planet_peak = (float(np.sum(eff_lyot)) / pup_sum_amp) ** 2

    # Save [2, nwf, nwf] pupil + Lyot mask array for plotting
    pup_lyot_npy = os.path.join(out_dir, "coro_pup_lyot.npy")
    np.save(pup_lyot_npy, np.stack([pup_amp, lyot_amp], axis=0).astype(np.float32))
    tmp_npys.append(pup_lyot_npy)

    lam_um = float(s_coro.get("lambda0_um", cnode.get("lambda_um", 1.65)))
    bw_frac = float(s_coro.get("bw_frac", cnode.get("bw_frac", 0.18)))
    pixscale_ld = float(s_coro.get("pixscale_ld", 2.50))
    spot_ld = float(cnode.get("spot_radius_ld", 3.0))
    ld_mas = (lam_um * 1.0e-6 / tel_diam_m) * RAD2MAS
    pix_mas = ld_mas / pixscale_ld

    img_dl = np.asarray(fits.getdata(coro_dl_p), dtype=np.float64)
    img_cl = np.asarray(fits.getdata(coro_cl_p), dtype=np.float64)
    unocc_dl_p = os.path.join(out_dir, "psf_nir_dl.fits")
    unocc_cl_p = os.path.join(out_dir, "psf_nir_final.fits")
    img_unocc_dl = (
        np.asarray(fits.getdata(unocc_dl_p), dtype=np.float64)
        if os.path.isfile(unocc_dl_p)
        else None
    )
    img_unocc_cl = (
        np.asarray(fits.getdata(unocc_cl_p), dtype=np.float64)
        if os.path.isfile(unocc_cl_p)
        else None
    )

    for stem, arr in (("psf_nir_coro_dl", img_dl), ("psf_nir_coro", img_cl)):
        p_npy = os.path.join(out_dir, f"{stem}.npy")
        np.save(p_npy, arr.astype(np.float32))
        tmp_npys.append(p_npy)
    if img_unocc_dl is not None:
        p_udl = os.path.join(out_dir, "psf_nir_unocc_dl.npy")
        np.save(p_udl, img_unocc_dl.astype(np.float32))
        tmp_npys.append(p_udl)
    if img_unocc_cl is not None:
        p_ucl = os.path.join(out_dir, "psf_nir_unocc_cl.npy")
        np.save(p_ucl, img_unocc_cl.astype(np.float32))
        tmp_npys.append(p_ucl)

    sr_nir_final = float(
        psf_metrics.get("nir", {}).get("final", {}).get("strehl_peak", 1.0)
    )
    unocc_dl_sum = (
        float(np.sum(img_unocc_dl)) if img_unocc_dl is not None else 1.0
    )

    c0 = img_cl.shape[1] // 2
    r_pix_dl, prof_dl, std_dl, rr_pix = radial_profile(
        img_dl, float(c0), float(c0), dr=0.5, return_std=True
    )
    _, prof_cl, std_cl, _ = radial_profile(
        img_cl, float(c0), float(c0), dr=0.5, return_std=True
    )
    if img_unocc_dl is not None and img_unocc_dl.shape == img_dl.shape:
        _, prof_unocc_dl, _ = radial_profile(img_unocc_dl, float(c0), float(c0), dr=0.5)
    else:
        prof_unocc_dl = np.zeros_like(prof_dl)
    if img_unocc_cl is not None and img_unocc_cl.shape == img_cl.shape:
        _, prof_unocc, _ = radial_profile(img_unocc_cl, float(c0), float(c0), dr=0.5)
    else:
        prof_unocc = np.zeros_like(prof_cl)

    r_ld = r_pix_dl / pixscale_ld
    r_mas = r_pix_dl * pix_mas
    denom_dl = max(eta_planet_peak, 1.0e-6)
    denom_cl = max(sr_nir_final * eta_planet_peak, 1.0e-6)

    sep_knots_ld = [3.0, 5.0, 10.0, 15.0, 20.0]
    sep_table = []
    for s_ld in sep_knots_ld:
        c_dl = float(np.interp(s_ld, r_ld, prof_dl))
        s_dl_v = float(np.interp(s_ld, r_ld, std_dl))
        c_cl = float(np.interp(s_ld, r_ld, prof_cl))
        s_cl_v = float(np.interp(s_ld, r_ld, std_cl))
        c_un = float(np.interp(s_ld, r_ld, prof_unocc))
        sep_table.append(
            {
                "sep_ld": s_ld,
                "sep_mas": s_ld * ld_mas,
                "dl_raw_contrast": c_dl,
                "dl_planet_contrast": c_dl / denom_dl,
                "dl_5sigma_planet_contrast": (5.0 * s_dl_v) / denom_dl,
                "cl_raw_contrast": c_cl,
                "cl_planet_contrast": c_cl / denom_cl,
                "cl_5sigma_planet_contrast": (5.0 * s_cl_v) / denom_cl,
                "unocc_cl_intensity": c_un,
                "coro_suppression_factor": c_un / max(c_cl, 1.0e-12) if c_un > 0 else 0.0,
            }
        )

    rr_2d_ld = rr_pix / pixscale_ld
    z_3_10 = (rr_2d_ld >= 3.0) & (rr_2d_ld <= 10.0)
    z_5_20 = (rr_2d_ld >= 5.0) & (rr_2d_ld <= 20.0)

    lowfs_dl_p = os.path.join(out_dir, "det_wfs_lowfs_dl.fits")
    lowfs_cl_p = os.path.join(out_dir, "det_wfs_lowfs.fits")
    imwfs3_p = os.path.join(out_dir, "aol3_imWFS2.fits")
    lowfs_rate = float(s_lowfs.get("rate_hz", 500.0))
    lowfs_qe = float(s_lowfs.get("qe", 0.85))
    lowfs_bw = float(s_lowfs.get("bw_frac", 0.18))
    lowfs_lam = float(s_lowfs.get("lambda0_um", 1.65))
    lowfs_nlam = int(s_lowfs.get("eff_nlam", 3))
    lowfs_refl = float(cnode.get("lowfs_refl", 0.95))
    coro_tput = float(cnode.get("tput", 0.92))
    defoc_tput = float(w_defoc.get("tput", 0.98))
    tput_tel_val = float(bcfg.get("tput_tel", 0.20))

    lowfs_info = {
        "sensor_id": s_lowfs.get("id", "wfs_lowfs"),
        "detector": f"{s_lowfs.get('ncam', 64)}x{s_lowfs.get('ncam', 64)}",
        "rate_hz": lowfs_rate,
        "lambda0_um": lowfs_lam,
        "bw_frac": lowfs_bw,
        "qe": lowfs_qe,
        "defocus_nm": float(w_defoc.get("defocus_nm", 200.0)),
        "clear_ref_phe_per_frame": float(s_lowfs.get("flux_ph_per_frame", 0.0)),
        "flux_ph_per_frame": float(s_lowfs.get("flux_ph_per_frame", 0.0)),
        "enabled_closed_loop": bool((stage3_info or {}).get("enabled", True)),
        "n_zernike_modes": int((stage3_info or {}).get("n_cm_modes", 14)),
        "dm3_stroke_rms_nm": float((stage3_info or {}).get("dm_rms_um", 0.0)) * 1000.0,
        "wfs3_sig_rms": float((stage3_info or {}).get("wfs_rms", 0.0)),
        "stg2_zpo_dm_rms_nm": float((stage2_info or {}).get("zpo_dm_rms_um", 0.0)) * 1000.0,
        "stg2_zpo_wfs_rms": float((stage2_info or {}).get("zpo_wfs_rms", 0.0)),
    }
    if os.path.isfile(lowfs_cl_p):
        det_lo = np.asarray(fits.getdata(lowfs_cl_p), dtype=np.float64)
        lowfs_info["cl_max_adu"] = float(np.max(det_lo))
        lowfs_info["cl_net_sum_adu"] = float(np.sum(np.maximum(det_lo - 100.0, 0.0)))
        lo_npy = os.path.join(out_dir, "det_wfs_lowfs.npy")
        np.save(lo_npy, det_lo.astype(np.float32))
        tmp_npys.append(lo_npy)
    if os.path.isfile(lowfs_dl_p):
        det_lo_dl = np.asarray(fits.getdata(lowfs_dl_p), dtype=np.float64)
        lowfs_info["dl_net_sum_adu"] = float(np.sum(np.maximum(det_lo_dl - 100.0, 0.0)))
        lo_dl_npy = os.path.join(out_dir, "det_wfs_lowfs_dl.npy")
        np.save(lo_dl_npy, det_lo_dl.astype(np.float32))
        tmp_npys.append(lo_dl_npy)
    if os.path.isfile(imwfs3_p):
        im3 = np.asarray(fits.getdata(imwfs3_p), dtype=np.float64)
        im3_npy = os.path.join(out_dir, "aol3_imWFS2.npy")
        np.save(im3_npy, im3.astype(np.float32))
        tmp_npys.append(im3_npy)

    # Compute H-band (1.50..1.80 um) photon rates along the bench & LOWFS light-fraction budget
    beams_dict = (chrom_info or {}).get("beams", {})
    dl_bin = float((chrom_info or {}).get("spec_dl_um", SPEC_DL_UM))

    def _beam_hband_ph_s(bname):
        entry = beams_dict.get(bname)
        if not entry or "ph_s_per_um" not in entry:
            return 0.0
        sp = [float(v) * dl_bin for v in entry["ph_s_per_um"]]
        ph_s, _, _, _ = _sample_band_exact(sp, lowfs_lam, lowfs_bw, lowfs_nlam, 1.0, 1.0)
        return float(ph_s)

    root_bname = bcfg.get("out_beam", "b_pup") or "b_pup"
    coro_in_bname = cnode.get("in_beam", "b_nir_sci") or "b_nir_sci"
    ph_s_pup_h = _beam_hband_ph_s(root_bname)
    ph_s_sky_h = ph_s_pup_h / max(tput_tel_val, 1.0e-9)
    ph_s_coro_in_h = _beam_hband_ph_s(coro_in_bname)
    if ph_s_coro_in_h <= 0.0:
        ph_s_coro_in_h = ph_s_pup_h
    ph_s_pup_broad = float(beams_dict.get(root_bname, {}).get("total_ph_s", 0.0))
    upstream_h_tput = ph_s_coro_in_h / max(ph_s_pup_h, 1.0e-12) if ph_s_pup_h > 0 else 1.0
    relay_lo_tput = coro_tput * defoc_tput

    def _eval_pre_lyot_regime(fits_path, npy_stem, net_cam_adu):
        if not os.path.isfile(fits_path):
            return None
        with fits.open(fits_path) as hdul:
            arr_pre = np.asarray(hdul[0].data, dtype=np.float64)
            hdr = hdul[0].header
            kw_f_lo = hdr.get("F_LOWFS")
            kw_f_pre = hdr.get("F_PRELYO")
            kw_f_tr = hdr.get("F_LYOTTR")
        np.save(os.path.join(out_dir, f"{npy_stem}.npy"), arr_pre.astype(np.float32))
        tmp_npys.append(os.path.join(out_dir, f"{npy_stem}.npy"))

        l2 = lyot_amp**2
        e_in_pow = max(pup_power, 1.0e-12)
        f_pre_map = float(np.sum(arr_pre)) / e_in_pow
        f_tr_map = float(np.sum(l2 * arr_pre)) / e_in_pow
        f_blk_map = float(np.sum(np.maximum(0.0, 1.0 - l2) * arr_pre)) / e_in_pow
        f_lo_map = (lowfs_refl**2) * f_blk_map

        f_pre = float(kw_f_pre) if (kw_f_pre is not None and kw_f_pre > 0) else f_pre_map
        f_tr = float(kw_f_tr) if (kw_f_tr is not None and kw_f_tr > 0) else f_tr_map
        f_blk = max(0.0, f_pre - f_tr)
        f_lo = float(kw_f_lo) if (kw_f_lo is not None and kw_f_lo > 0) else f_lo_map
        f_fpm_abs = max(0.0, 1.0 - f_pre)

        # Fraction of coro-input H-band photons reaching LOWFS focal plane (full plane vs 64x64 FOV)
        f_cam_inf_coro = f_lo * relay_lo_tput
        ref_clear_phe = max(lowfs_info["clear_ref_phe_per_frame"], 1.0e-12)
        if net_cam_adu is not None and net_cam_adu > 0.0 and ref_clear_phe > 1.0:
            fov_ratio = min(1.0, float(net_cam_adu) / (ref_clear_phe * max(f_lo, 1.0e-9)))
        else:
            fov_ratio = 0.96
        f_cam_fov_coro = f_cam_inf_coro * fov_ratio
        f_cam_fov_pup_h = f_cam_fov_coro * upstream_h_tput
        f_cam_fov_sky_h = f_cam_fov_pup_h * tput_tel_val
        f_cam_inf_pup_h = f_cam_inf_coro * upstream_h_tput
        f_cam_inf_sky_h = f_cam_inf_pup_h * tput_tel_val

        ph_s_cam_fov = ph_s_coro_in_h * f_cam_fov_coro
        phe_s_cam_fov = ph_s_cam_fov * lowfs_qe
        ph_fr_cam_fov = ph_s_cam_fov / max(lowfs_rate, 1.0)
        phe_fr_cam_fov = phe_s_cam_fov / max(lowfs_rate, 1.0)
        f_cam_fov_broad = ph_s_cam_fov / max(ph_s_pup_broad, 1.0e-12) if ph_s_pup_broad > 0 else 0.0

        return {
            "frac_coro_in_fpm_absorbed": f_fpm_abs,
            "frac_coro_in_incident_on_lyot": f_pre,
            "frac_coro_in_lyot_transmitted_raw": f_tr,
            "frac_coro_in_lyot_transmitted_sci": f_tr * coro_tput,
            "frac_coro_in_lyot_blocked": f_blk,
            "frac_coro_in_reflected_to_lowfs_beam": f_lo,
            "frac_coro_in_incident_lowfs_focal_plane": f_cam_inf_coro,
            "lowfs_64x64_fov_capture_fraction": fov_ratio,
            "frac_coro_in_reaching_lowfs_cam_fov": f_cam_fov_coro,
            "frac_entrance_pup_h_reaching_lowfs_focal": f_cam_inf_pup_h,
            "frac_entrance_pup_h_reaching_lowfs_cam_fov": f_cam_fov_pup_h,
            "frac_sky_h_reaching_lowfs_cam_fov": f_cam_fov_sky_h,
            "frac_entrance_broadband_reaching_lowfs_cam_fov": f_cam_fov_broad,
            "frac_entrance_pup_h_detected_phe": f_cam_fov_pup_h * lowfs_qe,
            "lowfs_cam_incident_ph_s": ph_s_cam_fov,
            "lowfs_cam_incident_ph_per_frame": ph_fr_cam_fov,
            "lowfs_cam_detected_phe_s": phe_s_cam_fov,
            "lowfs_cam_detected_phe_per_frame": phe_fr_cam_fov,
            "pre_lyot_peak_intensity": float(np.max(arr_pre)),
        }

    pre_dl_p = os.path.join(out_dir, "coro_pre_lyot_dl.fits")
    pre_cl_p = os.path.join(out_dir, "coro_pre_lyot.fits")
    pre_inst_p = os.path.join(out_dir, "coro_pre_lyot_inst.fits")
    if os.path.isfile(pre_inst_p):
        arr_pi = np.asarray(fits.getdata(pre_inst_p), dtype=np.float32)
        pi_npy = os.path.join(out_dir, "coro_pre_lyot_inst.npy")
        np.save(pi_npy, arr_pi)
        tmp_npys.append(pi_npy)

    bud_dl = _eval_pre_lyot_regime(
        pre_dl_p, "coro_pre_lyot_dl", lowfs_info.get("dl_net_sum_adu")
    )
    bud_cl = _eval_pre_lyot_regime(
        pre_cl_p, "coro_pre_lyot", lowfs_info.get("cl_net_sum_adu")
    )
    if bud_cl:
        # Expose true post-diffraction photon flux per frame on wfs_lowfs
        lowfs_info["flux_ph_per_frame"] = bud_cl["lowfs_cam_detected_phe_per_frame"]
        lowfs_info["incident_ph_per_frame"] = bud_cl["lowfs_cam_incident_ph_per_frame"]

    lo_ts_csv = os.path.join(out_dir, "lowfs_light_timeseries.csv")
    lo_ts_stats = None
    if os.path.isfile(lo_ts_csv):
        try:
            ts_data = np.genfromtxt(lo_ts_csv, delimiter=",", skip_header=1)
            if ts_data.ndim == 1 and ts_data.size >= 8:
                ts_data = ts_data[None, :]
            if ts_data.ndim == 2 and ts_data.shape[0] >= 1 and ts_data.shape[1] >= 8:
                ts_npy = os.path.join(out_dir, "lowfs_light_ts.npy")
                np.save(ts_npy, ts_data.astype(np.float32))
                tmp_npys.append(ts_npy)
                f_lo_i = ts_data[:, 3]
                f_pre_i = ts_data[:, 5]
                fov_r = bud_cl["lowfs_64x64_fov_capture_fraction"] if bud_cl else 0.96
                scale_cam_coro = relay_lo_tput * fov_r
                scale_cam_pup = scale_cam_coro * upstream_h_tput
                lo_ts_stats = {
                    "csv_file": "lowfs_light_timeseries.csv",
                    "n_samples": int(ts_data.shape[0]),
                    "frac_coro_in_lowfs_beam_mean": float(np.mean(f_lo_i)),
                    "frac_coro_in_lowfs_beam_median": float(np.median(f_lo_i)),
                    "frac_coro_in_lowfs_beam_std": float(np.std(f_lo_i)),
                    "frac_coro_in_lowfs_beam_p05": float(np.percentile(f_lo_i, 5.0)),
                    "frac_coro_in_lowfs_beam_p95": float(np.percentile(f_lo_i, 95.0)),
                    "frac_coro_in_lowfs_beam_min": float(np.min(f_lo_i)),
                    "frac_coro_in_lowfs_beam_max": float(np.max(f_lo_i)),
                    "frac_pre_lyot_mean": float(np.mean(f_pre_i)),
                    "frac_coro_in_cam_fov_mean": float(np.mean(f_lo_i) * scale_cam_coro),
                    "frac_pup_h_cam_fov_mean": float(np.mean(f_lo_i) * scale_cam_pup),
                }
        except (OSError, ValueError):
            pass

    lowfs_budget = {
        "tput_tel": tput_tel_val,
        "upstream_ao_h_tput": upstream_h_tput,
        "coro_relay_tput": coro_tput,
        "lowfs_refl_amp": lowfs_refl,
        "lowfs_refl_power": lowfs_refl**2,
        "defocus_wfe_tput": defoc_tput,
        "lowfs_qe": lowfs_qe,
        "hband_sky_ph_s": ph_s_sky_h,
        "hband_entrance_pupil_ph_s": ph_s_pup_h,
        "hband_coro_input_ph_s": ph_s_coro_in_h,
        "broadband_entrance_pupil_ph_s": ph_s_pup_broad,
        "diffraction_limited": bud_dl,
        "closed_loop": bud_cl,
        "timeseries": lo_ts_stats,
    }

    return {
        "coro_id": cnode.get("id", "coro_nir"),
        "coro_type": cnode.get("type", "lyot_spot"),
        "lambda_um": lam_um,
        "bw_frac": bw_frac,
        "nlambda": int(s_coro.get("eff_nlam", cnode.get("nlambda", 3))),
        "pixscale_ld": pixscale_ld,
        "pixscale_mas": pix_mas,
        "ld_mas": ld_mas,
        "spot_radius_ld": spot_ld,
        "spot_iwa_mas": spot_ld * ld_mas,
        "lowfs_mode": cnode.get("lowfs_mode", "lyot_refl"),
        "lowfs_refl": float(cnode.get("lowfs_refl", 0.95)),
        "lyot_stop": {
            "outer": lyot_outer,
            "obs": lyot_obs,
            "nspider": lyot_nsp,
            "spider_w": lyot_sw,
            "spider_deg": lyot_sdeg,
            "spider_offset": lyot_soff,
            "intensity_throughput": t_lyot_int,
            "planet_peak_throughput": eta_planet_peak,
        },
        "dl": {
            "on_axis_raw_contrast": float(img_dl[c0, c0]),
            "peak_raw_contrast": float(np.max(img_dl)),
            "total_leakage_frac": float(np.sum(img_dl)) / max(unocc_dl_sum, 1.0e-12),
            "mean_raw_contrast_3_10ld": float(np.mean(img_dl[z_3_10])),
            "mean_raw_contrast_5_20ld": float(np.mean(img_dl[z_5_20])),
        },
        "closed_loop": {
            "nir_unocculted_strehl": sr_nir_final,
            "on_axis_raw_contrast": float(img_cl[c0, c0]),
            "peak_raw_contrast": float(np.max(img_cl)),
            "total_leakage_frac": float(np.sum(img_cl)) / max(unocc_dl_sum, 1.0e-12),
            "mean_raw_contrast_3_10ld": float(np.mean(img_cl[z_3_10])),
            "mean_raw_contrast_5_20ld": float(np.mean(img_cl[z_5_20])),
            "mean_planet_contrast_3_10ld": float(np.mean(img_cl[z_3_10])) / denom_cl,
            "mean_planet_contrast_5_20ld": float(np.mean(img_cl[z_5_20])) / denom_cl,
        },
        "contrast_table": sep_table,
        "profiles": {
            "rad_ld": r_ld.tolist(),
            "rad_mas": r_mas.tolist(),
            "unocc_dl": prof_unocc_dl.tolist(),
            "dl_raw": prof_dl.tolist(),
            "dl_planet": (prof_dl / denom_dl).tolist(),
            "cl_raw": prof_cl.tolist(),
            "cl_planet": (prof_cl / denom_cl).tolist(),
            "cl_5sigma_planet": ((5.0 * std_cl) / denom_cl).tolist(),
            "unocc_cl": prof_unocc.tolist(),
        },
        "llowfs": lowfs_info,
        "lowfs_light_budget": lowfs_budget,
    }


def fit_mlat_curve(dt_fr, val):
    x = np.asarray(dt_fr, dtype=np.float64)
    y = np.asarray(val, dtype=np.float64)
    ym = float(np.mean(y))

    def search_grid(taus, sigs):
        g = np.exp(
            -0.5 * ((x[None, None, :] - taus[:, None, None]) / sigs[None, :, None]) ** 2
        )
        gm = np.mean(g, axis=2)
        gd = g - gm[:, :, None]
        gv = np.maximum(np.mean(gd**2, axis=2), 1e-18)
        cov = np.mean(gd * (y - ym)[None, None, :], axis=2)
        a_hat = np.maximum(0.0, cov / gv)
        b_hat = ym - a_hat * gm
        pred = b_hat[:, :, None] + a_hat[:, :, None] * g
        sse = np.sum((y[None, None, :] - pred) ** 2, axis=2)
        it, isg = np.unravel_index(int(np.argmin(sse)), sse.shape)
        return float(taus[it]), float(sigs[isg]), float(a_hat[it, isg]), float(
            b_hat[it, isg]
        ), float(sse[it, isg])

    t0, s0, _, _, _ = search_grid(
        np.linspace(0.4, 3.6, 161), np.linspace(0.18, 1.30, 57)
    )
    tau_f, sig_f, a_f, b_f, sse_f = search_grid(
        np.linspace(max(0.2, t0 - 0.03), t0 + 0.03, 61),
        np.linspace(max(0.10, s0 - 0.03), s0 + 0.03, 61),
    )
    sst = max(float(np.sum((y - ym) ** 2)), 1e-30)
    r2 = max(0.0, 1.0 - sse_f / sst)
    dof = max(len(x) - 4, 1)
    s2 = sse_f / dof
    g_opt = np.exp(-0.5 * ((x - tau_f) / sig_f) ** 2)
    dg_dtau = a_f * ((x - tau_f) / (sig_f**2)) * g_opt
    tau_err = math.sqrt(s2 / max(float(np.sum(dg_dtau**2)), 1e-18))
    return {
        "tau_fit_fr": tau_f,
        "tau_err_fr": tau_err,
        "sigma_fit_fr": sig_f,
        "fwhm_fit_fr": 2.35482 * sig_f,
        "amp_fit": a_f,
        "base_fit": b_f,
        "r2": r2,
    }


def smooth_boxcar_1d(arr, win):
    x = np.asarray(arr, dtype=np.float64)
    if x.size <= 3 or win <= 1:
        return x.copy()
    w = min(int(win) | 1, x.size if x.size % 2 == 1 else max(1, x.size - 1))
    if w <= 1:
        return x.copy()
    pad = w // 2
    xp = np.pad(x, pad, mode="reflect")
    kern = np.ones(w, dtype=np.float64) / float(w)
    return np.convolve(xp, kern, mode="valid")


def analyze_selfrm_pair(conf_dir, out_dir, loop_num, tmp_npys):
    cal_cands = [
        os.path.join(out_dir, f"selfRM_calib_stg{loop_num}.fits"),
        os.path.join(conf_dir, "selfRM_calib.fits"),
    ]
    sky_p = os.path.join(out_dir, f"selfRM_onsky_stg{loop_num}.fits")
    cal_p = next((p for p in cal_cands if os.path.isfile(p)), None)
    if cal_p is None or not os.path.isfile(sky_p):
        return None

    scal = np.asarray(fits.getdata(cal_p), dtype=np.float64)
    ssky = np.asarray(fits.getdata(sky_p), dtype=np.float64)
    if scal.ndim != 3 or ssky.ndim != 3:
        return None

    nz = min(scal.shape[0], ssky.shape[0])
    nm_tot = min(scal.shape[1], scal.shape[2], ssky.shape[1], ssky.shape[2])
    scal = scal[:nz, :nm_tot, :nm_tot]
    ssky = ssky[:nz, :nm_tot, :nm_tot]

    row_pk = np.max(np.abs(scal), axis=(0, 2))
    active_rows = np.where(row_pk > 1e-5)[0]
    m_cnt = int(active_rows[-1] + 1) if active_rows.size > 0 else nm_tot
    scal = scal[:, :m_cnt, :m_cnt]
    ssky = ssky[:, :m_cnt, :m_cnt]

    cal_net = scal
    sky_net = ssky

    idx_d = np.arange(m_cnt)
    d_cal_z = cal_net[:, idx_d, idx_d]
    d_sky_z = sky_net[:, idx_d, idx_d]

    mean_cal_z = np.mean(d_cal_z, axis=1)
    mean_sky_z = np.mean(d_sky_z, axis=1)

    pk_cal_val = float(np.max(mean_cal_z))
    settled = np.where(mean_cal_z >= 0.96 * pk_cal_val)[0]
    z_cal = int(settled[0]) if settled.size > 0 else int(np.argmax(mean_cal_z))
    z_sky = int(np.argmax(mean_sky_z))

    m_cal = cal_net[z_cal]
    m_sky = sky_net[z_sky]

    cal_diag = np.diag(m_cal)
    sky_diag = np.diag(m_sky)
    og_ratio = sky_diag / np.maximum(cal_diag, 0.20)
    win = max(3, min(17, (m_cnt // 9) | 1))
    sky_smooth = smooth_boxcar_1d(sky_diag, win)
    og_smooth = smooth_boxcar_1d(og_ratio, win)

    off_mask = ~np.eye(m_cnt, dtype=bool)
    cal_off_rms = float(np.sqrt(np.mean(m_cal[off_mask] ** 2))) if m_cnt > 1 else 0.0
    sky_off_rms = float(np.sqrt(np.mean(m_sky[off_mask] ** 2))) if m_cnt > 1 else 0.0

    n_lo = max(2, min(20, m_cnt // 5))
    i_hi = max(0, (3 * m_cnt) // 4)

    cal_npy = os.path.join(out_dir, f"srm_cal_stg{loop_num}.npy")
    sky_npy = os.path.join(out_dir, f"srm_sky_stg{loop_num}.npy")
    np.save(cal_npy, m_cal.astype(np.float32))
    np.save(sky_npy, m_sky.astype(np.float32))
    if tmp_npys is not None:
        tmp_npys.extend([cal_npy, sky_npy])

    return {
        "n_modes_probed": m_cnt,
        "zsize": nz,
        "z_cal_slice": z_cal,
        "z_sky_slice": z_sky,
        "cal_diag_mean": float(np.mean(cal_diag)),
        "cal_diag_std": float(np.std(cal_diag)),
        "cal_offdiag_rms": cal_off_rms,
        "sky_og_mean": float(np.mean(sky_diag)),
        "sky_og_ratio_mean": float(np.mean(og_ratio)),
        "sky_og_tt": float(np.mean(sky_diag[: min(2, m_cnt)])),
        "sky_og_low": float(np.mean(sky_diag[:n_lo])),
        "sky_og_high": float(np.mean(sky_diag[i_hi:])),
        "sky_ratio_tt": float(np.mean(og_ratio[: min(2, m_cnt)])),
        "sky_ratio_low": float(np.mean(og_ratio[:n_lo])),
        "sky_ratio_high": float(np.mean(og_ratio[i_hi:])),
        "sky_offdiag_rms": sky_off_rms,
        "cal_diag": cal_diag.tolist(),
        "sky_diag": sky_diag.tolist(),
        "sky_diag_smooth": sky_smooth.tolist(),
        "og_ratio_smooth": og_smooth.tolist(),
        "trace_cal_mean": mean_cal_z.tolist(),
        "trace_sky_low": np.mean(d_sky_z[:, :n_lo], axis=1).tolist(),
        "trace_sky_high": np.mean(d_sky_z[:, i_hi:], axis=1).tolist(),
    }


def load_loop_calib(
    work_dir, loop_name, loop_num, out_dir, tmp_npys=None, phys_hz_override=None
):
    conf_dir = os.path.join(work_dir, loop_name, "conf")
    if not os.path.isdir(conf_dir):
        alt_conf = os.path.join(work_dir, f"stage{loop_num}")
        if os.path.isdir(alt_conf):
            conf_dir = alt_conf
    info = {"loop_name": loop_name, "loop_number": loop_num}
    zresp_p = os.path.join(conf_dir, "zrespC.fits")
    syn_p = os.path.join(conf_dir, "RMsyn_modesDM.fits")
    cmdm_p = os.path.join(conf_dir, "CMmodesDM.fits")
    dmmask_p = os.path.join(conf_dir, "dmmask.fits")
    wfsmask_p = os.path.join(conf_dir, "wfsmask.fits")
    meta_p = os.path.join(conf_dir, "rm_meta.env")

    if os.path.isfile(zresp_p):
        info["n_rm_modes"] = int(fits.getheader(zresp_p).get("NAXIS3", 0))
    if os.path.isfile(syn_p):
        info["n_syn_modes"] = int(fits.getheader(syn_p).get("NAXIS3", 0))
    dm_m = None
    if os.path.isfile(dmmask_p):
        dm_m = np.asarray(fits.getdata(dmmask_p)) > 0.5
        info["active_dm_act"] = int(np.sum(dm_m))
        info["total_dm_act"] = int(dm_m.size)
    if os.path.isfile(cmdm_p):
        cm_arr = np.asarray(fits.getdata(cmdm_p), dtype=np.float64)
        info["n_cm_modes"] = int(cm_arr.shape[0])
        if dm_m is not None and cm_arr.ndim == 3:
            mx = dm_m[:, 1:] & dm_m[:, :-1]
            my = dm_m[1:, :] & dm_m[:-1, :]
            n_mx = max(int(np.sum(mx)), 1)
            n_my = max(int(np.sum(my)), 1)
            n_dm = max(int(np.sum(dm_m)), 1)
            v_dm = cm_arr[:, dm_m]
            v_dm_mean = np.mean(v_dm, axis=1)
            v = cm_arr - v_dm_mean[:, None, None]
            gx2 = np.sum((v[:, :, 1:][:, mx] - v[:, :, :-1][:, mx]) ** 2, axis=1) / n_mx
            gy2 = np.sum((v[:, 1:, :][:, my] - v[:, :-1, :][:, my]) ** 2, axis=1) / n_my
            v2 = np.sum((v_dm - v_dm_mean[:, None]) ** 2, axis=1) / n_dm
            info["mode_rel_grad"] = np.sqrt((gx2 + gy2) / np.maximum(v2, 1e-12)).tolist()
    if os.path.isfile(wfsmask_p):
        wfs_m = np.asarray(fits.getdata(wfsmask_p))
        info["active_wfs_pix"] = int(np.sum(wfs_m > 0.5))
        info["total_wfs_pix"] = int(wfs_m.size)
    if os.path.isfile(meta_p):
        txt = open(meta_p, "r", encoding="utf-8").read()
        mf = re.search(r'RM_WFSFRATE="([0-9eE.+\-]+)"', txt)
        ml = re.search(r'RM_LATENCYHARDWFR="([0-9eE.+\-]+)"', txt)
        ms = re.search(r'RM_SVDLIM="([0-9eE.+\-]+)"', txt)
        if mf:
            info["wall_cal_hz"] = float(mf.group(1))
        if ml:
            info["latency_fr"] = float(ml.group(1))
        if ms:
            info["svdlim"] = float(ms.group(1))

    for tag, fname in [
        ("wfs_rms", f"aol{loop_num}_imWFS2.fits"),
        ("mval_rms", f"aol{loop_num}_modevalWFS.fits"),
        ("dm_rms_um", f"aol{loop_num}_dmC.fits"),
        ("zpo_dm_rms_um", f"aol{loop_num}_dmzpo.fits"),
        ("zpo_wfs_rms", f"aol{loop_num}_wfszpo.fits"),
    ]:
        fpath = os.path.join(out_dir, fname)
        if os.path.isfile(fpath):
            arr = np.asarray(fits.getdata(fpath), dtype=np.float64)
            info[tag] = float(np.sqrt(np.mean(arr**2)))
            if tag == "dm_rms_um":
                info["dm_ptv_um"] = float(np.max(arr) - np.min(arr))

    mg_p = os.path.join(out_dir, f"aol{loop_num}_mgain.fits")
    mgf_p = os.path.join(out_dir, f"aol{loop_num}_mgainfact.fits")
    if os.path.isfile(mg_p):
        mg = np.asarray(fits.getdata(mg_p), dtype=np.float64).ravel()
        info["mgain_curve"] = mg.tolist()
        info["mgain_tt"] = float(mg[0]) if mg.size else 0.0
        info["mgain_median"] = float(np.median(mg)) if mg.size else 0.0
        info["mgain_min"] = float(np.min(mg)) if mg.size else 0.0
        info["mgain_max"] = float(np.max(mg)) if mg.size else 0.0
    if os.path.isfile(mgf_p):
        mgf = np.asarray(fits.getdata(mgf_p), dtype=np.float64).ravel()
        info["mgainfact_curve"] = mgf.tolist()

    pts_cands = [
        os.path.join(conf_dir, "mlat_hardwlatencypts.dat"),
        os.path.join(out_dir, f"stg{loop_num}_mlat_hardwlatencypts.dat"),
    ]
    raw_cands = [
        os.path.join(conf_dir, "mlat_hardwlatency.dat"),
        os.path.join(out_dir, f"stg{loop_num}_mlat_hardwlatency.dat"),
    ]
    pts_p = next((p for p in pts_cands if os.path.isfile(p)), None)
    raw_p = next((p for p in raw_cands if os.path.isfile(p)), None)
    def_wall_hz = {1: 40.0, 2: 80.0, 3: 20.0}.get(loop_num, 40.0)
    def_phys_hz = {1: 1000.0, 2: 2000.0, 3: 500.0}.get(loop_num, 1000.0)
    fps_cal = float(info.get("wall_cal_hz", def_wall_hz))
    phys_hz = float(phys_hz_override or def_phys_hz)

    if pts_p is not None:
        pts = np.loadtxt(pts_p)
        if pts.ndim == 2 and pts.shape[0] >= 6:
            dt_raw_fr = pts[:, 1] * fps_cal
            val_raw = pts[:, 2]
            dt_med_fr = pts[:, 7] * fps_cal
            val_med = pts[:, 8]
            ipeak = int(np.argmax(val_med))
            lat_fr = float(info.get("latency_fr", dt_med_fr[ipeak]))
            fit = fit_mlat_curve(dt_raw_fr, val_raw)
            nb_excl = 2
            dtfr = (lat_fr - 0.5) + 0.5 * nb_excl
            rm_del_fr = int(math.ceil(dtfr)) if dtfr > 0.0 else 0
            wait_fr = max(0.0, float(rm_del_fr) - dtfr)
            iter_lats = []
            if raw_p is not None:
                for line in open(raw_p, "r", encoding="utf-8"):
                    s = line.strip()
                    if s.startswith("#"):
                        toks = s[1:].split()
                        if len(toks) >= 2:
                            iter_lats.append(float(toks[1]) * fps_cal)
            info["mlat"] = {
                "n_points": int(pts.shape[0]),
                "n_iter": len(iter_lats),
                "wall_fps_hz": fps_cal,
                "phys_fps_hz": phys_hz,
                "phys_frame_ms": 1000.0 / phys_hz,
                "latency_fr": lat_fr,
                "latency_phys_ms": lat_fr * (1000.0 / phys_hz),
                "peak_val": float(val_med[ipeak]),
                "iter_lat_mean_fr": (
                    float(np.mean(iter_lats)) if iter_lats else lat_fr
                ),
                "iter_lat_std_fr": (
                    float(np.std(iter_lats)) if len(iter_lats) > 1 else 0.0
                ),
                "rm_nbave": 2,
                "rm_nbexcl": nb_excl,
                "rm_dtfr": dtfr,
                "rm_delay_fr": rm_del_fr,
                "rm_subframe_wait_fr": wait_fr,
                "rm_subframe_wait_wall_ms": (wait_fr / fps_cal) * 1000.0,
                "fit": {
                    **fit,
                    "tau_fit_phys_ms": fit["tau_fit_fr"] * (1000.0 / phys_hz),
                },
                "dt_raw_fr": dt_raw_fr.tolist(),
                "val_raw": val_raw.tolist(),
                "dt_med_fr": dt_med_fr.tolist(),
                "val_med": val_med.tolist(),
            }

    srm_info = analyze_selfrm_pair(conf_dir, out_dir, loop_num, tmp_npys)
    if srm_info is not None:
        info["selfrm"] = srm_info
    return info


def load_predictive_control_metrics(out_dir, tmp_npys):
    pf_json_p = os.path.join(out_dir, "pf_stats.json")
    env_pred = os.environ.get("CACAOSIM_PREDICTIVE", "0").lower() not in (
        "0",
        "off",
        "false",
        "",
    )
    has_pf_fits = os.path.isfile(os.path.join(out_dir, "aol1_arPFmat.fits")) or os.path.isfile(
        os.path.join(out_dir, "aol1_eofPFmat.fits")
    )
    if not env_pred and not os.path.isfile(pf_json_p) and not has_pf_fits:
        return None

    raw = {}
    if os.path.isfile(pf_json_p):
        try:
            with open(pf_json_p, "r", encoding="utf-8") as fh:
                raw = json.load(fh)
        except Exception:
            raw = {}

    pf_mode = str(raw.get("pf_mode", "ar")).lower()
    pf_blocksize = int(raw.get("pf_blocksize", 1 if pf_mode != "eof" else 128))
    pf_order = int(raw.get("pf_order", os.environ.get("CACAOSIM_PF_ORDER", "8")))
    pf_mix = float(raw.get("pf_mix", os.environ.get("CACAOSIM_PF_MIX", "0.90")))
    pf_reg = float(raw.get("pf_reg", os.environ.get("CACAOSIM_PF_REG", "0.005")))
    pf_mgain_exp = float(
        raw.get("pf_mgain_exp", os.environ.get("CACAOSIM_PF_MGAIN_EXP", "0.50"))
    )

    algo_str = (
        f"PSOL Block Cross-Mode EOF(B={pf_blocksize}, P={pf_order}) Predictor "
        "(mkEOFPF + applyEOFPF)"
        if pf_mode == "eof"
        else "PSOL Regularized Wiener Auto-Regressive Predictor (mkARPF + applyARPF)"
    )
    out = {
        "enabled": True,
        "algorithm": algo_str,
        "pf_mode": pf_mode,
        "pf_blocksize": pf_blocksize,
        "pf_order": pf_order,
        "pf_mix": pf_mix,
        "pf_reg": pf_reg,
        "pf_mgain_exp": pf_mgain_exp,
    }

    for stg_idx, stg_key, rate_hz in ((1, "stage1", 1000.0), (2, "stage2", 2000.0)):
        st_in = dict(raw.get(stg_key) or {})
        st_out = {
            "loop_rate_hz": rate_hz,
            "pflatency_fr": float(st_in.get("pflatency_fr", 0.0)),
            "pflatency_ms": float(st_in.get("pflatency_fr", 0.0)) * (1000.0 / rate_hz),
            "wfsfact": float(st_in.get("wfsfact", 1.0)),
            "n_updates": int(st_in.get("n_updates", 0)),
            "n_eof_updates": int(st_in.get("n_eof_updates", 0)),
            "eof_active": int(st_in.get("eof_active", 0)),
            "n_samples": int(st_in.get("n_samples", 0)),
            "rms_ol": float(st_in.get("rms_ol", 0.0)),
            "rms_zoh": float(st_in.get("rms_zoh", 0.0)),
            "rms_pred": float(st_in.get("rms_pred", 0.0)),
            "var_red_pct": float(st_in.get("var_red_pct", 0.0)),
            "offdiag_frac": float(st_in.get("offdiag_frac", 0.0)),
            "active_frames": int(st_in.get("active_frames", 0)),
            "timeout_cnt": int(st_in.get("timeout_cnt", 0)),
        }
        pf_mat_p = os.path.join(out_dir, f"aol{stg_idx}_arPFmat.fits")
        eof_mat_p = os.path.join(out_dir, f"aol{stg_idx}_eofPFmat.fits")
        if os.path.isfile(eof_mat_p):
            fmat = np.asarray(fits.getdata(eof_mat_p), dtype=np.float64)
            if fmat.ndim == 2:
                # FITS stores (NBmode, PForder*B + diag_tail)
                n_m, stride = fmat.shape
                b_sz = max(1, pf_blocksize)
                p_ord = pf_order if stride >= pf_order * b_sz else max(1, stride // b_sz)
                pb_len = p_ord * b_sz
                diag_tail = max(0, stride - pb_len)
                wmat = np.zeros((p_ord, n_m), dtype=np.float64)
                for m_i in range(n_m):
                    loc_m = m_i % b_sz
                    for k_i in range(p_ord):
                        col_i = k_i * b_sz + loc_m
                        if col_i < pb_len:
                            wmat[k_i, m_i] = fmat[m_i, col_i]
                npy_w = os.path.join(out_dir, f"pf_wmat_stg{stg_idx}.npy")
                np.save(npy_w, wmat.astype(np.float32))
                tmp_npys.append(npy_w)
                dc_g = np.sum(wmat, axis=0)
                if diag_tail > 0:
                    dc_g = dc_g + np.sum(fmat[:, pb_len:], axis=1)
                n2_g = np.sum(fmat**2, axis=1)
                npy_n2 = os.path.join(out_dir, f"pf_n2_stg{stg_idx}.npy")
                np.save(npy_n2, n2_g.astype(np.float32))
                tmp_npys.append(npy_n2)
                st_out.update(
                    {
                        "n_modes": int(n_m),
                        "tap_order": int(p_ord),
                        "blocksize": int(b_sz),
                        "w0_median": float(np.median(wmat[0])),
                        "w0_max": float(np.max(wmat[0])),
                        "w1_median": float(np.median(wmat[1])) if p_ord > 1 else 0.0,
                        "dc_gain_median": float(np.median(dc_g)),
                        "dc_gain_max": float(np.max(dc_g)),
                        "norm2_median": float(np.median(n2_g)),
                        "norm2_max": float(np.max(n2_g)),
                    }
                )
        elif os.path.isfile(pf_mat_p):
            wmat = np.asarray(fits.getdata(pf_mat_p), dtype=np.float64)
            if wmat.ndim == 2:
                # FITS stores (PForder, NBmode) when xsize=NBmode, ysize=PForder
                if wmat.shape[0] <= 64 and wmat.shape[1] > wmat.shape[0]:
                    p_ord, n_m = wmat.shape
                else:
                    wmat = wmat.T
                    p_ord, n_m = wmat.shape
                npy_w = os.path.join(out_dir, f"pf_wmat_stg{stg_idx}.npy")
                np.save(npy_w, wmat.astype(np.float32))
                tmp_npys.append(npy_w)
                dc_g = np.sum(wmat, axis=0)
                n2_g = np.sum(wmat**2, axis=0)
                st_out.update(
                    {
                        "n_modes": int(n_m),
                        "tap_order": int(p_ord),
                        "w0_median": float(np.median(wmat[0])),
                        "w0_max": float(np.max(wmat[0])),
                        "w1_median": float(np.median(wmat[1])) if p_ord > 1 else 0.0,
                        "dc_gain_median": float(np.median(dc_g)),
                        "dc_gain_max": float(np.max(dc_g)),
                        "norm2_median": float(np.median(n2_g)),
                        "norm2_max": float(np.max(n2_g)),
                    }
                )
        vecs = {}
        for sfx in ("mvalOLrms", "mvalPFresrms", "mvalWFSrms", "mvalDMrms", "mPFmix"):
            fp = os.path.join(out_dir, f"aol{stg_idx}_{sfx}.fits")
            if os.path.isfile(fp):
                v = np.asarray(fits.getdata(fp), dtype=np.float64).ravel()
                vecs[sfx] = v
                npy_v = os.path.join(out_dir, f"pf_{sfx}_stg{stg_idx}.npy")
                np.save(npy_v, v.astype(np.float32))
                tmp_npys.append(npy_v)
        if "mvalOLrms" in vecs:
            st_out["quad_ol_rms"] = float(np.linalg.norm(vecs["mvalOLrms"]))
        if "mvalPFresrms" in vecs:
            st_out["quad_pfres_rms"] = float(np.linalg.norm(vecs["mvalPFresrms"]))
        if "mvalWFSrms" in vecs:
            st_out["quad_wfs_rms"] = float(np.linalg.norm(vecs["mvalWFSrms"]))
        if "mvalDMrms" in vecs:
            st_out["quad_dm_rms"] = float(np.linalg.norm(vecs["mvalDMrms"]))
        out[stg_key] = st_out

    return out


def _bilinear_resample_2d(arr, new_h, new_w, scale_x=1.0, scale_y=1.0):
    """Pure-NumPy bilinear resampling of 2D array centered on grid midpoint."""
    old_h, old_w = arr.shape
    cy_old = 0.5 * (old_h - 1.0)
    cx_old = 0.5 * (old_w - 1.0)
    cy_new = 0.5 * (new_h - 1.0)
    cx_new = 0.5 * (new_w - 1.0)
    yy = (np.arange(new_h, dtype=np.float64) - cy_new) * scale_y + cy_old
    xx = (np.arange(new_w, dtype=np.float64) - cx_new) * scale_x + cx_old
    valid_y = (yy >= 0.0) & (yy <= old_h - 1.0)
    valid_x = (xx >= 0.0) & (xx <= old_w - 1.0)
    y0 = np.clip(np.floor(yy).astype(np.int64), 0, old_h - 1)
    x0 = np.clip(np.floor(xx).astype(np.int64), 0, old_w - 1)
    y1 = np.clip(y0 + 1, 0, old_h - 1)
    x1 = np.clip(x0 + 1, 0, old_w - 1)
    wy = (yy - y0)[:, None]
    wx = (xx - x0)[None, :]
    out = (
        (1.0 - wy) * (1.0 - wx) * arr[np.ix_(y0, x0)]
        + (1.0 - wy) * wx * arr[np.ix_(y0, x1)]
        + wy * (1.0 - wx) * arr[np.ix_(y1, x0)]
        + wy * wx * arr[np.ix_(y1, x1)]
    )
    mask = valid_y[:, None] & valid_x[None, :]
    out[~mask] = 0.0
    return out


def load_calib_2wfs1dm_metrics(out_dir, work_dir, tmp_npys):
    """Load 2-WFS + inter-stage DM telemetry calibration outputs (mlt.calib2wfs1dm / mlt.sysid)."""
    cands = [
        os.path.join(out_dir, "calib_2wfs1dm"),
        os.path.join(out_dir, "telemetry", "analysis", "calib_2wfs1dm"),
    ]
    cdir = next(
        (d for d in cands if os.path.isfile(os.path.join(d, "sysid_summary.json"))),
        None,
    )
    if cdir is None:
        return None

    try:
        with open(os.path.join(cdir, "sysid_summary.json"), "r", encoding="utf-8") as fh:
            raw = json.load(fh)
    except Exception:
        return None
    if not isinstance(raw, dict):
        return None

    # Copy compact JSON summary into out_dir root so web bundler stages it as downloadable data.
    root_json = os.path.join(out_dir, "calib_2wfs1dm_summary.json")
    if os.path.abspath(os.path.join(cdir, "sysid_summary.json")) != os.path.abspath(root_json):
        try:
            with open(root_json, "w", encoding="utf-8") as fh:
                json.dump(raw, fh, indent=2)
                fh.write("\n")
        except Exception:
            pass

    out = dict(raw)
    out["enabled"] = True
    out["algorithm"] = (
        "Joint 2-WFS + 1-DM Telemetry Calibration "
        "(B = Mab A + Mdb D + b0 & virtual A = Mba B - Mda_virt D + a0 via AR(p) W(z))"
    )
    out["source_dir"] = cdir

    fits_map = {
        "Mab": "Mab.fits",
        "Mdb": "Mdb.fits",
        "Mba": "Mba.fits",
        "Mda_virt": "Mda_virt.fits",
        "ar_taps": "ar_taps.fits",
        "eta_d": "eta_d.fits",
        "eta_d_raw": "eta_d_raw.fits",
        "mdb_diag": "mdb_diag.fits",
        "mdb_diag_raw": "mdb_diag_raw.fits",
        "r2_b_w": "r2_b_w.fits",
        "r2_ol_raw": "r2_ol_raw.fits",
        "r2_a_raw": "r2_a_raw.fits",
        "r2_a_w": "r2_a_w.fits",
        "og_selfrm": "og_selfrm.fits",
    }
    loaded = {}
    for key, fname in fits_map.items():
        fp = os.path.join(cdir, fname)
        if os.path.isfile(fp):
            arr = np.asarray(fits.getdata(fp), dtype=np.float64)
            loaded[key] = arr
            npy_p = os.path.join(out_dir, f"calib2wfs_{key}.npy")
            np.save(npy_p, arr.astype(np.float32))
            tmp_npys.append(npy_p)

    # Parse optional causal lag scan curve.
    lscan_p = os.path.join(cdir, "lag_scan.txt")
    if os.path.isfile(lscan_p):
        rows = []
        try:
            with open(lscan_p, "r", encoding="utf-8") as fh:
                for line in fh:
                    s = line.strip()
                    if not s or s.startswith("#"):
                        continue
                    parts = s.split()
                    if len(parts) >= 4:
                        rows.append(
                            {
                                "lag_db_fr": float(parts[0]),
                                "lag_ab_fr": float(parts[1]),
                                "r2_b_w_med": float(parts[2]),
                                "mdb_diag_med": float(parts[3]),
                            }
                        )
        except Exception:
            rows = []
        if rows:
            out["lag_scan"] = rows

    # Independent geometric cross-DM verification: project Stage-2 CMmodesDM onto Stage-1 grid.
    cm1_cands = [
        os.path.join(work_dir, "ao3k", "conf", "CMmodesDM.fits"),
        os.path.join(out_dir, "telemetry", "calib_stg1", "CMmodesDM.fits"),
    ]
    cm2_cands = [
        os.path.join(work_dir, "scexao", "conf", "CMmodesDM.fits"),
        os.path.join(out_dir, "telemetry", "calib_stg2", "CMmodesDM.fits"),
    ]
    cm1_p = next((p for p in cm1_cands if os.path.isfile(p)), None)
    cm2_p = next((p for p in cm2_cands if os.path.isfile(p)), None)
    if cm1_p and cm2_p and "Mda_virt" in loaded:
        try:
            mda = loaded["Mda_virt"]  # (dA, dD)
            d_a, d_d = mda.shape
            m1_raw = np.asarray(fits.getdata(cm1_p), dtype=np.float64)
            m2_raw = np.asarray(fits.getdata(cm2_p), dtype=np.float64)
            if m1_raw.ndim == 3 and m2_raw.ndim == 3:
                # FITS (nmodes, ny, nx)
                k1 = min(d_a, m1_raw.shape[0])
                k2 = min(d_d, m2_raw.shape[0])
                ny1, nx1 = m1_raw.shape[1], m1_raw.shape[2]
                # Match pupil diameter ratio: DM1 D=60 act on 64x64, DM2 D=46 act on 50x50
                scale = 46.0 / 60.0
                u1 = m1_raw[:k1].reshape(k1, ny1 * nx1)  # (k1, P1)
                u2_on_1 = np.empty((k2, ny1 * nx1), dtype=np.float64)
                for j in range(k2):
                    u2_on_1[j] = _bilinear_resample_2d(
                        m2_raw[j], ny1, nx1, scale_x=scale, scale_y=scale
                    ).ravel()
                # Least-squares geometric DM2 -> DM1 modal projection: U1^T * M_geom = U2^T
                g11 = u1 @ u1.T + 1e-6 * np.eye(k1)
                m_geom = np.linalg.solve(g11, u1 @ u2_on_1.T)  # (k1, k2)
                npy_g = os.path.join(out_dir, "calib2wfs_Mgeom.npy")
                np.save(npy_g, m_geom.astype(np.float32))
                tmp_npys.append(npy_g)
                # Column-wise cosine similarity between Mda_virt and geometric M_geom
                sub_est = mda[:k1, :k2]
                cos_list = []
                for j in range(k2):
                    n1 = np.linalg.norm(sub_est[:, j])
                    n2 = np.linalg.norm(m_geom[:, j])
                    if n1 > 1e-12 and n2 > 1e-12:
                        cos_list.append(abs(float(np.dot(sub_est[:, j], m_geom[:, j]) / (n1 * n2))))
                if cos_list:
                    out["geom_col_cos_med"] = float(np.median(cos_list))
                    out["geom_col_cos_mean"] = float(np.mean(cos_list))
                v1 = sub_est.ravel()
                v2 = m_geom.ravel()
                if np.std(v1) > 1e-12 and np.std(v2) > 1e-12:
                    out["geom_matrix_corr"] = abs(float(np.corrcoef(v1, v2)[0, 1]))
        except Exception:
            pass

    return out


def render_plots_via_sys_python(out_dir, summary_path):
    plotter = r"""
import json, os, sys
import numpy as np
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
from matplotlib.colors import LogNorm
from matplotlib.lines import Line2D
from matplotlib.patches import Circle, Patch
from matplotlib.ticker import MaxNLocator

out_dir, summary_path = sys.argv[1], sys.argv[2]
with open(summary_path, "r", encoding="utf-8") as fh:
    data = json.load(fh)

_orig_savefig = matplotlib.figure.Figure.savefig
def _fast_savefig(self, fname, *args, **kwargs):
    if isinstance(fname, str) and fname.endswith(".png") and "pil_kwargs" not in kwargs:
        kwargs["pil_kwargs"] = {"compress_level": 1}
    return _orig_savefig(self, fname, *args, **kwargs)
matplotlib.figure.Figure.savefig = _fast_savefig

_only_slot = os.environ.get("CACAOSIM_PLOT_SLOT", "").strip()
_n_shards = (
    1
    if _only_slot
    else (min(16, max(1, os.cpu_count() or 1)) if hasattr(os, "fork") else 1)
)
_child_pids = []
_my_shard = 0
if _n_shards > 1:
    for _s in range(1, _n_shards):
        _pid = os.fork()
        if _pid == 0:
            _my_shard = _s
            _child_pids = []
            break
        _child_pids.append(_pid)

def _want_plot(slot):
    if _only_slot:
        return slot == int(_only_slot)
    return (slot % _n_shards) == _my_shard

tel_info = data.get("telescope", {})
tel_d = float(tel_info.get("diameter_m", 8.2))
tput_pct = float(tel_info.get("tput_tel", 0.20)) * 100.0
sa_top = data.get("star_and_atmosphere", {})
phys_t_top = float(sa_top.get("physical_time_s", 10.0))
seeing_top = float(sa_top.get("seeing_arcsec_500nm", 0.60))

stages = [
    ("raw", f"Uncorrected ({seeing_top:.2f}\" Seeing)"),
    ("stg1", "After Stage 1 (AO3k NIR PyWFS)"),
    ("final", "Final Stage 1+2+3 (AO3k + SCExAO)"),
]
bands = [
    ("vis", "Visible I-Band (0.75 µm, 15% BW, 3ch)", 0.72),
    ("nir", "Near-IR H-Band (1.65 µm, 18% BW, 3ch)", 1.50),
]

if _want_plot(0):
    fig, axes = plt.subplots(2, 3, figsize=(14.5, 9.2), constrained_layout=True)
    fig.suptitle(
        f"Subaru {tel_d:.2f} m AO3k + SCExAO Correction — "
        f"{phys_t_top:.1f} s Polychromatic PSFs\n"
        f"(Seeing = {seeing_top:.2f}\", Tput = {tput_pct:.0f}%, "
        "Stg1 = 1 kHz J PyWFS, Stg2 = 2 kHz Vis PyWFS, Stg3 = 500 Hz LLOWFS)",
        fontsize=12.4,
        fontweight="bold",
    )

    for r, (bkey, blabel, half_fov_arcsec) in enumerate(bands):
        im_handle = None
        for c, (skey, slabel) in enumerate(stages):
            ax = axes[r, c]
            arr = np.load(os.path.join(out_dir, f"psf_{bkey}_{skey}.npy"))
            m = data["psf_metrics"][bkey][skey]
            ny, nx = arr.shape
            c0 = nx // 2
            pix_arcsec = m["pixscale_mas"] / 1000.0
            hw = min(c0, int(round(half_fov_arcsec / pix_arcsec)))
            sub = np.clip(arr[c0 - hw : c0 + hw, c0 - hw : c0 + hw], 1e-5, 1.0)
            ext = [-hw * pix_arcsec, hw * pix_arcsec, -hw * pix_arcsec, hw * pix_arcsec]

            im_handle = ax.imshow(
                sub,
                origin="lower",
                extent=ext,
                cmap="inferno",
                norm=LogNorm(vmin=1e-4, vmax=1.0),
                interpolation="nearest",
            )
            ld_arcsec = m["ld_mas"] / 1000.0
            c1 = Circle(
                (0.0, 0.0),
                30.0 * ld_arcsec,
                fill=False,
                ls="--",
                lw=0.9,
                ec="cyan",
                alpha=0.75,
                label="AO3k 30 λ/D",
            )
            c2 = Circle(
                (0.0, 0.0),
                23.0 * ld_arcsec,
                fill=False,
                ls=":",
                lw=1.0,
                ec="lime",
                alpha=0.85,
                label="SCExAO 23 λ/D",
            )
            ax.add_patch(c1)
            ax.add_patch(c2)
            if r == 0 and c == 2:
                ax.legend(
                    loc="upper right",
                    fontsize=8,
                    facecolor="#10141c",
                    edgecolor="#556070",
                    labelcolor="white",
                    framealpha=0.85,
                )

            if r == 0:
                ax.set_title(slabel, fontsize=11.5, fontweight="bold")
            if c == 0:
                ax.set_ylabel(f"{blabel}\nΔDec [arcsec]", fontsize=10.5)
            else:
                ax.set_ylabel("ΔDec [arcsec]", fontsize=9.5)
            ax.set_xlabel("ΔRA [arcsec]", fontsize=9.5)

            txt = (
                f"Strehl = {m['strehl_peak']*100:.1f}%\n"
                f"FWHM = {m['fwhm_mas']:.1f} mas ({m['fwhm_ld']:.2f} λ/D)\n"
                f"EE(1.22 λ/D) = {m['ee_1p22ld']*100:.1f}%"
            )
            ax.text(
                0.03,
                0.04,
                txt,
                transform=ax.transAxes,
                fontsize=8.8,
                color="white",
                family="monospace",
                bbox=dict(boxstyle="round,pad=0.3", fc="black", ec="none", alpha=0.68),
            )
        cbar = fig.colorbar(im_handle, ax=axes[r, :], shrink=0.88, pad=0.015)
        cbar.set_label("Strehl-Normalized Intensity", fontsize=10)

    fig.savefig(os.path.join(out_dir, "psf_comparison_2x3.png"), dpi=180)
    plt.close(fig)

if _want_plot(1):
    fig2, axes2 = plt.subplots(2, 2, figsize=(13.5, 8.8), constrained_layout=True)
    fig2.suptitle(
        f"Subaru {tel_d:.2f} m AO3k + SCExAO Azimuthal Radial PSF Profiles & "
        f"Encircled Energy ({phys_t_top:.1f} s)",
        fontsize=12.6,
        fontweight="bold",
    )
    curve_specs = [
        ("dl", "Diffraction-Limited (turb=0)", "black", "--", 1.5),
        ("raw", f"Uncorrected ({seeing_top:.2f}\" seeing)", "#d62728", "-", 1.8),
        ("stg1", "After Stage 1 (AO3k, 1 kHz)", "#ff7f0e", "-", 2.0),
        ("final", "Final Stage 1+2+3 (AO3k+SCExAO, 2 kHz)", "#1f77b4", "-", 2.2),
    ]

    for col, (bkey, blabel, _) in enumerate(bands):
        ax_p = axes2[0, col]
        ax_e = axes2[1, col]
        ld_mas = data["psf_metrics"][bkey]["dl"]["ld_mas"]
        for skey, lab, color, ls, lw in curve_specs:
            m = data["psf_metrics"][bkey][skey]
            r_mas = np.asarray(m["rad_mas"])
            prof = np.clip(np.asarray(m["rad_prof"]), 1e-6, 1.2)
            ax_p.semilogy(
                r_mas,
                prof,
                label=f"{lab} (SR={m['strehl_peak']*100:.1f}%)",
                color=color,
                ls=ls,
                lw=lw,
            )
            if skey != "dl":
                ax_e.plot(
                    m["ee_grid_mas"],
                    np.asarray(m["ee_grid_val"]) * 100.0,
                    label=f"{lab} (r50={m['ee50_radius_mas']:.0f} mas)",
                    color=color,
                    ls=ls,
                    lw=lw,
                )
            else:
                ax_e.plot(
                    m["ee_grid_mas"],
                    np.asarray(m["ee_grid_val"]) * 100.0,
                    label=lab,
                    color=color,
                    ls=ls,
                    lw=lw,
                )

        ax_p.axvline(30.0 * ld_mas, color="teal", ls="--", lw=1.0, alpha=0.7, label="AO3k 30 λ/D")
        ax_p.axvline(23.0 * ld_mas, color="green", ls=":", lw=1.2, alpha=0.8, label="SCExAO 23 λ/D")
        ax_p.set_xlim(0.0, 750.0 if bkey == "vis" else 1500.0)
        ax_p.set_ylim(2e-5, 1.3)
        ax_p.grid(True, which="both", alpha=0.28)
        ax_p.set_title(f"{blabel} — Radial Intensity Profile", fontsize=11, fontweight="bold")
        ax_p.set_xlabel("Angular Separation [mas]")
        ax_p.set_ylabel("Azimuthal Mean Intensity [Strehl units]")
        ax_p.legend(fontsize=8.2, loc="upper right")

        ax_e.axvline(30.0 * ld_mas, color="teal", ls="--", lw=1.0, alpha=0.7)
        ax_e.axvline(23.0 * ld_mas, color="green", ls=":", lw=1.2, alpha=0.8)
        ax_e.set_xlim(0.0, 750.0 if bkey == "vis" else 1500.0)
        ax_e.set_ylim(0.0, 102.0)
        ax_e.grid(True, alpha=0.28)
        ax_e.set_title(f"{blabel} — Encircled Energy", fontsize=11, fontweight="bold")
        ax_e.set_xlabel("Aperture Radius [mas]")
        ax_e.set_ylabel("Encircled Energy [%]")
        ax_e.legend(fontsize=8.2, loc="lower right")

    fig2.savefig(os.path.join(out_dir, "psf_radial_profiles.png"), dpi=180)
    plt.close(fig2)

wf_info = data.get("wavefront_metrics")
if wf_info and os.path.exists(os.path.join(out_dir, "wf_pupil_mask.npy")):
    pup = np.load(os.path.join(out_dir, "wf_pupil_mask.npy"))
    pmask = pup > 0.5
    nwf_grid = pup.shape[0]
    pup_pix = 0.9375 * nwf_grid
    half_m = 0.5 * nwf_grid * (tel_d / pup_pix)
    ext_m = [-half_m, half_m, -half_m, half_m]
    wf_locs = [
        ("raw", "Before Stage 1\n(Entrance Pupil b_pup)"),
        ("stg1", "Between Stages 1 & 2\n(Post-AO3k b_post_stg1)"),
        ("final", "After Stage 2+3\n(Post-SCExAO b_post_stg2)"),
    ]

    cmap_div = matplotlib.colormaps["RdBu_r"].copy()
    cmap_div.set_bad("#141820")
    cmap_std = matplotlib.colormaps["inferno"].copy()
    cmap_std.set_bad("#141820")

    samples = wf_info.get("samples", [])
    nsamp = len(samples)
    if _want_plot(2) and nsamp > 0:
        cubes = {
            k: np.load(os.path.join(out_dir, f"wf_samples_{k}.npy"))
            for k, _ in wf_locs
        }
        vmax_cols = {}
        for k, _ in wf_locs:
            vals = np.abs(cubes[k][:, pmask])
            lim = float(np.percentile(vals, 99.3)) if vals.size else 100.0
            step = 100.0 if lim > 800.0 else (25.0 if lim > 250.0 else 10.0)
            vmax_cols[k] = max(step, np.ceil(lim / step) * step)

        fig3, axes3 = plt.subplots(
            nsamp,
            3,
            figsize=(13.6, 3.15 * nsamp + 1.2),
            constrained_layout=True,
        )
        if nsamp == 1:
            axes3 = axes3[None, :]
        fig3.suptitle(
            f"Subaru {tel_d:.2f} m AO3k + SCExAO — Instantaneous Pupil Wavefront Samples\n"
            f"(Piston-removed OPD [nm] across {pup_pix:.0f}-pix Subaru pupil, "
            f"{seeing_top:.2f}\" seeing)",
            fontsize=13,
            fontweight="bold",
        )

        col_handles = {}
        for c, (k, clabel) in enumerate(wf_locs):
            vlim = vmax_cols[k]
            for r, sm in enumerate(samples):
                ax = axes3[r, c]
                wf_s = np.where(pmask, cubes[k][r], np.nan)
                imh = ax.imshow(
                    wf_s,
                    origin="lower",
                    extent=ext_m,
                    cmap=cmap_div,
                    vmin=-vlim,
                    vmax=vlim,
                    interpolation="nearest",
                )
                col_handles[c] = imh
                if r == 0:
                    ax.set_title(clabel, fontsize=11, fontweight="bold")
                if c == 0:
                    ax.set_ylabel(
                        f"S{r + 1} (t = {sm['t_phys_s']:.2f} s)\ny [m]",
                        fontsize=10,
                        fontweight="bold",
                    )
                else:
                    ax.set_ylabel("y [m]", fontsize=9)
                if r == nsamp - 1:
                    ax.set_xlabel("x [m]", fontsize=9.5)
                badge = (
                    f"RMS = {sm[k]['rms_nm']:6.1f} nm\n"
                    f"PTV = {sm[k]['ptv_nm']:6.0f} nm"
                )
                ax.text(
                    0.03,
                    0.04,
                    badge,
                    transform=ax.transAxes,
                    fontsize=8.5,
                    color="white",
                    family="monospace",
                    bbox=dict(
                        boxstyle="round,pad=0.25",
                        fc="black",
                        ec="none",
                        alpha=0.72,
                    ),
                )
            cb = fig3.colorbar(
                col_handles[c],
                ax=axes3[:, c],
                orientation="horizontal",
                shrink=0.88,
                pad=0.02,
            )
            cb.set_label(f"OPD [nm] (±{vlim:.0f} nm)", fontsize=9.5)

        fig3.savefig(os.path.join(out_dir, "wf_samples_5x3.png"), dpi=175)
        plt.close(fig3)

    if _want_plot(3):
        fig4, axes4 = plt.subplots(2, 3, figsize=(14.5, 9.2), constrained_layout=True)
        nfr = wf_info.get("n_frames", 0)
        t_rec = wf_info.get("phys_time_recorded_s", 0.0)
        fig4.suptitle(
            f"Subaru {tel_d:.2f} m AO3k + SCExAO — Wavefront Mean & Std Dev Maps "
            f"({t_rec:.1f} s, {nfr:,d} frames)\n"
            "(Row 1: Time-Averaged WF ⟨OPD⟩_t [nm] | Row 2: Temporal Std Dev std_t(OPD) [nm])",
            fontsize=12.8,
            fontweight="bold",
        )

        for c, (k, clabel) in enumerate(wf_locs):
            loc_m = wf_info["locations"][k]
            mean_arr = np.load(os.path.join(out_dir, f"wf_mean_{k}.npy"))
            std_arr = np.load(os.path.join(out_dir, f"wf_std_{k}.npy"))

            m_vals = np.abs(mean_arr[pmask])
            mlim = float(np.percentile(m_vals, 99.5)) if m_vals.size else 10.0
            mstep = 20.0 if mlim > 120.0 else (5.0 if mlim > 25.0 else 2.0)
            mvmax = max(mstep, np.ceil(mlim / mstep) * mstep)

            ax_m = axes4[0, c]
            im_m = ax_m.imshow(
                np.where(pmask, mean_arr, np.nan),
                origin="lower",
                extent=ext_m,
                cmap=cmap_div,
                vmin=-mvmax,
                vmax=mvmax,
                interpolation="nearest",
            )
            ax_m.set_title(clabel, fontsize=11, fontweight="bold")
            ax_m.set_xlabel("x [m]", fontsize=9.5)
            ax_m.set_ylabel("Average WF ⟨OPD⟩_t\ny [m]" if c == 0 else "y [m]", fontsize=10)
            cb_m = fig4.colorbar(im_m, ax=ax_m, shrink=0.86, pad=0.02)
            cb_m.set_label("Mean OPD [nm]", fontsize=9)
            ax_m.text(
                0.03,
                0.04,
                f"RMS(mean) = {loc_m['mean_map_rms_nm']:.1f} nm\n"
                f"PTV(mean) = {loc_m['mean_map_ptv_nm']:.0f} nm",
                transform=ax_m.transAxes,
                fontsize=8.6,
                color="white",
                family="monospace",
                bbox=dict(boxstyle="round,pad=0.26", fc="black", ec="none", alpha=0.72),
            )

            s_vals = std_arr[pmask]
            slim = float(np.percentile(s_vals, 99.5)) if s_vals.size else 50.0
            sstep = 100.0 if slim > 600.0 else (20.0 if slim > 150.0 else 10.0)
            svmax = max(sstep, np.ceil(slim / sstep) * sstep)

            ax_s = axes4[1, c]
            im_s = ax_s.imshow(
                np.where(pmask, std_arr, np.nan),
                origin="lower",
                extent=ext_m,
                cmap=cmap_std,
                vmin=0.0,
                vmax=svmax,
                interpolation="nearest",
            )
            ax_s.set_xlabel("x [m]", fontsize=9.5)
            ax_s.set_ylabel(
                "Std Dev std_t(OPD)\ny [m]" if c == 0 else "y [m]", fontsize=10
            )
            cb_s = fig4.colorbar(im_s, ax=ax_s, shrink=0.86, pad=0.02)
            cb_s.set_label("Std Dev OPD [nm]", fontsize=9)
            ax_s.text(
                0.03,
                0.04,
                f"RMS(std) = {loc_m['std_map_rms_nm']:.1f} nm\n"
                f"Med={loc_m['std_map_median_nm']:.0f}, P95={loc_m['std_map_p95_nm']:.0f} nm",
                transform=ax_s.transAxes,
                fontsize=8.5,
                color="white",
                family="monospace",
                bbox=dict(boxstyle="round,pad=0.26", fc="black", ec="none", alpha=0.72),
            )

        fig4.savefig(os.path.join(out_dir, "wf_stats_2x3.png"), dpi=180)
        plt.close(fig4)

    samples = wf_info.get("samples", []) if wf_info else []
    nsamp = len(samples)
    wfs_ready = nsamp > 0 and os.path.exists(
        os.path.join(out_dir, "wfs_raw_stg1_samples.npy")
    )
    if _want_plot(4) and wfs_ready:
        wfs_cols = [
            (
                "wfs_raw_stg1",
                "Stage 1 AO3k Raw PyWFS\n(csim_wfs_nir, 1.22 µm 20% 2ch @ 1 kHz)",
                "raw",
            ),
            (
                "wfs_sig_stg1",
                "Stage 1 AO3k Ref-Sub Signal\n(aol1_imWFS2, 160×160)",
                "sig",
            ),
            (
                "wfs_raw_stg2",
                "Stage 2 SCExAO Raw PyWFS\n(csim_wfs_vis, 0.75 µm 20% 2ch @ 2 kHz)",
                "raw",
            ),
            (
                "wfs_sig_stg2",
                "Stage 2 SCExAO Ref-Sub Signal\n(aol2_imWFS2, 120×120)",
                "sig",
            ),
        ]
        wcubes = {
            ek: np.load(os.path.join(out_dir, f"{ek}_samples.npy"))
            for ek, _, _ in wfs_cols
        }
        fig5, axes5 = plt.subplots(
            nsamp,
            4,
            figsize=(16.2, 3.05 * nsamp + 1.3),
            constrained_layout=True,
        )
        if nsamp == 1:
            axes5 = axes5[None, :]
        fig5.suptitle(
            f"Subaru {tel_d:.2f} m AO3k + SCExAO — Instantaneous Pyramid WFS Frames\n"
            "(Raw Detector [ADU] & Reference-Subtracted Differential Signal "
            "at 5 Sampled Instants)",
            fontsize=13,
            fontweight="bold",
        )
        for c, (ek, clab, kind) in enumerate(wfs_cols):
            cube = wcubes[ek]
            if kind == "raw":
                disp_cube = cube
                vmin = 95.0
                vmax = max(150.0, float(np.percentile(disp_cube, 99.7)))
                cmap_w = "magma"
                cblab = "Detector [ADU]"
            else:
                disp_cube = cube * 1.0e4
                lim = max(0.5, float(np.percentile(np.abs(disp_cube), 99.5)))
                vmin, vmax = -lim, lim
                cmap_w = "RdBu_r"
                cblab = "Ref-Sub Signal [×10⁻⁴ norm]"
            imh = None
            for r, sm in enumerate(samples):
                ax = axes5[r, c]
                imh = ax.imshow(
                    disp_cube[r],
                    origin="lower",
                    cmap=cmap_w,
                    vmin=vmin,
                    vmax=vmax,
                    interpolation="nearest",
                )
                if r == 0:
                    ax.set_title(clab, fontsize=10.5, fontweight="bold")
                if c == 0:
                    ax.set_ylabel(
                        f"S{r + 1} (t = {sm['t_phys_s']:.2f} s)\ny [pix]",
                        fontsize=10,
                        fontweight="bold",
                    )
                else:
                    ax.set_ylabel("y [pix]", fontsize=8.8)
                if r == nsamp - 1:
                    ax.set_xlabel("x [pix]", fontsize=9)
                ex = sm.get("extra", {}).get(ek, {})
                if kind == "raw":
                    btxt = (
                        f"Max = {ex.get('max_adu', 0.0):6.0f} ADU\n"
                        f"Sum = {ex.get('sum_adu', 0.0)/1e3:5.0f} kADU"
                    )
                else:
                    frm_f = cube[r].astype(np.float64)
                    rms_v = float(np.sqrt(np.mean(frm_f**2)))
                    ptv_v = float(np.max(frm_f) - np.min(frm_f))
                    btxt = (
                        f"RMS = {rms_v*1e4:5.2f}e-4\n"
                        f"PTV = {ptv_v*1e3:5.2f}e-3"
                    )
                ax.text(
                    0.03,
                    0.04,
                    btxt,
                    transform=ax.transAxes,
                    fontsize=8.1,
                    color="white" if kind == "raw" else "black",
                    family="monospace",
                    bbox=dict(
                        boxstyle="round,pad=0.22",
                        fc="black" if kind == "raw" else "white",
                        ec="none",
                        alpha=0.72 if kind == "raw" else 0.78,
                    ),
                )
            cb = fig5.colorbar(
                imh,
                ax=axes5[:, c],
                orientation="horizontal",
                shrink=0.88,
                pad=0.02,
            )
            if kind == "sig":
                cb.ax.xaxis.set_major_locator(MaxNLocator(5))
            cb.set_label(cblab, fontsize=9.2)
        fig5.savefig(os.path.join(out_dir, "wfs_samples_5x4.png"), dpi=175)
        plt.close(fig5)

    dm_ready = (
        nsamp > 0
        and os.path.exists(os.path.join(out_dir, "dm_cmd_stg1_samples.npy"))
        and os.path.exists(os.path.join(out_dir, "wf_pupil_mask.npy"))
    )
    if _want_plot(5) and dm_ready:
        dm_cols = [
            (
                "dm_cmd_stg1",
                "Stage 1 AO3k Actuator Cmd\n(dm01disp, 64×64, D=60 Stroke [µm])",
                "cmd",
            ),
            (
                "dm_opd_stg1",
                "Stage 1 AO3k Pupil DM OPD\n(csim_dm01_opd, 256×256 [nm])",
                "opd",
            ),
            (
                "dm_cmd_stg2",
                "Stage 2 SCExAO Actuator Cmd\n(dm02disp, 50×50, D=46 Stroke [µm])",
                "cmd",
            ),
            (
                "dm_opd_stg2",
                "Stage 2 SCExAO Pupil DM OPD\n(csim_dm02_opd, 256×256 [nm])",
                "opd",
            ),
        ]
        dcubes = {
            ek: np.load(os.path.join(out_dir, f"{ek}_samples.npy"))
            for ek, _, _ in dm_cols
        }
        fig6, axes6 = plt.subplots(
            nsamp,
            4,
            figsize=(16.2, 3.05 * nsamp + 1.3),
            constrained_layout=True,
        )
        if nsamp == 1:
            axes6 = axes6[None, :]
        fig6.suptitle(
            f"Subaru {tel_d:.2f} m AO3k + SCExAO — Instantaneous DM Actuator Commands & "
            "Pupil OPD Shapes\n"
            "(Mechanical Stroke [µm] & Piston-Removed Reflective OPD [nm] "
            "at 5 Sampled Instants)",
            fontsize=13,
            fontweight="bold",
        )
        for c, (ek, clab, kind) in enumerate(dm_cols):
            cube = dcubes[ek]
            if kind == "cmd":
                lim = max(0.05, float(np.percentile(np.abs(cube), 99.5)))
                vlim = np.ceil(lim * 20.0) / 20.0
                cblab = f"Stroke [µm] (±{vlim:.2f} µm)"
            else:
                vals = np.abs(cube[:, pmask])
                lim = max(10.0, float(np.percentile(vals, 99.3)))
                step = 100.0 if lim > 800.0 else (25.0 if lim > 200.0 else 10.0)
                vlim = max(step, np.ceil(lim / step) * step)
                cblab = f"DM OPD [nm] (±{vlim:.0f} nm)"
            imh = None
            for r, sm in enumerate(samples):
                ax = axes6[r, c]
                ex = sm.get("extra", {}).get(ek, {})
                if kind == "cmd":
                    imh = ax.imshow(
                        cube[r],
                        origin="lower",
                        cmap="RdBu_r",
                        vmin=-vlim,
                        vmax=vlim,
                        interpolation="nearest",
                    )
                    ylab = "act y"
                    xlab = "act x"
                    btxt = (
                        f"RMS = {ex.get('rms_um', 0.0):.3f} µm\n"
                        f"PTV = {ex.get('ptv_um', 0.0):.2f} µm"
                    )
                    tc, fc, al = "black", "white", 0.78
                else:
                    imh = ax.imshow(
                        np.where(pmask, cube[r], np.nan),
                        origin="lower",
                        extent=ext_m,
                        cmap=cmap_div,
                        vmin=-vlim,
                        vmax=vlim,
                        interpolation="nearest",
                    )
                    ylab = "y [m]"
                    xlab = "x [m]"
                    btxt = (
                        f"RMS = {ex.get('rms_nm', 0.0):6.1f} nm\n"
                        f"PTV = {ex.get('ptv_nm', 0.0):6.0f} nm"
                    )
                    tc, fc, al = "white", "black", 0.72
                if r == 0:
                    ax.set_title(clab, fontsize=10.5, fontweight="bold")
                if c == 0:
                    ax.set_ylabel(
                        f"S{r + 1} (t = {sm['t_phys_s']:.2f} s)\n{ylab}",
                        fontsize=10,
                        fontweight="bold",
                    )
                else:
                    ax.set_ylabel(ylab, fontsize=8.8)
                if r == nsamp - 1:
                    ax.set_xlabel(xlab, fontsize=9)
                ax.text(
                    0.03,
                    0.04,
                    btxt,
                    transform=ax.transAxes,
                    fontsize=8.1,
                    color=tc,
                    family="monospace",
                    bbox=dict(
                        boxstyle="round,pad=0.22", fc=fc, ec="none", alpha=al
                    ),
                )
            cb = fig6.colorbar(
                imh,
                ax=axes6[:, c],
                orientation="horizontal",
                shrink=0.88,
                pad=0.02,
            )
            cb.set_label(cblab, fontsize=9.2)
        fig6.savefig(os.path.join(out_dir, "dm_samples_5x4.png"), dpi=175)
        plt.close(fig6)

    psf_inst_stages = [
        ("raw", "Before Stage 1\n(Uncorrected Entrance Pupil)"),
        ("stg1", "Between Stages 1 & 2\n(After AO3k 1 kHz NIR PyWFS)"),
        ("final", "After Stage 2\n(Final AO3k + SCExAO 2 kHz)"),
    ]
    for _bi, (bkey, blabel, half_fov_arcsec) in enumerate(bands):
        if not _want_plot(6 + _bi):
            continue
        sr_check = os.path.join(out_dir, f"psf_inst_{bkey}_final_sr.npy")
        if nsamp == 0 or not os.path.exists(sr_check):
            continue
        pcubes = {
            sk: np.load(os.path.join(out_dir, f"psf_inst_{bkey}_{sk}_sr.npy"))
            for sk, _ in psf_inst_stages
        }
        m_ref = data["psf_metrics"][bkey]["final"]
        pix_arcsec = m_ref["pixscale_mas"] / 1000.0
        ld_arcsec = m_ref["ld_mas"] / 1000.0
        c0 = pcubes["final"].shape[-1] // 2
        hw = min(c0, int(round(half_fov_arcsec / pix_arcsec)))
        ext_p = [
            -hw * pix_arcsec,
            hw * pix_arcsec,
            -hw * pix_arcsec,
            hw * pix_arcsec,
        ]

        figp, axesp = plt.subplots(
            nsamp,
            3,
            figsize=(13.8, 3.15 * nsamp + 1.3),
            constrained_layout=True,
        )
        if nsamp == 1:
            axesp = axesp[None, :]
        figp.suptitle(
            f"Subaru {tel_d:.2f} m AO3k + SCExAO — Instantaneous {blabel} PSFs (10 ms Exposures)\n"
            "(Detector Speckle Snapshots Normalized to Strehl Intensity Units, "
            f"{seeing_top:.2f}\" Seeing)",
            fontsize=12.8,
            fontweight="bold",
        )
        imh_p = None
        for c, (sk, slab) in enumerate(psf_inst_stages):
            for r, sm in enumerate(samples):
                ax = axesp[r, c]
                sub = np.clip(
                    pcubes[sk][r, c0 - hw : c0 + hw, c0 - hw : c0 + hw],
                    1e-5,
                    1.0,
                )
                imh_p = ax.imshow(
                    sub,
                    origin="lower",
                    extent=ext_p,
                    cmap="inferno",
                    norm=LogNorm(vmin=1e-4, vmax=1.0),
