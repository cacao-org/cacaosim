        c0 = nx // 2
        pix_arcsec = m["pixscale_mas"] / 1000.0
        hw = min(c0, int(round(half_fov_arcsec / pix_arcsec)))
        sub = np.clip(arr[c0 - hw : c0 + hw, c0 - hw : c0 + hw], 1e-5, 1.0)
        ext = [-hw * pix_arcsec, hw * pix_arcsec, -hw * pix_arcsec, hw * pix_arcsec]

        im_handle = ax.imshow(
            sub,
            origin="lower",
            extent=ext,
            cmap="inferno",
