if (
    _want_plot(15)
    and coro_m
    and os.path.exists(os.path.join(out_dir, "coro_pup_lyot.npy"))
    and os.path.exists(os.path.join(out_dir, "coro_pre_lyot_dl.npy"))
    and os.path.exists(os.path.join(out_dir, "coro_pre_lyot.npy"))
):
    bud_ly = coro_m.get("lowfs_light_budget") or {}
    bdl_ly = bud_ly.get("diffraction_limited") or {}
    bcl_ly = bud_ly.get("closed_loop") or {}
    if bdl_ly and bcl_ly:
        figly, axesly = plt.subplots(2, 3, figsize=(16.2, 9.8), constrained_layout=True)
        ly = coro_m["lyot_stop"]
        lo = coro_m["llowfs"]
        spot_ld = float(coro_m["spot_radius_ld"])
        refl_r = float(coro_m["lowfs_refl"])
        up_h = float(bud_ly.get("upstream_ao_h_tput", 0.867))

        figly.suptitle(
            f"Subaru {tel_d:.2f} m AO3k + SCExAO — Light Incident on Lyot Stop & "
            f"Reflective-Lyot LOWFS Power Budget\n"
            f"(H-Band 1.65 µm, 18% BW; Spot R = {spot_ld:.1f} λ/D; "
            f"Lyot Outer/Obs = {ly['outer']:.2f}/{ly['obs']:.2f}, r = {refl_r:.2f} → "
            f"+{lo['defocus_nm']:.0f} nm Z4 Defocused 64×64 LOWFS @ {lo['rate_hz']:.0f} Hz)",
            fontsize=12.0,
            fontweight="bold",
        )

        pup_ly = np.load(os.path.join(out_dir, "coro_pup_lyot.npy"))
        p_amp, l_amp = pup_ly[0], pup_ly[1]
        p_int = p_amp**2
        l_int = l_amp**2
        pup_sum = max(float(np.sum(p_int)), 1.0)
        nwf_c = p_amp.shape[0]
        hm_c = 0.5 * nwf_c * (tel_d / (0.9375 * nwf_c))
        ext_c = [-hm_c, hm_c, -hm_c, hm_c]

        pre_dl_raw = np.load(os.path.join(out_dir, "coro_pre_lyot_dl.npy")).astype(np.float64)
        pre_cl_raw = np.load(os.path.join(out_dir, "coro_pre_lyot.npy")).astype(np.float64)
        f_pre_dl = float(bdl_ly["frac_coro_in_incident_on_lyot"])
        f_pre_cl = float(bcl_ly["frac_coro_in_incident_on_lyot"])
        pre_dl_n = pre_dl_raw * (f_pre_dl * pup_sum / max(float(np.sum(pre_dl_raw)), 1e-30))
        pre_cl_n = pre_cl_raw * (f_pre_cl * pup_sum / max(float(np.sum(pre_cl_raw)), 1e-30))
        refl_cl_n = (refl_r**2) * np.maximum(0.0, 1.0 - l_int) * pre_cl_n

        pup_panels = [
            (
                axesly[0, 0],
                p_int,
                "Coronagraph Input Pupil |E_in|²\n(b_nir_sci, Before 3.0 λ/D Focal Spot)",
                f"Coro-In H-Band = 100.00%\n"
                f"= {up_h*100:.1f}% of b_pup H-Band\n"
                f"= {up_h*float(bud_ly.get('tput_tel', 0.20))*100:.2f}% of Sky H-Band",
            ),
            (
                axesly[0, 1],
                pre_dl_n,
                "Light Incident on Lyot Stop — DL (turb = 0)\n"
                "(coro_pre_lyot_dl, Cyan = Lyot Stop Edge)",
                f"Inc on Lyot = {f_pre_dl*100:.2f}% coro-in\n"
                f"FPM Absorb  = {bdl_ly['frac_coro_in_fpm_absorbed']*100:.2f}%\n"
                f"Lyot T / R  = {bdl_ly['frac_coro_in_lyot_transmitted_raw']*100:.2f}% / "
                f"{bdl_ly['frac_coro_in_reflected_to_lowfs_beam']*100:.2f}%",
            ),
            (
                axesly[0, 2],
                pre_cl_n,
                f"Light Incident on Lyot Stop — CL ({seeing_top:.2f}\" Seeing)\n"
                "(coro_pre_lyot, Cyan = Lyot Stop Edge)",
                f"Inc on Lyot = {f_pre_cl*100:.2f}% coro-in\n"
                f"FPM Absorb  = {bcl_ly['frac_coro_in_fpm_absorbed']*100:.2f}%\n"
                f"Lyot T / R  = {bcl_ly['frac_coro_in_lyot_transmitted_raw']*100:.2f}% / "
                f"{bcl_ly['frac_coro_in_reflected_to_lowfs_beam']*100:.2f}%",
            ),
            (
                axesly[1, 0],
                refl_cl_n,
                "Light Reflected by Lyot Stop → b_lowfs (CL)\n"
                f"(r²(1 - |L|²)|E_pre_Lyot|², R = {refl_r**2*100:.2f}%)",
                f"Refl b_lowfs = "
                f"{bcl_ly['frac_coro_in_reflected_to_lowfs_beam']*100:.2f}% coro-in\n"
                f"= {bcl_ly['frac_coro_in_reflected_to_lowfs_beam']*up_h*100:.2f}% "
                f"of b_pup H-Band\n"
                f"Blocked Mask = {bcl_ly['frac_coro_in_lyot_blocked']*100:.2f}% coro-in",
            ),
        ]

        for idx_p, (axp, arr_p, ttl_p, ptxt) in enumerate(pup_panels):
            im_p = axp.imshow(
                np.clip(arr_p, 3e-4, 1.5),
                origin="lower",
                extent=ext_c,
                cmap="inferno",
                norm=LogNorm(vmin=3e-4, vmax=1.5),
                interpolation="nearest",
            )
            axp.contour(
                l_amp,
                levels=[0.5],
                extent=ext_c,
                origin="lower",
                colors=["#22d3ee"],
                linewidths=0.95,
                linestyles="--" if idx_p == 0 else "-",
            )
            axp.set_title(ttl_p, fontsize=10.1, fontweight="bold")
            axp.set_xlabel("x [m]")
            axp.set_ylabel("y [m]")
            axp.text(
                0.03,
                0.04,
                ptxt,
                transform=axp.transAxes,
                fontsize=7.9,
                color="white",
                family="monospace",
                bbox=dict(boxstyle="round,pad=0.25", fc="black", ec="none", alpha=0.78),
            )
            cb_p = figly.colorbar(im_p, ax=axp, shrink=0.86, pad=0.02)
            cb_p.set_label("Pupil Intensity [I / I_in,clear]", fontsize=8.6)

        # (1, 1): Defocused 64x64 LOWFS Camera Image
        ax_cam = axesly[1, 1]
        lo_npy_p = os.path.join(out_dir, "det_wfs_lowfs.npy")
        if os.path.exists(lo_npy_p):
            det_lo = np.maximum(np.load(lo_npy_p) - 100.0, 0.5)
            vmax_lo = max(10.0, float(np.percentile(det_lo, 99.8)))
            im_cam = ax_cam.imshow(
                det_lo,
                origin="lower",
                cmap="magma",
                norm=LogNorm(vmin=1.0, vmax=vmax_lo),
                interpolation="nearest",
            )
            cb_cam = figly.colorbar(im_cam, ax=ax_cam, shrink=0.86, pad=0.02)
            cb_cam.set_label("Net Detector [ADU / frame]", fontsize=8.8)
            f_ci_cam = bcl_ly["frac_coro_in_reaching_lowfs_cam_fov"] * 100.0
            f_ph_cam = bcl_ly["frac_entrance_pup_h_reaching_lowfs_cam_fov"] * 100.0
            f_sk_cam = bcl_ly["frac_sky_h_reaching_lowfs_cam_fov"] * 100.0
            ax_cam.text(
                0.03,
                0.04,
                f"LOWFS Cam FOV = {f_ci_cam:.2f}% coro-in\n"
                f"= {f_ph_cam:.2f}% H-pup | {f_sk_cam:.2f}% Sky H\n"
                f"Inc = {bcl_ly['lowfs_cam_incident_ph_per_frame']:.2e} ph/fr "
                f"({bcl_ly['lowfs_cam_detected_phe_per_frame']:.2e} e⁻/fr)",
                transform=ax_cam.transAxes,
                fontsize=7.9,
                color="white",
                family="monospace",
                bbox=dict(boxstyle="round,pad=0.25", fc="black", ec="none", alpha=0.78),
            )
        ax_cam.set_title(
            f"Defocused LOWFS Camera ({lo['detector']} = 32×32 λ/D)\n"
            f"(csim_wfs_lowfs @ {lo['rate_hz']:.0f} Hz, +{lo['defocus_nm']:.0f} nm Z4)",
            fontsize=10.1,
            fontweight="bold",
        )
        ax_cam.set_xlabel("x [pix]")
        ax_cam.set_ylabel("y [pix]")

        # (1, 2): 500 Hz LOWFS Light-Fraction Time Series
        ax_ts = axesly[1, 2]
        ts_npy_p = os.path.join(out_dir, "lowfs_light_ts.npy")
        coro_tp = float(bud_ly.get("coro_relay_tput", 0.92))
        def_tp = float(bud_ly.get("defocus_wfe_tput", 0.99))
        fov_r = float(bcl_ly.get("lowfs_64x64_fov_capture_fraction", 0.96))
        scale_cam = coro_tp * def_tp * fov_r

        if os.path.exists(ts_npy_p):
            ts_d = np.load(ts_npy_p)
            t_v = ts_d[:, 2]
            f_lo_inst = ts_d[:, 3] * 100.0
            f_lo_long = ts_d[:, 4] * 100.0
            f_pre_inst = ts_d[:, 5] * 100.0
            f_cam_inst = f_lo_inst * scale_cam
            f_cam_long = f_lo_long * scale_cam
            dl_cam_pct = bdl_ly["frac_coro_in_reaching_lowfs_cam_fov"] * 100.0

            ax_ts.plot(
                t_v,
                f_pre_inst,
                color="#7c3aed",
                lw=1.0,
                alpha=0.65,
                label=f"Incident on Lyot Stop (⟨{float(np.mean(f_pre_inst)):.2f}%⟩)",
            )
            ax_ts.plot(
                t_v,
                f_lo_inst,
                color="#0284c7",
                lw=1.05,
                alpha=0.72,
                label=f"Reflected into b_lowfs (⟨{float(np.mean(f_lo_inst)):.2f}%⟩)",
            )
            ax_ts.plot(
                t_v,
                f_cam_inst,
                color="#10b981",
                lw=1.15,
                alpha=0.78,
                label=f"Reaching LOWFS FOV inst (⟨{float(np.mean(f_cam_inst)):.2f}%⟩)",
            )
            ax_ts.plot(
                t_v,
                f_cam_long,
                color="#064e3b",
                lw=2.1,
                label=f"Reaching LOWFS FOV cumul ({float(f_cam_long[-1]):.2f}%)",
            )
            ax_ts.axhline(
                dl_cam_pct,
                color="#dc2626",
                ls="--",
                lw=1.4,
                label=f"DL Floor LOWFS FOV ({dl_cam_pct:.2f}%, turb=0)",
            )
            y_hi = max(22.0, float(np.percentile(f_pre_inst, 99.5)) * 1.25)
            ax_ts.set_xlim(float(t_v[0]), max(float(t_v[-1]), 0.05))
            ax_ts.set_ylim(0.0, y_hi)
            sec_y = ax_ts.secondary_yaxis(
                "right",
                functions=(lambda y, u=up_h: y * u, lambda yp, u=up_h: yp / max(u, 1e-6)),
            )
            sec_y.set_ylabel("Entrance-Pupil H-Band Light [%]", fontsize=8.6)
            ax_ts.set_xlabel("Physical Time [s]")
            ax_ts.set_ylabel("Coronagraph-Input H-Band Light [%]")
            ax_ts.legend(loc="upper right", fontsize=7.4, framealpha=0.92)
        else:
            lbls_b = ["Inc Lyot", "Refl b_lowfs", "LOWFS FOV", "H-Pup FOV"]
            vals_dl = [
                bdl_ly["frac_coro_in_incident_on_lyot"] * 100.0,
                bdl_ly["frac_coro_in_reflected_to_lowfs_beam"] * 100.0,
                bdl_ly["frac_coro_in_reaching_lowfs_cam_fov"] * 100.0,
                bdl_ly["frac_entrance_pup_h_reaching_lowfs_cam_fov"] * 100.0,
            ]
            vals_cl = [
                bcl_ly["frac_coro_in_incident_on_lyot"] * 100.0,
                bcl_ly["frac_coro_in_reflected_to_lowfs_beam"] * 100.0,
                bcl_ly["frac_coro_in_reaching_lowfs_cam_fov"] * 100.0,
                bcl_ly["frac_entrance_pup_h_reaching_lowfs_cam_fov"] * 100.0,
            ]
            xb = np.arange(len(lbls_b))
            ax_ts.bar(xb - 0.17, vals_dl, 0.34, label="DL (turb=0)", color="#64748b")
            ax_ts.bar(xb + 0.17, vals_cl, 0.34, label="Closed-Loop", color="#059669")
            ax_ts.set_xticks(xb)
            ax_ts.set_xticklabels(lbls_b, fontsize=8.5)
            ax_ts.set_ylabel("Light Fraction [%]")
            ax_ts.legend(loc="upper right", fontsize=8.0)

        ax_ts.grid(True, which="both", alpha=0.28)
        ax_ts.set_title(
            "500 Hz Tracked Light Fraction to LOWFS Camera",
            fontsize=10.1,
            fontweight="bold",
        )

        figly.savefig(os.path.join(out_dir, "coro_lyot_stop_illumination.png"), dpi=180)
        plt.close(figly)

pc_plot = data.get("predictive_control")
if (
    _want_plot(16)
    and isinstance(pc_plot, dict)
    and pc_plot.get("enabled")
    and os.path.exists(os.path.join(out_dir, "pf_wmat_stg1.npy"))
    and os.path.exists(os.path.join(out_dir, "pf_wmat_stg2.npy"))
):
    figpc, axespc = plt.subplots(2, 2, figsize=(14.4, 9.2), constrained_layout=True)
    p_mode_top = str(pc_plot.get("pf_mode", "ar")).lower()
    p_blk_top = int(pc_plot.get("pf_blocksize", 128))
    p_ord_top = int(pc_plot.get("pf_order", 8))
    p_mix_top = float(pc_plot.get("pf_mix", 0.90))
    if p_mode_top == "eof":
        pc_hdr = (
            f"PSOL Block-EOF(B={p_blk_top}, P={p_ord_top}) Predictive Control "
            f"Summary (mkEOFPF + applyEOFPF + mfilt)"
        )
    else:
        pc_hdr = (
            f"PSOL AR({p_ord_top}) Predictive Control "
            f"Summary (mkARPF + applyARPF + mfilt)"
        )
    figpc.suptitle(
        f"Subaru {tel_d:.2f} m AO3k + SCExAO — {pc_hdr}\n"
        f"(Seeing = {seeing_top:.2f}\", Mix = {p_mix_top:.2f}, "
        f"Stg1 = 1 kHz J PyWFS, Stg2 = 2 kHz Vis PyWFS)",
        fontsize=12.0,
        fontweight="bold",
    )
    for col_i, (stg_idx, stg_key, stg_lbl) in enumerate(
        (
            (1, "stage1", "Stage 1 (AO3k, 1.0 kHz)"),
            (2, "stage2", "Stage 2 (SCExAO, 2.0 kHz)"),
        )
    ):
        st_pc = pc_plot.get(stg_key, {})
        wmat = np.load(os.path.join(out_dir, f"pf_wmat_stg{stg_idx}.npy"))
        p_o, n_m = wmat.shape
        modes = np.arange(n_m)

        ax_top = axespc[0, col_i]
        dc_g = np.sum(wmat, axis=0)
        n2_p = os.path.join(out_dir, f"pf_n2_stg{stg_idx}.npy")
        if os.path.exists(n2_p):
            n2_g = np.sqrt(np.maximum(np.load(n2_p), 0.0))
            n2_lbl = "Total Noise Gain ‖Fₘ‖₂"
        else:
            n2_g = np.sqrt(np.sum(wmat**2, axis=0))
            n2_lbl = "Noise Gain ‖w‖₂"
        ax_top.plot(modes, wmat[0], color="#2563eb", lw=1.0, alpha=0.82, label="Tap w₀ (t)")
        if p_o > 1:
            ax_top.plot(
                modes, wmat[1], color="#ea580c", lw=0.95, alpha=0.78, label="Tap w₁ (t−1)"
            )
        if p_o > 2:
            ax_top.plot(
                modes, wmat[2], color="#059669", lw=0.9, alpha=0.72, label="Tap w₂ (t−2)"
            )
        ax_top.plot(
            modes, dc_g, color="#0f172a", lw=1.5, ls="--", label="Self DC Gain Σwₖ"
        )
        ax_top.plot(
            modes, n2_g, color="#9333ea", lw=1.3, ls=":", label=n2_lbl
        )
        ax_top.axhline(0.0, color="#64748b", lw=0.7, alpha=0.6)
        ax_top.set_xlim(0, max(1, n_m - 1))
        if p_mode_top == "eof":
            sub_t = (
                f"{stg_lbl} — Learned Block-EOF(B={p_blk_top}, P={p_o}) Weights\n"
                f"(PFlat = {st_pc.get('pflatency_fr', 0):.2f} fr, "
                f"Off-Diag = {st_pc.get('offdiag_frac', 0)*100.0:.1f}%, "
                f"ΔVar vs Lag = {st_pc.get('var_red_pct', 0):.1f}%)"
            )
        else:
            sub_t = (
                f"{stg_lbl} — Learned AR({p_o}) Filter Weights\n"
                f"(PFlatency = {st_pc.get('pflatency_fr', 0):.2f} fr, "
                f"Updates = {st_pc.get('n_updates', 0)}, "
                f"ΔVar vs Lag = {st_pc.get('var_red_pct', 0):.1f}%)"
            )
        ax_top.set_title(
            sub_t,
            fontsize=10.2,
            fontweight="bold",
        )
        ax_top.set_xlabel("Modal Index")
        ax_top.set_ylabel("Filter Weight / Gain")
        ax_top.grid(True, alpha=0.28)
        ax_top.legend(loc="best", fontsize=7.8, ncol=2, framealpha=0.9)

        ax_bot = axespc[1, col_i]
        ol_p = os.path.join(out_dir, f"pf_mvalOLrms_stg{stg_idx}.npy")
        pr_p = os.path.join(out_dir, f"pf_mvalPFresrms_stg{stg_idx}.npy")
        wf_p = os.path.join(out_dir, f"pf_mvalWFSrms_stg{stg_idx}.npy")
        mx_p = os.path.join(out_dir, f"pf_mPFmix_stg{stg_idx}.npy")
        if os.path.exists(ol_p):
            v_ol = np.maximum(np.load(ol_p) * 1e3, 1e-3)
            ax_bot.semilogy(
                modes[: len(v_ol)],
                v_ol,
                color="#dc2626",
                lw=1.0,
                alpha=0.80,
                label=f"PSOL Open-Loop ({st_pc.get('quad_ol_rms', 0)*1e3:.1f} nm)",
            )
        if os.path.exists(wf_p):
            v_wf = np.maximum(np.load(wf_p) * 1e3, 1e-3)
            ax_bot.semilogy(
                modes[: len(v_wf)],
                v_wf,
                color="#2563eb",
                lw=1.0,
                alpha=0.85,
                label=f"Closed-Loop WFS ({st_pc.get('quad_wfs_rms', 0)*1e3:.1f} nm)",
            )
        if os.path.exists(pr_p):
            v_pr = np.maximum(np.load(pr_p) * 1e3, 1e-3)
            pr_lbl = "EOF Pred Residual" if p_mode_top == "eof" else "AR Pred Residual"
            ax_bot.semilogy(
                modes[: len(v_pr)],
                v_pr,
                color="#059669",
                lw=0.95,
                alpha=0.78,
                label=f"{pr_lbl} ({st_pc.get('quad_pfres_rms', 0)*1e3:.1f} nm)",
            )
        if os.path.exists(mx_p):
            v_mx = np.load(mx_p)
            ax_r = ax_bot.twinx()
            ax_r.plot(
                modes[: len(v_mx)],
                v_mx,
                color="#475569",
                lw=1.4,
                ls="--",
                label="Applied PF Mix",
            )
            ax_r.set_ylim(0.0, 1.05)
            ax_r.set_ylabel("PF Mixing Weight", fontsize=8.8, color="#475569")
        ax_bot.set_xlim(0, max(1, n_m - 1))
        ax_bot.set_title(
            f"{stg_lbl} — PSOL vs Closed-Loop Modal RMS Spectrum",
            fontsize=10.2,
            fontweight="bold",
        )
        ax_bot.set_xlabel("Modal Index")
        ax_bot.set_ylabel("Modal Amplitude RMS [nm]")
        ax_bot.grid(True, which="both", alpha=0.28)
        ax_bot.legend(loc="upper right", fontsize=7.8, framealpha=0.9)

    figpc.savefig(os.path.join(out_dir, "predictive_control_summary_2x2.png"), dpi=180)
    plt.close(figpc)

c2d_plot = data.get("calib_2wfs1dm")
if (
    _want_plot(17)
    and isinstance(c2d_plot, dict)
    and c2d_plot.get("enabled")
    and os.path.exists(os.path.join(out_dir, "calib2wfs_Mdb.npy"))
    and os.path.exists(os.path.join(out_dir, "calib2wfs_Mab.npy"))
):
    fig2w, axes2w = plt.subplots(2, 2, figsize=(14.6, 9.5), constrained_layout=True)
    w_ord_c = int(c2d_plot.get("whiten_order", 4))
    nfr_c = int(c2d_plot.get("nframes", 0))
    lag_db_c = float(c2d_plot.get("lag_db_fr", 2.5))
    lag_ab_c = float(c2d_plot.get("lag_ab_fr", 0.0))
    fig2w.suptitle(
        f"Subaru {tel_d:.2f} m AO3k + SCExAO — Two-WFS + Inter-Stage DM Telemetry Calibration "
        f"(B = Mab A + Mdb D)\n"
        f"(N = {nfr_c} aligned frames, AR({w_ord_c}) whitening W(z), "
        f"lag_DB = {lag_db_c:.2f} fr, lag_AB = {lag_ab_c:+.2f} fr)",
        fontsize=11.8,
        fontweight="bold",
    )

    # Panel (0,0): Conditional DM excitation eta_D (Unwhitened vs Whitened) + W(z) inset
    ax00 = axes2w[0, 0]
    eta_w = np.load(os.path.join(out_dir, "calib2wfs_eta_d.npy")).ravel()
    eta_r = np.load(os.path.join(out_dir, "calib2wfs_eta_d_raw.npy")).ravel()
    md_idx = np.arange(len(eta_w))
    ax00.plot(
        md_idx,
        eta_r,
        color="#dc2626",
        lw=1.4,
        ls="--",
        alpha=0.85,
        label=f"Unwhitened (med η_D = {float(c2d_plot.get('eta_d_raw_med', 0)):.3f})",
    )
    ax00.plot(
        md_idx,
        eta_w,
        color="#2563eb",
        lw=1.7,
        label=f"AR({w_ord_c})-Whitened W(z) (med η_D = {float(c2d_plot.get('eta_d_white_med', 0)):.3f})",
    )
    ax00.fill_between(md_idx, eta_r, eta_w, color="#3b82f6", alpha=0.14)
    ax00.set_ylim(0.0, 1.05)
    ax00.set_xlim(0, max(1, len(eta_w) - 1))
    ax00.set_xlabel("Stage-2 DM Mode Index")
    ax00.set_ylabel("Conditional Excitation η_D = S_D / Σ_DD")
    ax00.set_title("Breaking Closed-Loop Collinearity via W(z)", fontsize=10.3, fontweight="bold")
    ax00.grid(True, alpha=0.28)
    ax00.legend(loc="lower right", fontsize=8.2, framealpha=0.92)
    taps_p = os.path.join(out_dir, "calib2wfs_ar_taps.npy")
    if os.path.exists(taps_p):
        taps = np.load(taps_p).ravel()
        if len(taps) >= 2:
            ax_in = ax00.inset_axes([0.55, 0.37, 0.42, 0.34])
            w_f = np.linspace(0.0, np.pi, 128)
            z_inv = np.exp(-1j * np.outer(w_f, np.arange(len(taps))))
            H_w = np.abs(z_inv @ taps)
            H_db = 20.0 * np.log10(np.maximum(H_w, 1e-4))
            ax_in.plot(w_f / np.pi, H_db, color="#0f172a", lw=1.4)
            ax_in.axhline(0.0, color="#64748b", lw=0.7, ls=":")
            ax_in.set_title(r"$|W(e^{j\omega})|$ [dB]", fontsize=8.0, pad=2)
            ax_in.set_xlabel(r"$f / f_{\mathrm{Nyq}}$", fontsize=7.4, labelpad=1.5)
            ax_in.tick_params(labelsize=6.8)
            ax_in.grid(True, alpha=0.3)

    # Panel (0,1): Recovered Mdb diagonal (Unwhitened vs Whitened vs selfRM truth)
    ax01 = axes2w[0, 1]
    mdb_w = np.load(os.path.join(out_dir, "calib2wfs_mdb_diag.npy")).ravel()
    mdb_r = np.load(os.path.join(out_dir, "calib2wfs_mdb_diag_raw.npy")).ravel()
    mx = np.arange(len(mdb_w))
    ax01.plot(
        mx,
        mdb_r,
        color="#dc2626",
        lw=1.3,
        ls=":",
        alpha=0.85,
        label=f"Unwhitened diag(Mdb) (med = {float(c2d_plot.get('mdb_diag_raw_med', 0)):.3f})",
    )
    ax01.plot(
        mx,
        mdb_w,
        color="#2563eb",
        lw=1.7,
        label=(
            f"AR({w_ord_c}) diag(Mdb) (med = {float(c2d_plot.get('mdb_diag_med', 0)):.3f}, "
            f"off = {float(c2d_plot.get('mdb_offdiag_rms', 0)):.3f})"
        ),
    )
    og_p = os.path.join(out_dir, "calib2wfs_og_selfrm.npy")
    if os.path.exists(og_p):
        og_s = np.load(og_p).ravel()[: len(mdb_w)]
        if np.any(og_s > 0):
            ax01.plot(
                mx,
                og_s,
                color="#0f172a",
                lw=1.5,
                ls="--",
                label=(
                    f"Active selfRM Opt. Gain "
                    f"(med = {float(c2d_plot.get('selfrm_og_med', 0)):.3f}, "
                    f"err = {float(c2d_plot.get('selfrm_rel_err', 0))*100:.1f}%)"
                ),
            )
    ax01.set_xlim(0, max(1, len(mdb_w) - 1))
    ax01.set_ylim(0.0, max(1.05, float(np.max(mdb_w)) * 1.15))
    ax01.set_xlabel("Stage-2 Modal Index")
    ax01.set_ylabel("DM2 → WFS B Modal Gain diag(Mdb)")
    ax01.set_title("Probe-Free DM2 → WFS B Calibration vs Active selfRM", fontsize=10.3, fontweight="bold")
    ax01.grid(True, alpha=0.28)
    ax01.legend(loc="lower right", fontsize=8.0, framealpha=0.92)

    # Panel (1,0): Calibrated Matrix Structure (|Mdb|, |Mab|, |Mda_virt| normalized tiles)
    ax10 = axes2w[1, 0]
    Mdb_m = np.load(os.path.join(out_dir, "calib2wfs_Mdb.npy"))
    Mab_m = np.load(os.path.join(out_dir, "calib2wfs_Mab.npy"))
    Mda_p = os.path.join(out_dir, "calib2wfs_Mda_virt.npy")
    Mda_m = np.load(Mda_p) if os.path.exists(Mda_p) else None
    kshow = min(30, Mdb_m.shape[0], Mdb_m.shape[1], Mab_m.shape[0], Mab_m.shape[1])
    t_mdb = np.abs(Mdb_m[:kshow, :kshow])
    t_mdb = t_mdb / max(float(np.percentile(t_mdb, 99.5)), 1e-9)
    t_mab = np.abs(Mab_m[:kshow, :kshow])
    t_mab = t_mab / max(float(np.percentile(t_mab, 99.5)), 1e-9)
    gap = np.full((kshow, 2), np.nan)
    if Mda_m is not None and Mda_m.shape[0] >= kshow and Mda_m.shape[1] >= kshow:
        t_mda = np.abs(Mda_m[:kshow, :kshow])
        t_mda = t_mda / max(float(np.percentile(t_mda, 99.5)), 1e-9)
        mosaic = np.hstack([t_mdb, gap, t_mab, gap, t_mda])
        x_ticks = [kshow * 0.5, kshow * 1.5 + 2, kshow * 2.5 + 4]
        x_lbls = ["|Mdb| (DM2→B)", "|Mab| (A→B)", "|Mda_virt| (DM2→A)"]
    else:
        mosaic = np.hstack([t_mdb, gap, t_mab])
        x_ticks = [kshow * 0.5, kshow * 1.5 + 2]
        x_lbls = ["|Mdb| (DM2→B)", "|Mab| (A→B)"]
    cmap_m = plt.get_cmap("magma").copy()
    cmap_m.set_bad(color="#ffffff")
    im10 = ax10.imshow(np.clip(mosaic, 0.0, 1.0), origin="lower", cmap=cmap_m, aspect="auto")
    ax10.set_xticks(x_ticks)
    ax10.set_xticklabels(x_lbls, fontsize=9.0, fontweight="bold")
    ax10.set_ylabel(f"Output Mode Index (0..{kshow - 1})")
    geom_note = ""
    if "geom_col_cos_med" in c2d_plot:
        geom_note = f" | DM2→DM1 Geom Cos = {float(c2d_plot['geom_col_cos_med']):.3f}"
    ax10.set_title(
        f"Calibrated Response Matrices (Normalized |M|, top {kshow} modes){geom_note}",
        fontsize=9.8,
        fontweight="bold",
    )
    fig2w.colorbar(im10, ax=ax10, fraction=0.032, pad=0.02, label="Relative |M|")

    # Panel (1,1): Held-out contiguous temporal cross-validation R^2 per mode
    ax11 = axes2w[1, 1]
    r2_bw = np.load(os.path.join(out_dir, "calib2wfs_r2_b_w.npy")).ravel()
    r2_ol = np.load(os.path.join(out_dir, "calib2wfs_r2_ol_raw.npy")).ravel()
    r2_ar = np.load(os.path.join(out_dir, "calib2wfs_r2_a_raw.npy")).ravel()
    n_ov = min(len(r2_bw), len(r2_ar))
    xm = np.arange(n_ov)
    ax11.plot(
        xm,
        np.clip(r2_ar[:n_ov], -0.2, 1.0),
        color="#059669",
        lw=1.7,
        label=f"Virtual Upstream A = Mba B − Mda_virt D (med R² = {float(c2d_plot.get('r2_a_raw_med', 0)):.3f})",
    )
    ax11.plot(
        xm,
        np.clip(r2_ol[:n_ov], -0.2, 1.0),
        color="#ea580c",
        lw=1.4,
        ls="--",
        label=f"Pseudo-OL (B − Mdb D) vs Mab A (med R² = {float(c2d_plot.get('r2_ol_raw_med', 0)):.3f})",
    )
    ax11.plot(
        xm,
        np.clip(r2_bw[:n_ov], -0.2, 1.0),
        color="#2563eb",
        lw=1.4,
        alpha=0.85,
        label=f"Whitened Forward W(z)[B] (med R² = {float(c2d_plot.get('r2_b_w_med', 0)):.3f})",
    )
    ax11.axhline(0.0, color="#64748b", lw=0.8, ls=":")
    ax11.set_xlim(0, max(1, n_ov - 1))
    ax11.set_ylim(-0.15, 1.05)
    ax11.set_xlabel("Modal Index")
    ax11.set_ylabel("Held-Out Temporal CV R²")
    ax11.set_title(
        f"Out-of-Sample Contiguous Validation "
        f"(Train = {int(c2d_plot.get('n_train', 0))}, Test = {int(c2d_plot.get('n_test', 0))})",
        fontsize=10.2,
        fontweight="bold",
    )
    ax11.grid(True, alpha=0.28)
    ax11.legend(loc="lower right", fontsize=7.8, framealpha=0.92)

    fig2w.savefig(os.path.join(out_dir, "calib_2wfs1dm_summary_2x2.png"), dpi=180)
    plt.close(fig2w)

if _my_shard != 0:
    os._exit(0)
_fail = 0
for _cpid in _child_pids:
    _, _st = os.waitpid(_cpid, 0)
    if _st != 0:
        _fail = 1
if _fail:
    sys.exit(1)
"""
    py_exec = sys.executable
    try:
        subprocess.run(
            [py_exec, "-c", "import matplotlib.pyplot"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=True,
        )
    except (OSError, subprocess.CalledProcessError):
        py_exec = "/usr/bin/python3"
    if os.path.exists(py_exec):
        subprocess.run([py_exec, "-c", plotter, out_dir, summary_path], check=True)


def ensure_gui_screenshots(work_dir, out_dir):
    bench_cands = []
    if os.path.isdir(out_dir):
        local_benches = sorted(
            f for f in os.listdir(out_dir) if f.endswith(".bench")
        )
        for fb in local_benches:
            if fb != "csim_active.bench":
                bench_cands.append(os.path.join(out_dir, fb))
        for fb in local_benches:
            if fb == "csim_active.bench":
                bench_cands.append(os.path.join(out_dir, fb))

    env_bench = os.environ.get("CACAOSIM_BENCH_FILE", "")
    if env_bench:
        bench_cands.append(env_bench)
    shm_dir = os.environ.get("MILK_SHM_DIR", "")
    if shm_dir and shm_dir != "/milk/shm":
        bench_cands.append(os.path.join(shm_dir, "csim_active.bench"))
    if work_dir:
        bench_cands.append(os.path.join(work_dir, "csim", "csim_active.bench"))

    cacao_root = os.environ.get("CACAO_WORK_ROOT", "")
    if cacao_root:
        bench_cands.append(
            os.path.join(cacao_root, "benches", "ao3k_scexao", "ao3k_scexao.bench")
        )
    cur = os.path.abspath(out_dir)
    for _ in range(4):
        cand = os.path.join(cur, "benches", "ao3k_scexao", "ao3k_scexao.bench")
        bench_cands.append(cand)
        parent = os.path.dirname(cur)
        if parent == cur:
            break
        cur = parent

    src_bench = next((p for p in bench_cands if p and os.path.isfile(p)), None)
    if src_bench is None:
        return None

    base_name = os.path.basename(src_bench)
    if base_name == "csim_active.bench":
        base_name = "ao3k_scexao.bench"
    staged_bench = os.path.join(out_dir, base_name)
    if os.path.abspath(src_bench) != os.path.abspath(staged_bench):
        if not os.path.isfile(staged_bench):
            shutil.copy2(src_bench, staged_bench)

    gui_pngs = (
        "cacaosim_gui_schematic.png",
        "cacaosim_gui_builder.png",
        "cacaosim_gui_tables.png",
        "cacaosim_gui_status.png",
    )
    if all(os.path.isfile(os.path.join(out_dir, gp)) for gp in gui_pngs):
        return os.path.basename(staged_bench)

    script_dir = os.path.dirname(os.path.abspath(__file__))
    shot_cands = [
        shutil.which("cacaosim-gui-screenshot") or "",
        os.path.join(script_dir, "cacaosim-gui-screenshot"),
        os.path.join(
            os.environ.get("MILK_INSTALL_ROOT", ""), "bin", "cacaosim-gui-screenshot"
        ),
        os.path.join(os.environ.get("MILK_ROOT", ""), "bin", "cacaosim-gui-screenshot"),
    ]
    shot_bin = next(
        (p for p in shot_cands if p and os.path.isfile(p) and os.access(p, os.X_OK)),
        None,
    )
    if shot_bin is not None:
        try:
            subprocess.run(
                [
                    sys.executable,
                    shot_bin,
                    "--outdir",
                    out_dir,
                    "--keep-existing",
                    staged_bench,
                ],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
        except OSError:
            pass
    return os.path.basename(staged_bench)


def ensure_telemetry_video(out_dir):
    tlm_cands = [
        os.environ.get("CACAOSIM_TELEMETRY_DIR", ""),
        os.path.join(out_dir, "telemetry"),
    ]
    tlm_dir = next(
        (
            d
            for d in tlm_cands
            if d
            and os.path.isdir(d)
            and glob.glob(os.path.join(d, "csim_wfs_vis_*.fits*"))
            and glob.glob(os.path.join(d, "psf_vis_final_*.fits*"))
        ),
        None,
    )
    mp4_path = os.path.join(out_dir, "wfs_psf_short_evolution.mp4")
    meta_cache = os.path.join(out_dir, "wfs_psf_short_evolution_meta.json")
    reuse_existing = os.environ.get("CACAOSIM_REUSE_VIDEO", "") in ("1", "true", "yes")

    if tlm_dir is not None and not (
        reuse_existing and os.path.isfile(mp4_path) and os.path.isfile(meta_cache)
    ):
        script_dir = os.path.dirname(os.path.abspath(__file__))
        vid_cands = [
            shutil.which("cacaosim-telemetry-video") or "",
            os.path.join(script_dir, "cacaosim-telemetry-video"),
            os.path.join(
                os.environ.get("MILK_INSTALL_ROOT", ""), "bin", "cacaosim-telemetry-video"
            ),
            os.path.join(
                os.environ.get("MILK_ROOT", ""), "bin", "cacaosim-telemetry-video"
            ),
        ]
        vid_bin = next(
            (p for p in vid_cands if p and os.path.isfile(p)),
            None,
        )
        if vid_bin is not None:
            try:
                subprocess.run(
                    [
                        sys.executable,
                        vid_bin,
                        "--telemetry-dir",
                        tlm_dir,
                        "--report-dir",
                        out_dir,
                        "--out",
                        mp4_path,
                        "--meta-out",
                        meta_cache,
                    ],
                    check=True,
                )
            except (OSError, subprocess.CalledProcessError) as exc:
                print(
                    f"[cacaosim-ao-report] Warning: telemetry video render failed: {exc}",
                    file=sys.stderr,
                )

    if os.path.isfile(mp4_path) and os.path.isfile(meta_cache):
        try:
            with open(meta_cache, "r", encoding="utf-8") as fh:
                return json.load(fh)
        except (OSError, json.JSONDecodeError):
            pass
    if os.path.isfile(mp4_path):
        return {
            "video_file": "wfs_psf_short_evolution.mp4",
            "size_bytes": int(os.path.getsize(mp4_path)),
        }
    return None


