        else:
            ax0.plot(t_wf, y, "o-", color=col_c, lw=1.8, ms=4.5, label=lbl)
        if samp_list:
            sx, sy = [], []
            for sm in samp_list:
                ts_v = float(sm["t_phys_s"])
                yv = sm.get(skey, {}).get("rms_nm")
                if yv is None and t_wf.size > 0:
                    yv = float(y[int(np.argmin(np.abs(t_wf - ts_v)))])
                if yv is not None and np.isfinite(yv):
                    sx.append(ts_v)
                    sy.append(float(yv))
            if sx:
                ax0.scatter(
                    sx,
                    sy,
                    s=46,
                    facecolor=col_c,
                    edgecolor="#111827",
                    linewidths=1.15,
                    zorder=6,
                )
    if samp_list:
        sec_s = ax0.secondary_xaxis("top", functions=(lambda x: x, lambda x: x))
        s_ticks = [float(sm["t_phys_s"]) for sm in samp_list]
        if phys_t >= 1.0:
            s_labs = [f"S{i + 1} ({tv:.2f} s)" for i, tv in enumerate(s_ticks)]
        else:
            s_labs = [f"S{i + 1} ({tv * 1e3:.0f} ms)" for i, tv in enumerate(s_ticks)]
