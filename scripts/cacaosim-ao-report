                ls=ls,
                lw=lw,
            )

    ax_p.axvline(30.0 * ld_mas, color="teal", ls="--", lw=1.0, alpha=0.7, label="AO3k 30 λ/D")
    ax_p.axvline(23.0 * ld_mas, color="green", ls=":", lw=1.2, alpha=0.8, label="SCExAO 23 λ/D")
    ax_p.set_xlim(0.0, 750.0 if bkey == "vis" else 1500.0)
    ax_p.set_ylim(2e-5, 1.3)
    ax_p.grid(True, which="both", alpha=0.28)
    ax_p.set_title(f"{blabel} — Radial Intensity Profile", fontsize=11, fontweight="bold")
    ax_p.set_xlabel("Angular Separation [mas]")
    ax_p.set_ylabel("Azimuthal Mean Intensity [Strehl units]")
    ax_p.legend(fontsize=8.2, loc="upper right")

    ax_e.axvline(30.0 * ld_mas, color="teal", ls="--", lw=1.0, alpha=0.7)
    ax_e.axvline(23.0 * ld_mas, color="green", ls=":", lw=1.2, alpha=0.8)
    ax_e.set_xlim(0.0, 750.0 if bkey == "vis" else 1500.0)
    ax_e.set_ylim(0.0, 102.0)
    ax_e.grid(True, alpha=0.28)
    ax_e.set_title(f"{blabel} — Encircled Energy", fontsize=11, fontweight="bold")
    ax_e.set_xlabel("Aperture Radius [mas]")
    ax_e.set_ylabel("Encircled Energy [%]")
    ax_e.legend(fontsize=8.2, loc="lower right")

fig2.savefig(os.path.join(out_dir, "psf_radial_profiles.png"), dpi=180)
plt.close(fig2)

wf_info = data.get("wavefront_metrics")
if wf_info and os.path.exists(os.path.join(out_dir, "wf_pupil_mask.npy")):
    pup = np.load(os.path.join(out_dir, "wf_pupil_mask.npy"))
    pmask = pup > 0.5
    nwf_grid = pup.shape[0]
    pup_pix = 0.9375 * nwf_grid
    half_m = 0.5 * nwf_grid * (8.2 / pup_pix)
    ext_m = [-half_m, half_m, -half_m, half_m]
    wf_locs = [
        ("raw", "Before Stage 1\n(Entrance Pupil b_pup)"),
        ("stg1", "Between Stages 1 & 2\n(Post-AO3k b_post_stg1)"),
        ("final", "After Stage 2\n(Post-SCExAO b_post_stg2)"),
    ]

    cmap_div = matplotlib.colormaps["RdBu_r"].copy()
    cmap_div.set_bad("#141820")
    cmap_std = matplotlib.colormaps["inferno"].copy()
    cmap_std.set_bad("#141820")

    samples = wf_info.get("samples", [])
    nsamp = len(samples)
    if nsamp > 0:
        cubes = {
            k: np.load(os.path.join(out_dir, f"wf_samples_{k}.npy"))
            for k, _ in wf_locs
        }
        vmax_cols = {}
        for k, _ in wf_locs:
            vals = np.abs(cubes[k][:, pmask])
            lim = float(np.percentile(vals, 99.3)) if vals.size else 100.0
            step = 100.0 if lim > 800.0 else (25.0 if lim > 250.0 else 10.0)
            vmax_cols[k] = max(step, np.ceil(lim / step) * step)

        fig3, axes3 = plt.subplots(
            nsamp,
            3,
            figsize=(13.6, 3.15 * nsamp + 1.2),
            constrained_layout=True,
        )
        if nsamp == 1:
            axes3 = axes3[None, :]
        fig3.suptitle(
            "Subaru 8.2 m AO3k + SCExAO — Instantaneous Pupil Wavefront Samples\n"
            f"(Piston-removed OPD [nm] across {pup_pix:.0f}-pix Subaru pupil, 0.60\" seeing)",
            fontsize=13,
            fontweight="bold",
        )

        col_handles = {}
        for c, (k, clabel) in enumerate(wf_locs):
            vlim = vmax_cols[k]
            for r, sm in enumerate(samples):
                ax = axes3[r, c]
                wf_s = np.where(pmask, cubes[k][r], np.nan)
                imh = ax.imshow(
                    wf_s,
                    origin="lower",
                    extent=ext_m,
                    cmap=cmap_div,
                    vmin=-vlim,
                    vmax=vlim,
                    interpolation="nearest",
                )
                col_handles[c] = imh
                if r == 0:
                    ax.set_title(clabel, fontsize=11, fontweight="bold")
                if c == 0:
                    ax.set_ylabel(
                        f"S{r + 1} (t = {sm['t_phys_s']:.2f} s)\ny [m]",
                        fontsize=10,
                        fontweight="bold",
                    )
                else:
                    ax.set_ylabel("y [m]", fontsize=9)
                if r == nsamp - 1:
                    ax.set_xlabel("x [m]", fontsize=9.5)
                badge = (
                    f"RMS = {sm[k]['rms_nm']:6.1f} nm\n"
                    f"PTV = {sm[k]['ptv_nm']:6.0f} nm"
                )
                ax.text(
                    0.03,
                    0.04,
                    badge,
                    transform=ax.transAxes,
                    fontsize=8.5,
                    color="white",
                    family="monospace",
                    bbox=dict(
                        boxstyle="round,pad=0.25",
                        fc="black",
                        ec="none",
                        alpha=0.72,
                    ),
                )
            cb = fig3.colorbar(
                col_handles[c],
                ax=axes3[:, c],
                orientation="horizontal",
                shrink=0.88,
                pad=0.02,
            )
            cb.set_label(f"OPD [nm] (±{vlim:.0f} nm)", fontsize=9.5)

        fig3.savefig(os.path.join(out_dir, "wf_samples_5x3.png"), dpi=175)
        plt.close(fig3)

    fig4, axes4 = plt.subplots(2, 3, figsize=(14.5, 9.2), constrained_layout=True)
    nfr = wf_info.get("n_frames", 0)
    t_rec = wf_info.get("phys_time_recorded_s", 0.0)
    fig4.suptitle(
        f"Subaru 8.2 m AO3k + SCExAO — Wavefront Mean & Std Dev Maps "
        f"({t_rec:.1f} s, {nfr:,d} frames)\n"
        "(Row 1: Time-Averaged WF ⟨OPD⟩_t [nm] | Row 2: Temporal Std Dev std_t(OPD) [nm])",
        fontsize=12.8,
        fontweight="bold",
    )

    for c, (k, clabel) in enumerate(wf_locs):
        loc_m = wf_info["locations"][k]
        mean_arr = np.load(os.path.join(out_dir, f"wf_mean_{k}.npy"))
        std_arr = np.load(os.path.join(out_dir, f"wf_std_{k}.npy"))

        m_vals = np.abs(mean_arr[pmask])
        mlim = float(np.percentile(m_vals, 99.5)) if m_vals.size else 10.0
        mstep = 20.0 if mlim > 120.0 else (5.0 if mlim > 25.0 else 2.0)
        mvmax = max(mstep, np.ceil(mlim / mstep) * mstep)

        ax_m = axes4[0, c]
        im_m = ax_m.imshow(
            np.where(pmask, mean_arr, np.nan),
            origin="lower",
            extent=ext_m,
            cmap=cmap_div,
            vmin=-mvmax,
            vmax=mvmax,
            interpolation="nearest",
        )
        ax_m.set_title(clabel, fontsize=11, fontweight="bold")
        ax_m.set_xlabel("x [m]", fontsize=9.5)
        ax_m.set_ylabel("Average WF ⟨OPD⟩_t\ny [m]" if c == 0 else "y [m]", fontsize=10)
        cb_m = fig4.colorbar(im_m, ax=ax_m, shrink=0.86, pad=0.02)
        cb_m.set_label("Mean OPD [nm]", fontsize=9)
        ax_m.text(
            0.03,
            0.04,
            f"RMS(mean) = {loc_m['mean_map_rms_nm']:.1f} nm\n"
            f"PTV(mean) = {loc_m['mean_map_ptv_nm']:.0f} nm",
            transform=ax_m.transAxes,
            fontsize=8.6,
            color="white",
            family="monospace",
            bbox=dict(boxstyle="round,pad=0.26", fc="black", ec="none", alpha=0.72),
        )

        s_vals = std_arr[pmask]
        slim = float(np.percentile(s_vals, 99.5)) if s_vals.size else 50.0
        sstep = 100.0 if slim > 600.0 else (20.0 if slim > 150.0 else 10.0)
        svmax = max(sstep, np.ceil(slim / sstep) * sstep)

        ax_s = axes4[1, c]
        im_s = ax_s.imshow(
            np.where(pmask, std_arr, np.nan),
            origin="lower",
            extent=ext_m,
            cmap=cmap_std,
            vmin=0.0,
            vmax=svmax,
            interpolation="nearest",
        )
        ax_s.set_xlabel("x [m]", fontsize=9.5)
        ax_s.set_ylabel(
            "Std Dev std_t(OPD)\ny [m]" if c == 0 else "y [m]", fontsize=10
        )
        cb_s = fig4.colorbar(im_s, ax=ax_s, shrink=0.86, pad=0.02)
        cb_s.set_label("Std Dev OPD [nm]", fontsize=9)
        ax_s.text(
            0.03,
            0.04,
            f"RMS(std) = {loc_m['std_map_rms_nm']:.1f} nm\n"
            f"Med={loc_m['std_map_median_nm']:.0f}, P95={loc_m['std_map_p95_nm']:.0f} nm",
            transform=ax_s.transAxes,
            fontsize=8.5,
            color="white",
            family="monospace",
            bbox=dict(boxstyle="round,pad=0.26", fc="black", ec="none", alpha=0.72),
        )

    fig4.savefig(os.path.join(out_dir, "wf_stats_2x3.png"), dpi=180)
    plt.close(fig4)

    samples = wf_info.get("samples", []) if wf_info else []
    nsamp = len(samples)
    wfs_ready = nsamp > 0 and os.path.exists(
        os.path.join(out_dir, "wfs_raw_stg1_samples.npy")
    )
    if wfs_ready:
        wfs_cols = [
            (
                "wfs_raw_stg1",
                "Stage 1 AO3k Raw PyWFS\n(csim_wfs_nir, 1.22 µm 20% 2ch @ 1 kHz)",
                "raw",
            ),
            (
                "wfs_sig_stg1",
                "Stage 1 AO3k Ref-Sub Signal\n(aol1_imWFS2, 160×160)",
                "sig",
            ),
            (
                "wfs_raw_stg2",
                "Stage 2 SCExAO Raw PyWFS\n(csim_wfs_vis, 0.75 µm 20% 2ch @ 2 kHz)",
                "raw",
            ),
            (
                "wfs_sig_stg2",
                "Stage 2 SCExAO Ref-Sub Signal\n(aol2_imWFS2, 120×120)",
                "sig",
            ),
        ]
        wcubes = {
            ek: np.load(os.path.join(out_dir, f"{ek}_samples.npy"))
            for ek, _, _ in wfs_cols
        }
        fig5, axes5 = plt.subplots(
            nsamp,
            4,
            figsize=(16.2, 3.05 * nsamp + 1.3),
            constrained_layout=True,
        )
        if nsamp == 1:
            axes5 = axes5[None, :]
        fig5.suptitle(
            "Subaru 8.2 m AO3k + SCExAO — Instantaneous Pyramid WFS Frames\n"
            "(Raw Detector [ADU] & Reference-Subtracted Differential Signal "
            "at 5 Sampled Instants)",
            fontsize=13,
            fontweight="bold",
        )
        for c, (ek, clab, kind) in enumerate(wfs_cols):
            cube = wcubes[ek]
            if kind == "raw":
                disp_cube = cube
                vmin = 95.0
                vmax = max(150.0, float(np.percentile(disp_cube, 99.7)))
                cmap_w = "magma"
                cblab = "Detector [ADU]"
            else:
                disp_cube = cube * 1.0e4
                lim = max(0.5, float(np.percentile(np.abs(disp_cube), 99.5)))
                vmin, vmax = -lim, lim
                cmap_w = "RdBu_r"
                cblab = "Ref-Sub Signal [×10⁻⁴ norm]"
            imh = None
            for r, sm in enumerate(samples):
                ax = axes5[r, c]
                imh = ax.imshow(
                    disp_cube[r],
                    origin="lower",
                    cmap=cmap_w,
                    vmin=vmin,
                    vmax=vmax,
                    interpolation="nearest",
                )
                if r == 0:
                    ax.set_title(clab, fontsize=10.5, fontweight="bold")
                if c == 0:
                    ax.set_ylabel(
                        f"S{r + 1} (t = {sm['t_phys_s']:.2f} s)\ny [pix]",
                        fontsize=10,
                        fontweight="bold",
                    )
                else:
                    ax.set_ylabel("y [pix]", fontsize=8.8)
                if r == nsamp - 1:
                    ax.set_xlabel("x [pix]", fontsize=9)
                ex = sm.get("extra", {}).get(ek, {})
                if kind == "raw":
                    btxt = (
                        f"Max = {ex.get('max_adu', 0.0):6.0f} ADU\n"
                        f"Sum = {ex.get('sum_adu', 0.0)/1e3:5.0f} kADU"
                    )
                else:
                    frm_f = cube[r].astype(np.float64)
                    rms_v = float(np.sqrt(np.mean(frm_f**2)))
                    ptv_v = float(np.max(frm_f) - np.min(frm_f))
                    btxt = (
                        f"RMS = {rms_v*1e4:5.2f}e-4\n"
                        f"PTV = {ptv_v*1e3:5.2f}e-3"
                    )
                ax.text(
                    0.03,
                    0.04,
                    btxt,
                    transform=ax.transAxes,
                    fontsize=8.1,
                    color="white" if kind == "raw" else "black",
                    family="monospace",
                    bbox=dict(
                        boxstyle="round,pad=0.22",
                        fc="black" if kind == "raw" else "white",
                        ec="none",
                        alpha=0.72 if kind == "raw" else 0.78,
                    ),
                )
            cb = fig5.colorbar(
                imh,
                ax=axes5[:, c],
                orientation="horizontal",
                shrink=0.88,
                pad=0.02,
            )
            if kind == "sig":
                cb.ax.xaxis.set_major_locator(MaxNLocator(5))
            cb.set_label(cblab, fontsize=9.2)
        fig5.savefig(os.path.join(out_dir, "wfs_samples_5x4.png"), dpi=175)
        plt.close(fig5)

    dm_ready = (
        nsamp > 0
        and os.path.exists(os.path.join(out_dir, "dm_cmd_stg1_samples.npy"))
        and os.path.exists(os.path.join(out_dir, "wf_pupil_mask.npy"))
    )
    if dm_ready:
        dm_cols = [
            (
                "dm_cmd_stg1",
                "Stage 1 AO3k Actuator Cmd\n(dm01disp, 64×64, D=60 Stroke [µm])",
                "cmd",
            ),
            (
                "dm_opd_stg1",
                "Stage 1 AO3k Pupil DM OPD\n(csim_dm01_opd, 256×256 [nm])",
                "opd",
            ),
            (
                "dm_cmd_stg2",
                "Stage 2 SCExAO Actuator Cmd\n(dm02disp, 50×50, D=46 Stroke [µm])",
                "cmd",
            ),
            (
                "dm_opd_stg2",
                "Stage 2 SCExAO Pupil DM OPD\n(csim_dm02_opd, 256×256 [nm])",
                "opd",
            ),
        ]
        dcubes = {
            ek: np.load(os.path.join(out_dir, f"{ek}_samples.npy"))
            for ek, _, _ in dm_cols
        }
        fig6, axes6 = plt.subplots(
            nsamp,
            4,
            figsize=(16.2, 3.05 * nsamp + 1.3),
            constrained_layout=True,
        )
        if nsamp == 1:
            axes6 = axes6[None, :]
        fig6.suptitle(
            "Subaru 8.2 m AO3k + SCExAO — Instantaneous DM Actuator Commands & "
            "Pupil OPD Shapes\n"
            "(Mechanical Stroke [µm] & Piston-Removed Reflective OPD [nm] "
            "at 5 Sampled Instants)",
            fontsize=13,
            fontweight="bold",
        )
        for c, (ek, clab, kind) in enumerate(dm_cols):
            cube = dcubes[ek]
            if kind == "cmd":
                lim = max(0.05, float(np.percentile(np.abs(cube), 99.5)))
                vlim = np.ceil(lim * 20.0) / 20.0
                cblab = f"Stroke [µm] (±{vlim:.2f} µm)"
            else:
                vals = np.abs(cube[:, pmask])
                lim = max(10.0, float(np.percentile(vals, 99.3)))
                step = 100.0 if lim > 800.0 else (25.0 if lim > 200.0 else 10.0)
                vlim = max(step, np.ceil(lim / step) * step)
                cblab = f"DM OPD [nm] (±{vlim:.0f} nm)"
            imh = None
            for r, sm in enumerate(samples):
                ax = axes6[r, c]
                ex = sm.get("extra", {}).get(ek, {})
                if kind == "cmd":
                    imh = ax.imshow(
                        cube[r],
                        origin="lower",
                        cmap="RdBu_r",
                        vmin=-vlim,
                        vmax=vlim,
                        interpolation="nearest",
                    )
                    ylab = "act y"
                    xlab = "act x"
                    btxt = (
                        f"RMS = {ex.get('rms_um', 0.0):.3f} µm\n"
                        f"PTV = {ex.get('ptv_um', 0.0):.2f} µm"
                    )
                    tc, fc, al = "black", "white", 0.78
                else:
                    imh = ax.imshow(
                        np.where(pmask, cube[r], np.nan),
                        origin="lower",
                        extent=ext_m,
                        cmap=cmap_div,
                        vmin=-vlim,
                        vmax=vlim,
                        interpolation="nearest",
                    )
                    ylab = "y [m]"
                    xlab = "x [m]"
                    btxt = (
                        f"RMS = {ex.get('rms_nm', 0.0):6.1f} nm\n"
                        f"PTV = {ex.get('ptv_nm', 0.0):6.0f} nm"
                    )
                    tc, fc, al = "white", "black", 0.72
                if r == 0:
                    ax.set_title(clab, fontsize=10.5, fontweight="bold")
                if c == 0:
                    ax.set_ylabel(
                        f"S{r + 1} (t = {sm['t_phys_s']:.2f} s)\n{ylab}",
                        fontsize=10,
                        fontweight="bold",
                    )
                else:
                    ax.set_ylabel(ylab, fontsize=8.8)
                if r == nsamp - 1:
                    ax.set_xlabel(xlab, fontsize=9)
                ax.text(
                    0.03,
                    0.04,
                    btxt,
                    transform=ax.transAxes,
                    fontsize=8.1,
                    color=tc,
                    family="monospace",
                    bbox=dict(
                        boxstyle="round,pad=0.22", fc=fc, ec="none", alpha=al
                    ),
                )
            cb = fig6.colorbar(
                imh,
                ax=axes6[:, c],
                orientation="horizontal",
                shrink=0.88,
                pad=0.02,
            )
            cb.set_label(cblab, fontsize=9.2)
        fig6.savefig(os.path.join(out_dir, "dm_samples_5x4.png"), dpi=175)
        plt.close(fig6)

    psf_inst_stages = [
        ("raw", "Before Stage 1\n(Uncorrected Entrance Pupil)"),
        ("stg1", "Between Stages 1 & 2\n(After AO3k 1 kHz NIR PyWFS)"),
        ("final", "After Stage 2\n(Final AO3k + SCExAO 2 kHz)"),
    ]
    for bkey, blabel, half_fov_arcsec in bands:
        sr_check = os.path.join(out_dir, f"psf_inst_{bkey}_final_sr.npy")
        if nsamp == 0 or not os.path.exists(sr_check):
            continue
        pcubes = {
            sk: np.load(os.path.join(out_dir, f"psf_inst_{bkey}_{sk}_sr.npy"))
            for sk, _ in psf_inst_stages
        }
        m_ref = data["psf_metrics"][bkey]["final"]
        pix_arcsec = m_ref["pixscale_mas"] / 1000.0
        ld_arcsec = m_ref["ld_mas"] / 1000.0
        c0 = pcubes["final"].shape[-1] // 2
        hw = min(c0, int(round(half_fov_arcsec / pix_arcsec)))
        ext_p = [
            -hw * pix_arcsec,
            hw * pix_arcsec,
            -hw * pix_arcsec,
            hw * pix_arcsec,
        ]

        figp, axesp = plt.subplots(
            nsamp,
            3,
            figsize=(13.8, 3.15 * nsamp + 1.3),
            constrained_layout=True,
        )
        if nsamp == 1:
            axesp = axesp[None, :]
        figp.suptitle(
            f"Subaru 8.2 m AO3k + SCExAO — Instantaneous {blabel} PSFs (10 ms Exposures)\n"
            "(Detector Speckle Snapshots Normalized to Strehl Intensity Units, "
            "0.60\" Seeing)",
            fontsize=12.8,
            fontweight="bold",
        )
        imh_p = None
        for c, (sk, slab) in enumerate(psf_inst_stages):
            for r, sm in enumerate(samples):
                ax = axesp[r, c]
                sub = np.clip(
                    pcubes[sk][r, c0 - hw : c0 + hw, c0 - hw : c0 + hw],
                    1e-5,
                    1.0,
                )
                imh_p = ax.imshow(
                    sub,
                    origin="lower",
                    extent=ext_p,
                    cmap="inferno",
                    norm=LogNorm(vmin=1e-4, vmax=1.0),
                    interpolation="nearest",
                )
                c1 = Circle(
                    (0.0, 0.0),
                    30.0 * ld_arcsec,
                    fill=False,
                    ls="--",
                    lw=0.85,
                    ec="cyan",
                    alpha=0.72,
                    label="AO3k 30 λ/D",
                )
                c2 = Circle(
                    (0.0, 0.0),
                    23.0 * ld_arcsec,
                    fill=False,
                    ls=":",
                    lw=0.95,
                    ec="lime",
                    alpha=0.82,
                    label="SCExAO 23 λ/D",
                )
                ax.add_patch(c1)
                ax.add_patch(c2)
                if r == 0 and c == 2:
                    ax.legend(
                        loc="upper right",
                        fontsize=8,
                        facecolor="#10141c",
                        edgecolor="#556070",
                        labelcolor="white",
                        framealpha=0.85,
                    )
                if r == 0:
                    ax.set_title(slab, fontsize=11, fontweight="bold")
                if c == 0:
                    ax.set_ylabel(
                        f"S{r + 1} (t = {sm['t_phys_s']:.2f} s)\nΔDec [\"]",
                        fontsize=10,
                        fontweight="bold",
                    )
                else:
                    ax.set_ylabel("ΔDec [\"]", fontsize=9)
                if r == nsamp - 1:
                    ax.set_xlabel("ΔRA [\"]", fontsize=9.5)
                pm = sm.get("inst_psf", {}).get(bkey, {}).get(sk, {})
                ptxt = (
                    f"Inst SR = {pm.get('strehl_peak', 0.0)*100:5.1f}%\n"
                    f"r50 = {pm.get('ee50_radius_mas', 0.0):5.0f} mas"
                )
                ax.text(
                    0.03,
                    0.04,
                    ptxt,
                    transform=ax.transAxes,
                    fontsize=8.4,
                    color="white",
                    family="monospace",
                    bbox=dict(
                        boxstyle="round,pad=0.25",
                        fc="black",
                        ec="none",
                        alpha=0.70,
                    ),
                )
            cb_p = figp.colorbar(
                imh_p,
                ax=axesp[:, c],
                orientation="horizontal",
                shrink=0.88,
                pad=0.02,
            )
            cb_p.set_label("Strehl-Normalized Intensity", fontsize=9.2)
        figp.savefig(
            os.path.join(out_dir, f"psf_inst_{bkey}_5x3.png"), dpi=175
        )
        plt.close(figp)

lp1 = data.get("loops", {}).get("stage1_ao3k", {})
lp2 = data.get("loops", {}).get("stage2_scexao", {})
if lp1.get("mgain_curve") and lp2.get("mgain_curve"):
    figg, axesg = plt.subplots(1, 2, figsize=(13.5, 4.9), constrained_layout=True)
    figg.suptitle(
        "Subaru 8.2 m AO3k + SCExAO — Applied Per-Mode Integrator Gains "
        "(mgain = loopgain × mgainfact)\n"
        f"(Power-Law Rolloff α = {lp1.get('mgain_alpha', 0.8):.2f}, "
        f"Floor = {lp1.get('mgain_floor', 0.10):.2f}, "
        f"Tip/Tilt Factor = {lp1.get('mgain_tt_factor', 1.0):.2f}, "
        f"Leak Mult = {lp1.get('mult', 0.98):.2f})",
        fontsize=12.2,
        fontweight="bold",
    )
    loop_specs = [
        (
            lp1,
            "Stage 1 — AO3k (64×64 DM D=60, 160×160 NIR PyWFS @ 1 kHz)",
            "#ff7f0e",
        ),
        (
            lp2,
            "Stage 2 — SCExAO (50×50 DM D=46, 120×120 Vis PyWFS @ 2 kHz)",
            "#1f77b4",
        ),
    ]
    for col, (lp, title, col_g) in enumerate(loop_specs):
        ax = axesg[col]
        mg = np.asarray(lp["mgain_curve"])
        m_idx = np.arange(len(mg))
        l1 = ax.plot(
            m_idx,
            mg,
            color=col_g,
            lw=2.3,
            label=f"Modal Gain mgain[m] (N={len(mg)} modes)",
        )
        ax.scatter(
            [0, 1],
            mg[:2],
            color="#d62728",
            s=36,
            zorder=5,
            label=f"Tip/Tilt (m=0,1): g={mg[0]:.3f}",
        )
        ax.set_title(title, fontsize=11, fontweight="bold")
        ax.set_xlabel("Controlled Mode Index m (Low → High Spatial Frequency)")
        ax.set_ylabel("Effective Integrator Gain mgain[m]", color=col_g)
        ax.set_ylim(0.0, max(0.48, float(np.max(mg)) * 1.35))
        ax.set_xlim(-2, len(mg) + 1)
        ax.grid(True, alpha=0.30)

        lines = list(l1)
        rgrad = lp.get("mode_rel_grad")
        if rgrad and len(rgrad) == len(mg):
            ax_r = ax.twinx()
            l2 = ax_r.plot(
                m_idx,
                rgrad,
                color="#4d5666",
                ls="--",
                lw=1.4,
                alpha=0.80,
                label="DM Spatial Gradient ‖∇φ_m‖/‖φ_m‖",
            )
            ax_r.set_ylabel("Relative DM Spatial Gradient", color="#4d5666")
            ax_r.set_ylim(0.0, float(np.max(rgrad)) * 1.36)
            lines.extend(l2)

        g_med = float(np.median(mg))
        g_min = float(np.min(mg))
        txt_g = (
            f"Modes 0..1 (TT) : {mg[0]:.3f}\n"
            f"Median Gain     : {g_med:.3f}\n"
            f"Highest Mode    : {g_min:.3f}"
        )
        ax.text(
            0.04,
            0.08,
            txt_g,
            transform=ax.transAxes,
            fontsize=8.8,
            family="monospace",
            bbox=dict(
                boxstyle="round,pad=0.3",
                fc="white",
                ec="#ccd2dc",
                alpha=0.90,
            ),
        )
        labs = [ln.get_label() for ln in lines]
        ax.legend(lines, labs, loc="upper right", fontsize=8.4)

    figg.savefig(os.path.join(out_dir, "modal_gains_1x2.png"), dpi=180)
    plt.close(figg)

