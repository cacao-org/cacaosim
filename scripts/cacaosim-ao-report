            f"mlat latency  : {lat_fr:6.3f} fr ({ml['latency_phys_ms']:.2f} ms)\n"
            f"Gauss τ / FWHM: {fit['tau_fit_fr']:6.3f} / {fit['fwhm_fit_fr']:.2f} fr\n"
            f"RM poke shift : RMdelayfr={ml['rm_delay_fr']} fr "
            f"(+{ml['rm_subframe_wait_fr']:.2f} fr)"
        )
        ax.text(
            0.47,
            0.46,
            txt_m,
            transform=ax.transAxes,
            fontsize=8.2,
            family="monospace",
            bbox=dict(
                boxstyle="round,pad=0.32",
                fc="white",
                ec="#ccd2dc",
                alpha=0.92,
            ),
