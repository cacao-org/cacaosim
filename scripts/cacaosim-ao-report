        ls="-",
        lw=1.8,
        label="After Coro CL Raw Intensity [I/I_DL(0)]",
    )
    ax_cl_r.axvspan(0.0, spot_ld, color="#94a3b8", alpha=0.22, label=f"FPM ({spot_ld:.1f} λ/D)")
    ax_cl_r.axvline(23.0, color="green", ls=":", lw=1.1, alpha=0.80)
    ax_cl_r.set_xlim(0.0, 30.0)
    ax_cl_r.set_ylim(3e-7, 1.5)
    ax_cl_r.grid(True, which="both", alpha=0.28)
    ax_cl_r.set_title(
        f"Closed-Loop Radial Profile ({seeing_top:.2f}\" Seeing)",
        fontsize=10.2,
        fontweight="bold",
    )
    ax_cl_r.set_xlabel("Angular Separation [λ/D at 1.65 µm]")
    ax_cl_r.set_ylabel("Azimuthal Mean / Contrast")
    sec_cl = ax_cl_r.secondary_xaxis(
        "top",
        functions=(lambda x, s=ld_mas_c: x * s, lambda m, s=ld_mas_c: m / s),
