    ax01.set_title(
        f"Reflective-Lyot Defocused LLOWFS\n"
        f"(csim_wfs_lowfs, {lo['detector']} @ {lo['rate_hz']:.0f} Hz)",
        fontsize=10.4,
        fontweight="bold",
    )
    ax01.set_xlabel("x [pix]")
    ax01.set_ylabel("y [pix]")

    # (0, 2): Stage-3 LLOWFS Ref-Sub Signal & ZPO Coupling
    ax02 = axesk[0, 2]
    im3_p = os.path.join(out_dir, "aol3_imWFS2.npy")
    if os.path.exists(im3_p):
        im3 = np.load(im3_p) * 1.0e4
        lim3 = max(0.5, float(np.percentile(np.abs(im3), 99.5)))
        im02 = ax02.imshow(
            im3,
            origin="lower",
            cmap="RdBu_r",
            vmin=-lim3,
            vmax=lim3,
            interpolation="nearest",
        )
        cb02 = figk.colorbar(im02, ax=ax02, shrink=0.86, pad=0.02)
        cb02.set_label("Ref-Sub Signal [×10⁻⁴]", fontsize=9)
        st_lbl = "CLOSED" if lo["enabled_closed_loop"] else "OPEN"
        ax02.text(
            0.03,
            0.04,
            f"Loop 3 ({st_lbl}, N={lo['n_zernike_modes']} Z2..Z15)\n"
            f"aol3_dmC RMS  = {lo['dm3_stroke_rms_nm']:.1f} nm stroke\n"
            f"Stg2 ZPO WFS  = {lo['stg2_zpo_wfs_rms']*1e4:.2f}e-4",
            transform=ax02.transAxes,
            fontsize=8.1,
            color="black",
            family="monospace",
            bbox=dict(boxstyle="round,pad=0.26", fc="white", ec="#cbd5e1", alpha=0.88),
        )
    ax02.set_title(
        "Stage-3 LLOWFS Differential Signal\n"
        "(aol3_imWFS2 → dm02 ZPO → aol2_wfszpo)",
        fontsize=10.4,
        fontweight="bold",
    )
    ax02.set_xlabel("x [pix]")
    ax02.set_ylabel("y [pix]")

    # (1, 0) & (1, 1): DL vs Closed-Loop Coronagraphic H-band PSFs
    c_dl = np.load(os.path.join(out_dir, "psf_nir_coro_dl.npy"))
    c_cl = np.load(os.path.join(out_dir, "psf_nir_coro.npy"))
    c0_p = c_cl.shape[1] // 2
    pix_arc = pix_mas_c / 1000.0
    ld_arc = ld_mas_c / 1000.0
    hw_p = min(c0_p, int(round(1.35 / pix_arc)))
    ext_k = [-hw_p * pix_arc, hw_p * pix_arc, -hw_p * pix_arc, hw_p * pix_arc]
    coro_panels = [
        (
            axesk[1, 0],
            c_dl,
            "Diffraction-Limited Lyot Coronagraph\n(psf_nir_coro_dl, turb = 0)",
            coro_m["dl"],
        ),
        (
            axesk[1, 1],
            c_cl,
            f"Closed-Loop Lyot Coronagraph\n(psf_nir_coro, {seeing_top:.2f}\" Seeing)",
            coro_m["closed_loop"],
        ),
    ]
    im_cp = None
    for idx_cp, (axc, arr_c, ttl_c, m_blk) in enumerate(coro_panels):
        sub_c = np.clip(arr_c[c0_p - hw_p : c0_p + hw_p, c0_p - hw_p : c0_p + hw_p], 1e-8, 1.0)
        im_cp = axc.imshow(
            sub_c,
            origin="lower",
            extent=ext_k,
            cmap="inferno",
            norm=LogNorm(vmin=1e-6, vmax=3e-2),
            interpolation="nearest",
        )
        axc.add_patch(
            Circle(
                (0.0, 0.0),
                spot_ld * ld_arc,
                fill=False,
                ls="-",
                lw=1.2,
                ec="white",
                alpha=0.90,
                label=f"Spot {spot_ld:.1f} λ/D",
            )
        )
        axc.add_patch(
            Circle(
                (0.0, 0.0),
                23.0 * ld_arc,
                fill=False,
                ls=":",
                lw=1.0,
                ec="lime",
                alpha=0.85,
                label="SCExAO 23 λ/D",
            )
        )
        if idx_cp == 1:
            axc.legend(
                loc="upper right",
                fontsize=7.8,
                facecolor="#10141c",
                edgecolor="#556070",
                labelcolor="white",
                framealpha=0.85,
            )
        axc.set_title(ttl_c, fontsize=10.4, fontweight="bold")
        axc.set_xlabel("ΔRA [arcsec]")
        axc.set_ylabel("ΔDec [arcsec]")
        axc.text(
            0.03,
            0.04,
            f"Peak Raw   = {m_blk['peak_raw_contrast']:.2e}\n"
            f"⟨3..10λ/D⟩ = {m_blk['mean_raw_contrast_3_10ld']:.2e}\n"
            f"⟨5..20λ/D⟩ = {m_blk['mean_raw_contrast_5_20ld']:.2e}",
            transform=axc.transAxes,
            fontsize=8.1,
            color="white",
            family="monospace",
            bbox=dict(boxstyle="round,pad=0.26", fc="black", ec="none", alpha=0.74),
        )
        cb_c = figk.colorbar(im_cp, ax=axc, shrink=0.86, pad=0.02)
        cb_c.set_label("Raw Contrast [I / I_DL(0)]", fontsize=8.8)

    # (1, 2): Radial Raw & Planet-Throughput-Normalized Contrast Curves
    ax12 = axesk[1, 2]
    pr = coro_m["profiles"]
    r_ld_v = np.asarray(pr["rad_ld"], dtype=float)
    unocc_v = np.asarray(pr["unocc_cl"], dtype=float)
    if np.any(unocc_v > 0):
        sr_un_pct = coro_m["closed_loop"]["nir_unocculted_strehl"] * 100.0
        ax12.semilogy(
            r_ld_v,
            np.clip(unocc_v, 1e-8, 2.0),
            color="#64748b",
            ls="--",
            lw=1.5,
            label=f"Unocculted CL PSF (SR={sr_un_pct:.1f}%)",
        )
    ax12.semilogy(
        r_ld_v,
        np.clip(np.asarray(pr["cl_planet"], dtype=float), 1e-8, 2.0),
        color="#dc2626",
        ls="-",
        lw=2.2,
        label="Coro CL Planet Contrast (Lyot+SR corr.)",
    )
    ax12.semilogy(
        r_ld_v,
        np.clip(np.asarray(pr["cl_5sigma_planet"], dtype=float), 1e-8, 2.0),
        color="#f59e0b",
        ls="-.",
        lw=1.7,
        label="Coro CL 5σ Speckle Contrast",
    )
    ax12.semilogy(
        r_ld_v,
        np.clip(np.asarray(pr["cl_raw"], dtype=float), 1e-8, 2.0),
        color="#2563eb",
        ls="-",
        lw=1.8,
        label="Coro CL Raw Intensity [I/I_DL(0)]",
    )
    ax12.semilogy(
        r_ld_v,
        np.clip(np.asarray(pr["dl_raw"], dtype=float), 1e-8, 2.0),
        color="#111827",
        ls=":",
        lw=1.5,
        label="Coro DL Raw Floor (turb=0)",
    )
    ax12.axvspan(0.0, spot_ld, color="#94a3b8", alpha=0.22, label=f"Spot IWA ({spot_ld:.1f} λ/D)")
    ax12.axvline(23.0, color="green", ls=":", lw=1.2, alpha=0.80)
    ax12.set_xlim(0.0, 32.0)
    ax12.set_ylim(3e-7, 1.5)
    ax12.grid(True, which="both", alpha=0.28)
    ax12.set_title(
        "H-Band Radial Contrast vs Separation", fontsize=10.4, fontweight="bold"
    )
    ax12.set_xlabel("Angular Separation [λ/D at 1.65 µm]")
    ax12.set_ylabel("Azimuthal Contrast")
    sec12 = ax12.secondary_xaxis(
        "top",
        functions=(
            lambda x, s=ld_mas_c: x * s,
            lambda m, s=ld_mas_c: m / s,
        ),
    )
    sec12.set_xlabel("Separation [mas]", fontsize=8.8)
    ax12.legend(loc="upper right", fontsize=7.6, framealpha=0.92)

    figk.savefig(os.path.join(out_dir, "coro_lowfs_summary.png"), dpi=180)
    plt.close(figk)

if (
    _want_plot(14)
    and coro_m
    and os.path.exists(os.path.join(out_dir, "psf_nir_unocc_dl.npy"))
    and os.path.exists(os.path.join(out_dir, "psf_nir_unocc_cl.npy"))
    and os.path.exists(os.path.join(out_dir, "psf_nir_coro_dl.npy"))
    and os.path.exists(os.path.join(out_dir, "psf_nir_coro.npy"))
):
    figba, axesba = plt.subplots(2, 3, figsize=(16.0, 9.6), constrained_layout=True)
    spot_ld = float(coro_m["spot_radius_ld"])
    ld_mas_c = float(coro_m["ld_mas"])
    pix_mas_c = float(coro_m["pixscale_mas"])
    pix_arc = pix_mas_c / 1000.0
    ld_arc = ld_mas_c / 1000.0
    bud_ba = coro_m.get("lowfs_light_budget") or {}
    bdl_ba = bud_ba.get("diffraction_limited") or {}
    bcl_ba = bud_ba.get("closed_loop") or {}

    figba.suptitle(
        f"Subaru {tel_d:.2f} m AO3k + SCExAO — H-Band Focal-Plane PSF "
        f"Before vs After Lyot Coronagraph ({phys_t_top:.1f} s)\n"
        f"(λ₀ = {coro_m['lambda_um']:.2f} µm, {coro_m['bw_frac']*100:.0f}% BW, "
        f"N = {coro_m['nlambda']}ch; Occulting Spot R = {spot_ld:.1f} λ/D = "
        f"{coro_m['spot_iwa_mas']:.0f} mas; Shared I/I_DL(0) Scale)",
        fontsize=12.2,
        fontweight="bold",
    )

    u_dl = np.load(os.path.join(out_dir, "psf_nir_unocc_dl.npy"))
    c_dl = np.load(os.path.join(out_dir, "psf_nir_coro_dl.npy"))
    u_cl = np.load(os.path.join(out_dir, "psf_nir_unocc_cl.npy"))
    c_cl = np.load(os.path.join(out_dir, "psf_nir_coro.npy"))
    c0_ba = c_cl.shape[1] // 2
    hw_ba = min(c0_ba, int(round(1.25 / pix_arc)))
    ext_ba = [-hw_ba * pix_arc, hw_ba * pix_arc, -hw_ba * pix_arc, hw_ba * pix_arc]

    dl_abs_pct = bdl_ba.get("frac_coro_in_fpm_absorbed", 0.882) * 100.0
    cl_abs_pct = bcl_ba.get("frac_coro_in_fpm_absorbed", 0.840) * 100.0
    sr_h_pct = coro_m["closed_loop"]["nir_unocculted_strehl"] * 100.0
    dl_m = coro_m["dl"]
    cl_m = coro_m["closed_loop"]

    ba_panels = [
        (
            axesba[0, 0],
            u_dl,
            "BEFORE Coronagraph — Diffraction-Limited\n(psf_nir_dl, turb = 0)",
            False,
            f"Peak       = 1.000 I_DL(0)\n"
            f"FPM <3λ/D  = {dl_abs_pct:.1f}% (absorbed)\n"
            f"Halo >3λ/D = {100.0 - dl_abs_pct:.1f}% (→ Lyot)",
        ),
        (
            axesba[0, 1],
            c_dl,
            "AFTER Lyot Coronagraph — Diffraction-Limited\n(psf_nir_coro_dl, turb = 0)",
            True,
            f"Peak Raw   = {dl_m['peak_raw_contrast']:.2e}\n"
            f"Tot Leak   = {dl_m['total_leakage_frac']*100:.3f}%\n"
            f"⟨3..10λ/D⟩ = {dl_m['mean_raw_contrast_3_10ld']:.2e}",
        ),
        (
            axesba[1, 0],
            u_cl,
            f"BEFORE Coronagraph — Closed-Loop ({seeing_top:.2f}\" Seeing)\n"
            f"(psf_nir_final, Strehl = {sr_h_pct:.1f}%)",
            False,
            f"Peak SR_H  = {sr_h_pct:.1f}%\n"
            f"FPM <3λ/D  = {cl_abs_pct:.1f}% (absorbed)\n"
            f"Halo >3λ/D = {100.0 - cl_abs_pct:.1f}% (→ Lyot)",
        ),
        (
            axesba[1, 1],
            c_cl,
            f"AFTER Lyot Coronagraph — Closed-Loop ({seeing_top:.2f}\" Seeing)\n"
            f"(psf_nir_coro, +Stage-3 LLOWFS)",
            True,
            f"Peak Raw   = {cl_m['peak_raw_contrast']:.2e}\n"
            f"Tot Leak   = {cl_m['total_leakage_frac']*100:.2f}%\n"
            f"⟨3..10λ/D⟩ = {cl_m['mean_raw_contrast_3_10ld']:.2e} "
            f"(Pl {cl_m['mean_planet_contrast_3_10ld']:.1e})",
        ),
    ]

    for idx_b, (axb, arr_b, ttl_b, is_after, btxt) in enumerate(ba_panels):
        sub_b = np.clip(
            arr_b[c0_ba - hw_ba : c0_ba + hw_ba, c0_ba - hw_ba : c0_ba + hw_ba],
            3e-7,
            1.0,
        )
        im_b = axb.imshow(
            sub_b,
            origin="lower",
            extent=ext_ba,
            cmap="inferno",
            norm=LogNorm(vmin=3e-7, vmax=1.0),
            interpolation="nearest",
        )
        axb.add_patch(
            Circle(
                (0.0, 0.0),
                spot_ld * ld_arc,
                fill=False,
                ls="-" if is_after else "--",
                lw=1.25,
                ec="white" if is_after else "#22d3ee",
                alpha=0.92,
                label=f"Spot {spot_ld:.1f} λ/D",
            )
        )
        axb.add_patch(
            Circle(
                (0.0, 0.0),
                23.0 * ld_arc,
                fill=False,
                ls=":",
                lw=1.0,
                ec="lime",
                alpha=0.85,
                label="SCExAO 23 λ/D",
            )
        )
        if idx_b in (0, 1):
            axb.legend(
                loc="upper right",
                fontsize=7.6,
                facecolor="#10141c",
                edgecolor="#556070",
                labelcolor="white",
                framealpha=0.85,
            )
        axb.set_title(ttl_b, fontsize=10.2, fontweight="bold")
        axb.set_xlabel("ΔRA [arcsec]")
        axb.set_ylabel("ΔDec [arcsec]")
        axb.text(
            0.03,
            0.04,
            btxt,
            transform=axb.transAxes,
            fontsize=8.0,
            color="white",
            family="monospace",
            bbox=dict(boxstyle="round,pad=0.26", fc="black", ec="none", alpha=0.76),
        )
        cb_b = figba.colorbar(im_b, ax=axb, shrink=0.86, pad=0.02)
        cb_b.set_label("Intensity [I / I_DL(0)]", fontsize=8.8)

    pr = coro_m["profiles"]
    r_ld_v = np.asarray(pr["rad_ld"], dtype=float)

    # (0, 2): Diffraction-Limited Before vs After Radial Profiles
    ax_dl_r = axesba[0, 2]
    ax_dl_r.semilogy(
        r_ld_v,
        np.clip(np.asarray(pr.get("unocc_dl", pr["unocc_cl"]), dtype=float), 1e-8, 2.0),
        color="#334155",
        ls="--",
        lw=1.8,
        label="Before Coro (Unocculted DL PSF)",
    )
    ax_dl_r.semilogy(
        r_ld_v,
        np.clip(np.asarray(pr["dl_planet"], dtype=float), 1e-8, 2.0),
        color="#dc2626",
        ls="-",
        lw=2.0,
        label="After Coro Planet Contrast (η_peak corr.)",
    )
    ax_dl_r.semilogy(
        r_ld_v,
        np.clip(np.asarray(pr["dl_raw"], dtype=float), 1e-8, 2.0),
        color="#2563eb",
        ls="-",
        lw=1.7,
        label="After Coro Raw Intensity [I/I_DL(0)]",
    )
    ax_dl_r.axvspan(0.0, spot_ld, color="#94a3b8", alpha=0.22, label=f"FPM ({spot_ld:.1f} λ/D)")
    ax_dl_r.axvline(23.0, color="green", ls=":", lw=1.1, alpha=0.80)
    ax_dl_r.set_xlim(0.0, 30.0)
    ax_dl_r.set_ylim(1e-7, 1.5)
    ax_dl_r.grid(True, which="both", alpha=0.28)
    ax_dl_r.set_title(
        "Diffraction-Limited Radial Profile (turb = 0)",
        fontsize=10.2,
        fontweight="bold",
    )
    ax_dl_r.set_xlabel("Angular Separation [λ/D at 1.65 µm]")
    ax_dl_r.set_ylabel("Azimuthal Mean [I / I_DL(0)]")
    sec_dl = ax_dl_r.secondary_xaxis(
        "top",
        functions=(lambda x, s=ld_mas_c: x * s, lambda m, s=ld_mas_c: m / s),
    )
    sec_dl.set_xlabel("Separation [mas]", fontsize=8.6)
    ax_dl_r.legend(loc="upper right", fontsize=7.6, framealpha=0.92)

    # (1, 2): Closed-Loop Before vs After Radial Profiles
    ax_cl_r = axesba[1, 2]
    ax_cl_r.semilogy(
        r_ld_v,
        np.clip(np.asarray(pr["unocc_cl"], dtype=float), 1e-8, 2.0),
        color="#334155",
        ls="--",
        lw=1.8,
        label=f"Before Coro CL PSF (SR={sr_h_pct:.1f}%)",
    )
    ax_cl_r.semilogy(
        r_ld_v,
