            )
        )
    nc_l = len(mlat_specs)
    figl, axesl = plt.subplots(
        1, nc_l, figsize=(6.8 * nc_l + 0.3, 5.2), constrained_layout=True
    )
    figl.suptitle(
        f"Subaru {tel_d:.2f} m AO3k + SCExAO — Hardware Latency Calibration "
        "(CACAO mlat → measlinresp Timing)\n"
        "(Sub-Frame Randomized DM Step Pokes vs Frame-to-Frame WFS "
        "Differential Response)",
        fontsize=12.2,
        fontweight="bold",
    )
    for col, (ml, title, col_m) in enumerate(mlat_specs):
        ax = axesl[col]
        xr = np.asarray(ml["dt_raw_fr"], dtype=float)
        yr = np.asarray(ml["val_raw"], dtype=float) * 1.0e4
        xm = np.asarray(ml["dt_med_fr"], dtype=float)
        ym = np.asarray(ml["val_med"], dtype=float) * 1.0e4
        fit = ml["fit"]
        xg = np.linspace(-1.6, 6.4, 400)
        yg = (
            fit["base_fit"]
            + fit["amp_fit"]
            * np.exp(-0.5 * ((xg - fit["tau_fit_fr"]) / fit["sigma_fit_fr"]) ** 2)
        ) * 1.0e4

        ax.axvline(0.0, color="#6b7280", ls=":", lw=1.2, label="DM Poke Sent (Δt = 0)")
        ax.scatter(
            xr,
            yr,
            s=17,
            color=col_m,
            alpha=0.36,
            edgecolors="none",
            label=f"Raw Sub-Frame Diffs (N={ml['n_points']})",
        )
        ax.plot(
            xm,
            ym,
            color=col_m,
            lw=2.3,
            label="CACAO mlat Sliding-Window Curve",
        )
        ax.plot(
            xg,
            yg,
            color="#111827",
            ls="--",
            lw=1.9,
            label=(
                f"Gaussian Fit: τ={fit['tau_fit_fr']:.3f}±{fit['tau_err_fr']:.3f} fr "
                f"(R²={fit['r2']:.2f})"
            ),
        )
        lat_fr = ml["latency_fr"]
        pk_y = ml["peak_val"] * 1.0e4
        ax.axvline(
            lat_fr,
            color="#d62728",
            ls="-.",
            lw=1.7,
            label=f"mlat Peak: {lat_fr:.3f} fr ({ml['latency_phys_ms']:.2f} ms)",
        )
        ax.scatter([lat_fr], [pk_y], color="#d62728", marker="*", s=115, zorder=6)

        ymax = max(float(np.max(yr)), float(np.max(yg)), pk_y) * 1.38
        ax.set_xlim(-1.5, 6.2)
        ax.set_ylim(0.0, max(ymax, 0.1))
        ax.set_title(title, fontsize=10.5, fontweight="bold")
        ax.set_xlabel("Time Offset Δt from DM Poke [WFS Frames]")
        ax.set_ylabel("WFS Frame-to-Frame Diff RMS [×10⁻⁴]")
        ax.grid(True, alpha=0.30)

        t_fr_ms = ml["phys_frame_ms"]
        secax = ax.secondary_xaxis(
            "top",
            functions=(
                lambda f, s=t_fr_ms: f * s,
                lambda ms, s=t_fr_ms: ms / s,
            ),
        )
        secax.set_xlabel(
            f"Simulated Physical Delay [ms] (1 fr = {t_fr_ms:.2f} ms)",
            fontsize=8.8,
        )

        txt_m = (
            f"mlat WFSfrequ : {ml['wall_fps_hz']:6.2f} Hz (wall)\n"
            f"mlat latency  : {lat_fr:6.3f} fr ({ml['latency_phys_ms']:.2f} ms)\n"
            f"Gauss τ / FWHM: {fit['tau_fit_fr']:6.3f} / {fit['fwhm_fit_fr']:.2f} fr\n"
            f"RM poke shift : RMdelayfr={ml['rm_delay_fr']} fr "
            f"(+{ml['rm_subframe_wait_fr']:.2f} fr)"
        )
        ax.text(
            0.47,
            0.46,
            txt_m,
            transform=ax.transAxes,
            fontsize=8.0,
            family="monospace",
            bbox=dict(
                boxstyle="round,pad=0.32",
                fc="white",
                ec="#ccd2dc",
                alpha=0.92,
            ),
        )
        ax.legend(loc="upper right", fontsize=7.8, framealpha=0.92)

    figl.savefig(os.path.join(out_dir, "mlat_latency_1x2.png"), dpi=180)
    plt.close(figl)

