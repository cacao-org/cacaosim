ts_wf_p = os.path.join(out_dir, "ts_wf_plot.npy")
ts_sr_p = os.path.join(out_dir, "ts_strehl_plot.npy")
has_wf_ts = os.path.exists(ts_wf_p)
has_sr_ts = os.path.exists(ts_sr_p)
if has_wf_ts and has_sr_ts:
    wf_arr = np.load(ts_wf_p)
    sr_arr = np.load(ts_sr_p)
    ts_m = data.get("timeseries_metrics", {})
    wf_stat = ts_m.get("wf_rms_nm", {})
    sr_stat = ts_m.get("strehl", {})
    sa_m = data.get("star_and_atmosphere", {})
    seeing_v = sa_m.get("seeing_arcsec_500nm", 0.6)
    phys_t = sa_m.get("physical_time_s", 10.0)
    nfr_wf = wf_stat.get("final", {}).get("n_frames", wf_arr.shape[0])
    nexp_sr = sr_stat.get("vis", {}).get("final", {}).get("n_exposures", sr_arr.shape[0])

    def _boxcar_1d(y, win):
        y = np.asarray(y, dtype=float)
        if y.size <= 3 or win <= 1:
            return y
        w = min(int(win) | 1, y.size if y.size % 2 == 1 else max(1, y.size - 1))
        if w <= 1:
            return y
        pad = w // 2
        yp = np.pad(y, pad, mode="edge")
        return np.convolve(yp, np.ones(w) / float(w), mode="valid")

    figt, axest = plt.subplots(
        4, 1, figsize=(14.5, 12.2), sharex=True, constrained_layout=True
    )
    figt.suptitle(
        "Subaru 8.2 m AO3k + SCExAO — Pupil RMS Wavefront Error & Strehl Ratio vs Time\n"
        f"(Seeing = {seeing_v:.2f}\", {phys_t:.1f} s physical, {nfr_wf:,d} WF frames, "
        f"{nexp_sr:,d} PSF exposures)",
        fontsize=12.8,
        fontweight="bold",
    )

    t_wf = wf_arr[:, 1]
    t_sr = sr_arr[:, 0]
    samp_list = [
        sm for sm in (wf_info or {}).get("samples", []) if sm.get("t_phys_s") is not None
    ]
    vid_info = data.get("short_timescale_video")
    vid_span = None
    if vid_info and vid_info.get("t_start_s") is not None and vid_info.get("t_end_s") is not None:
        vid_span = (float(vid_info["t_start_s"]), float(vid_info["t_end_s"]))

