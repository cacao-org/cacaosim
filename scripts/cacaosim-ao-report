        )
        cb01 = figk.colorbar(im01, ax=ax01, shrink=0.86, pad=0.02)
        cb01.set_label("Net Detector [ADU]", fontsize=9)
        bcl_k = (coro_m.get("lowfs_light_budget") or {}).get("closed_loop") or {}
        if bcl_k:
            f_ci_k = bcl_k.get("frac_coro_in_reaching_lowfs_cam_fov", 0.0) * 100.0
