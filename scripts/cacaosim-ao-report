    )

    # (0, 0): Subaru Nasmyth-IR Pupil + Reflective Lyot Stop Geometry
    ax00 = axesk[0, 0]
    pup_ly = np.load(os.path.join(out_dir, "coro_pup_lyot.npy"))
    p_amp, l_amp = pup_ly[0], pup_ly[1]
    nwf_c = p_amp.shape[0]
    hm_c = 0.5 * nwf_c * (tel_d / (0.9375 * nwf_c))
    ext_c = [-hm_c, hm_c, -hm_c, hm_c]
    rgb = np.zeros((nwf_c, nwf_c, 3), dtype=np.float32)
    rgb[:, :] = np.array([0.08, 0.10, 0.14], dtype=np.float32)
    t_trans = p_amp * l_amp
    t_refl = p_amp * np.maximum(0.0, 1.0 - l_amp)
    for ch, c_tr, c_rf in zip(
        range(3), (0.98, 0.84, 0.30), (0.14, 0.68, 0.90)
    ):
        rgb[:, :, ch] += t_trans * (c_tr - rgb[0, 0, ch]) + t_refl * (
            c_rf - rgb[0, 0, ch]
        )
    ax00.imshow(np.clip(rgb, 0.0, 1.0), origin="lower", extent=ext_c)
    ax00.set_title(
        "Subaru Nasmyth-IR Pupil & Lyot Stop\n"
        "(Gold = Coro Trans, Cyan = Reflected to LLOWFS)",
        fontsize=10.4,
        fontweight="bold",
    )
    ax00.set_xlabel("x [m]")
    ax00.set_ylabel("y [m]")
    ax00.text(
        0.03,
        0.04,
        f"D = {tel_d:.2f} m, cobs = {tel_info.get('cobs', 0.307)*100:.1f}%\n"
        f"V-spiders: ±{tel_info.get('spider_deg', 51.75):.2f}°, "
        f"off={tel_info.get('spider_offset', 0.08289)*tel_d:.3f} m\n"
        f"T_Lyot = {ly['intensity_throughput']*100:.1f}%, "
        f"η_peak = {ly['planet_peak_throughput']*100:.1f}%",
        transform=ax00.transAxes,
        fontsize=8.1,
        color="white",
        family="monospace",
        bbox=dict(boxstyle="round,pad=0.26", fc="black", ec="none", alpha=0.76),
    )

    # (0, 1): Defocused LLOWFS Detector Frame
    ax01 = axesk[0, 1]
    lo_npy_p = os.path.join(out_dir, "det_wfs_lowfs.npy")
    if os.path.exists(lo_npy_p):
        det_lo = np.maximum(np.load(lo_npy_p) - 100.0, 0.5)
