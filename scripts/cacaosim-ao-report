    "Subaru 8.2 m AO3k + SCExAO Two-Stage Correction — 10.0 s Polychromatic PSFs\n"
    "(Seeing = 0.60\", Star mV = 6 / mH = 6, Stage 1 = 1 kHz J-Band 20% 2ch PyWFS, "
    "Stage 2 = 2 kHz Vis 20% 2ch PyWFS)",
    fontsize=12.6,
    fontweight="bold",
)

for r, (bkey, blabel, half_fov_arcsec) in enumerate(bands):
    im_handle = None
    for c, (skey, slabel) in enumerate(stages):
        ax = axes[r, c]
        arr = np.load(os.path.join(out_dir, f"psf_{bkey}_{skey}.npy"))
        m = data["psf_metrics"][bkey][skey]
