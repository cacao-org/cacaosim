def _git_query(repo_dir, *args):
    try:
        res = subprocess.run(
            ["git", "-C", repo_dir, *args],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
        if res.returncode == 0:
            return res.stdout.strip()
    except OSError:
        pass
    return ""


def collect_reproducibility_info(out_dir, summary, bench_filename=None):
    cacao_work_hint = os.environ.get("CACAO_WORK_ROOT", "")
    if not cacao_work_hint:
        cur = os.path.abspath(out_dir)
        for _ in range(4):
            if os.path.isfile(os.path.join(cur, "env.sh")):
                cacao_work_hint = cur
                break
            parent = os.path.dirname(cur)
            if parent == cur:
                break
            cur = parent
    src_parent = (
        os.path.dirname(os.path.abspath(cacao_work_hint))
        if cacao_work_hint
        else os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    )

    repos_out = []
    for name, env_key, def_url, def_branch, role in REPO_SPECS:
        cands = []
        if env_key and os.environ.get(env_key):
            cands.append(os.environ[env_key])
        if name == "ImageStreamIO":
            milk_d = os.environ.get("MILK_SRC_DIR") or os.path.join(src_parent, "milk")
            cands.append(os.path.join(milk_d, "src", "engine", "ImageStreamIO"))
        cands.extend(
            [
                os.path.join(src_parent, name),
                os.path.expanduser(f"~/src/{name}"),
            ]
        )
        rdir = next(
            (
                d
                for d in cands
                if d
                and (
                    os.path.isdir(os.path.join(d, ".git"))
                    or os.path.isfile(os.path.join(d, ".git"))
                )
            ),
            None,
        )
        url = def_url
        branch = def_branch
        sha = ""
        if rdir:
            raw_url = _git_query(rdir, "remote", "get-url", "origin")
            if raw_url:
                if raw_url.startswith("git@github.com:"):
                    raw_url = "https://github.com/" + raw_url[len("git@github.com:") :]
                if raw_url.endswith(".git"):
                    raw_url = raw_url[:-4]
                url = raw_url
            br = _git_query(rdir, "rev-parse", "--abbrev-ref", "HEAD")
            if br and br != "HEAD":
                branch = br
            sha = _git_query(rdir, "rev-parse", "HEAD")
        repos_out.append(
            {
                "name": name,
                "url": url,
                "branch": branch,
                "commit": sha,
                "short_commit": sha[:7] if sha else "",
                "role": role,
            }
        )

    sa = summary.get("star_and_atmosphere", {})
    lps = summary.get("loops", {})
    l1 = lps.get("stage1_ao3k", {})
    l2 = lps.get("stage2_scexao", {})
    l3 = lps.get("stage3_llowfs", {})
    vid = summary.get("short_timescale_video")
    ov_k = int(sa.get("oversample", 4))
    tlm_mode = vid.get("telemetry_mode", "speckle") if isinstance(vid, dict) else "none"
    tlm_flag = f" --save-telemetry {tlm_mode}" if tlm_mode != "none" else ""
    svd1 = l1.get("svdlim", 0.004)
    svd2 = l2.get("svdlim", 0.004)
    l3_flags = ""
    if l3:
        if not l3.get("enabled", True):
            l3_flags = " --no-lowfs"
        else:
            svd3 = l3.get("svdlim", 0.02)
            l3_flags = (
                f" --gain3 {l3.get('gain', 0.20):.2f}"
                f" --mult3 {l3.get('mult', 0.995):.3f}"
                f" --svdlim3 {svd3}"
            )

    pc_rep = summary.get("predictive_control")
    pf_flags = ""
    if isinstance(pc_rep, dict) and pc_rep.get("enabled"):
        pf_flags = " --predictive"
        if abs(float(pc_rep.get("pf_mix", 0.90)) - 0.90) > 1e-4:
            pf_flags += f" --pf-mix {float(pc_rep['pf_mix']):.2f}"
        if int(pc_rep.get("pf_order", 8)) != 8:
            pf_flags += f" --pf-order {int(pc_rep['pf_order'])}"

    c2d_rep = summary.get("calib_2wfs1dm")
    c2d_flags = ""
    if isinstance(c2d_rep, dict) and c2d_rep.get("enabled"):
        c2d_flags = " --calib-2wfs1dm"
        if int(c2d_rep.get("dim_b", 40)) != 40:
            c2d_flags += f" --sysid-modes {int(c2d_rep['dim_b'])}"
        if int(c2d_rep.get("whiten_order", 4)) != 4:
            c2d_flags += f" --sysid-whiten-order {int(c2d_rep['whiten_order'])}"

    out_base = os.path.basename(os.path.abspath(out_dir))
    out_flag = f" --outdir _work/{out_base}" if out_base != "ao3k_scexao" else ""

    run_cmd = (
        f"./scripts/run-ao3k-scexao.sh"
        f" --seeing {sa.get('seeing_arcsec_500nm', 0.6):.2f}"
        f" --phys-time {sa.get('physical_time_s', 10.0):.1f}"
        f" --oversample {ov_k}"
        f" --bench-mode fused"
        f" --gain1 {l1.get('gain', 0.35):.2f}"
        f" --gain2 {l2.get('gain', 0.35):.2f}"
        f" --mult1 {l1.get('mult', 0.98):.2f}"
        f" --mult2 {l2.get('mult', 0.98):.2f}"
        f" --mgain-alpha {l1.get('mgain_alpha', 0.8):.2f}"
        f" --mgain-floor {l1.get('mgain_floor', 0.10):.2f}"
        f" --mgain-tt {l1.get('mgain_tt_factor', 1.0):.2f}"
        f" --svdlim1 {svd1}"
        f" --svdlim2 {svd2}{l3_flags}{pf_flags}{c2d_flags}"
        f" --save-rm _work/ao3k_scexao_rm{out_flag}{tlm_flag}"
    )

    return {
        "bench_file": bench_filename or "ao3k_scexao.bench",
        "metrics_file": "ao3k_scexao_metrics.json",
        "run_command": run_cmd,
        "telemetry_mode": tlm_mode,
        "repositories": repos_out,
    }


def write_ao_report_md(out_dir, s, bench_filename=None):
    tel = s.get("telescope", {})
    sa = s.get("star_and_atmosphere", {})
    lps = s.get("loops", {})
    l1 = lps.get("stage1_ao3k", {})
    l2 = lps.get("stage2_scexao", {})
    l3 = lps.get("stage3_llowfs", {})
    pm = s.get("psf_metrics", {})
    wm = s.get("wavefront_metrics")
    coro_m = s.get("coronagraph_metrics")

    chrom = s.get("chromaticity", {})
    tinfo = s.get("timing") or chrom.get("timing", {})
    outer_hz = float(tinfo.get("outer_master_hz", sa.get("master_rate_phys_hz", 2000.0)))
    outer_khz = outer_hz / 1000.0
    outer_dt_ms = float(tinfo.get("outer_dt_ms", 1000.0 / max(outer_hz, 1.0)))
    ov_k = max(1, int(tinfo.get("oversample", sa.get("oversample", 4))))
    int_hz = float(tinfo.get("internal_bench_hz", outer_hz * ov_k))
    int_khz = int_hz / 1000.0
    int_dt_ms = float(tinfo.get("internal_dt_ms", 1000.0 / max(int_hz, 1.0)))
    int_dt_us = float(tinfo.get("internal_dt_us", 1.0e6 / max(int_hz, 1.0)))
    n_outer_ticks = int(sa.get("master_ticks_integrated", 0))
    n_sub_ticks = n_outer_ticks * ov_k
    diam_top = float(tel.get("diameter_m", 7.95))
    cobs_top = float(tel.get("cobs", 0.307)) * 100.0
    tput_top = float(tel.get("tput_tel", 0.20)) * 100.0
    sdeg_top = float(tel.get("spider_deg", 51.75))
    soff_m = float(tel.get("spider_offset", 0.08289)) * diam_top

    lines = [
        f"# AO Optical & Control Report: {s.get('configuration', 'AO3k + SCExAO')}",
        "",
        "End-to-end closed-loop adaptive optics hardware-in-the-loop simulation coupling "
        "[cacao](https://github.com/cacao-org/cacao) real-time control, "
        "[milk](https://github.com/milk-org/milk) shared-memory pipelines "
        "(`fpspipe` / `milk-script`), "
        "[cacaosim](https://github.com/cacao-org/cacaosim) GPU polychromatic sub-stepping optics, "
        "[milkatmturb](https://github.com/oguyon/AtmosphericTurbulenceSimul) Maunakea turbulence, "
        "and [milk-mltools](https://github.com/milk-org/milk-mltools) telemetry & PSF "
        "reconstruction, orchestrated by [cacao-work](https://github.com/cacao-org/cacao-work).",
        "",
        f"- **Telescope & Throughput**: Subaru Nasmyth-IR `D = {diam_top:.2f} m` "
        f"(`cobs = {cobs_top:.1f}%`, `4` V-spiders at `+/-{sdeg_top:.2f} deg` / "
        f"`{soff_m:.3f} m` offset), optical throughput **`{tput_top:.0f}%`** (`tput_tel`)",
        f"- **Seeing**: `{sa.get('seeing_arcsec_500nm', 0):.2f}\"` at 0.50 um | "
