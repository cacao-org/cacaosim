    figk, axesk = plt.subplots(2, 3, figsize=(15.8, 9.6), constrained_layout=True)
    ly = coro_m["lyot_stop"]
    lo = coro_m["llowfs"]
    spot_ld = float(coro_m["spot_radius_ld"])
    ld_mas_c = float(coro_m["ld_mas"])
    pix_mas_c = float(coro_m["pixscale_mas"])
    figk.suptitle(
        f"Subaru {tel_d:.2f} m AO3k + SCExAO — H-Band Lyot Coronagraph & "
