#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Olivier Guyon et al
# SPDX-License-Identifier: LGPL-3.0-or-later
#
# =================================================================================================
# cacaosim-bench — Turnkey fpspipe launcher for single- and multi-stage cacaosim AO benches
# =================================================================================================
#
# Architectural Role:
#   Unified command-line orchestrator for configuring, visualizing, deploying, inspecting, stopping,
#   and tearing down Adaptive Optics hardware simulations within a `milk` / `cacao` POSIX
#   shared-memory domain (`MILK_SHM_DIR`, defaulting to `/milk/shm`). Bridges interactive frontends
#   (`cacaosim-CTRL`, `cacaosim-bench-view`, `$EDITOR`) with `share/milk/commands.d/cacaosim.bash`
#   (`fpspipe.workdir`, `fpspipe.loadfits`, `fpspipe.init`, `fpspipe.setparams`,
#   `milk-fps-runstart`, and event-driven `milk-stream-wait`).
#
# Execution Topologies (`--mode fused` vs `--mode modular`):
#   1. Fused Mode (`--mode fused`, default):
#      Executes the entire optical bench inside a single `milk-fpsexec-cacaosim-htsim` process
#      paced by monotonic `TIMER_ABSTIME` (`procinfo.triggermode = 0`), exposing only external DM
#      command and WFS/science detector SHM streams for maximum kHz throughput and low jitter.
#   2. Modular Mode (`--mode modular`):
#      Deploys separate `csim_<id>` FPS processes in forward topological DAG waves chained via
#      `ImageStreamIO` semaphores (`procinfo.triggermode = 3`) driven by root `csim_mkbeam`.
# =================================================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PREFIX_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
if [[ -d "${PREFIX_DIR}/_build" ]]; then
    export PATH="${PREFIX_DIR}/_build:${SCRIPT_DIR}:${PREFIX_DIR}/bin:${PATH}"
else
    export PATH="${SCRIPT_DIR}:${PREFIX_DIR}/bin:${PATH}"
fi

MODE="fused"
BENCH_CFG=""
NWF=128
NACT=20
WFS_NCAM=64
FP_NCAM=128
RATE_HZ=2000
RATE_SET=0
MOD_RAD=3.0
BACKEND=0
BACKEND_SET=0
WITH_ATMTURB=0
SEEING=0.7
RESTART=0
WORKDIR=""
SHOW_VIEW=1

usage() {
    cat <<EOF
Usage: cacaosim-bench [command] [options]

Commands:
  gui         Launch milk-CTRL-style hardware configurator & status GUI (cacaosim-CTRL)
  ctrl        Alias for 'gui' (cacaosim-CTRL)
  tui         Alias for 'gui' (cacaosim-CTRL)
  view        Render milk-styled ANSI/UTF-8 graphical optical bench schematic
  edit        Edit a .bench text file in \$EDITOR (creates template if new) & visualize
  start       Deploy and start AO hardware simulator via fpspipe (default)
  deploy      Alias for 'start' (idempotent warm deploy unless --restart is set)
  stop        Stop running cacaosim / atmturb FPS units cleanly
  teardown    Stop units and remove tracked .fps.shm, .im.shm, and rundir artifacts
  status      Show active optical bench schematic, FPS unit states, and SHM streams

Options:
  -c, --config <file.bench>  Declarative multi-stage optical bench (.bench) file
  --mode <fused|modular>     Fused zero-hop htsim (default) or separate FPS units
  --nwf <int>                Pupil wavefront grid size [pixels] (default: ${NWF})
  --nact <int>               Linear DM actuator count (default: ${NACT})
  --wfs-ncam <int>           WFS camera size [pixels] (default: ${WFS_NCAM})
  --fp-ncam <int>            Focal plane camera size [pixels] (default: ${FP_NCAM})
  --rate <float>             Hardware master frame rate [Hz] (default: ${RATE_HZ})
  --mod-rad <float>          Pyramid modulation radius [lambda/D] (default: ${MOD_RAD})
  --backend <0|1|2>          0=auto (default), 1=CPU, 2=CUDA
  --atmturb                  Also launch milk-fpsexec-atmturb-mkwfs phase stream
  --seeing <float>           Seeing [arcsec] when --atmturb is active (default: ${SEEING})
  --restart                  Force unit restart and reset live WRITERUN parameters
  --workdir <dir>            Override fpspipe workspace root directory
  --no-view                  Suppress automatic graphical schematic on start/status
  -h, --help                 Show this help message
EOF
}

CMD="start"
if [[ $# -gt 0 && "$1" != -* ]]; then
    CMD="$1"
    shift
fi

case "${CMD}" in
    view|show)
        exec cacaosim-bench-view "$@"
        ;;
    gui|ctrl|config|tui)
        exec cacaosim-CTRL "$@"
        ;;
    edit)
        EDIT_TARGET=""
        for ((idx = 1; idx <= $#; idx++)); do
            arg="${!idx}"
            if [[ "${arg}" == "--config" || "${arg}" == "-c" ]]; then
                nxt=$((idx + 1))
                EDIT_TARGET="${!nxt:-}"
                break
            elif [[ "${arg}" != -* ]]; then
                EDIT_TARGET="${arg}"
                break
            fi
        done
        if [[ -z "${EDIT_TARGET}" ]]; then
            echo "[cacaosim-bench] Usage: cacaosim-bench edit <file.bench>" >&2
            exit 1
        fi
        if [[ ! -f "${EDIT_TARGET}" ]]; then
            cacaosim-bench-view --init "${EDIT_TARGET}" --no-footer >/dev/null
            echo "[cacaosim-bench] Created starter configuration '${EDIT_TARGET}'"
        fi
        "${VISUAL:-${EDITOR:-vi}}" "${EDIT_TARGET}"
        exec cacaosim-bench-view "${EDIT_TARGET}"
        ;;
esac

while [[ $# -gt 0 ]]; do
    case "$1" in
        -c|--config) BENCH_CFG="$2"; shift 2 ;;
        --mode)      MODE="$2"; shift 2 ;;
        --nwf)       NWF="$2"; shift 2 ;;
        --nact)      NACT="$2"; shift 2 ;;
        --wfs-ncam)  WFS_NCAM="$2"; shift 2 ;;
        --fp-ncam)   FP_NCAM="$2"; shift 2 ;;
        --rate)      RATE_HZ="$2"; RATE_SET=1; shift 2 ;;
        --mod-rad)   MOD_RAD="$2"; shift 2 ;;
        --backend)   BACKEND="$2"; BACKEND_SET=1; shift 2 ;;
        --atmturb)   WITH_ATMTURB=1; shift ;;
        --seeing)    SEEING="$2"; shift 2 ;;
        --restart)   RESTART=1; shift ;;
        --workdir)   WORKDIR="$2"; shift 2 ;;
        --no-view)   SHOW_VIEW=0; shift ;;
        -h|--help)   usage; exit 0 ;;
        -*)          echo "Unknown option: $1" >&2; usage; exit 1 ;;
        *)
            if [[ -z "${BENCH_CFG}" && ( "${CMD}" == "start" || "${CMD}" == "deploy" ) ]]; then
                BENCH_CFG="$1"
                shift
            else
                echo "Unexpected argument: $1" >&2
                usage
                exit 1
            fi
            ;;
    esac
done

SHM_DIR="${MILK_SHM_DIR:-/milk/shm}"
mkdir -p "${SHM_DIR}"
export MILK_SHM_DIR="${SHM_DIR}"

if [[ -n "${BENCH_CFG}" && "${BENCH_CFG}" != /* ]]; then
    if [[ -f "${PWD}/${BENCH_CFG}" ]]; then
        BENCH_CFG="$(realpath "${PWD}/${BENCH_CFG}")"
    elif [[ -f "${PREFIX_DIR}/examples/${BENCH_CFG}" ]]; then
        BENCH_CFG="$(realpath "${PREFIX_DIR}/examples/${BENCH_CFG}")"
    elif [[ -n "${MILK_ROOT:-}" && -f "${MILK_ROOT}/share/cacaosim/examples/${BENCH_CFG}" ]]; then
        BENCH_CFG="${MILK_ROOT}/share/cacaosim/examples/${BENCH_CFG}"
    fi
fi

CSIM_CMD_FILE=""
if [[ -f "${SCRIPT_DIR}/commands.d/cacaosim.bash" ]]; then
    CSIM_CMD_FILE="${SCRIPT_DIR}/commands.d/cacaosim.bash"
fi

EFF_RATE="0"
if (( RATE_SET )); then
    EFF_RATE="${RATE_HZ}"
elif [[ -z "${BENCH_CFG}" ]]; then
    EFF_RATE="${RATE_HZ}"
fi

EFF_BACKEND="-1"
if (( BACKEND_SET )); then
    EFF_BACKEND="${BACKEND}"
elif [[ -z "${BENCH_CFG}" ]]; then
    EFF_BACKEND="${BACKEND}"
fi

export _CSIM_CMD_FILE="${CSIM_CMD_FILE}"
export _CSIM_BENCH="${BENCH_CFG}"
export _CSIM_MODE="${MODE}"
export _CSIM_ATMTURB="${WITH_ATMTURB}"
export _CSIM_SEEING="${SEEING}"
export _CSIM_RATE="${EFF_RATE}"
export _CSIM_BACKEND="${EFF_BACKEND}"
export _CSIM_RESTART="${RESTART}"
export _CSIM_WORKDIR="${WORKDIR}"
export _CSIM_NWF="${NWF}"
export _CSIM_NACT="${NACT}"
export _CSIM_WFS_NCAM="${WFS_NCAM}"
export _CSIM_FP_NCAM="${FP_NCAM}"
export _CSIM_MOD_RAD="${MOD_RAD}"
export _CSIM_SHOW_VIEW="${SHOW_VIEW}"

case "${CMD}" in
    start|deploy)
        milk-script -e <<'EOF'
[[ -n "${_CSIM_CMD_FILE:-}" && -f "${_CSIM_CMD_FILE}" ]] && source "${_CSIM_CMD_FILE}"
cacaosim.deploy \
    "${_CSIM_BENCH}" \
    "${_CSIM_MODE}" \
    "${_CSIM_ATMTURB}" \
    "${_CSIM_SEEING}" \
    "${_CSIM_RATE}" \
    "${_CSIM_BACKEND}" \
    "${_CSIM_RESTART}" \
    "${_CSIM_WORKDIR}" \
    "${_CSIM_NWF}" \
    "${_CSIM_NACT}" \
    "${_CSIM_WFS_NCAM}" \
    "${_CSIM_FP_NCAM}" \
    "${_CSIM_MOD_RAD}"
EOF
        if (( SHOW_VIEW )) && command -v cacaosim-bench-view >/dev/null 2>&1; then
            if [[ -f "${SHM_DIR}/csim_active.bench" ]]; then
                cacaosim-bench-view "${SHM_DIR}/csim_active.bench" --no-footer || true
            else
                cacaosim-bench-view --live --no-footer || true
            fi
        fi
        echo "[cacaosim-bench] Bench deployed (mode=${MODE}, shm=${SHM_DIR})"
        ;;
    stop)
        milk-script -e <<'EOF'
[[ -n "${_CSIM_CMD_FILE:-}" && -f "${_CSIM_CMD_FILE}" ]] && source "${_CSIM_CMD_FILE}"
cacaosim.stop "${_CSIM_WORKDIR}"
EOF
        echo "[cacaosim-bench] All cacaosim units stopped."
        ;;
    teardown)
        milk-script -e <<'EOF'
[[ -n "${_CSIM_CMD_FILE:-}" && -f "${_CSIM_CMD_FILE}" ]] && source "${_CSIM_CMD_FILE}"
cacaosim.teardown "${_CSIM_WORKDIR}" 1
EOF
        echo "[cacaosim-bench] Bench torn down (units & streams removed)."
        ;;
    status)
        milk-script -e <<'EOF'
[[ -n "${_CSIM_CMD_FILE:-}" && -f "${_CSIM_CMD_FILE}" ]] && source "${_CSIM_CMD_FILE}"
cacaosim.status "${_CSIM_WORKDIR}" "${_CSIM_SHOW_VIEW}"
EOF
        ;;
    *)
        echo "Unknown command: ${CMD}" >&2
        usage
        exit 1
        ;;
esac
