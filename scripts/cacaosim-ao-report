        ls="-",
        lw=2.1,
        label="After Coro CL Planet Contrast",
    )
    ax_cl_r.semilogy(
        r_ld_v,
        np.clip(np.asarray(pr["cl_5sigma_planet"], dtype=float), 1e-8, 2.0),
        color="#f59e0b",
        ls="-.",
        lw=1.6,
        label="After Coro CL 5σ Speckle Contrast",
    )
    ax_cl_r.semilogy(
        r_ld_v,
        np.clip(np.asarray(pr["cl_raw"], dtype=float), 1e-8, 2.0),
